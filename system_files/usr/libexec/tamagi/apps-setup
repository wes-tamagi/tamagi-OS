#!/usr/bin/bash
# apps-setup — instala, em segundo plano, o que foi escolhido no primeiro login
# (tamagi-firstrun, "O que instalar"). Inspirado no aeon-firstboot do openSUSE
# Aeon (MIT): espera a rede, instala tudo de uma vez e avisa no fim — só que
# aqui roda como unidade do systemd do usuário, e o assistente continua
# enquanto os apps baixam.
#
#   apps-setup <arquivo>     uma ação por linha:
#       flatpak:<remote>:<ID>   app Flatpak (no usuário, sem pedir senha)
#       browser                 Chrome na caixa Fedora (tamagi-browser setup)
#       antigravity             Antigravity na caixa (tamagi-antigravity)
#       claude                  Claude Code (baixa no primeiro uso)
#       default-browser:<app>   navegador padrão (ex.: org.mozilla.firefox)
#   apps-setup status        o que está sendo instalado agora
set -uo pipefail
. /usr/libexec/tamagi/i18n

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/tamagi"
LOG="$STATE/apps-setup.log"
PROGRESS="$STATE/apps-setup.progress"
mkdir -p "$STATE"

if [[ ${1:-} == status ]]; then
    if systemctl --user is-active --quiet tamagi-apps-setup.service 2>/dev/null; then
        echo "$(t "Instalando em segundo plano"): $(cat "$PROGRESS" 2>/dev/null)"
    else
        tail -n 3 "$LOG" 2>/dev/null || echo "$(t "Nada sendo instalado")"
    fi
    exit 0
fi

list=${1:?uso: apps-setup <arquivo>}
[[ -s $list ]] || exit 0
exec >>"$LOG" 2>&1
echo "== $(date -Is) apps-setup"

notify() { notify-send -a Tamagi -i system-software-install "$@" 2>/dev/null || true; }

# 1) Rede (o primeiro login pode chegar antes do Wi-Fi).
for _ in $(seq 120); do
    curl -fsS -m 5 -o /dev/null https://dl.flathub.org/repo/summary.idx && break
    echo "$(t "esperando a conexão com a internet")" > "$PROGRESS"
    sleep 5
done

mapfile -t actions < "$list"
total=${#actions[@]} done_n=0 failed=()
step() { done_n=$((done_n + 1)); echo "$done_n/$total $1" > "$PROGRESS"; echo "-- $1"; }

# 2) Flatpaks: uma transação por remote (dependências e runtimes baixam uma vez).
declare -A by_remote=()
for a in "${actions[@]}"; do
    [[ $a == flatpak:* ]] || continue
    IFS=: read -r _ remote app <<<"$a"
    by_remote[$remote]+="$app "
done
if [[ ${#by_remote[@]} -gt 0 ]]; then
    flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
    flatpak remote-add --user --if-not-exists cosmic /etc/flatpak/remotes.d/cosmic.flatpakrepo 2>/dev/null || true
    for remote in "${!by_remote[@]}"; do
        read -r -a apps <<<"${by_remote[$remote]}"
        step "Flatpak: ${apps[*]}"
        if ! flatpak install --user --noninteractive --or-update "$remote" "${apps[@]}"; then
            # Uma falha não derruba as outras: tenta um por um.
            for app in "${apps[@]}"; do
                flatpak install --user --noninteractive --or-update "$remote" "$app" || failed+=("$app")
            done
        fi
        done_n=$((done_n + ${#apps[@]} - 1))
    done
fi

# 3) O que vive fora do Flatpak.
for a in "${actions[@]}"; do
    case $a in
        browser)     step "Chrome";      tamagi-browser setup </dev/null || failed+=(Chrome) ;;
        antigravity) step "Antigravity"; tamagi-antigravity instalar </dev/null || failed+=(Antigravity) ;;
        claude)      step "Claude Code"; claude --version </dev/null || failed+=("Claude Code") ;;
        default-browser:*)
            app=${a#default-browser:}
            step "$(t "navegador padrão"): $app"
            xdg-settings set default-web-browser "$app.desktop" 2>/dev/null \
                || xdg-mime default "$app.desktop" x-scheme-handler/http x-scheme-handler/https text/html ;;
    esac
done

rm -f "$PROGRESS"
if [[ ${#failed[@]} -eq 0 ]]; then
    echo "== ok"
    notify "$(t "Seus apps estão prontos")" "$(t "Tudo o que você escolheu no primeiro login foi instalado.")"
else
    echo "== falhou: ${failed[*]}"
    notify "$(t "Alguns apps não foram instalados")" "${failed[*]} — $(t "tente de novo pelo Super+Espaço (Instalar).")"
fi
