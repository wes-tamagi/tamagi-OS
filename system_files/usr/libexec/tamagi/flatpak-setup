#!/usr/bin/bash
# Instala os apps Flatpak essenciais do Tamagi no escopo --user (zero Flatpak de
# sistema: todos os apps ficam portáteis em ~/.local/share/flatpak dentro de /var/home).
#
# Waits for the first-login assistant to finish (it installs the browser and the
# apps the user picked): two installations at once make the first minutes of
# the desktop slow. A notification says when this one starts and ends.
set -uo pipefail
. /usr/libexec/tamagi/i18n

LIST=/usr/share/tamagi/flatpaks.list
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/tamagi
STAMP=$STATE_DIR/flatpaks.done

flatpak remote-add --user --if-not-exists flathub /etc/flatpak/remotes.d/flathub.flatpakrepo 2>/dev/null \
    || flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
flatpak remote-add --user --if-not-exists cosmic /etc/flatpak/remotes.d/cosmic.flatpakrepo 2>/dev/null || true

# The assistant has the turn (up to 30 min; then this goes on anyway).
DONE=${XDG_CONFIG_HOME:-$HOME/.config}/tamagi/firstrun-done
for _ in $(seq 360); do
    [[ -f $DONE ]] && ! pgrep -u "$UID" -x tamagi-install >/dev/null 2>&1 && break
    sleep 5
done
note() { notify-send -a Tamagi -i system-software-install "$@" 2>/dev/null || true; }
# Once per session: the service retries every minute while offline.
SAID=${XDG_RUNTIME_DIR:-/tmp}/tamagi-flatpak-setup.said
[[ -e $SAID ]] || note "$(t "Installing the essential apps in the background")"
: > "$SAID"

failed=0
while read -r remote app kind _; do
    [[ -z $remote || $remote == \#* ]] && continue
    [[ ${kind:-essencial} == essencial ]] || continue
    flatpak install --user --noninteractive --or-update "$remote" "$app" || failed=1
done < "$LIST"

# Sem o carimbo o serviço tenta de novo no próximo login.
(( failed )) && exit 1
mkdir -p "$STATE_DIR"
touch "$STAMP"
note "$(t "Your apps are ready")"
