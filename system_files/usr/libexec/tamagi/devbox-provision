#!/usr/bin/env bash
# devbox-provision — runs INSIDE a development box (as root), called by
# tamagi-devbox through /run/host/usr/libexec/tamagi/devbox-provision.
#
#   devbox-provision <distro> [extras_csv]
#   distros: fedora | ubuntu | opensuse | arch
#   extras:  go, zig, clang, browser (Chromium for tests),
#            only (install just the extras, skip the base set)
#
# Base set of every box:
#   compilers (gcc/g++/make/cmake/ninja/pkg-config), git, jq, ripgrep, tmux
#   SQLite + headers, Rust + Cargo, Node.js + npm, Python + pip/venv
#   database clients: psql, mariadb, valkey-cli/redis-cli
#   the GPU stack: Vulkan, VA-API and OpenCL drivers and tools (NVIDIA comes
#   from the host through `distrobox --nvidia`)
#   bubblewrap (the jail of `tamagi ai run`)
#   the terminal tools that used to ship in the image and now live here:
#   neovim, lazygit, gh, uv, glow, hyperfine, direnv, yq, ShellCheck
#   (tamagi-devbox exports them to the host: see DEV_TOOLS there)
#   mise (other languages and versions, per box) and the bridge to the
#   browser of the host (links and logins open on the desktop)
set -euo pipefail

DISTRO=${1:-fedora}
EXTRAS=${2:-}
STAMP=/var/lib/tamagi-devbox-provisioned

has_extra() { [[ ,$EXTRAS, == *,"$1",* ]]; }
# Database clients and the test browser are a bonus: a package renamed by the
# distro must not undo the whole box.
try() { "$@" || echo "devbox-provision: warning: '$*' failed; the box continues without it" >&2; }

provision_fedora() {
    local dnf=(dnf -y install --setopt=install_weak_deps=False)
    if ! has_extra only; then
        "${dnf[@]}" gcc gcc-c++ make cmake ninja-build pkgconf-pkg-config autoconf automake \
            git curl wget unzip tar jq ripgrep fd-find htop tmux xdg-utils bubblewrap perl \
            sqlite sqlite-devel openssl-devel zlib-devel libffi-devel libpq-devel \
            rust cargo clippy rustfmt rust-analyzer nodejs npm \
            python3 python3-pip python3-devel python3-virtualenv
        try "${dnf[@]}" postgresql mariadb valkey
        try "${dnf[@]}" neovim gh uv hyperfine direnv yq ShellCheck
        try "${dnf[@]}" lazygit glow
        # The GPUs of the machine, usable from the box: Vulkan, video (VA-API), OpenCL.
        try "${dnf[@]}" mesa-vulkan-drivers vulkan-loader vulkan-tools mesa-va-drivers libva-utils mesa-libOpenCL clinfo
    fi
    local extra=()
    has_extra go    && extra+=(golang)
    has_extra zig   && extra+=(zig)
    has_extra clang && extra+=(clang lld lldb)
    (( ${#extra[@]} )) && "${dnf[@]}" "${extra[@]}"
    has_extra browser && try "${dnf[@]}" chromium chromium-headless liberation-fonts google-noto-color-emoji-fonts
    return 0
}

provision_ubuntu() {
    export DEBIAN_FRONTEND=noninteractive
    local apt=(apt-get install -y --no-install-recommends)
    apt-get update -qq
    if ! has_extra only; then
        "${apt[@]}" ca-certificates curl gnupg build-essential cmake ninja-build pkg-config autoconf automake \
            git wget unzip jq ripgrep fd-find htop tmux xdg-utils bubblewrap perl \
            sqlite3 libsqlite3-dev libssl-dev zlib1g-dev libffi-dev libpq-dev \
            rustc cargo nodejs npm python3 python3-pip python3-dev python3-venv
        try "${apt[@]}" postgresql-client mariadb-client redis-tools
        try "${apt[@]}" neovim gh hyperfine direnv shellcheck
        try "${apt[@]}" lazygit
        try "${apt[@]}" yq
        try "${apt[@]}" mesa-vulkan-drivers vulkan-tools mesa-va-drivers vainfo mesa-opencl-icd clinfo
    fi
    local extra=()
    has_extra go    && extra+=(golang-go)
    has_extra clang && extra+=(clang lld lldb)
    (( ${#extra[@]} )) && "${apt[@]}" "${extra[@]}"
    # Ubuntu's "chromium" is a snap stub; Playwright brings its own build.
    has_extra browser && try "${apt[@]}" fonts-liberation fonts-noto-color-emoji libnss3 libatk-bridge2.0-0 libgbm1 libasound2t64
    return 0
}

provision_opensuse() {
    local zy=(zypper --non-interactive install --no-recommends)
    zypper --non-interactive refresh
    if ! has_extra only; then
        "${zy[@]}" gcc gcc-c++ make cmake ninja pkg-config autoconf automake \
            git curl wget unzip tar jq ripgrep fd tmux xdg-utils bubblewrap perl \
            sqlite3 sqlite3-devel libopenssl-devel zlib-devel libffi-devel \
            rust cargo nodejs-default npm-default python3-devel python3-pip
        try "${zy[@]}" postgresql mariadb-client valkey
        try "${zy[@]}" neovim gh uv hyperfine direnv yq ShellCheck
        try "${zy[@]}" lazygit glow
        try "${zy[@]}" libvulkan_radeon libvulkan_intel vulkan-tools libva-utils Mesa-libOpenCL clinfo
    fi
    local extra=()
    has_extra go    && extra+=(go)
    has_extra zig   && extra+=(zig)
    has_extra clang && extra+=(clang lld)
    (( ${#extra[@]} )) && "${zy[@]}" "${extra[@]}"
    has_extra browser && try "${zy[@]}" chromium liberation-fonts google-noto-coloremoji-fonts
    return 0
}

provision_arch() {
    local pm=(pacman -S --noconfirm --needed)
    if ! has_extra only; then
        pacman -Syu --noconfirm --needed base-devel cmake ninja pkgconf git curl wget unzip jq ripgrep fd htop tmux \
            xdg-utils bubblewrap perl sqlite openssl rust nodejs npm python python-pip
        try "${pm[@]}" postgresql-libs postgresql mariadb-clients valkey
        try "${pm[@]}" neovim github-cli uv hyperfine direnv go-yq shellcheck lazygit glow
        try "${pm[@]}" vulkan-radeon vulkan-intel vulkan-tools libva-utils libva-mesa-driver opencl-mesa clinfo
    fi
    local extra=()
    has_extra go    && extra+=(go)
    has_extra zig   && extra+=(zig)
    has_extra clang && extra+=(clang lld lldb)
    (( ${#extra[@]} )) && "${pm[@]}" "${extra[@]}"
    has_extra browser && try "${pm[@]}" chromium ttf-liberation noto-fonts-emoji
    return 0
}

# mise: official binary of the latest release, checksum verified. It lives in
# the box (not on the immutable host), and keeps the tools of each box apart:
# a Node built for Arch is not run by Ubuntu.
install_mise() {
    command -v mise >/dev/null 2>&1 && return 0
    local tmp tag asset
    tmp=$(mktemp -d)
    tag=$(curl -fsSLI -o /dev/null -w '%{url_effective}' https://github.com/jdx/mise/releases/latest)
    tag=${tag##*/}
    [[ $tag =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "mise: unexpected release tag '$tag'" >&2; return 1; }
    asset="mise-$tag-linux-x64"
    curl -fsSL -o "$tmp/$asset" "https://github.com/jdx/mise/releases/download/$tag/$asset"
    curl -fsSL -o "$tmp/SHASUMS256.txt" "https://github.com/jdx/mise/releases/download/$tag/SHASUMS256.txt"
    ( cd "$tmp" && grep -E " (\./)?$asset\$" SHASUMS256.txt | sha256sum -c - >/dev/null )
    install -Dm755 "$tmp/$asset" /usr/local/bin/mise
    rm -rf "$tmp"
    echo "mise $tag installed in the box"
}

# Environment of the box: mise per box, links open on the host, and the test
# browser (when installed) is where Playwright/Puppeteer/Selenium look for it.
write_profile() {
    install -Dm755 /dev/stdin /usr/local/bin/tamagi-open <<'SH'
#!/bin/sh
# Opens a link or file with the desktop of the host (outside the box).
exec distrobox-host-exec xdg-open "$@"
SH
    install -Dm644 /dev/stdin /etc/profile.d/tamagi-devbox.sh <<'SH'
# Tamagi development box (written by devbox-provision).
_box="${CONTAINER_ID:-box}"
export MISE_DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/mise-$_box"
export MISE_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/mise-$_box"
export MISE_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/mise-$_box"
case ":$PATH:" in *":$MISE_DATA_DIR/shims:"*) ;; *) PATH="$MISE_DATA_DIR/shims:$PATH" ;; esac
export PATH
export BROWSER=/usr/local/bin/tamagi-open
for _b in chromium-browser chromium chromium-headless; do
    if command -v "$_b" >/dev/null 2>&1; then
        CHROME_BIN=$(command -v "$_b"); export CHROME_BIN
        export PUPPETEER_EXECUTABLE_PATH="$CHROME_BIN" PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH="$CHROME_BIN"
        break
    fi
done
unset _b _box
if [ -n "${BASH_VERSION:-}" ] && command -v mise >/dev/null 2>&1; then
    case $- in *i*) eval "$(mise activate bash)" ;; esac
fi
SH
}

case "$DISTRO" in
    fedora)   provision_fedora ;;
    ubuntu)   provision_ubuntu ;;
    opensuse) provision_opensuse ;;
    arch)     provision_arch ;;
    *) echo "devbox-provision: unknown distro: $DISTRO (fedora, ubuntu, opensuse, arch)" >&2; exit 2 ;;
esac
try install_mise
write_profile

mkdir -p "$(dirname "$STAMP")"
printf '%s\n' "$DISTRO" > "$STAMP"
