#!/usr/bin/bash
# lazydocker-setup — lazydocker, a terminal view of containers, images,
# volumes and logs. Works with Docker and with Podman (the system's engine):
# without Docker, it is pointed at Podman's socket.
#
#   lazydocker-setup            install or update   (catalog: tamagi install lazydocker)
#   lazydocker-setup remove
# The official binary of the latest GitHub release, checked against the
# SHA-256 digest GitHub publishes for it, goes to ~/.local/bin.
set -euo pipefail
. /usr/libexec/tamagi/i18n

BIN="$HOME/.local/bin/lazydocker"
REAL="${XDG_DATA_HOME:-$HOME/.local/share}/tamagi/lazydocker/lazydocker"
die() { echo "$(t "error"): $*" >&2; exit 1; }

case "${1:-install}" in
    install)
        tmp=$(mktemp -d); trap 'rm -rf -- "${tmp:?}"' EXIT
        json=$(curl -fsSL -H "Accept: application/vnd.github+json" https://api.github.com/repos/jesseduffield/lazydocker/releases/latest)
        url=$(jq -r '.assets[] | select(.name | test("_Linux_x86_64\\.tar\\.gz$")) | .browser_download_url' <<<"$json" | head -1)
        digest=$(jq -r '.assets[] | select(.name | test("_Linux_x86_64\\.tar\\.gz$")) | .digest // ""' <<<"$json" | head -1)
        [[ -n $url ]] || die "lazydocker: $(t "could not find the binary in the latest release")"
        [[ $digest =~ ^sha256:[0-9a-f]{64}$ ]] || die "lazydocker: $(t "the release does not carry the SHA-256 digest; nothing was installed")"
        curl -fL --progress-bar -o "$tmp/pkg.tar.gz" "$url"
        echo "${digest#sha256:}  $tmp/pkg.tar.gz" | sha256sum -c --quiet - || die "lazydocker: $(t "the downloaded file does not match the published digest")"
        tar -xzf "$tmp/pkg.tar.gz" -C "$tmp" lazydocker
        install -Dm755 "$tmp/lazydocker" "$REAL"
        # Launcher: with no Docker daemon, lazydocker talks to Podman's socket.
        mkdir -p "$(dirname "$BIN")"
        cat > "$BIN" <<LAUNCHER
#!/bin/sh
# Generated by Tamagi (lazydocker-setup).
if [ -z "\${DOCKER_HOST:-}" ] && [ ! -S /run/docker.sock ] && [ ! -S /var/run/docker.sock ]; then
    systemctl --user start podman.socket 2>/dev/null
    DOCKER_HOST="unix://\${XDG_RUNTIME_DIR:-/run/user/\$(id -u)}/podman/podman.sock"; export DOCKER_HOST
fi
exec "$REAL" "\$@"
LAUNCHER
        chmod +x "$BIN"
        echo "lazydocker $("$REAL" --version 2>/dev/null | sed -n 's/^Version: //p' | head -1): $(t "installed")" ;;
    remove)
        rm -f "$BIN" "$REAL"
        echo "$(t "Removed"): lazydocker" ;;
    *) echo "usage: lazydocker-setup [install|remove]" >&2; exit 2 ;;
esac
