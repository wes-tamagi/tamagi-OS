#!/usr/bin/bash
# home-snapshots — snapshots automáticos da pasta pessoal (roda como root).
#
# A ideia vem do HAMMER2 do DragonFly BSD: o sistema de arquivos guarda o
# histórico sozinho. O Tamagi já volta o *sistema* (bootc + boot-check); isto
# faz o mesmo pelos *seus arquivos*: o snapper tira um snapshot btrfs da
# pasta pessoal a cada hora e guarda 24 por hora, 7 diários e 4 semanais.
# `tamagi-snap restore <arquivo>` traz um arquivo de volta.
#
#   home-snapshots enable <usuário>    liga (converte a pasta em subvolume, se
#                                      preciso; com o usuário logado, agenda
#                                      para o próximo boot, antes do login)
#   home-snapshots pending           faz as conversões agendadas (serviço de boot)
#   home-snapshots clean <usuário>    apaga a cópia de segurança da conversão
#   home-snapshots prune [min_free_gb] poda snapshots antigos se o espaço livre cair
#                                      abaixo do mínimo (e limpa backups com >7 dias)
#   home-snapshots status <usuário>
#
# Snapshot btrfs só existe de subvolume, e no Tamagi /var/home é uma pasta
# comum. A conversão copia com reflink (instantâneo e sem ocupar espaço em
# dobro), confere e troca os nomes; a pasta original fica como
# /var/home/.<usuário>.antes-snapshots até `limpar`.
# ~/.cache, ~/.local/share/containers, Flatpaks do usuário, jogos (Steam/Lutris)
# e os discos de VM (tamagi-windows, libvirt) viram subvolumes à parte: ficam
# fora dos snapshots (mudam o tempo todo e só ocupariam espaço).
# O snapper NUNCA é ligado na raiz (/): a imagem do sistema já é atômica pelo
# bootc (composefs), e snapshots da raiz prenderiam camadas antigas no btrfs.
set -euo pipefail

HOMES=/var/home
PENDING=/var/lib/tamagi/home-snapshots.pending
EXCLUDE=(
    .cache
    .local/share/containers
    .local/share/flatpak
    .local/share/Steam
    .local/share/lutris
    .local/share/tamagi-windows
    .local/share/libvirt/images
)

die() { echo "home-snapshots: $*" >&2; exit 1; }
[[ $(id -u) -eq 0 ]] || die "precisa de root (use: tamagi-snap enable)"

is_subvol() { [[ $(stat -c %i "$1" 2>/dev/null) == 256 ]] && btrfs subvolume show "$1" >/dev/null 2>&1; }
on_btrfs() { [[ $(stat -f -c %T "$1") == btrfs ]]; }
logged_in() { loginctl show-user "$1" -p State --value 2>/dev/null | grep -qE 'active|online|lingering'; }
config_of() { echo "home-$1"; }

check_user() {
    local user=$1
    [[ $user =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || die "usuário inválido: $user"
    id "$user" >/dev/null 2>&1 || die "usuário não existe: $user"
    local home; home=$(getent passwd "$user" | cut -d: -f6)
    [[ $(realpath "$home") == "$HOMES/$user" ]] || die "a pasta de $user não está em $HOMES ($home)"
    on_btrfs "$HOMES" || die "$HOMES não está em btrfs: sem snapshots"
}

# Transforma uma pasta comum em subvolume, com o mesmo conteúdo, dono,
# permissões e rótulos SELinux. O original só sai do lugar depois de conferido.
to_subvol() {
    local dir=$1 keep_backup=${2:-}
    is_subvol "$dir" && return 0
    local parent name new old
    parent=$(dirname "$dir"); name=$(basename "$dir")
    new="$parent/.$name.novo-subvol"; old="$parent/.$name.antes-snapshots"
    [[ -e $new ]] && btrfs subvolume delete "$new" >/dev/null
    btrfs subvolume create "$new" >/dev/null
    if [[ -d $dir ]]; then
        if ! cp -a --reflink=always "$dir/." "$new/"; then
            btrfs subvolume delete "$new" >/dev/null 2>&1 || true
            die "não deu para copiar $dir (nada foi alterado)"
        fi
        local a b
        a=$(find "$dir" -xdev | wc -l); b=$(find "$new" -xdev | wc -l)
        [[ $a == "$b" ]] || { btrfs subvolume delete "$new" >/dev/null; die "cópia de $dir não confere ($a x $b)"; }
        chown --reference="$dir" "$new"; chmod --reference="$dir" "$new"
        [[ -e $old ]] && die "já existe $old (rode 'clean' antes)"
        mv "$dir" "$old"
    fi
    mv "$new" "$dir"
    command -v restorecon >/dev/null && restorecon "$dir" 2>/dev/null || true
    if [[ -e $old && -z $keep_backup ]]; then
        rm -rf --one-file-system "$old"
    fi
}

# Cria cada pasta intermediária dentro de $home com dono $user:$group
# (evita que `install -d -o user a/b` deixe o pai `a` pertencendo a root:root,
# o que quebrava ~/.local/state para mise, cosmic e apps no primeiro login).
ensure_user_dir() {
    local home=$1 user=$2 group=$3 rel=$4 cur="$1" part
    IFS='/' read -r -a parts <<<"$rel"
    for part in "${parts[@]}"; do
        [[ -n $part ]] || continue
        cur="$cur/$part"
        if [[ ! -d $cur ]]; then
            mkdir -p "$cur"
            chown "$user:$group" "$cur"
            chmod 755 "$cur"
            command -v restorecon >/dev/null && restorecon "$cur" 2>/dev/null || true
        elif [[ $user != root && $(stat -c '%u' "$cur" 2>/dev/null) == 0 ]]; then
            chown "$user:$group" "$cur"
            command -v restorecon >/dev/null && restorecon "$cur" 2>/dev/null || true
        fi
    done
}

convert_home() {
    local user=$1 group home="$HOMES/$1" sub
    group=$(id -gn "$user")
    # A pasta pessoal guarda a cópia de segurança; as de cache, não.
    to_subvol "$home" keep
    # Garante a árvore XDG padrão pertencente ao usuário (nunca root:root).
    for d in .local .local/share .local/state .local/bin; do
        ensure_user_dir "$home" "$user" "$group" "$d"
    done
    for sub in "${EXCLUDE[@]}"; do
        local p="$home/$sub"
        if [[ ! -e $p ]]; then
            local parent_rel
            parent_rel=$(dirname "$sub")
            [[ $parent_rel != . ]] && ensure_user_dir "$home" "$user" "$group" "$parent_rel"
            btrfs subvolume create "$p" >/dev/null
            chown "$user:$group" "$p"; chmod 700 "$p"
            command -v restorecon >/dev/null && restorecon "$p" 2>/dev/null || true
        else
            to_subvol "$p"
        fi
    done
}

setup_snapper() {
    local user=$1 cfg; cfg=$(config_of "$1")
    local snaps="$HOMES/$user/.snapshots"
    local preserved="$HOMES/$user/.snapshots.tamagi-preserve"
    # Guardrail: o snapper nunca gerencia a raiz (/), que pertence ao bootc.
    if [[ -f /etc/snapper/configs/root ]]; then
        grep -q '^SUBVOLUME="/"' /etc/snapper/configs/root 2>/dev/null && rm -f /etc/snapper/configs/root
    fi
    if [[ ! -f /etc/snapper/configs/$cfg ]]; then
        if [[ -d $snaps ]]; then
            # Preserva snapshots de uma instalação anterior: o create-config do snapper
            # exige criar o próprio subvolume .snapshots vazio, então guardamos e
            # reconectamos o existente logo em seguida.
            rm -rf "$preserved" 2>/dev/null || true
            mv "$snaps" "$preserved"
            if snapper --no-dbus -c "$cfg" create-config "$HOMES/$user"; then
                if is_subvol "$preserved"; then
                    btrfs subvolume delete "$snaps" >/dev/null 2>&1 || rm -rf "$snaps"
                    mv "$preserved" "$snaps"
                else
                    shopt -s nullglob dotglob
                    for item in "$preserved"/*; do
                        mv "$item" "$snaps/"
                    done
                    shopt -u nullglob dotglob
                    rmdir "$preserved" 2>/dev/null || rm -rf "$preserved"
                fi
            else
                mv "$preserved" "$snaps"
                return 1
            fi
        else
            snapper --no-dbus -c "$cfg" create-config "$HOMES/$user"
        fi
    fi
    chown root:root "$snaps"
    chmod 750 "$snaps"
    snapper --no-dbus -c "$cfg" set-config \
        ALLOW_USERS="$user" SYNC_ACL=yes \
        TIMELINE_CREATE=yes TIMELINE_CLEANUP=yes TIMELINE_MIN_AGE=1800 \
        TIMELINE_LIMIT_HOURLY=12 TIMELINE_LIMIT_DAILY=7 TIMELINE_LIMIT_WEEKLY=4 \
        TIMELINE_LIMIT_MONTHLY=0 TIMELINE_LIMIT_QUARTERLY=0 TIMELINE_LIMIT_YEARLY=0 \
        NUMBER_CLEANUP=yes NUMBER_LIMIT=10 SPACE_LIMIT=0.3 FREE_LIMIT=0.2
    snapper --no-dbus -c "$cfg" create -d "snapshots ligados" -c number
}

# Evita colapso de espaço entre o snapper e o bootc: remove config "root" se
# alguém a tiver criado por engano, apaga cópias de conversão (.antes-snapshots)
# com mais de 7 dias e, se o espaço livre cair abaixo de <min_free_gb> (padrão
# 15 GiB), roda os algoritmos de limpeza do snapper e poda os snapshots mais
# antigos até abrir espaço.
prune_space() {
    local min_gb=${1:-15} free_bytes min_bytes cfg
    min_bytes=$(( min_gb * 1024 * 1024 * 1024 ))
    if [[ -f /etc/snapper/configs/root ]] && grep -q '^SUBVOLUME="/"' /etc/snapper/configs/root 2>/dev/null; then
        echo "home-snapshots: removendo configuração indevida do snapper na raiz (/ pertence ao bootc)" >&2
        rm -f /etc/snapper/configs/root
    fi
    # Cópias de segurança da conversão inicial com mais de 7 dias.
    if [[ -d $HOMES ]]; then
        while read -r old; do
            [[ -n $old ]] || continue
            echo "home-snapshots: limpando cópia de conversão antiga $old"
            rm -rf --one-file-system "$old"
        done < <(find "$HOMES" -maxdepth 1 -mindepth 1 -name '.*.antes-snapshots' -mtime +7 2>/dev/null || true)
    fi
    [[ -d /etc/snapper/configs ]] || return 0
    for cfg in /etc/snapper/configs/home-*; do
        [[ -f $cfg ]] || continue
        cfg=$(basename "$cfg")
        snapper --no-dbus -c "$cfg" cleanup timeline >/dev/null 2>&1 || true
        snapper --no-dbus -c "$cfg" cleanup number >/dev/null 2>&1 || true
    done
    free_bytes=$(df --output=avail -B1 "$HOMES" 2>/dev/null | tail -1 | tr -d ' ')
    [[ $free_bytes =~ ^[0-9]+$ ]] || return 0
    (( free_bytes >= min_bytes )) && return 0
    echo "home-snapshots: espaço livre baixo ($(( free_bytes / 1024 / 1024 / 1024 )) GiB < ${min_gb} GiB); podando snapshots antigos"
    for cfg in /etc/snapper/configs/home-*; do
        [[ -f $cfg ]] || continue
        cfg=$(basename "$cfg")
        local subvol
        subvol=$(awk -F'"' '/^SUBVOLUME=/ {print $2}' "/etc/snapper/configs/$cfg" 2>/dev/null)
        [[ -n $subvol && -d $subvol/.snapshots ]] || continue
        local snaps=()
        mapfile -t snaps < <(find "$subvol/.snapshots" -maxdepth 1 -mindepth 1 -type d -printf '%f\n' | grep -E '^[0-9]+$' | sort -n)
        # Mantém sempre os 3 snapshots mais recentes.
        if (( ${#snaps[@]} > 3 )); then
            local to_del=("${snaps[@]:0:${#snaps[@]}-3}")
            for s in "${to_del[@]}"; do
                snapper --no-dbus -c "$cfg" delete "$s" >/dev/null 2>&1 || true
                free_bytes=$(df --output=avail -B1 "$HOMES" 2>/dev/null | tail -1 | tr -d ' ')
                [[ $free_bytes =~ ^[0-9]+$ ]] && (( free_bytes >= min_bytes )) && break
            done
        fi
    done
}

activate() {
    local user=$1 at_boot=${2:-}
    check_user "$user"
    # No boot (serviço antes do login) ninguém está usando a pasta; um usuário
    # com "linger" aparece como logado, mas a sessão gráfica ainda não abriu.
    if [[ -z $at_boot ]] && ! is_subvol "$HOMES/$user" && logged_in "$user"; then
        install -d -m 755 "$(dirname "$PENDING")"
        grep -qx "$user" "$PENDING" 2>/dev/null || echo "$user" >> "$PENDING"
        echo "agendado: a pasta de $user vira subvolume no próximo boot, antes do login"
        return 0
    fi
    convert_home "$user"
    setup_snapper "$user"
    echo "snapshots da pasta pessoal ligados para $user"
    [[ -e $HOMES/.$user.antes-snapshots ]] && \
        echo "cópia de segurança em $HOMES/.$user.antes-snapshots (tamagi-snap clean-backup apaga)"
    return 0
}

case "${1:-}" in
    enable)
        [[ -n ${2:-} ]] || die "usage: home-snapshots enable <usuário>"
        activate "$2" ;;
    pending)
        [[ -f $PENDING ]] || exit 0
        while read -r user; do
            [[ -n $user ]] || continue
            activate "$user" boot || echo "falhou para $user" >&2
        done < "$PENDING"
        rm -f "$PENDING" ;;
    clean)
        [[ -n ${2:-} ]] || die "usage: home-snapshots clean <usuário>"
        check_user "$2"
        old="$HOMES/.$2.antes-snapshots"
        [[ -e $old ]] || { echo "não há cópia de segurança"; exit 0; }
        rm -rf --one-file-system "$old"
        echo "cópia de segurança apagada" ;;
    prune)
        prune_space "${2:-15}" ;;
    status)
        [[ -n ${2:-} ]] || die "usage: home-snapshots status <usuário>"
        u=$2
        echo "subvolume: $(is_subvol "$HOMES/$u" && echo sim || echo não)"
        echo "snapper:   $([[ -f /etc/snapper/configs/$(config_of "$u") ]] && echo sim || echo não)"
        echo "agendado:  $(grep -qx "$u" "$PENDING" 2>/dev/null && echo sim || echo não)" ;;
    *)
        sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 2 ;;
esac
