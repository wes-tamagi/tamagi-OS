#!/usr/bin/bash
# secureboot-guard — impede que uma atualização deixe a máquina sem boot.
#
# O kernel padrão do Tamagi (Open Gaming Collective) é assinado
# só pelo Universal Blue. Com o Secure Boot ligado e a chave do Universal Blue
# fora da lista do firmware (MOK), o shim recusa esse kernel antes de qualquer
# coisa do sistema rodar — nem a volta automática consegue desfazer. Por isso,
# logo depois de preparar uma atualização, o system-update chama este guarda, que
# confere: kernel novo sem assinatura do Fedora + Secure Boot ligado + chave do
# Universal Blue ausente => sai com 3 (o system-update descarta a atualização) e avisa como registrar a
# chave (tamagi setup secure-boot-key, senha universalblue, e reiniciar).
#
# Variáveis só para testes: TAMAGI_SB_ENABLED=0|1 TAMAGI_SB_KEY=0|1
# TAMAGI_STAGED_VMLINUZ=<arquivo> TAMAGI_SB_DRYRUN=1
set -uo pipefail

KEY=/etc/pki/akmods/certs/akmods-ublue.der
FLAG=/var/lib/tamagi/secureboot-blocked

sb_enabled() {
    [[ -n ${TAMAGI_SB_ENABLED:-} ]] && { [[ $TAMAGI_SB_ENABLED == 1 ]]; return; }
    mokutil --sb-state 2>/dev/null | grep -qi 'SecureBoot enabled'
}
key_enrolled() {
    [[ -n ${TAMAGI_SB_KEY:-} ]] && { [[ $TAMAGI_SB_KEY == 1 ]]; return; }
    [[ -f $KEY ]] && mokutil --test-key "$KEY" 2>/dev/null | grep -qi 'already enrolled'
}
staged_vmlinuz() {
    [[ -n ${TAMAGI_STAGED_VMLINUZ:-} ]] && { echo "$TAMAGI_STAGED_VMLINUZ"; return; }
    # systemd-boot: o bootc deixa o kernel de cada imagem na partição EFI,
    # numa pasta com o identificador dela (EFI/Linux/bootc_composefs-<id>).
    # Imagens com o mesmo kernel dividem a pasta: o caminho certo é o da linha
    # "linux" da entrada preparada (loader/entries.staged) dessa imagem.
    local id entry path
    id=$(jq -r '.status.staged.composefs.verity // empty' "${TAMAGI_BOOTC_STATUS:-/run/tamagi/bootc-status.json}" 2>/dev/null)
    [[ -n $id ]] || return 1
    entry=$(grep -ls "composefs.digest=[^ ]*$id" /efi/loader/entries.staged/*.conf /efi/loader/entries/*.conf 2>/dev/null | head -1)
    [[ -n $entry ]] || return 1
    path=$(awk '$1 == "linux" {print $2; exit}' "$entry")
    [[ -n $path ]] && echo "/efi$path"
}
notify_users() {
    local uid user
    for uid in $(loginctl list-users --no-legend 2>/dev/null | awk '{print $1}'); do
        user=$(id -nu "$uid" 2>/dev/null) || continue
        [[ -S /run/user/$uid/bus ]] || continue
        runuser -u "$user" -- env DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
            notify-send -a Tamagi -u critical -i dialog-warning "$1" "$2" 2>/dev/null || true
    done
}

sb_enabled || { rm -f "$FLAG"; exit 0; }
key_enrolled && { rm -f "$FLAG"; exit 0; }
vmlinuz=$(staged_vmlinuz) || exit 0
[[ -f $vmlinuz ]] || exit 0
# Kernel assinado pelo Fedora (main, ark) inicia sem a chave do Universal Blue.
grep -aq 'Fedora Secure Boot Signer' "$vmlinuz" && exit 0

echo "secureboot-guard: Secure Boot ligado, chave do Universal Blue ausente e kernel novo assinado só por ela: atualização cancelada"
if [[ -z ${TAMAGI_SB_DRYRUN:-} ]]; then
    mkdir -p "$(dirname "$FLAG")"
    date -Is > "$FLAG"
    notify_users "Atualização cancelada: Secure Boot / Update cancelled: Secure Boot" \
        "O kernel novo precisa da chave do Universal Blue registrada. Rode: tamagi setup secure-boot-key (senha: universalblue), reinicie e confirme 'Enroll MOK'. Depois, tamagi-update.
The new kernel needs the Universal Blue key enrolled: tamagi setup secure-boot-key (password: universalblue), reboot and confirm 'Enroll MOK', then tamagi-update."
fi
exit 3
