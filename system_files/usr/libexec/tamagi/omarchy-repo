#!/usr/bin/bash
# Roda DENTRO da caixa Arch, como root (tamagi-pkg chama pelo /run/host):
# acrescenta o repositório de pacotes do Omarchy (https://pkgs.omarchy.org) ao
# pacman da caixa. A chave pública vem na imagem do Tamagi e é conferida pela
# impressão digital antes de ser aceita.
#   omarchy-repo [stable|rc|edge]
set -euo pipefail

CHANNEL=${1:-stable}
KEY=${TAMAGI_OMARCHY_KEY:-/run/host/usr/share/tamagi/omarchy/omarchy.gpg}
FPR=40DFB630FF42BCFFB047046CF0134EE680CAC571

[[ $CHANNEL =~ ^(stable|rc|edge)$ ]] || { echo "canal inválido: $CHANNEL" >&2; exit 2; }
[[ -f /etc/pacman.conf ]] || { echo "esta caixa não é Arch (sem /etc/pacman.conf)" >&2; exit 1; }
[[ -f $KEY ]] || { echo "chave do Omarchy não encontrada em $KEY" >&2; exit 1; }

if grep -q '^\[omarchy\]' /etc/pacman.conf; then
    sed -i -E "/^\[omarchy\]/,/^\[/ s|^Server = https://pkgs.omarchy.org/[a-z]+/|Server = https://pkgs.omarchy.org/$CHANNEL/|" /etc/pacman.conf
    echo "Repositório do Omarchy já configurado (canal: $CHANNEL)."
    exit 0
fi

[[ -d /etc/pacman.d/gnupg ]] || pacman-key --init
found=$(gpg --show-keys --with-colons "$KEY" | awk -F: '$1 == "fpr" { print $10; exit }')
[[ $found == "$FPR" ]] || { echo "a chave em $KEY não é a do Omarchy (impressão digital $found)" >&2; exit 1; }
pacman-key --add "$KEY"
pacman-key --lsign-key "$FPR"

# [omarchy] antes de [core], como no próprio Omarchy: os pacotes dele têm prioridade.
awk -v channel="$CHANNEL" '
    /^\[core\]/ && !done {
        print "[omarchy]"
        print "SigLevel = Required DatabaseOptional"
        print "Server = https://pkgs.omarchy.org/" channel "/$arch"
        print ""
        done = 1
    }
    { print }
    END { if (!done) exit 1 }
' /etc/pacman.conf > /etc/pacman.conf.tamagi
mv /etc/pacman.conf.tamagi /etc/pacman.conf

pacman -Sy --noconfirm --needed omarchy-keyring
echo "Repositório do Omarchy pronto (canal: $CHANNEL). Ex.: tamagi-pkg install --omarchy <pacote>"
