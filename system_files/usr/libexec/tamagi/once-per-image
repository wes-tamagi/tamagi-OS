#!/usr/bin/bash
# once-per-image — deixa uma tarefa de boot rodar só quando a imagem do
# sistema muda (instalação nova ou atualização), em vez de a cada boot.
#
#   once-per-image check NOME   sai 0 se NOME ainda não rodou nesta imagem
#   once-per-image done NOME    marca NOME como feito para esta imagem
#
# A imagem é identificada pelo composefs=/ostree= da linha do kernel (muda a
# cada imagem nova); sem eles, pelo os-release.
set -euo pipefail
dir=/var/lib/tamagi/once-per-image
name=${2:?uso: once-per-image check|done NOME}
[[ $name =~ ^[A-Za-z0-9_.-]+$ ]] || { echo "nome inválido: $name" >&2; exit 2; }

id=$(grep -oE '(composefs|ostree)=[^ ]+' /proc/cmdline | head -n1 || true)
[[ -n $id ]] || id=$(sha256sum /usr/lib/os-release | cut -d' ' -f1)

case $1 in
    check) [[ $(cat "$dir/$name" 2>/dev/null) != "$id" ]] ;;
    done)  mkdir -p "$dir" && printf '%s\n' "$id" > "$dir/$name" ;;
    *)     echo "uso: once-per-image check|done NOME" >&2; exit 2 ;;
esac
