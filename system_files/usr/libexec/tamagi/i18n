# shellcheck shell=bash
# Tamagi — textos das ferramentas em quatro idiomas: português (o original),
# inglês (EUA), espanhol e francês. Para usar num script:
#
#   . /usr/libexec/tamagi/i18n
#   echo "$(t "Texto em português")"        # ou: tl "Texto" (com quebra de linha)
#
# A chave é o próprio texto em português; as traduções ficam em
# /usr/share/tamagi/i18n/<idioma>.tsv (português<TAB>tradução, uma por linha).
# Sem tradução, sai o português. Prioridade do idioma:
#   TAMAGI_LANG > LC_ALL > LC_MESSAGES > ~/.config/tamagi/lang > LANG
# Idiomas fora de pt/es/fr caem no inglês.
declare -gA TAMAGI_TR=()
_tamagi_cfg_lang="${XDG_CONFIG_HOME:-$HOME/.config}/tamagi/lang"
if [[ -n ${TAMAGI_LANG:-} ]]; then
    _tamagi_raw=$TAMAGI_LANG
elif [[ -n ${LC_ALL:-} ]]; then
    _tamagi_raw=$LC_ALL
elif [[ -n ${LC_MESSAGES:-} ]]; then
    _tamagi_raw=$LC_MESSAGES
elif [[ -r $_tamagi_cfg_lang ]]; then
    _tamagi_raw=$(head -n 1 "$_tamagi_cfg_lang" 2>/dev/null || true)
else
    _tamagi_raw="${LANG:-pt_BR}"
fi
case "${_tamagi_raw,,}" in
    pt*) TAMAGI_LANG=pt ;;
    es*) TAMAGI_LANG=es ;;
    fr*) TAMAGI_LANG=fr ;;
    *)   TAMAGI_LANG=en ;;
esac
unset _tamagi_cfg_lang _tamagi_raw
if [[ $TAMAGI_LANG != pt && -r ${TAMAGI_I18N_DIR:-/usr/share/tamagi/i18n}/$TAMAGI_LANG.tsv ]]; then
    while IFS=$'\t' read -r _k _v; do
        [[ -n $_k && $_k != \#* && -n $_v ]] && TAMAGI_TR[$_k]=$_v
    done < "${TAMAGI_I18N_DIR:-/usr/share/tamagi/i18n}/$TAMAGI_LANG.tsv"
    unset _k _v
fi
t() { printf '%s' "${TAMAGI_TR[$1]:-$1}"; }
tl() { printf '%s\n' "${TAMAGI_TR[$1]:-$1}"; }
# Arquivo de texto traduzido: tfile /usr/share/tamagi/keys.txt -> keys.en.txt se existir.
tfile() { local f="${1%.*}.$TAMAGI_LANG.${1##*.}"; [[ $TAMAGI_LANG != pt && -r $f ]] && echo "$f" || echo "$1"; }
