#!/usr/bin/bash
# llm-scripts-setup — fewtarius/llm-scripts (GPL-3.0) on top of the llama.cpp
# that Tamagi already ships.
#
# llm-scripts is a runner (`llm`) that reads the GGUF metadata and the GPU
# memory of the machine and works out the launch profile of the model
# (context, KV cache, sessions, draft model): `llm profile`, `llm serve`,
# `llm doctor`, `llm pull`. Nothing is compiled here: the runner is pointed at
# the system's llama-server (Vulkan) and at the models of `tamagi ai`.
#
#   llm-scripts-setup            install or update   (catalog: tamagi install llm-scripts)
#   llm-scripts-setup remove
# Its other engine (gufo, for AMD APUs) and the ROCm build need compilers:
# do those inside the development box (`tamagi dev box enter`, then `llm build`).
set -euo pipefail
. /usr/libexec/tamagi/i18n

DATA="${XDG_DATA_HOME:-$HOME/.local/share}/tamagi"
REPO="$DATA/llm-scripts"
BUILD="$DATA/llm-scripts-build"          # where the runner looks for the engines
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/llm-scripts/config.env"
MODELS="${TAMAGI_AI_MODELS:-$DATA/models}"
URL=https://github.com/fewtarius/llm-scripts.git

case "${1:-install}" in
    install)
        if [[ -d $REPO/.git ]]; then
            git -C "$REPO" pull -q --ff-only
        else
            mkdir -p "$DATA"
            git clone -q --depth 1 "$URL" "$REPO"        # no submodules: the engines are the system's
        fi
        # The runner finds llama.cpp in <build>/llama-vulkan/bin: links to /usr/bin.
        mkdir -p "$BUILD/llama-vulkan/bin" "$MODELS" "$(dirname "$CONF")" "$HOME/.local/bin"
        for b in /usr/bin/llama-*; do
            [[ -x $b ]] && ln -sfn "$b" "$BUILD/llama-vulkan/bin/$(basename "$b")"
        done
        if [[ ! -e $CONF ]]; then
            cat > "$CONF" <<CONFIG
# Written by Tamagi (llm-scripts-setup); yours to edit. See $REPO/config/llm.conf.example
LLM_ENGINE=llama.cpp
LLM_BACKEND=vulkan
LLM_MODEL_DIR=$MODELS
LLM_BUILD_DIR=$BUILD
LLM_HOST=127.0.0.1
LLM_PORT=9932
CONFIG
        fi
        # Launcher: the model folder and the engines are given in the environment
        # (the runner takes its own default for the model folder before it
        # reads the configuration file, so the file alone is not enough).
        rm -f "$HOME/.local/bin/llm"
        cat > "$HOME/.local/bin/llm" <<LAUNCHER
#!/bin/sh
# Generated by Tamagi (llm-scripts-setup): llm-scripts with the system's llama.cpp.
: "\${LLM_MODEL_DIR:=$MODELS}" "\${LLM_BUILD_DIR:=$BUILD}"
export LLM_MODEL_DIR LLM_BUILD_DIR
exec "$REPO/llm" "\$@"
LAUNCHER
        chmod +x "$HOME/.local/bin/llm"
        echo "llm-scripts $(git -C "$REPO" rev-parse --short HEAD): $(t "installed"). llm doctor · llm models · llm profile --model <model>" ;;
    remove)
        rm -f "$HOME/.local/bin/llm"
        [[ -d $REPO ]] && rm -rf -- "${REPO:?}"
        [[ -d $BUILD ]] && rm -rf -- "${BUILD:?}"
        echo "$(t "Removed"): llm-scripts ($CONF $(t "stays"))" ;;
    *) echo "usage: llm-scripts-setup [install|remove]" >&2; exit 2 ;;
esac
