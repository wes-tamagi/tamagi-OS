#!/usr/bin/bash
# agent-jail — builds the bubblewrap jail of `tamagi agents run` and enters it.
#
# It runs WHERE THE JAIL IS BUILT: on the host, or inside the development box
# (called there as /run/host/usr/libexec/tamagi/agent-jail). The two places
# look different — in a box, /home is a real folder with the host's home
# mounted in it and the whole host is visible under /run/host — so the list of
# what to hide has to be worked out on the spot, never on the other side.
#
#   agent-jail [--offline] [--print] --root <project> --cwd <dir>
#              [--state "<rel> <rel>…"] [--rw <dir>]… [--setenv NAME=value]…
#              -- <command> [args]
#
# Inside the jail the command sees the project folder (read-write), its own
# state folders (--state, relative to the home), the tools installed in the
# home (read-only) and a read-only system. Hidden: every home, mounted and
# removable disks, the host seen from a box, the session sockets (D-Bus,
# Wayland, podman) and libvirt's socket.
set -euo pipefail

offline=0 print=0 root="" cwd="" state="" rw=() envs=()
while (( $# )); do
    case $1 in
        --offline) offline=1 ;;
        --print)   print=1 ;;
        --root)    root=$2; shift ;;
        --cwd)     cwd=$2; shift ;;
        --state)   state=$2; shift ;;
        --rw)      rw+=("$2"); shift ;;
        --setenv)  envs+=("$2"); shift ;;
        --)        shift; break ;;
        *) echo "agent-jail: unknown option: $1" >&2; exit 2 ;;
    esac
    shift
done
(( $# )) || { echo "agent-jail: no command" >&2; exit 2; }
[[ -n $root && -d $root ]] || { echo "agent-jail: --root <project> is required" >&2; exit 2; }

home=$(realpath "$HOME")
root=$(realpath "$root")
cwd=$(realpath "${cwd:-$root}")
[[ $root != "$home" && $root != / ]] || { echo "agent-jail: the project cannot be the whole home folder" >&2; exit 2; }
case $cwd/ in "$root"/*) ;; *) cwd=$root ;; esac

args=(--die-with-parent --unshare-pid --unshare-ipc --ro-bind / / --dev /dev --proc /proc --tmpfs /tmp)

# Everything personal or outside the project is emptied. A path that is a
# link is skipped: its target is in the list too (on the atomic host /home
# links to /var/home; in a box both are real folders).
for d in /var/home /home /root /var/roothome /run/media /media /mnt /var/mnt /srv /var/srv \
         /run/host /run/libvirt "/run/user/$(id -u)"; do
    [[ -d $d && ! -L $d ]] && args+=(--tmpfs "$d")
done
# The home itself, empty (wherever it is).
args+=(--tmpfs "$home")

# The project. Git's hooks and configuration stay read-only: a hook or a
# `core.sshCommand` planted there would run on your side, outside the jail,
# the next time you use git in the project.
args+=(--bind "$root" "$root")
for f in "$root/.git/hooks" "$root/.git/config"; do
    [[ -e $f ]] && args+=(--ro-bind "$f" "$f")
done

# Tools installed in the home, read-only.
for rel in .local/bin .local/share/claude .local/share/tamagi/agents .local/share/tamagi/clio .config/mise .gitconfig; do
    [[ -e $home/$rel ]] && args+=(--ro-bind "$home/$rel" "$home/$rel")
done
path="$home/.local/bin"
# mise keeps the tools of each box apart (devbox-provision): the box's own.
box=${CONTAINER_ID:-}
if [[ -n $box && -d $home/.local/share/mise-$box ]]; then
    args+=(--ro-bind "$home/.local/share/mise-$box" "$home/.local/share/mise-$box"
           --setenv MISE_DATA_DIR "$home/.local/share/mise-$box"
           --setenv MISE_CACHE_DIR "$home/.cache/mise-$box"
           --setenv MISE_STATE_DIR "$home/.local/state/mise-$box")
    path="$home/.local/share/mise-$box/shims:$path"
fi

# The agent's own state (settings, login, history) and extra writable folders.
for rel in $state; do
    mkdir -p "$home/$rel"
    args+=(--bind "$home/$rel" "$home/$rel")
done
for d in "${rw[@]}"; do
    mkdir -p "$d"
    args+=(--bind "$d" "$d")
done

(( offline )) && args+=(--unshare-net)
args+=(--setenv HOME "$home" --setenv TAMAGI_AGENT_JAIL 1
       --setenv PATH "$path:/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin"
       --setenv XDG_CONFIG_HOME "$home/.config" --setenv XDG_DATA_HOME "$home/.local/share"
       --setenv XDG_CACHE_HOME "$home/.cache" --setenv XDG_STATE_HOME "$home/.local/state"
       --unsetenv XDG_RUNTIME_DIR --unsetenv DBUS_SESSION_BUS_ADDRESS --unsetenv WAYLAND_DISPLAY
       --unsetenv DISPLAY --unsetenv SSH_AUTH_SOCK
       --chdir "$cwd")
for kv in "${envs[@]}"; do
    args+=(--setenv "${kv%%=*}" "${kv#*=}")
done

if (( print )); then
    printf '%s\n' "${args[@]}"
    exit 0
fi
command -v bwrap >/dev/null || { echo "agent-jail: bubblewrap (bwrap) is missing here" >&2; exit 127; }
exec bwrap "${args[@]}" -- "$@"
