#!/usr/bin/bash
# system-update — the image of the system, updated with bootc (runs as root).
#
# The idea is the one of transactional-update (openSUSE): the new system is
# prepared beside the running one, which is not touched; it becomes active only
# on the next boot, and only if everything succeeded. A boot that fails goes
# back to the previous image by itself. From Bluefin: one background service
# that does not download on battery or on a metered connection.
#
#   system-update              called by tamagi-system-update.timer
#   system-update --now        asked by a person (tamagi update): no conditions
#   system-update --check      only says whether there is something new (exit 0 = yes)
#   system-update --status     refreshes /run/tamagi/bootc-status.json
#
# `bootc status` needs root; the desktop (notifications, tamagi update status,
# tamagi rewind) reads the copy in /run/tamagi/bootc-status.json.
#
# Settings: /usr/lib/tamagi/update.conf, overridden by /etc/tamagi/update.conf.
set -uo pipefail

QUARANTINE=${TAMAGI_QUARANTINE:-/var/lib/tamagi/quarantine.list}
STATUS=${TAMAGI_BOOTC_STATUS:-/run/tamagi/bootc-status.json}
GUARD=/usr/libexec/tamagi/secureboot-guard
LOCK=${TAMAGI_UPDATE_LOCK:-/run/lock/tamagi-system-update.lock}
HISTORY=${TAMAGI_UPDATE_HISTORY:-/var/lib/tamagi/update/history.log}
HOOKS_DIR=${TAMAGI_UPDATE_HOOKS:-/etc/tamagi/update.d}
MIN_FREE_GB=${TAMAGI_MIN_FREE_GB:-8}

ON_BATTERY=skip      # skip | run
ON_METERED=skip      # skip | run
for conf in /usr/lib/tamagi/update.conf /etc/tamagi/update.conf; do
    # shellcheck source=/dev/null
    [[ -r $conf ]] && . "$conf"
done

log() { echo "system-update: $*"; }

record_history() { # record_history <action> <detail>
    local action=$1 detail=${2:-}
    mkdir -p "$(dirname "$HISTORY")"
    printf '%s  %-14s  %s\n' "$(date -Is)" "$action" "$detail" >> "$HISTORY"
    if [[ -f $HISTORY ]] && (( $(wc -l < "$HISTORY") > 120 )); then
        tail -n 100 "$HISTORY" > "$HISTORY.tmp" && mv -f "$HISTORY.tmp" "$HISTORY"
    fi
    chmod 644 "$HISTORY" 2>/dev/null || true
}

run_hooks() { # run_hooks <pre.d|post.d> <booted> <staged>
    local dir="$HOOKS_DIR/$1" booted=${2:-} staged=${3:-} script
    [[ -d $dir ]] || return 0
    for script in "$dir"/*.sh; do
        [[ -x $script ]] || continue
        TAMAGI_UPDATE_BOOTED="$booted" TAMAGI_UPDATE_STAGED="$staged" "$script" \
            || log "hook ${script##*/} failed (continuing)"
    done
}

refresh_status() {
    local tmp
    mkdir -p "$(dirname "$STATUS")"
    tmp=$(mktemp "$STATUS.XXXXXX") || return 1
    if bootc status --format=json --format-version=1 > "$tmp" 2>/dev/null && [[ -s $tmp ]]; then
        chmod 644 "$tmp"
        mv -f "$tmp" "$STATUS"
    else
        rm -f "$tmp"
        return 1
    fi
}

field() { jq -r "$1 // empty" "$STATUS" 2>/dev/null; }

on_battery() { # only the battery of the computer counts, not a wireless mouse
    local s
    for s in /sys/class/power_supply/*; do
        [[ $(cat "$s/type" 2>/dev/null) == Battery ]] || continue
        [[ $(cat "$s/scope" 2>/dev/null) == Device ]] && continue
        [[ $(cat "$s/status" 2>/dev/null) == Discharging ]] && return 0
    done
    return 1
}

metered() { # NetworkManager: 1 = yes, 3 = guessed yes
    local v
    v=$(busctl get-property org.freedesktop.NetworkManager /org/freedesktop/NetworkManager \
        org.freedesktop.NetworkManager Metered 2>/dev/null | awk '{print $2}')
    [[ $v == 1 || $v == 3 ]]
}

# The digest the registry has now for the image this system follows. Asked
# before downloading: an image in quarantine is not even fetched.
remote_digest() {
    local ref transport
    ref=$(field '.status.booted.image.image.image')
    transport=$(field '.status.booted.image.image.transport')
    [[ -n $ref && ${transport:-registry} == registry ]] || return 1
    skopeo inspect --no-tags --format '{{.Digest}}' "docker://$ref" 2>/dev/null
}

notify_users() { # notify_users <urgency> <icon> <title> <body>
    local uid user
    for uid in $(loginctl list-users --no-legend 2>/dev/null | awk '{print $1}'); do
        user=$(id -nu "$uid" 2>/dev/null) || continue
        [[ -S /run/user/$uid/bus ]] || continue
        runuser -u "$user" -- env DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
            notify-send -a Tamagi -u "$1" -i "$2" "$3" "$4" 2>/dev/null || true
    done
}

# The packages of the image in use and of the prepared one, for "what changes
# in this update" (update-changes): the prepared image is mounted read-only
# from the store of bootc just to read its package list.
save_packages() {
    local id dir=/var/lib/tamagi/update mnt q='%{NAME} %{EPOCHNUM}:%{VERSION}-%{RELEASE}\n'
    id=$(field '.status.staged.composefs.verity')
    [[ -n $id && -e /sysroot/composefs/images/$id ]] || return 1
    mkdir -p "$dir"
    mnt=$(mktemp -d /run/tamagi/staged.XXXXXX) || return 1
    if bootc internals cfs --system mount "$id" "$mnt" 2>/dev/null \
            || mount -t composefs -o ro,basedir=/sysroot/composefs/objects "/sysroot/composefs/images/$id" "$mnt"; then
        rpm -qa --root "$mnt" --dbpath /usr/lib/sysimage/rpm --qf "$q" 2>/dev/null | sort > "$dir/staged.pkgs.new"
        umount "$mnt"
    fi
    rmdir "$mnt" 2>/dev/null
    [[ -s $dir/staged.pkgs.new ]] || { rm -f "$dir/staged.pkgs.new"; return 1; }
    rpm -qa --qf "$q" | sort > "$dir/booted.pkgs"
    mv -f "$dir/staged.pkgs.new" "$dir/staged.pkgs"
    field '.status.staged.image.imageDigest' > "$dir/staged.digest"
    chmod 644 "$dir"/*
}

mode=${1:-timer}
case $mode in
    --status)  refresh_status; exit $? ;;
    --rollback)
        refresh_status || true
        prev=$(field '.status.rollback.image.imageDigest')
        bootc rollback || exit 1
        record_history "rollback" "${prev:-previous}"
        refresh_status
        exit 0 ;;
    --drop)
        # transactional-update --drop: discards a staged deployment using bootc's
        # native command so bootloader entries and state stay consistent.
        refresh_status || { log "bootc status failed"; exit 1; }
        staged_verity=$(field '.status.staged.composefs.verity')
        staged_digest=$(field '.status.staged.image.imageDigest')
        if [[ -z $staged_digest ]]; then
            log "no staged deployment to discard"
            exit 0
        fi
        if [[ -n $staged_verity ]]; then
            bootc delete-deployment "$staged_verity" || exit 1
        else
            # Fallback for legacy ostree-backend installs: index 0 is staged when present.
            ostree admin undeploy 0 || exit 1
        fi
        rm -f /var/lib/tamagi/update/staged.pkgs /var/lib/tamagi/update/staged.digest 2>/dev/null || true
        record_history "drop" "$staged_digest"
        refresh_status
        exit 0 ;;
    --apply)
        refresh_status || exit 1
        staged_verity=$(field '.status.staged | select(.downloadOnly != true) | .composefs.verity')
        [[ -n $staged_verity ]] || { log "no staged update ready to apply"; exit 1; }
        systemctl reboot
        exit 0 ;;
    --soft-reboot)
        refresh_status || exit 1
        staged_verity=$(field '.status.staged | select(.downloadOnly != true) | .composefs.verity')
        [[ -n $staged_verity ]] || { log "no staged update ready to apply"; exit 1; }
        if bootc internals prep-soft-reboot "$staged_verity" >/dev/null 2>&1; then
            systemctl soft-reboot
        else
            log "soft-reboot unavailable for this update (kernel changed?); performing full reboot"
            systemctl reboot
        fi
        exit 0 ;;
esac

# Single-instance lock (flock): if the background timer is already downloading
# an update when the user runs `tamagi update`, wait for it instead of colliding
# on bootc/composefs; if the timer triggers while a manual update is running,
# the timer exits quietly.
mkdir -p "$(dirname "$LOCK")"
exec 9>"$LOCK"
if ! flock -n 9; then
    if [[ $mode == timer ]]; then
        log "another system-update is already running: skipping timer run"
        exit 0
    fi
    log "waiting for the background update in progress to finish…"
    flock 9
fi

refresh_status || { log "bootc status failed"; exit 1; }

if [[ $mode == timer ]]; then
    if [[ $ON_BATTERY == skip ]] && on_battery; then log "on battery: next run"; exit 0; fi
    if [[ $ON_METERED == skip ]] && metered; then log "metered connection: next run"; exit 0; fi
fi

booted=$(field '.status.booted.image.imageDigest')
staged=$(field '.status.staged.image.imageDigest')
# Downloaded but held back (the Secure Boot guard refused it): not ready.
[[ $(field '.status.staged.downloadOnly') == true ]] && held=$staged || held=""
remote=$(remote_digest) || remote=""

if [[ -z $remote ]]; then
    # Offline, or an image installed from a local build: nothing to ask.
    [[ $mode == timer ]] && { log "registry not reachable: next run"; exit 0; }
    log "could not reach the registry of the image"
    [[ $mode == --check ]] && exit 1
fi

if [[ -n $remote && ( $remote == "$booted" || ( $remote == "$staged" && -z $held ) ) ]]; then
    log "already up to date ($remote)"
    [[ $mode == --check ]] && exit 10
    exit 0
fi
[[ $mode == --check ]] && { echo "$remote"; exit 0; }

if [[ -n $remote && -r $QUARANTINE ]] && grep -qxF "$remote" "$QUARANTINE"; then
    log "the image available is in quarantine (it failed to boot here): $remote"
    notify_users normal dialog-warning "Update blocked by quarantine" \
        "The available image is the same one that failed the previous boot. Waiting for a newer build."
    exit 0
fi

# Prevent btrfs/snapper storage collapse before downloading a new system image:
# prune old home snapshots, stale conversion backups, and orphaned composefs objects.
if [[ -x /usr/libexec/tamagi/home-snapshots ]]; then
    /usr/libexec/tamagi/home-snapshots prune 15 || true
fi
free_bytes=$(df --output=avail -B1 /sysroot 2>/dev/null | tail -1 | tr -d ' ')
if [[ $free_bytes =~ ^[0-9]+$ ]] && (( free_bytes < 15 * 1024 * 1024 * 1024 )); then
    bootc internals composefs-gc --prune-repo 2>/dev/null || true
    free_bytes=$(df --output=avail -B1 /sysroot 2>/dev/null | tail -1 | tr -d ' ')
fi
if [[ $free_bytes =~ ^[0-9]+$ ]] && (( free_bytes < MIN_FREE_GB * 1024 * 1024 * 1024 )); then
    log "not enough free disk space on /sysroot ($(( free_bytes / 1024 / 1024 / 1024 )) GiB < ${MIN_FREE_GB} GiB)"
    exit 1
fi

run_hooks pre.d "$booted" "${remote:-}"

# Two steps, so that a bad update never becomes the next boot: the image is
# downloaded and prepared but held back (it would not be applied on shutdown);
# only after the Secure Boot guard agrees is it released.
if [[ -n $held && $held == "$remote" ]]; then
    log "already downloaded, checking again: $held"
else
    log "preparing ${remote:-the new image}"
    if ! bootc upgrade --download-only; then
        log "bootc upgrade failed"
        exit 1
    fi
fi
refresh_status
staged=$(field '.status.staged.image.imageDigest')
[[ -n $staged ]] || { log "nothing was prepared"; exit 0; }

# A kernel the firmware would refuse (Secure Boot without the key) stays held.
"$GUARD"; rc=$?
if (( rc == 3 )); then
    log "held back by the Secure Boot guard: $staged"
    record_history "held-secureboot" "$staged"
    exit 0
fi

# The kernel parameters added on this machine go into the new boot entry too.
/usr/libexec/tamagi/kargs --apply || log "could not re-apply the kernel parameters of this machine"

if ! bootc upgrade --from-downloaded; then
    log "could not release the prepared image"
    exit 1
fi
refresh_status
save_packages || log "could not read the package list of the new image (tamagi update changes will not show it)"
record_history "staged" "$staged"
run_hooks post.d "$booted" "$staged"
log "prepared: $staged (takes effect on the next boot)"
exit 0
