#!/usr/bin/bash
# Roda DENTRO da caixa de navegadores (Fedora), como root. Quem chama é o
# tamagi-browser, pelo /run/host.
#   browser-provision base                  vídeo por hardware, fontes, pt-BR
#   browser-provision install <navegador>   chrome | firefox | vivaldi | chromium
#   browser-provision app antigravity       IDE do Google (usa o Chrome desta caixa)
#   browser-provision upgrade               dnf upgrade
set -euo pipefail
REPOS=/etc/yum.repos.d
STAMP=/var/lib/tamagi-browser-base

die() { echo "erro: $*" >&2; exit 1; }
dnf_install() { dnf -y install --setopt=install_weak_deps=False "$@"; }
available() { dnf -q repoquery "$1" 2>/dev/null | grep -q .; }
gpu_vendor() { grep -qsi "^$1\$" /sys/class/drm/card*/device/vendor; }

repo() { # repo <id> <nome> <baseurl> <url da chave>
    cat > "$REPOS/$1.repo" <<REPO
[$1]
name=$2
baseurl=$3
enabled=1
gpgcheck=1
repo_gpgcheck=0
gpgkey=$4
REPO
}

base() {
    local ver; ver=$(rpm -E %fedora)
    dnf_install ca-certificates curl gnupg2 xdg-utils pciutils procps-ng \
        glibc-langpack-pt glibc-langpack-en \
        libva libva-utils mesa-dri-drivers mesa-vulkan-drivers vulkan-loader vulkan-tools \
        mesa-libGL mesa-libEGL mesa-libgbm pipewire-libs pulseaudio-libs nss-tools \
        liberation-fonts google-noto-sans-fonts google-noto-color-emoji-fonts
    # Vídeo por hardware. O Mesa do Fedora vem sem H.264/HEVC (patentes); a
    # versão completa do driver VA-API está no RPM Fusion (mesa-va-drivers-freeworld).
    if ! rpm -q rpmfusion-free-release >/dev/null 2>&1; then
        dnf -y install "https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$ver.noarch.rpm" \
            || echo "aviso: RPM Fusion indisponível; H.264/HEVC por hardware ficam de fora" >&2
    fi
    if rpm -q rpmfusion-free-release >/dev/null 2>&1 && available mesa-va-drivers-freeworld; then
        if rpm -q mesa-va-drivers >/dev/null 2>&1; then
            dnf -y swap mesa-va-drivers mesa-va-drivers-freeworld
        else
            dnf_install mesa-va-drivers-freeworld
        fi
    else
        dnf_install mesa-va-drivers
    fi
    # Intel: driver de mídia. NVIDIA: as bibliotecas vêm do host (distrobox --nvidia).
    if gpu_vendor 0x8086; then
        if available intel-media-driver; then dnf_install intel-media-driver
        elif available libva-intel-media-driver; then dnf_install libva-intel-media-driver; fi
    fi
    if gpu_vendor 0x10de && available libva-nvidia-driver; then dnf_install libva-nvidia-driver; fi
    mkdir -p "$(dirname "$STAMP")"; touch "$STAMP"
}

install_browser() {
    [[ -f $STAMP ]] || base
    case "$1" in
        chrome)
            repo google-chrome "Google Chrome" 'https://dl.google.com/linux/chrome/rpm/stable/$basearch' \
                https://dl.google.com/linux/linux_signing_key.pub
            dnf_install google-chrome-stable ;;
        firefox)
            dnf_install firefox firefox-langpacks
            # Decodificação de vídeo por hardware (VA-API) ligada por padrão.
            install -Dm644 /dev/stdin /usr/lib64/firefox/defaults/pref/tamagi.js <<'JS'
pref("media.ffmpeg.vaapi.enabled", true);
pref("media.hardware-video-decoding.force-enabled", true);
pref("gfx.webrender.all", true);
JS
            ;;
        vivaldi)
            repo vivaldi "Vivaldi" 'https://repo.vivaldi.com/archive/rpm/$basearch' \
                https://repo.vivaldi.com/archive/linux_signing_key.pub
            dnf_install vivaldi-stable ;;
        chromium)
            dnf_install chromium ;;
        *) die "unknown browser: $1 (chrome, firefox, vivaldi, chromium)" ;;
    esac
}

install_app() {
    [[ -f $STAMP ]] || base
    case "$1" in
        antigravity)
            # Repositório oficial do Google. Ele ainda não publica chave para os
            # pacotes (gpgcheck=0 é a instrução deles): a integridade depende do HTTPS.
            cat > "$REPOS/antigravity.repo" <<'REPO'
[antigravity-rpm]
name=Antigravity RPM Repository
baseurl=https://us-central1-yum.pkg.dev/projects/antigravity-auto-updater-dev/antigravity-rpm
enabled=1
gpgcheck=0
REPO
            dnf_install antigravity ;;
        *) die "app desconhecido: $1 (use: antigravity)" ;;
    esac
}

case "${1:-}" in
    base)    base ;;
    app)     [[ -n ${2:-} ]] || die "diga o app"; install_app "$2" ;;
    install) [[ -n ${2:-} ]] || die "diga o navegador"; install_browser "$2" ;;
    upgrade) dnf -y upgrade --refresh ;;
    *) die "usage: browser-provision base | install <browser> | app <app> | upgrade" ;;
esac
