#!/usr/bin/bash
# privacy-helper — a parte do modo privacidade que precisa de root.
# Chamado pelo tamagi-privacidade via pkexec (a regra do polkit libera, sem
# senha, para quem é administrador e está na sessão ativa).
#
#   privacy-helper on | off | status
#
# on:  câmera desligada no kernel (as interfaces de vídeo USB são soltas do
#      driver uvcvideo: nenhum programa consegue abri-la, nem com permissão),
#      Bluetooth bloqueado (rfkill), firewall fechado para conexões de entrada
#      (interfaces ativas na zona "drop", só em tempo de execução) e descoberta
#      na rede local desligada (avahi/mDNS).
# off: desfaz exatamente o que o "on" mudou. Tudo some no reboot de qualquer
#      jeito (nada é gravado de forma permanente).
#
# TAMAGI_PRIVACY_DRYRUN=1 só mostra o que faria (testes).
set -uo pipefail

STATE=/run/tamagi/privacy
UVC=/sys/bus/usb/drivers/uvcvideo
DRY=${TAMAGI_PRIVACY_DRYRUN:-}
run() { if [[ -n $DRY ]]; then echo "[dry] $*"; else "$@"; fi; }
write() { if [[ -n $DRY ]]; then echo "[dry] echo $1 > $2"; else echo -n "$1" > "$2"; fi; }

on() {
    [[ -z $DRY ]] && mkdir -p "$STATE"
    # Câmera: solta cada interface do uvcvideo e guarda para religar.
    local cams=() i
    for i in "$UVC"/*:*; do
        [[ -e $i ]] || continue
        cams+=("$(basename "$i")")
    done
    [[ -z $DRY ]] && printf '%s\n' "${cams[@]}" > "$STATE/cameras"
    for i in "${cams[@]}"; do write "$i" "$UVC/unbind"; done
    echo "camera: ${#cams[@]} interface(s) desligada(s)"

    # Bluetooth: guarda se já estava bloqueado.
    if rfkill -J 2>/dev/null | jq -e '[.rfkilldevices[]? | select(.type=="bluetooth" and .soft=="unblocked")] | length > 0' >/dev/null; then
        [[ -z $DRY ]] && touch "$STATE/bluetooth"
        run rfkill block bluetooth
        echo "bluetooth: bloqueado"
    fi

    # Firewall: interfaces ativas vão para a zona "drop" (só em execução).
    if firewall-cmd --state >/dev/null 2>&1; then
        local zone ifs
        : > "$STATE/zones" 2>/dev/null || true
        # "public (default)" → zona "public"
        while read -r zone _; do
            [[ -z $zone || $zone == drop ]] && continue
            ifs=$(firewall-cmd --zone="$zone" --list-interfaces 2>/dev/null)
            for i in $ifs; do
                [[ -z $DRY ]] && echo "$i $zone" >> "$STATE/zones"
                run firewall-cmd -q --zone=drop --change-interface="$i"
                echo "firewall: $i $zone -> drop"
            done
        done < <(firewall-cmd --get-active-zones 2>/dev/null | grep -v '^ ')
    fi

    # Descoberta na rede local (mDNS): o computador some da rede.
    if systemctl is-active --quiet avahi-daemon.service; then
        [[ -z $DRY ]] && touch "$STATE/avahi"
        run systemctl stop avahi-daemon.socket avahi-daemon.service
        echo "mdns: desligado"
    fi
}

off() {
    local i zone
    if [[ -f $STATE/cameras ]]; then
        while read -r i; do
            [[ -n $i ]] && write "$i" "$UVC/bind" 2>/dev/null
        done < "$STATE/cameras"
        echo "camera: religada"
    fi
    [[ -f $STATE/bluetooth ]] && run rfkill unblock bluetooth && echo "bluetooth: liberado"
    if [[ -s $STATE/zones ]]; then
        while read -r i zone; do
            run firewall-cmd -q --zone="$zone" --change-interface="$i" && echo "firewall: $i -> $zone"
        done < "$STATE/zones"
    fi
    [[ -f $STATE/avahi ]] && run systemctl start avahi-daemon.socket avahi-daemon.service && echo "mdns: religado"
    [[ -z $DRY ]] && rm -rf "$STATE"
    return 0
}

case "${1:-}" in
    on)     on ;;
    off)    off ;;
    status) [[ -d $STATE ]] && echo on || echo off ;;
    *)      echo "uso: privacy-helper on|off|status" >&2; exit 2 ;;
esac
