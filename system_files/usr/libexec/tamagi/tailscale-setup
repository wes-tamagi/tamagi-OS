#!/usr/bin/bash
# tailscale-setup — Tailscale (mesh VPN), optional and native.
#
# It does not ship in the image. This installs the official package (the
# vendor's repository, signed) in a reversible layer, starts the daemon now
# and at every boot, and connects this computer to your network.
#
#   tailscale-setup            install and connect      (catalog: tamagi install tailscale)
#   tailscale-setup remove     disconnects and removes the layer
set -euo pipefail
. /usr/libexec/tamagi/i18n

LAYER=tailscale
REPO="tailscale-stable=https://pkgs.tailscale.com/stable/fedora/x86_64=https://pkgs.tailscale.com/stable/fedora/repo.gpg"

case "${1:-install}" in
    install)
        if ! command -v tailscale >/dev/null 2>&1; then
            tamagi-layer add "$LAYER" --repo "$REPO" --unit tailscaled.service tailscale
        fi
        echo "$(t "Connecting this computer to your Tailscale network…")"
        sudo tailscale up ;;
    remove)
        sudo tailscale down 2>/dev/null || true
        tamagi-layer remove "$LAYER" ;;
    *) echo "usage: tailscale-setup [install|remove]" >&2; exit 2 ;;
esac
