#!/usr/bin/bash
# tailscale-setup — Tailscale (mesh VPN) pré-instalado na imagem, desligado por padrão.
#
#   tamagi shield tailscale [on|off|status]
set -euo pipefail
. /usr/libexec/tamagi/i18n

case "${1:-on}" in
    on|up|install)
        command -v tailscale >/dev/null 2>&1 || { echo "$(t "error"): tailscale not installed" >&2; exit 1; }
        sudo systemctl enable --now tailscaled.service
        echo "$(t "Connecting this computer to your Tailscale network…")"
        sudo tailscale up ;;
    off|down|remove)
        sudo tailscale down 2>/dev/null || true
        sudo systemctl disable --now tailscaled.service 2>/dev/null || true
        tl "Tailscale stopped and disabled." ;;
    status)
        if systemctl is-active --quiet tailscaled.service 2>/dev/null; then
            tailscale status || true
        else
            tl "Tailscale is installed and off (enable with: tamagi shield tailscale on)."
        fi ;;
    -h|--help|help)
        echo "usage: tamagi shield tailscale [on|off|status]" ;;
    *)
        echo "usage: tamagi shield tailscale [on|off|status]" >&2; exit 2 ;;
esac
