#!/usr/bin/bash
# agent-manager — AI coding agents, installed on demand in your user, with
# Copy-on-Write Shadow Workspaces and kernel-enforced Egress Guard.
#
# None ships in the image: they are third-party software, downloaded from the
# vendor on your machine when you choose them.
#
#   tamagi ai agents                       choose from a list
#   tamagi ai agents list                  what exists and what is installed
#   tamagi ai agents install <name>…       claude antigravity codex clio qwen opencode gemini openclaw local
#   tamagi ai agents remove <name>
#   tamagi ai agents update                updates the installed ones
#   tamagi ai run [opts] <name> …          runs the agent JAILED in the current project
#   tamagi ai jail [opts] [-- cmd]         a shell in the same jail (see what the agent sees)
#   tamagi ai shadow <subcommand>          speculative CoW shadow workspaces:
#                                            list | run | diff <id> | apply <id> | drop <id|--all>
#   tamagi ai flights [list|show|clear]    agent flight recorder (audit)
#
# Options of run/jail:
#   --shadow [--shadow-id <id>]   run on an instant Copy-on-Write reflink clone
#                                 (0 extra bytes on Btrfs, warm target/ & node_modules/);
#                                 your live tree is untouched until `shadow apply <id>`
#   --egress-guard                airgap network (--unshare-net) and allow only AI APIs
#                                 and open-source package registries (default with --shadow)
#   --allow-domain <domain>       add an extra allowed domain to --egress-guard
#   --full-net                    disable automatic --egress-guard when using --shadow
#   --offline                     cut all network access inside the jail
#   --db                          snapshot running `tamagi dev db` databases before launch
#   --no-snapshot                 skip pre-agent git/Btrfs save point
#   --host                        run on the host instead of the development box
set -euo pipefail
. /usr/libexec/tamagi/i18n

BIN_DIR="$HOME/.local/bin"
PREFIX="${XDG_DATA_HOME:-$HOME/.local/share}/tamagi/agents"   # npm prefix, used from the dev box
SHADOWS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/tamagi/shadows"
FLIGHTS_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/tamagi/flights"
BOX="${TAMAGI_AGENTS_BOX:-dev}"
ORDER=(claude antigravity codex clio qwen opencode gemini openclaw local)
declare -A TITLE=(
    [claude]="Claude Code — Anthropic" [antigravity]="Antigravity CLI (agy) — Google" [codex]="Codex CLI — OpenAI"
    [clio]="CLIO — pure Perl, local models" [qwen]="Qwen Code — Alibaba" [opencode]="opencode — open source" [gemini]="Gemini CLI — Google"
    [openclaw]="OpenClaw — open source" [local]="Tamagi agent + local model (llama.cpp)"
)
declare -A NPM=([qwen]="@qwen-code/qwen-code" [gemini]="@google/gemini-cli" [openclaw]="openclaw")
declare -A GH_REPO=([codex]="openai/codex" [opencode]="anomalyco/opencode" [clio]="SyntheticAutonomicMind/CLIO")
CLIO_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/tamagi/clio"
declare -A GH_ASSET=([codex]='^codex-x86_64-unknown-linux-musl\.tar\.gz$' [opencode]='^opencode-linux-x64-baseline\.tar\.gz$'
                     [clio]='^clio-[0-9.]+\.tar\.gz$')

die() { echo "$(t "error"): $*" >&2; exit 1; }
APPS="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
menu_entry() {
    [[ -f /usr/share/tamagi/desktop/$1.desktop ]] || return 0
    install -Dm644 "/usr/share/tamagi/desktop/$1.desktop" "$APPS/$1.desktop"
    update-desktop-database "$APPS" 2>/dev/null || true
}
has_host_mise() { command -v mise >/dev/null 2>&1; }
needs_box() { [[ $1 == clio ]] || { [[ -n ${NPM[$1]:-} ]] && ! has_host_mise; }; }
ensure_box() { podman container exists "$BOX" 2>/dev/null || tamagi-devbox create fedora --name "$BOX"; }
ensure_host_node() {
    if ! mise which npm >/dev/null 2>&1; then
        info "mise use -g node@lts"
        mise use -g node@lts
    fi
    dirname "$(mise which npm)"
}
write_host_npm_launcher() {
    mkdir -p "$BIN_DIR"
    rm -f "$BIN_DIR/$1"
    cat > "$BIN_DIR/$1" <<SH
#!/bin/sh
# Generated by tamagi-agents: $1 runs natively on the host via mise Node.js.
SHIMS="\${XDG_DATA_HOME:-\$HOME/.local/share}/mise/shims"
case ":\$PATH:" in *":\$SHIMS:"*) ;; *) PATH="\$SHIMS:\$PATH"; export PATH ;; esac
exec "$2" "\$@"
SH
    chmod +x "$BIN_DIR/$1"
}
write_launcher() {
    mkdir -p "$BIN_DIR"
    rm -f "$BIN_DIR/$1"
    cat > "$BIN_DIR/$1" <<SH
#!/bin/sh
# Generated by tamagi-agents: $1 runs in the development box "$BOX".
BIN="$2"
if [ -e /run/.containerenv ] || [ -n "\${CONTAINER_ID:-}" ]; then exec "\$BIN" "\$@"; fi
exec distrobox enter $BOX -- "\$BIN" "\$@"
SH
    chmod +x "$BIN_DIR/$1"
}

DOWNLOAD_TMP=""
EGRESS_PID=""
EGRESS_TMP=""
cleanup_runtime() {
    [[ -n $EGRESS_PID ]] && kill "$EGRESS_PID" 2>/dev/null || true
    [[ -n $EGRESS_TMP ]] && rm -rf -- "${EGRESS_TMP:?}" || true
    [[ -n $DOWNLOAD_TMP ]] && rm -rf -- "${DOWNLOAD_TMP:?}" || true
}
trap cleanup_runtime EXIT

info() { echo -e "\033[1m$*\033[0m"; }
canon() { case "${1:-}" in claude-code) echo claude ;; qwen-code) echo qwen ;; gemini-cli) echo gemini ;; claw|claws) echo openclaw ;; agy) echo antigravity ;; *) echo "${1:-}" ;; esac; }
known() { [[ -n ${1:-} && -n ${TITLE[$1]:-} ]]; }

is_installed() {
    case $1 in
        claude)      [[ -x $BIN_DIR/claude ]] ;;
        antigravity) [[ -x $BIN_DIR/agy ]] ;;
        codex|opencode) [[ -x $BIN_DIR/$1 ]] ;;
        clio)        [[ -x $CLIO_DIR/clio && -e $BIN_DIR/clio ]] ;;
        qwen|gemini|openclaw) [[ -x $BIN_DIR/$1 && -e $PREFIX/bin/$1 ]] ;;
        local)       compgen -G "${XDG_DATA_HOME:-$HOME/.local/share}/tamagi/models/*.gguf" >/dev/null \
                         || compgen -G "$HOME/.cache/llama.cpp/*.gguf" >/dev/null ;;
    esac
}

install_github() {
    local name=$1 json url digest tmp bin
    tmp=$(mktemp -d); DOWNLOAD_TMP=$tmp
    json=$(curl -fsSL -H "Accept: application/vnd.github+json" "https://api.github.com/repos/${GH_REPO[$name]}/releases/latest")
    url=$(jq -r --arg re "${GH_ASSET[$name]}" '.assets[] | select(.name | test($re)) | .browser_download_url' <<<"$json" | head -1)
    digest=$(jq -r --arg re "${GH_ASSET[$name]}" '.assets[] | select(.name | test($re)) | .digest // ""' <<<"$json" | head -1)
    [[ -n $url ]] || die "$name: $(t "could not find the binary in the latest release")"
    [[ $digest =~ ^sha256:[0-9a-f]{64}$ ]] || die "$name: $(t "the release does not carry the SHA-256 digest; nothing was installed")"
    curl -fL --progress-bar -o "$tmp/pkg.tar.gz" "$url"
    echo "${digest#sha256:}  $tmp/pkg.tar.gz" | sha256sum -c --quiet - || die "$name: $(t "the downloaded file does not match the published digest")"
    mkdir "$tmp/x"; tar -xzf "$tmp/pkg.tar.gz" -C "$tmp/x"
    if [[ $name == clio ]]; then
        bin=$(find "$tmp/x" -maxdepth 2 -type f -name clio | head -1)
        [[ -n $bin ]] || die "$name: $(t "the package has no executable")"
        mkdir -p "$(dirname "$CLIO_DIR")"
        [[ -d $CLIO_DIR ]] && mv "$CLIO_DIR" "$tmp/old"
        mv "$(dirname "$bin")" "$CLIO_DIR"
        ensure_box
        distrobox enter "$BOX" -- perl -MFindBin -e1 2>/dev/null \
            || echo "$name: $(t "the box has no complete Perl; run"): tamagi dev box provision $BOX" >&2
        write_launcher clio "$CLIO_DIR/clio"
    else
        bin=$(find "$tmp/x" -type f -perm -u+x \( -name "$name" -o -name "$name-*" \) | head -1)
        [[ -n $bin ]] || die "$name: $(t "the package has no executable")"
        install -Dm755 "$bin" "$BIN_DIR/$name"
    fi
    rm -rf -- "${tmp:?}"; DOWNLOAD_TMP=""
    echo "$name: $("$BIN_DIR/$name" --version 2>/dev/null | head -1)"
}

install_npm() {
    local name=$1
    mkdir -p "$PREFIX"
    if has_host_mise; then
        local node_bin
        node_bin=$(ensure_host_node)
        info "npm install -g ${NPM[$name]}   ($(t "host (mise)"))"
        PATH="$node_bin:$PATH" npm install -g --prefix "$PREFIX" "${NPM[$name]}"
        [[ -e $PREFIX/bin/$name ]] || die "$name: $(t "npm did not create the executable")"
        write_host_npm_launcher "$name" "$PREFIX/bin/$name"
        return 0
    fi
    ensure_box
    info "npm install -g ${NPM[$name]}   ($(t "box") $BOX)"
    distrobox enter "$BOX" -- "$JAIL_BOX" --root "$PREFIX" --cwd "$PREFIX" -- npm install -g --prefix "$PREFIX" "${NPM[$name]}"
    [[ -e $PREFIX/bin/$name ]] || die "$name: $(t "npm did not create the executable")"
    write_launcher "$name" "$PREFIX/bin/$name"
}

AGY_INSTALLER=https://antigravity.google/cli/install.sh
install_agy() {
    local tmp; tmp=$(mktemp -d); DOWNLOAD_TMP=$tmp
    echo "$(t "Antigravity CLI is Google software and is downloaded now, on your machine (Google's terms).")"
    curl -fsSL --proto '=https' --tlsv1.2 -o "$tmp/install.sh" "$AGY_INSTALLER" \
        || die "antigravity: $(t "could not download Google's installer")"
    head -1 "$tmp/install.sh" | grep -q '^#!' || die "antigravity: $(t "what came from Google is not an install script; nothing was installed")"
    mkdir -p "$BIN_DIR"
    bash "$tmp/install.sh" --dir "$BIN_DIR" </dev/null
    rm -rf -- "${tmp:?}"; DOWNLOAD_TMP=""
    [[ -x $BIN_DIR/agy ]] || die "antigravity: $(t "the installer did not leave the executable")"
    echo "agy: $("$BIN_DIR/agy" --version 2>/dev/null </dev/null | head -1)"
}

install_one() {
    local name; name=$(canon "$1")
    known "$name" || die "$(t "unknown agent"): $1 (${ORDER[*]})"
    info "── ${TITLE[$name]}"
    case $name in
        claude)      claude --version </dev/null && menu_entry claude-code ;;
        antigravity) install_agy && menu_entry agy ;;
        codex|opencode|clio) install_github "$name" ;;
        qwen|gemini|openclaw) install_npm "$name" ;;
        local)       tamagi-ai setup ;;
    esac
}

remove_one() {
    local name; name=$(canon "$1")
    known "$name" || die "$(t "unknown agent"): $1"
    case $name in
        claude)      rm -f "$BIN_DIR/claude" "$APPS/claude-code.desktop"; rm -rf "${XDG_DATA_HOME:-$HOME/.local/share}/claude" ;;
        antigravity) rm -f "$BIN_DIR/agy" "$APPS/agy.desktop" ;;
        codex|opencode) rm -f "$BIN_DIR/$name" ;;
        clio)        rm -f "$BIN_DIR/clio"; [[ -d $CLIO_DIR ]] && rm -rf -- "${CLIO_DIR:?}" ;;
        qwen|gemini|openclaw)
            if has_host_mise && mise which npm >/dev/null 2>&1; then
                PATH="$(dirname "$(mise which npm)"):$PATH" npm uninstall -g --prefix "$PREFIX" "${NPM[$name]}" || true
            elif podman container exists "$BOX" 2>/dev/null; then
                distrobox enter "$BOX" -- npm uninstall -g --prefix "$PREFIX" "${NPM[$name]}" || true
            fi
            rm -f "$BIN_DIR/$name" ;;
        local)       echo "$(t "Local models are deleted with"): tamagi ai rm <model>"; return 0 ;;
    esac
    echo "$(t "Removed"): $name"
}

# ── The jail, Egress Guard & Shadow Workspaces ─────────────────────────────
declare -A STATE=(
    [claude]=".claude" [codex]=".codex" [clio]=".clio" [qwen]=".qwen" [gemini]=".gemini" [openclaw]=".openclaw"
    [opencode]=".config/opencode .local/share/opencode .local/state/opencode .cache/opencode"
    [antigravity]=".gemini" [local]=""
)

project_root() {
    local root
    root=$(git rev-parse --show-toplevel 2>/dev/null) || root=$PWD
    root=$(realpath "$root")
    [[ $root != "$(realpath "$HOME")" && $root != / && $root != /var/home && $root != /home ]] \
        || die "$(t "enter a project folder: the jail cannot be the whole home folder")"
    echo "$root"
}

save_point() {
    local root=$1 label=$2 db=$3 stamp ref name
    stamp=$(date +%Y%m%d-%H%M%S)
    if git -C "$root" rev-parse --git-dir >/dev/null 2>&1; then
        ref=$(git -C "$root" stash create "tamagi: before $label" 2>/dev/null || true)
        [[ -n $ref ]] || ref=$(git -C "$root" rev-parse -q --verify HEAD 2>/dev/null || true)
        if [[ -n $ref ]]; then
            git -C "$root" update-ref "refs/tamagi/before-agent/$stamp" "$ref"
            echo "$(t "Save point (git)"): git diff refs/tamagi/before-agent/$stamp"
        fi
    fi
    if [[ -d $HOME/.snapshots ]] && command -v tamagi-snap >/dev/null 2>&1; then
        tamagi-snap now "before $label in $(basename "$root")" >/dev/null 2>&1 \
            && echo "$(t "Save point (files)"): tamagi rewind"
    fi
    if (( db )); then
        for name in postgres mysql mariadb redis valkey mongo; do
            [[ $(podman container inspect -f '{{.State.Running}}' "tamagi-db-$name" 2>/dev/null) == true ]] || continue
            tamagi-db snapshot "$name" "before-$label-$stamp" || true
        done
    fi
}

JAIL_HOST="${TAMAGI_LIBEXEC:-/usr/libexec/tamagi}/agent-jail"
JAIL_BOX="${TAMAGI_BOX_LIBEXEC:-/run/host/usr/libexec/tamagi}/agent-jail"
GUARD_HOST="${TAMAGI_LIBEXEC:-/usr/libexec/tamagi}/egress-guard"

valid_shadow_id() { [[ ${1:-} =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,48}$ ]] || die "$(t "invalid shadow ID"): ${1:-}"; }

shadow_changes_count() {
    python3 - "$1" "$2" <<'PY'
import filecmp, os, pathlib, sys
SKIP = {".git", "target", "node_modules", "__pycache__", ".venv", ".pytest_cache", ".mypy_cache"}
src = pathlib.Path(sys.argv[1])
dst = pathlib.Path(sys.argv[2])
changed = 0
def walk(base):
    out = {}
    for root, dirs, files in os.walk(base):
        dirs[:] = [d for d in dirs if d not in SKIP]
        rel_dir = pathlib.Path(root).relative_to(base)
        for f in files:
            p = pathlib.Path(root) / f
            if p.is_symlink() or p.is_file():
                out[str(rel_dir / f)] = p
    return out
a, b = walk(src), walk(dst)
for k in set(a) | set(b):
    if k not in a or k not in b:
        changed += 1
    elif a[k].is_symlink() != b[k].is_symlink():
        changed += 1
    elif a[k].is_symlink():
        if os.readlink(a[k]) != os.readlink(b[k]):
            changed += 1
    elif not filecmp.cmp(a[k], b[k], shallow=False):
        changed += 1
print(changed)
PY
}

start_egress_daemon() {
    local allow_csv=$1
    [[ -x $GUARD_HOST ]] || die "missing $GUARD_HOST"
    EGRESS_TMP=$(mktemp -d "${TMPDIR:-/tmp}/tamagi-egress.XXXXXX")
    chmod 700 "$EGRESS_TMP"
    local sock="$EGRESS_TMP/proxy.sock"
    "$GUARD_HOST" --daemon "$sock" --allow "$allow_csv" --log "$EGRESS_TMP/egress.log" &
    EGRESS_PID=$!
    for _ in $(seq 30); do
        [[ -S $sock ]] && break
        sleep 0.1
    done
    [[ -S $sock ]] || die "could not start egress-guard socket"
    echo "$sock"
}

cmd_run() {
    local shell=$1 offline=0 db=0 snapshot=1 use_box=1 print=0 shadow=0 shadow_id="" egress=0 full_net=0 allow_domains="" agent="" root
    shift
    while (( $# )); do
        case $1 in
            --offline)       offline=1 ;;
            --db)            db=1 ;;
            --no-snapshot)   snapshot=0 ;;
            --host)          use_box=0 ;;
            --print)         print=1 ;;
            --shadow)        shadow=1 ;;
            --shadow-id)     shadow=1; shadow_id=${2:?--shadow-id needs a value}; shift ;;
            --egress-guard)  egress=1 ;;
            --allow-domain)  egress=1; allow_domains="${allow_domains:+$allow_domains,}${2:?--allow-domain needs a value}"; shift ;;
            --full-net)      full_net=1 ;;
            --)              shift; break ;;
            -*)              die "$(t "unknown option"): $1" ;;
            *)               break ;;
        esac
        shift
    done
    (( shadow && ! offline && ! full_net )) && egress=1
    (( offline )) && egress=0

    local home; home=$(realpath "$HOME")
    local -a cmd opts=()
    if (( shell )); then
        cmd=("$@"); (( ${#cmd[@]} )) || cmd=(bash)
    else
        agent=$(canon "${1:-}"); shift || true
        known "$agent" && [[ -n ${STATE[$agent]} ]] || die "usage: tamagi ai run [options] <claude|antigravity|codex|clio|qwen|opencode|gemini|openclaw> [args]"
        is_installed "$agent" || die "$agent $(t "is not installed"): tamagi ai agents install $agent"
        cmd=("$home/.local/bin/$agent" "$@")
        [[ $agent == antigravity ]] && cmd=("$home/.local/bin/agy" "$@")
        [[ -n ${NPM[$agent]:-} ]] && cmd=("$PREFIX/bin/$agent" "$@")
        [[ $agent == clio ]] && cmd=("$CLIO_DIR/clio" "$@")
        opts+=(--state "${STATE[$agent]}")
        if [[ $agent == claude ]]; then
            if [[ -f $home/.claude.json && ( ! -e $home/.claude/.claude.json || $home/.claude.json -nt $home/.claude/.claude.json ) ]]; then
                mkdir -p "$home/.claude"; cp "$home/.claude.json" "$home/.claude/.claude.json"
            fi
            opts+=(--setenv "CLAUDE_CONFIG_DIR=$home/.claude")
        fi
    fi

    root=$(project_root)
    # Declarative per-project egress allowlist from tamagi-workspace.toml ([egress] allow = [...])
    if [[ -f $root/tamagi-workspace.toml ]]; then
        local ws_domains
        ws_domains=$(python3 - "$root/tamagi-workspace.toml" <<'PY' 2>/dev/null || true
import sys, tomllib
try:
    data = tomllib.load(open(sys.argv[1], "rb"))
    allow = data.get("egress", {}).get("allow", [])
    if isinstance(allow, list):
        print(",".join(str(x).strip() for x in allow if str(x).strip()))
except Exception:
    pass
PY
)
        if [[ -n $ws_domains ]]; then
            allow_domains="${allow_domains:+$allow_domains,}$ws_domains"
        fi
    fi
    local sdir=""
    if (( shadow )); then
        [[ -n $shadow_id ]] || shadow_id="${agent:-jail}-$(date +%Y%m%d-%H%M%S)"
        valid_shadow_id "$shadow_id"
        sdir="$SHADOWS_DIR/$shadow_id"
        [[ ! -e $sdir ]] || die "$(t "shadow already exists"): $shadow_id"
        if (( print )); then
            opts+=(--shadow "/tmp/tamagi-shadow-preview-$shadow_id")
        else
            mkdir -p "$sdir"
            cp -a --reflink=auto "$root" "$sdir/work"
            {
                printf 'SHADOW_ID=%s\n' "$shadow_id"
                printf 'SHADOW_ROOT=%s\n' "$root"
                printf 'SHADOW_AGENT=%s\n' "${agent:-jail}"
                printf 'SHADOW_CREATED=%s\n' "$(date -Iseconds)"
            } > "$sdir/meta.env"
            opts+=(--shadow "$sdir/work")
        fi
    fi

    if (( egress )); then
        if (( print )); then
            opts+=(--egress-sock "/tmp/tamagi-egress-preview.sock")
        else
            local sock
            sock=$(start_egress_daemon "$allow_domains")
            opts+=(--egress-sock "$sock")
        fi
    fi

    (( offline )) && opts+=(--offline)
    (( print )) && opts+=(--print)
    opts+=(--root "$root" --cwd "$(realpath "$PWD")")

    local in_box=0
    if (( use_box )) && podman container exists "$BOX" 2>/dev/null; then in_box=1; fi
    if [[ -n $agent ]] && needs_box "$agent" && (( ! in_box )); then
        die "$agent $(t "runs in the development box"): tamagi dev box create"
    fi

    if (( ! print )); then
        local mode_note=""
        (( offline )) && mode_note+=", offline"
        (( egress )) && mode_note+=", egress-guard"
        (( shadow )) && mode_note+=", shadow:$shadow_id"
        info "$(t "Jail"): $root   ($( (( in_box )) && echo "$(t "box") $BOX" || t "on the host, without compilers")$mode_note)"
        if (( ! shadow && snapshot )); then
            save_point "$root" "${agent:-jail}" "$db"
        elif (( shadow && db )); then
            save_point "$root" "shadow-$shadow_id" 1
        fi
    fi

    if (( ! print && (shadow || egress) )); then
        local rc=0 started ended nchg=0
        started=$(date -Iseconds)
        if (( in_box )); then
            distrobox enter "$BOX" -- env TAMAGI_EGRESS_GUARD_BIN="/run/host${GUARD_HOST}" "$JAIL_BOX" "${opts[@]}" -- "${cmd[@]}" || rc=$?
        else
            env TAMAGI_EGRESS_GUARD_BIN="$GUARD_HOST" "$JAIL_HOST" "${opts[@]}" -- "${cmd[@]}" || rc=$?
        fi
        ended=$(date -Iseconds)
        if (( shadow )) && [[ -d $sdir/work ]]; then
            nchg=$(shadow_changes_count "$root" "$sdir/work")
        fi
        record_flight "${shadow_id:-${agent:-jail}-$(date +%Y%m%d-%H%M%S)}" "${agent:-jail}" "$root" "$started" "$ended" "$rc" "${shadow_id:-}" "$nchg" "${EGRESS_TMP:+$EGRESS_TMP/egress.log}"
        if (( shadow )) && [[ -d $sdir/work ]]; then
            echo
            info "── $(t "Shadow workspace"): $shadow_id ($nchg $(t "changed files"))"
            echo "  tamagi ai shadow diff $shadow_id"
            echo "  tamagi ai shadow apply $shadow_id"
            echo "  tamagi ai shadow drop $shadow_id"
        fi
        return "$rc"
    fi

    if (( in_box )); then
        exec distrobox enter "$BOX" -- "$JAIL_BOX" "${opts[@]}" -- "${cmd[@]}"
    fi
    exec "$JAIL_HOST" "${opts[@]}" -- "${cmd[@]}"
}

load_shadow_meta() {
    local id=$1
    valid_shadow_id "$id"
    local m="$SHADOWS_DIR/$id/meta.env"
    [[ -f $m && -d $SHADOWS_DIR/$id/work ]] || die "$(t "no such shadow workspace"): $id"
    SHADOW_ID="" SHADOW_ROOT="" SHADOW_AGENT=""
    while IFS='=' read -r k v; do
        case $k in
            SHADOW_ID) SHADOW_ID=$v ;;
            SHADOW_ROOT) SHADOW_ROOT=$v ;;
            SHADOW_AGENT) SHADOW_AGENT=$v ;;
        esac
    done < "$m"
}

cmd_shadow() {
    local sub=${1:-list}
    shift || true
    case "$sub" in
        list)
            local m any=0 nchg
            for m in "$SHADOWS_DIR"/*/meta.env; do
                [[ -f $m ]] || continue
                any=1
                load_shadow_meta "$(basename "$(dirname "$m")")"
                nchg="?"
                [[ -d $SHADOW_ROOT ]] && nchg=$(shadow_changes_count "$SHADOW_ROOT" "$SHADOWS_DIR/$SHADOW_ID/work")
                printf '  %-26s %-10s %4s %-16s %s\n' "$SHADOW_ID" "$SHADOW_AGENT" "$nchg" "$(t "changed files")" "$SHADOW_ROOT"
            done
            (( any )) || tl "No active shadow workspaces. Start one with: tamagi ai run --shadow <agent>"
            ;;
        run)
            cmd_run 0 --shadow "$@"
            ;;
        jail)
            cmd_run 1 --shadow "$@"
            ;;
        diff)
            local id=${1:?usage: tamagi ai shadow diff <id>}
            load_shadow_meta "$id"
            [[ -d $SHADOW_ROOT ]] || die "$(t "original project folder is missing"): $SHADOW_ROOT"
            diff -ruN \
                --exclude=.git --exclude=target --exclude=node_modules \
                --exclude=__pycache__ --exclude=.venv --exclude=.pytest_cache \
                "$SHADOW_ROOT" "$SHADOWS_DIR/$id/work" || true
            ;;
        apply)
            local id=${1:?usage: tamagi ai shadow apply <id>}
            load_shadow_meta "$id"
            [[ -d $SHADOW_ROOT ]] || die "$(t "original project folder is missing"): $SHADOW_ROOT"
            save_point "$SHADOW_ROOT" "shadow-apply-$id" 0
            python3 - "$SHADOWS_DIR/$id/work" "$SHADOW_ROOT" <<'PY'
import os, pathlib, shutil, subprocess, sys
SKIP = {".git", "target", "node_modules", "__pycache__", ".venv", ".pytest_cache", ".mypy_cache"}
src = pathlib.Path(sys.argv[1]).resolve()
dst = pathlib.Path(sys.argv[2]).resolve()

def rel_entries(base):
    files, dirs = set(), set()
    for root, dnames, fnames in os.walk(base):
        dnames[:] = [d for d in dnames if d not in SKIP]
        rel_root = pathlib.Path(root).relative_to(base)
        if str(rel_root) != ".":
            dirs.add(rel_root)
        for f in fnames:
            files.add(rel_root / f)
    return files, dirs

src_files, src_dirs = rel_entries(src)
dst_files, dst_dirs = rel_entries(dst)

for rel in sorted(dst_files - src_files):
    p = dst / rel
    if p.exists() or p.is_symlink():
        p.unlink()

for rel in sorted(dst_dirs - src_dirs, key=lambda p: len(p.parts), reverse=True):
    p = dst / rel
    try:
        p.rmdir()
    except OSError:
        pass

for rel in sorted(src_dirs):
    (dst / rel).mkdir(parents=True, exist_ok=True)

for rel in sorted(src_files):
    s, d = src / rel, dst / rel
    d.parent.mkdir(parents=True, exist_ok=True)
    if d.exists() or d.is_symlink():
        d.unlink()
    subprocess.run(["cp", "-a", "--reflink=auto", str(s), str(d)], check=True)
PY
            rm -rf -- "${SHADOWS_DIR:?}/$id"
            echo "$(t "Shadow workspace applied and cleaned up"): $id → $SHADOW_ROOT"
            ;;
        drop)
            local target=${1:?usage: tamagi ai shadow drop <id|--all>}
            if [[ $target == --all ]]; then
                rm -rf -- "${SHADOWS_DIR:?}"
                tl "All shadow workspaces removed."
            else
                load_shadow_meta "$target"
                rm -rf -- "${SHADOWS_DIR:?}/$target"
                echo "$(t "Removed"): $target"
            fi
            ;;
        *)
            die "usage: tamagi ai shadow [list|run|jail|diff <id>|apply <id>|drop <id|--all>]"
            ;;
    esac
}

cmd_list() {
    local name
    for name in "${ORDER[@]}"; do
        printf '  %-12s %-42s %s\n' "$name" "${TITLE[$name]}" "$(is_installed "$name" && t "installed" || echo -)"
    done
}

cmd_update() {
    local name rc=0
    for name in "${ORDER[@]}"; do
        is_installed "$name" || continue
        case $name in
            claude)         "$BIN_DIR/claude" update </dev/null || rc=1 ;;
            codex|opencode|clio) install_github "$name" || rc=1 ;;
            qwen|gemini|openclaw)
                if has_host_mise; then
                    local node_bin
                    node_bin=$(ensure_host_node) || { rc=1; continue; }
                    PATH="$node_bin:$PATH" npm install -g --prefix "$PREFIX" "${NPM[$name]}@latest" </dev/null || rc=1
                else
                    distrobox enter "$BOX" -- "$JAIL_BOX" --root "$PREFIX" --cwd "$PREFIX" -- npm install -g --prefix "$PREFIX" "${NPM[$name]}@latest" </dev/null || rc=1
                fi ;;
            *) ;;
        esac
    done
    return $rc
}

pick() {
    [[ -t 0 ]] || { cmd_list; return 0; }
    local picked name
    picked=$(for name in "${ORDER[@]}"; do
                 is_installed "$name" || printf '%-12s %s\n' "$name" "${TITLE[$name]}"
             done | /usr/libexec/tamagi/gum-multi --height 12 \
                 --header "$(t "AI agents (space marks, Enter installs)")") || return 0
    [[ -n $picked ]] || return 0
    while read -r name _; do install_one "$name" || echo "$(t "failed"): $name" >&2; done <<<"$picked"
}

record_flight() {
    local fid=$1 agent=$2 root=$3 started=$4 ended=$5 rc=$6 sid=$7 nchg=$8 elog=${9:-}
    mkdir -p "$FLIGHTS_DIR"
    python3 - "$FLIGHTS_DIR/$fid.json" "$fid" "$agent" "$root" "$started" "$ended" "$rc" "$sid" "$nchg" "$elog" <<'PY' 2>/dev/null || true
import json, os, pathlib, sys
out, fid, agent, root, started, ended, rc, sid, nchg, elog = sys.argv[1:11]
allowed, blocked = [], []
if elog and os.path.isfile(elog):
    for ln in pathlib.Path(elog).read_text(encoding="utf-8", errors="ignore").splitlines():
        parts = ln.split()
        if "ALLOW" in parts:
            allowed.append(parts[-1])
        elif "DENY" in parts or "BLOCK" in parts:
            blocked.append(parts[-1])
rec = {
    "id": fid,
    "agent": agent,
    "root": root,
    "started": started,
    "ended": ended,
    "exit_code": int(rc),
    "shadow_id": sid,
    "changed_files": int(nchg),
    "egress_allowed": sorted(set(allowed)),
    "egress_blocked": sorted(set(blocked)),
}
pathlib.Path(out).write_text(json.dumps(rec, indent=2) + "\n", encoding="utf-8")
PY
}

cmd_flights() {
    local sub=${1:-list}
    shift || true
    case "$sub" in
        list)
            local f any=0
            for f in $(ls -1t "$FLIGHTS_DIR"/*.json 2>/dev/null || true); do
                [[ -f $f ]] || continue
                any=1
                jq -r '"  \(.id)  \(.agent)  rc=\(.exit_code)  files=\(.changed_files)  blocked=\(.egress_blocked | length)  \(.root)"' "$f" 2>/dev/null || true
            done
            (( any )) || tl "No agent flights recorded yet. Run: tamagi ai run --shadow <agent>"
            ;;
        show)
            local fid=${1:?usage: tamagi ai flights show <id> [--json]}
            [[ -f $FLIGHTS_DIR/$fid.json ]] || die "$(t "flight not found"): $fid"
            if [[ ${2:-} == --json ]]; then
                cat "$FLIGHTS_DIR/$fid.json"
            else
                python3 - "$FLIGHTS_DIR/$fid.json" <<'PY'
import datetime, json, sys
d = json.load(open(sys.argv[1], encoding="utf-8"))
dur = "?"
try:
    t0 = datetime.datetime.fromisoformat(d["started"])
    t1 = datetime.datetime.fromisoformat(d["ended"])
    dur = f"{int((t1 - t0).total_seconds())}s"
except Exception:
    pass
print(f":: Flight {d.get('id', '?')}")
print(f"   Agent         : {d.get('agent', '?')}")
print(f"   Project       : {d.get('root', '?')}")
print(f"   Duration      : {dur} (exit {d.get('exit_code', '?')})")
print(f"   Shadow ID     : {d.get('shadow_id') or '-'} ({d.get('changed_files', 0)} changed files)")
print(f"   Egress allow  : {', '.join(d.get('egress_allowed') or []) or '-'}")
print(f"   Egress block  : {', '.join(d.get('egress_blocked') or []) or '-'}")
PY
            fi
            ;;
        clear)
            rm -rf -- "${FLIGHTS_DIR:?}"
            tl "Flight recorder history cleared."
            ;;
        *)
            die "usage: tamagi ai flights [list|show <id> [--json]|clear]"
            ;;
    esac
}

case "${1:-}" in
    "")              pick ;;
    list)            cmd_list ;;
    installed)       for n in "${ORDER[@]}"; do [[ $n != local ]] && is_installed "$n" && echo "$n"; done; exit 0 ;;
    install)         shift; (( $# )) || die "usage: tamagi ai agents install <${ORDER[*]}>"
                     for a in "$@"; do install_one "$a"; done ;;
    remove)          shift; (( $# )) || die "usage: tamagi ai agents remove <name>"
                     for a in "$@"; do remove_one "$a"; done ;;
    update)          cmd_update ;;
    run)             shift; cmd_run 0 "$@" ;;
    jail)            shift; cmd_run 1 "$@" ;;
    shadow|shadows)  shift; cmd_shadow "$@" ;;
    flights)         shift; cmd_flights "$@" ;;
    -h|--help|help)  sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//' ;;
    *)               die "usage: tamagi ai agents [list|install <name>…|remove <name>|update|run <name>|jail|shadow|flights]" ;;
esac
