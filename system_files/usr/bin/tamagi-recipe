#!/usr/bin/bash
# tamagi-recipe — your own commands, written as recipes in a Markdown file.
#
# A recipe is a few lines of shell with a name. They live in a Markdown file,
# inside ```just blocks, with the explanation of each one written around it:
# the text is the documentation, the block is what runs (the `just` command
# runner reads it: https://just.systems/man/en/markdown-justfiles.html).
#
#   tamagi recipe                 lists the recipes: yours first, then Tamagi's
#   tamagi recipe <name> [args]   runs one, in the folder you are in
#   tamagi recipe edit            opens your file (creates it with an example)
#   tamagi recipe show <name>     prints what a recipe would run
#
# Your file: ~/.config/tamagi/recipes.md. Tamagi's: /usr/share/tamagi/recipes.md.
# A recipe of yours with the same name as one of Tamagi's wins.
set -euo pipefail
. /usr/libexec/tamagi/i18n

USER_FILE=${TAMAGI_RECIPES:-${XDG_CONFIG_HOME:-$HOME/.config}/tamagi/recipes.md}
SYSTEM_FILE=${TAMAGI_SYSTEM_RECIPES:-/usr/share/tamagi/recipes.md}

die() { echo "$(t "error"): $*" >&2; exit 1; }
command -v just >/dev/null 2>&1 || die "just $(t "is not installed")"
usage() { sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//'; }

# has <file> <recipe>
has() { [[ -f $1 ]] && just --justfile "$1" --summary 2>/dev/null | tr ' ' '\n' | grep -qxF -- "$2"; }
# file_of <recipe>: yours first.
file_of() {
    if has "$USER_FILE" "$1"; then echo "$USER_FILE"
    elif has "$SYSTEM_FILE" "$1"; then echo "$SYSTEM_FILE"
    else return 1; fi
}

list_file() { # list_file <file> <heading>
    [[ -f $1 ]] || return 0
    local out
    # A mistake in the file is shown as it is: it says the line.
    out=$(just --justfile "$1" --list --unsorted --list-heading '' --list-prefix '  ') || die "$1"
    [[ -n $out ]] || return 0
    echo "$2"
    echo "$out"
}

template() {
    cat <<'MD'
# My recipes

Commands of my own. Run one with `tamagi recipe <name>`; list them with
`tamagi recipe`. Only the ```just blocks run; everything else is notes for me.

## Example

Says hello, to check that this file works. The line starting with `#` is the
description shown in the list.

```just
# says hello (an example: change or delete it)
hello name="world":
    @echo "Hello, {{name}}!"
```
MD
}

case ${1:-list} in
    list)
        list_file "$USER_FILE" "$(t "Your recipes") ($USER_FILE)"
        list_file "$SYSTEM_FILE" "$(t "Tamagi recipes")"
        [[ -f $USER_FILE ]] || echo "$(t "Write your own with"): tamagi recipe edit" ;;
    edit)
        if [[ ! -f $USER_FILE ]]; then
            mkdir -p "$(dirname "$USER_FILE")"
            template > "$USER_FILE"
        fi
        exec "${VISUAL:-${EDITOR:-nano}}" "$USER_FILE" ;;
    show)
        [[ -n ${2:-} ]] || { usage >&2; exit 2; }
        file=$(file_of "$2") || die "$(t "no such recipe"): $2  ($(t "see"): tamagi recipe)"
        exec just --justfile "$file" --show "$2" ;;
    -h|--help|help) usage ;;
    -*) usage >&2; exit 2 ;;
    *)
        file=$(file_of "$1") || die "$(t "no such recipe"): $1  ($(t "see"): tamagi recipe)"
        exec just --justfile "$file" --working-directory "$PWD" "$@" ;;
esac
