#!/usr/bin/bash
# tamagi-layer — pacotes do Fedora por cima da imagem, sem refazer a imagem.
set -euo pipefail
. /usr/libexec/tamagi/i18n

EXT=${TAMAGI_LAYER_DIR:-/var/lib/extensions}
META=${TAMAGI_LAYER_META:-/var/lib/tamagi/layers}
OFF=${TAMAGI_LAYER_OFF:-/var/lib/tamagi/layers-off}
SUDO=sudo; (( EUID == 0 )) && SUDO=

die() { echo "tamagi-layer: $*" >&2; exit 1; }
usage() {
    echo "tamagi-layer — $(t "pacotes do Fedora por cima da imagem (systemd-sysext)")"
    echo
    echo "  tamagi-layer add <nome> <pacote>…    $(t "cria a camada e a liga (pede senha)")"
    echo "  tamagi-layer remove <nome>           $(t "desliga e apaga a camada")"
    echo "  tamagi-layer list                    $(t "camadas, pacotes e estado")"
    echo "  tamagi-layer rebuild [nome]          $(t "refaz as camadas contra a imagem atual")"
    echo "  tamagi-layer off | on                $(t "desliga / religa todas (sem apagar)")"
    echo "  tamagi-layer temp                    $(t "/usr gravável até o próximo reinício")"
    echo "  tamagi-layer build <nome> <pacote>…  $(t "só gera o arquivo (-o <arquivo>), sem instalar")"
    echo "  --copr dono/projeto   --rpmfusion   --allow-upgrade"
    exit "${1:-0}"
}

# shellcheck disable=SC1091
os() { ( . /usr/lib/os-release; echo "${!1:-}" ); }
image_version() { local v; v=$(os IMAGE_VERSION); echo "${v:-$(os OSTREE_VERSION)}"; }
valid_name() { [[ $1 =~ ^[a-z][a-z0-9-]{0,39}$ ]] || die "$(t "nome inválido"): '$1'"; }
names() { local f; for f in "$EXT"/*.raw "$OFF"/*.raw; do [[ -e $f ]] && basename "$f" .raw; done | sort -u; }
meta() { cat "$META/$1.$2" 2>/dev/null || true; }

build_layer() {
    local name=$1 out=$2 work
    command -v mkfs.erofs >/dev/null || die "$(t "falta o mkfs.erofs (pacote erofs-utils)")"
    mkdir -p "${XDG_CACHE_HOME:-$HOME/.cache}/tamagi"
    work=$(mktemp -d "${XDG_CACHE_HOME:-$HOME/.cache}/tamagi/layer.XXXXXX")
    # shellcheck disable=SC2064
    trap "$( (( EUID == 0 )) && echo "rm -rf '$work'" || echo "podman unshare rm -rf '$work'")" EXIT
    printf '%s\n' "${PKGS[@]}" > "$work/request"
    printf '%s\n' "${COPRS[@]}" > "$work/coprs"
    printf '%s\n' "$RPMFUSION" > "$work/rpmfusion"

    local msg_already msg_upgraded msg_upgrade_hint msg_nousr
    msg_already=$(t "nada a fazer: tudo isso já está na imagem")
    msg_upgraded=$(t "estes pacotes da imagem seriam atualizados pela camada:")
    msg_upgrade_hint=$(t "atualize o sistema primeiro (tamagi-update) ou repita com --allow-upgrade")
    msg_nousr=$(t "os pacotes não instalam nada em /usr")

    cat > "$work/inner.sh" <<'INNER'
set -euo pipefail
export LC_ALL=C
work=$1 name=$2 allow_upgrade=$3
R=$work/root
dbpath=$(rpm --eval '%_dbpath')
ver=$(. /usr/lib/os-release; echo "$VERSION_ID")
arch=$(uname -m)

mkdir -p "$R$dbpath"
cp -a "$(realpath "$dbpath")/." "$R$dbpath/"
rpm -qa --qf '%{NAME}.%{ARCH} %{NAME} %{EPOCHNUM}:%{VERSION}-%{RELEASE}.%{ARCH}\n' | sort > "$work/before"

repo=()
while read -r copr; do
    [[ -n $copr ]] || continue
    id="copr-${copr//\//-}"
    base="https://download.copr.fedorainfracloud.org/results/$copr"
    repo+=("--repofrompath=$id,$base/fedora-$ver-$arch/"
           "--setopt=$id.gpgcheck=1" "--setopt=$id.gpgkey=$base/pubkey.gpg")
done < "$work/coprs"
if [[ $(cat "$work/rpmfusion" 2>/dev/null || echo 0) == 1 ]]; then
    repo+=(
        "--repofrompath=rpmfusion-free,https://download1.rpmfusion.org/free/fedora/releases/$ver/Everything/$arch/os/"
        "--setopt=rpmfusion-free.gpgcheck=0"
        "--repofrompath=rpmfusion-free-updates,https://download1.rpmfusion.org/free/fedora/updates/$ver/$arch/"
        "--setopt=rpmfusion-free-updates.gpgcheck=0"
        "--repofrompath=rpmfusion-nonfree,https://download1.rpmfusion.org/nonfree/fedora/releases/$ver/Everything/$arch/os/"
        "--setopt=rpmfusion-nonfree.gpgcheck=0"
        "--repofrompath=rpmfusion-nonfree-updates,https://download1.rpmfusion.org/nonfree/fedora/updates/$ver/$arch/"
        "--setopt=rpmfusion-nonfree-updates.gpgcheck=0"
    )
fi

mapfile -t pkgs < "$work/request"
dnf5 -y --installroot="$R" --use-host-config --releasever="$ver" \
    --setopt=install_weak_deps=False --setopt=tsflags=noscripts \
    --setopt=cachedir="$work/cache" --setopt=keepcache=False \
    --setopt=persistdir="$work/persist" --setopt=logdir="$work/log" \
    "${repo[@]}" install "${pkgs[@]}"

rpm --root "$R" -qa --qf '%{NAME}.%{ARCH} %{NAME} %{EPOCHNUM}:%{VERSION}-%{RELEASE}.%{ARCH}\n' | sort > "$work/after"
join -v 2 -j 1 <(cut -d' ' -f1 "$work/before" | sort -u) <(cut -d' ' -f1 "$work/after" | sort -u) \
    | grep -v '^gpg-pubkey\.' > "$work/new-names" || true
awk 'NR == FNR { new[$1]; next } $1 in new { print $2, $3 }' "$work/new-names" "$work/after" > "$work/packages"
[[ -s $work/packages ]] || { echo "$MSG_ALREADY" >&2; exit 3; }
comm -13 "$work/before" "$work/after" | cut -d' ' -f1 | grep -v -x -F -f "$work/new-names" \
    | grep -v '^gpg-pubkey\.' > "$work/upgraded" || true
if [[ -s $work/upgraded && $allow_upgrade != 1 ]]; then
    echo "$MSG_UPGRADED" >&2
    sed 's/^/  /' "$work/upgraded" >&2
    echo "$MSG_UPGRADE_HINT" >&2
    exit 4
fi

if [[ -d $R/etc ]]; then
    ( cd "$R" && find etc -type f -o -type l | sort ) > "$work/etc.list"
    tar -C "$R" -cf "$work/etc.tar" etc
fi
rm -rf "$R$dbpath" "$R/usr/lib/sysimage" "$R/var" "$R/etc" "$R/run" "$R/tmp" "$R/dev" "$R/proc" "$R/sys"
find "$R" -mindepth 1 -maxdepth 1 ! -name usr ! -name opt -exec rm -rf {} +
[[ -d $R/usr ]] || { echo "$MSG_NOUSR" >&2; exit 5; }

mkdir -p "$R/usr/lib/extension-release.d" "$R/usr/share/tamagi/layers"
printf 'ID=%s\nVERSION_ID=%s\n' "$(. /usr/lib/os-release; echo "$ID")" "$ver" \
    > "$R/usr/lib/extension-release.d/extension-release.$name"
cp "$work/packages" "$R/usr/share/tamagi/layers/$name.packages"

ctx=/etc/selinux/targeted/contexts/files/file_contexts
args=(-zlz4hc -T0 --quiet)
[[ -r $ctx ]] && args+=(--file-contexts="$ctx")
mkfs.erofs "${args[@]}" "$work/layer.raw" "$R"
chmod 0644 "$work/layer.raw"
INNER

    local rc=0
    if (( EUID == 0 )); then
        MSG_ALREADY=$msg_already MSG_UPGRADED=$msg_upgraded MSG_UPGRADE_HINT=$msg_upgrade_hint MSG_NOUSR=$msg_nousr \
            bash "$work/inner.sh" "$work" "$name" "$ALLOW_UPGRADE" || rc=$?
    else
        MSG_ALREADY=$msg_already MSG_UPGRADED=$msg_upgraded MSG_UPGRADE_HINT=$msg_upgrade_hint MSG_NOUSR=$msg_nousr \
            podman unshare bash "$work/inner.sh" "$work" "$name" "$ALLOW_UPGRADE" || rc=$?
    fi
    (( rc == 0 )) || exit "$rc"
    cp "$work/layer.raw" "$out"
    BUILT_PACKAGES=$(cat "$work/packages")
    BUILT_ETC=""
    if [[ -s $work/etc.list ]]; then
        BUILT_ETC=$out.etc.tar
        cp "$work/etc.tar" "$BUILT_ETC"
    fi
}

parse_build_args() {
    NAME="" PKGS=() COPRS=() ALLOW_UPGRADE=0 RPMFUSION=0 OUT=""
    while (( $# )); do
        case "$1" in
            --copr)          [[ ${2:-} =~ ^[A-Za-z0-9@_.-]+/[A-Za-z0-9_.-]+$ ]] || die "--copr dono/projeto"
                             COPRS+=("$2"); shift ;;
            --rpmfusion)     RPMFUSION=1 ;;
            --allow-upgrade) ALLOW_UPGRADE=1 ;;
            -o)              OUT=${2:?-o <arquivo>}; shift ;;
            -*)              die "$(t "opção desconhecida"): $1" ;;
            *)               if [[ -z $NAME ]]; then NAME=$1; else PKGS+=("$1"); fi ;;
        esac
        shift
    done
    [[ -n $NAME ]] || usage 2
    valid_name "$NAME"
    (( ${#PKGS[@]} )) || die "$(t "diga pelo menos um pacote")"
    local p; for p in "${PKGS[@]}"; do [[ $p =~ ^[A-Za-z0-9@][A-Za-z0-9+._:@/-]*$ ]] || die "$(t "pacote inválido"): $p"; done
}

install_layer() {
    local name=$1 raw=$2
    echo "$(t "Ligando a camada") '$name' ($(t "pede senha"))…"
    $SUDO install -d -m 755 "$EXT" "$META"
    $SUDO install -m 644 "$raw" "$EXT/$name.raw"
    $SUDO rm -f "$OFF/$name.raw"
    printf '%s\n' "${PKGS[@]}"  | $SUDO install -m 644 /dev/stdin "$META/$name.request"
    printf '%s\n' "${COPRS[@]}" | $SUDO install -m 644 /dev/stdin "$META/$name.coprs"
    printf '%s\n' "$RPMFUSION"  | $SUDO install -m 644 /dev/stdin "$META/$name.rpmfusion"
    echo "$BUILT_PACKAGES"      | $SUDO install -m 644 /dev/stdin "$META/$name.packages"
    image_version               | $SUDO install -m 644 /dev/stdin "$META/$name.image"
    if [[ -n $BUILT_ETC ]]; then
        $SUDO tar -C / --skip-old-files --no-same-owner -xf "$BUILT_ETC"
        $SUDO restorecon -R /etc 2>/dev/null || true
        rm -f "$BUILT_ETC"
    fi
    refresh
}

refresh() {
    command -v restorecon >/dev/null && $SUDO restorecon -R "$EXT" 2>/dev/null || true
    $SUDO systemd-sysext refresh
    command -v ldconfig >/dev/null && $SUDO ldconfig 2>/dev/null || true
    $SUDO systemctl daemon-reload 2>/dev/null || true
}

cmd_add() {
    parse_build_args "$@"
    local tmp; tmp=$(mktemp -d)
    build_layer "$NAME" "$tmp/$NAME.raw"
    install_layer "$NAME" "$tmp/$NAME.raw"
    rm -rf "$tmp"
    echo "$(t "Camada ligada"): '$NAME' ($(wc -l <<<"$BUILT_PACKAGES") $(t "pacote(s)"), $(image_version))."
    echo "$(t "Para desfazer"): tamagi-layer remove $NAME"
}

cmd_build() {
    parse_build_args "$@"
    OUT=${OUT:-$PWD/$NAME.raw}
    build_layer "$NAME" "$OUT"
    echo "$(t "Gerado"): $OUT ($(wc -l <<<"$BUILT_PACKAGES") $(t "pacote(s)"))"
    [[ -z $BUILT_ETC ]] || echo "$(t "Arquivos de /etc dos pacotes"): $BUILT_ETC"
}

cmd_remove() {
    local name=${1:?$(t "uso"): tamagi-layer remove <nome>}
    valid_name "$name"
    [[ -e $EXT/$name.raw || -e $OFF/$name.raw ]] || die "$(t "não existe a camada") '$name'"
    $SUDO rm -f "$EXT/$name.raw" "$OFF/$name.raw" "$META/$name".{request,coprs,rpmfusion,packages,image}
    refresh
    echo "$(t "Camada removida"): '$name'."
}

state_of() {
    local name=$1
    [[ -e $EXT/$name.raw ]] || { echo desligada; return; }
    [[ $(meta "$name" image) == "$(image_version)" ]] && echo ligada || echo desatualizada
}

cmd_list() {
    local name found=0 st
    for name in $(names); do
        found=1
        st=$(state_of "$name")
        printf '%-20s %-14s %s\n' "$name" "$(t "$st")" "$(meta "$name" request | tr '\n' ' ')"
    done
    (( found )) || echo "$(t "Nenhuma camada. Exemplo"): tamagi-layer add ferramentas strace ltrace"
}

cmd_rebuild() {
    local only=${1:-} name tmp rc=0
    for name in $(names); do
        [[ -z $only || $only == "$name" ]] || continue
        [[ -e $EXT/$name.raw ]] || continue
        mapfile -t PKGS < <(meta "$name" request); mapfile -t COPRS < <(meta "$name" coprs | grep . || true)
        RPMFUSION=$(meta "$name" rpmfusion); RPMFUSION=${RPMFUSION:-0}
        (( ${#PKGS[@]} )) || { echo "$(t "camada") '$name': $(t "sem a lista de pacotes, não dá para refazer")" >&2; rc=1; continue; }
        ALLOW_UPGRADE=0
        echo "── $(t "Refazendo a camada") '$name' ($(image_version))"
        tmp=$(mktemp -d)
        if ( build_layer "$name" "$tmp/$name.raw"; install_layer "$name" "$tmp/$name.raw" ); then :; else
            echo "$(t "camada") '$name': $(t "não consegui refazer; ela continua como estava")" >&2; rc=1
        fi
        rm -rf "$tmp"
    done
    return $rc
}

cmd_stale() {
    local name
    for name in $(names); do [[ $(state_of "$name") == desatualizada ]] && echo "$name"; done
    return 0
}

cmd_off() {
    compgen -G "$EXT/*.raw" >/dev/null || { tl "Nenhuma camada ligada."; return 0; }
    $SUDO install -d -m 755 "$OFF"
    $SUDO sh -c "mv '$EXT'/*.raw '$OFF'/"
    refresh
    echo "$(t "Camadas desligadas. Para religar"): tamagi-layer on"
}

cmd_on() {
    compgen -G "$OFF/*.raw" >/dev/null || { tl "Nenhuma camada desligada."; return 0; }
    $SUDO install -d -m 755 "$EXT"
    $SUDO sh -c "mv '$OFF'/*.raw '$EXT'/"
    refresh
    tl "Camadas religadas."
}

cmd_temp() {
    tl "O /usr fica gravável até o próximo reinício; tudo o que mudar some ao reiniciar."
    exec $SUDO bootc usr-overlay
}

case "${1:-}" in
    add|adicionar)   shift; cmd_add "$@" ;;
    build|construir) shift; cmd_build "$@" ;;
    remove|rm|remover) shift; cmd_remove "$@" ;;
    list|ls|lista)   cmd_list ;;
    rebuild|refazer) shift; cmd_rebuild "$@" ;;
    stale)           cmd_stale ;;
    off|desligar)    cmd_off ;;
    on|ligar)        cmd_on ;;
    temp)            cmd_temp ;;
    -h|--help|help|ajuda) usage 0 ;;
    *)               usage 2 ;;
esac
