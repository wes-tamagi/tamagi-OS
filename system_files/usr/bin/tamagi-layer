#!/usr/bin/bash
# tamagi-layer — pacotes do Fedora por cima da imagem, sem refazer a imagem.
set -euo pipefail
. /usr/libexec/tamagi/i18n

EXT=${TAMAGI_LAYER_DIR:-/var/lib/extensions}
META=${TAMAGI_LAYER_META:-/var/lib/tamagi/layers}
OFF=${TAMAGI_LAYER_OFF:-/var/lib/tamagi/layers-off}
OVERLAY_DIR=${TAMAGI_LAYER_OVERLAYS:-/usr/share/tamagi/layer-overlays}
SUDO=sudo; (( EUID == 0 )) && SUDO=

die() { echo "tamagi-layer: $*" >&2; exit 1; }
usage() {
    echo "tamagi-layer — $(t "Fedora packages layered over the image (systemd-sysext)")"
    echo
    echo "  tamagi-layer add <nome> <pacote>…    $(t "create and enable the layer (needs password)")"
    echo "  tamagi-layer remove <nome>           $(t "disable and delete the layer")"
    echo "  tamagi-layer list                    $(t "layers, packages, and status")"
    echo "  tamagi-layer rebuild [nome]          $(t "rebuild layers against the current image")"
    echo "  tamagi-layer off | on                $(t "disable / re-enable all layers (without deleting)")"
    echo "  tamagi-layer temp                    $(t "writable /usr until next reboot")"
    echo "  tamagi-layer build <nome> <pacote>…  $(t "only build the file (-o <file>), without installing")"
    echo "  --copr owner/project   --rpmfusion   --allow-upgrade"
    echo "  --repo id=baseurl[=gpgkey-url]       $(t "extra RPM repository (e.g. Google Chrome's)")"
    echo "  --unit name.socket                   $(t "systemd unit the layer starts at every boot")"
    echo "  --overlay name                       $(t "extra files of the image that go in with the layer")"
    exit "${1:-0}"
}

# shellcheck disable=SC1091
os() { ( . /usr/lib/os-release; echo "${!1:-}" ); }
image_version() { local v; v=$(os IMAGE_VERSION); echo "${v:-$(os OSTREE_VERSION)}"; }
valid_name() { [[ $1 =~ ^[a-z][a-z0-9-]{0,39}$ ]] || die "$(t "invalid name"): '$1'"; }
names() { local f; for f in "$EXT"/*.raw "$OFF"/*.raw; do [[ -e $f ]] && basename "$f" .raw; done | sort -u; }
meta() { cat "$META/$1.$2" 2>/dev/null || true; }

build_layer() {
    local name=$1 out=$2 work
    command -v mkfs.erofs >/dev/null || die "$(t "mkfs.erofs missing (erofs-utils package)")"
    mkdir -p "${XDG_CACHE_HOME:-$HOME/.cache}/tamagi"
    work=$(mktemp -d "${XDG_CACHE_HOME:-$HOME/.cache}/tamagi/layer.XXXXXX")
    # shellcheck disable=SC2064
    trap "$( (( EUID == 0 )) && echo "rm -rf '$work'" || echo "podman unshare rm -rf '$work'")" EXIT
    printf '%s\n' "${PKGS[@]}" > "$work/request"
    printf '%s\n' "${COPRS[@]}" > "$work/coprs"
    printf '%s\n' "$RPMFUSION" > "$work/rpmfusion"
    printf '%s\n' "${REPOS[@]}" > "$work/repos"
    : > "$work/overlay"
    [[ -n $OVERLAY ]] && echo "$OVERLAY_DIR/$OVERLAY" > "$work/overlay"

    local msg_already msg_upgraded msg_upgrade_hint msg_nousr
    msg_already=$(t "nothing to do: all requested packages are already in the image")
    msg_upgraded=$(t "these base image packages would be upgraded by the layer:")
    msg_upgrade_hint=$(t "update the system first (tamagi-update) or retry with --allow-upgrade")
    msg_nousr=$(t "packages install nothing into /usr")

    cat > "$work/inner.sh" <<'INNER'
set -euo pipefail
export LC_ALL=C
work=$1 name=$2 allow_upgrade=$3
R=$work/root
dbpath=$(rpm --eval '%_dbpath')
ver=$(. /usr/lib/os-release; echo "$VERSION_ID")
arch=$(uname -m)

mkdir -p "$R$dbpath"
cp -a "$(realpath "$dbpath")/." "$R$dbpath/"
rpm -qa --qf '%{NAME}.%{ARCH} %{NAME} %{EPOCHNUM}:%{VERSION}-%{RELEASE}.%{ARCH}\n' | sort > "$work/before"

repo=()
while read -r copr; do
    [[ -n $copr ]] || continue
    id="copr-${copr//\//-}"
    base="https://download.copr.fedorainfracloud.org/results/$copr"
    repo+=("--repofrompath=$id,$base/fedora-$ver-$arch/"
           "--setopt=$id.gpgcheck=1" "--setopt=$id.gpgkey=$base/pubkey.gpg")
done < "$work/coprs"
while IFS='=' read -r id base key; do
    [[ -n $id && -n $base ]] || continue
    base=${base//\$basearch/$arch}
    repo+=("--repofrompath=$id,$base")
    if [[ -n $key ]]; then repo+=("--setopt=$id.gpgcheck=1" "--setopt=$id.gpgkey=$key"); else repo+=("--setopt=$id.gpgcheck=0"); fi
done < "$work/repos"
if [[ $(cat "$work/rpmfusion" 2>/dev/null || echo 0) == 1 ]]; then
    repo+=(
        "--repofrompath=rpmfusion-free,https://download1.rpmfusion.org/free/fedora/releases/$ver/Everything/$arch/os/"
        "--setopt=rpmfusion-free.gpgcheck=0"
        "--repofrompath=rpmfusion-free-updates,https://download1.rpmfusion.org/free/fedora/updates/$ver/$arch/"
        "--setopt=rpmfusion-free-updates.gpgcheck=0"
        "--repofrompath=rpmfusion-nonfree,https://download1.rpmfusion.org/nonfree/fedora/releases/$ver/Everything/$arch/os/"
        "--setopt=rpmfusion-nonfree.gpgcheck=0"
        "--repofrompath=rpmfusion-nonfree-updates,https://download1.rpmfusion.org/nonfree/fedora/updates/$ver/$arch/"
        "--setopt=rpmfusion-nonfree-updates.gpgcheck=0"
    )
fi

mapfile -t pkgs < "$work/request"
dnf5 -y --installroot="$R" --use-host-config --releasever="$ver" \
    --setopt=install_weak_deps=False --setopt=tsflags=noscripts \
    --setopt=cachedir="$work/cache" --setopt=keepcache=False \
    --setopt=persistdir="$work/persist" --setopt=logdir="$work/log" \
    "${repo[@]}" install "${pkgs[@]}"

rpm --root "$R" -qa --qf '%{NAME}.%{ARCH} %{NAME} %{EPOCHNUM}:%{VERSION}-%{RELEASE}.%{ARCH}\n' | sort > "$work/after"
join -v 2 -j 1 <(cut -d' ' -f1 "$work/before" | sort -u) <(cut -d' ' -f1 "$work/after" | sort -u) \
    | grep -v '^gpg-pubkey\.' > "$work/new-names" || true
awk 'NR == FNR { new[$1]; next } $1 in new { print $2, $3 }' "$work/new-names" "$work/after" > "$work/packages"
[[ -s $work/packages ]] || { echo "$MSG_ALREADY" >&2; exit 3; }
comm -13 "$work/before" "$work/after" | cut -d' ' -f1 | grep -v -x -F -f "$work/new-names" \
    | grep -v '^gpg-pubkey\.' > "$work/upgraded" || true
if [[ -s $work/upgraded && $allow_upgrade != 1 ]]; then
    echo "$MSG_UPGRADED" >&2
    sed 's/^/  /' "$work/upgraded" >&2
    echo "$MSG_UPGRADE_HINT" >&2
    exit 4
fi

# Folders the packages own under /var (libvirt's images and nvram, swtpm's
# state...): /var is the machine's, not the layer's, so they become tmpfiles
# lines and are created with the right owner and mode when the layer is on.
mapfile -t newpkgs < <(cut -d" " -f1 "$work/packages")
if (( ${#newpkgs[@]} )); then
    mkdir -p "$R/usr/lib/tmpfiles.d"
    rpm --root "$R" -q --qf '[%{FILEMODES:perms} %{FILEMODES:octal} %{FILEUSERNAME} %{FILEGROUPNAME} %{FILENAMES}\n]' "${newpkgs[@]}" 2>/dev/null \
        | awk '$1 ~ /^d/ && $5 ~ /^\/var\/(lib|log|cache|spool)\// { printf "d %s %s %s %s -\n", $5, substr($2, length($2) - 3), $3, $4 }' \
        | sort -u > "$R/usr/lib/tmpfiles.d/tamagi-layer-$name-var.conf"
    [[ -s $R/usr/lib/tmpfiles.d/tamagi-layer-$name-var.conf ]] || rm -f "$R/usr/lib/tmpfiles.d/tamagi-layer-$name-var.conf"
fi

if [[ -d $R/etc ]]; then
    ( cd "$R" && find etc -type f -o -type l | sort ) > "$work/etc.list"
    tar -C "$R" -cf "$work/etc.tar" etc
fi
rm -rf "$R$dbpath" "$R/usr/lib/sysimage" "$R/var" "$R/etc" "$R/run" "$R/tmp" "$R/dev" "$R/proc" "$R/sys"
# /opt is a link to /var/opt on this system (state, not image): packages that
# install there (Chrome, Vivaldi) go to /usr/lib/opt, and a tmpfiles line puts
# the /opt/<name> link back — the same thing rpm-ostree does.
if [[ -d $R/opt ]] && compgen -G "$R/opt/*" >/dev/null; then
    mkdir -p "$R/usr/lib/opt" "$R/usr/lib/tmpfiles.d"
    for d in "$R"/opt/*; do
        n=$(basename "$d")
        mv "$d" "$R/usr/lib/opt/$n"
        printf 'L+ /opt/%s - - - - /usr/lib/opt/%s\n' "$n" "$n" >> "$R/usr/lib/tmpfiles.d/tamagi-layer-$name.conf"
    done
fi
find "$R" -mindepth 1 -maxdepth 1 ! -name usr -exec rm -rf {} +
[[ -d $R/usr ]] || { echo "$MSG_NOUSR" >&2; exit 5; }

mkdir -p "$R/usr/lib/extension-release.d" "$R/usr/share/tamagi/layers"
printf 'ID=%s\nVERSION_ID=%s\n' "$(. /usr/lib/os-release; echo "$ID")" "$ver" \
    > "$R/usr/lib/extension-release.d/extension-release.$name"
cp "$work/packages" "$R/usr/share/tamagi/layers/$name.packages"
# Files of the image that only make sense with this layer on (e.g. the login
# session of the gaming layer).
overlay=$(cat "$work/overlay" 2>/dev/null || true)
if [[ -n $overlay && -d $overlay/usr ]]; then cp -a "$overlay/usr/." "$R/usr/"; fi

ctx=/etc/selinux/targeted/contexts/files/file_contexts
args=(-zlz4hc -T0 --quiet)
[[ -r $ctx ]] && args+=(--file-contexts="$ctx")
mkfs.erofs "${args[@]}" "$work/layer.raw" "$R"
chmod 0644 "$work/layer.raw"
INNER

    local rc=0
    if (( EUID == 0 )); then
        MSG_ALREADY=$msg_already MSG_UPGRADED=$msg_upgraded MSG_UPGRADE_HINT=$msg_upgrade_hint MSG_NOUSR=$msg_nousr \
            bash "$work/inner.sh" "$work" "$name" "$ALLOW_UPGRADE" || rc=$?
    else
        MSG_ALREADY=$msg_already MSG_UPGRADED=$msg_upgraded MSG_UPGRADE_HINT=$msg_upgrade_hint MSG_NOUSR=$msg_nousr \
            podman unshare bash "$work/inner.sh" "$work" "$name" "$ALLOW_UPGRADE" || rc=$?
    fi
    (( rc == 0 )) || exit "$rc"
    cp "$work/layer.raw" "$out"
    BUILT_PACKAGES=$(cat "$work/packages")
    BUILT_ETC=""
    if [[ -s $work/etc.list ]]; then
        BUILT_ETC=$out.etc.tar
        cp "$work/etc.tar" "$BUILT_ETC"
    fi
}

parse_build_args() {
    NAME="" PKGS=() COPRS=() REPOS=() UNITS=() ALLOW_UPGRADE=0 RPMFUSION=0 OUT="" OVERLAY=""
    while (( $# )); do
        case "$1" in
            --copr)          [[ ${2:-} =~ ^[A-Za-z0-9@_.-]+/[A-Za-z0-9_.-]+$ ]] || die "--copr dono/projeto"
                             COPRS+=("$2"); shift ;;
            --rpmfusion)     RPMFUSION=1 ;;
            --repo)          [[ ${2:-} =~ ^[a-z][a-z0-9-]*=https://[^=[:space:],]+(=https://[^=[:space:],]+)?$ ]] || die "--repo id=https://baseurl[=https://gpgkey]"
                             REPOS+=("$2"); shift ;;
            --unit)          [[ ${2:-} =~ ^[A-Za-z0-9@_.-]+\.(service|socket|timer|path)$ ]] || die "--unit name.service|socket|timer|path"
                             UNITS+=("$2"); shift ;;
            --overlay)       [[ ${2:-} =~ ^[a-z][a-z0-9-]*$ && -d $OVERLAY_DIR/$2 ]] || die "--overlay <name in $OVERLAY_DIR>"
                             OVERLAY=$2; shift ;;
            --allow-upgrade) ALLOW_UPGRADE=1 ;;
            -o)              OUT=${2:?-o <arquivo>}; shift ;;
            -*)              die "$(t "unknown option"): $1" ;;
            *)               if [[ -z $NAME ]]; then NAME=$1; else PKGS+=("$1"); fi ;;
        esac
        shift
    done
    [[ -n $NAME ]] || usage 2
    valid_name "$NAME"
    (( ${#PKGS[@]} )) || die "$(t "specify at least one package")"
    local p; for p in "${PKGS[@]}"; do [[ $p =~ ^[A-Za-z0-9@][A-Za-z0-9+._:@/-]*$ ]] || die "$(t "invalid package"): $p"; done
}

install_layer() {
    local name=$1 raw=$2
    echo "$(t "Enabling layer") '$name' ($(t "needs password"))…"
    $SUDO install -d -m 755 "$EXT" "$META"
    $SUDO install -m 644 "$raw" "$EXT/$name.raw"
    $SUDO rm -f "$OFF/$name.raw"
    printf '%s\n' "${PKGS[@]}"  | $SUDO install -m 644 /dev/stdin "$META/$name.request"
    printf '%s\n' "${COPRS[@]}" | $SUDO install -m 644 /dev/stdin "$META/$name.coprs"
    printf '%s\n' "$RPMFUSION"  | $SUDO install -m 644 /dev/stdin "$META/$name.rpmfusion"
    printf '%s\n' "${REPOS[@]}" | $SUDO install -m 644 /dev/stdin "$META/$name.repos"
    printf '%s\n' "${UNITS[@]}" | $SUDO install -m 644 /dev/stdin "$META/$name.units"
    printf '%s\n' "$OVERLAY"    | $SUDO install -m 644 /dev/stdin "$META/$name.overlay"
    echo "$BUILT_PACKAGES"      | $SUDO install -m 644 /dev/stdin "$META/$name.packages"
    image_version               | $SUDO install -m 644 /dev/stdin "$META/$name.image"
    if [[ -n $BUILT_ETC ]]; then
        $SUDO tar -C / --skip-old-files --no-same-owner -xf "$BUILT_ETC"
        $SUDO restorecon -R /etc 2>/dev/null || true
        rm -f "$BUILT_ETC"
    fi
    refresh
}

refresh() {
    command -v restorecon >/dev/null && $SUDO restorecon -R "$EXT" 2>/dev/null || true
    $SUDO systemd-sysext refresh
    settle
}

# What the packages' scriptlets would have done (the layer installs without
# them): users and groups, folders in /var and /opt links, library cache,
# udev rules — and the units each layer asked for (--unit).
settle() {
    command -v ldconfig >/dev/null && $SUDO ldconfig 2>/dev/null || true
    $SUDO systemd-sysusers 2>/dev/null || true
    $SUDO systemd-tmpfiles --create 2>/dev/null || true
    $SUDO systemctl daemon-reload 2>/dev/null || true
    $SUDO udevadm control --reload 2>/dev/null || true
    local f unit
    for f in "$META"/*.units; do
        [[ -e $f && -e $EXT/$(basename "$f" .units).raw ]] || continue
        while read -r unit; do
            [[ -n $unit ]] && { $SUDO systemctl start --no-block "$unit" 2>/dev/null || true; }
        done < "$f"
    done
}

cmd_add() {
    parse_build_args "$@"
    local tmp; tmp=$(mktemp -d)
    build_layer "$NAME" "$tmp/$NAME.raw"
    install_layer "$NAME" "$tmp/$NAME.raw"
    rm -rf "$tmp"
    echo "$(t "Layer enabled"): '$NAME' ($(wc -l <<<"$BUILT_PACKAGES") $(t "package(s)"), $(image_version))."
    echo "$(t "To undo"): tamagi-layer remove $NAME"
}

cmd_build() {
    parse_build_args "$@"
    OUT=${OUT:-$PWD/$NAME.raw}
    build_layer "$NAME" "$OUT"
    echo "$(t "Generated"): $OUT ($(wc -l <<<"$BUILT_PACKAGES") $(t "package(s)"))"
    [[ -z $BUILT_ETC ]] || echo "$(t "Package /etc files"): $BUILT_ETC"
}

cmd_remove() {
    local name=${1:?$(t "usage"): tamagi-layer remove <nome>}
    valid_name "$name"
    [[ -e $EXT/$name.raw || -e $OFF/$name.raw ]] || die "$(t "layer does not exist") '$name'"
    local unit
    while read -r unit; do
        [[ -n $unit ]] && { $SUDO systemctl stop "$unit" 2>/dev/null || true; }
    done < <(meta "$name" units)
    $SUDO rm -f "$EXT/$name.raw" "$OFF/$name.raw" "$META/$name".{request,coprs,rpmfusion,repos,units,overlay,packages,image}
    refresh
    echo "$(t "Layer removed"): '$name'."
}

state_of() {
    local name=$1
    [[ -e $EXT/$name.raw ]] || { echo desligada; return; }
    [[ $(meta "$name" image) == "$(image_version)" ]] && echo ligada || echo desatualizada
}

cmd_list() {
    local name found=0 st
    for name in $(names); do
        found=1
        st=$(state_of "$name")
        printf '%-20s %-14s %s\n' "$name" "$(t "$st")" "$(meta "$name" request | tr '\n' ' ')"
    done
    (( found )) || echo "$(t "No layers yet. Example"): tamagi-layer add ferramentas strace ltrace"
}

cmd_rebuild() {
    local only=${1:-} name tmp rc=0
    for name in $(names); do
        [[ -z $only || $only == "$name" ]] || continue
        [[ -e $EXT/$name.raw ]] || continue
        mapfile -t PKGS < <(meta "$name" request); mapfile -t COPRS < <(meta "$name" coprs | grep . || true)
        mapfile -t REPOS < <(meta "$name" repos | grep . || true); mapfile -t UNITS < <(meta "$name" units | grep . || true)
        RPMFUSION=$(meta "$name" rpmfusion); RPMFUSION=${RPMFUSION:-0}
        OVERLAY=$(meta "$name" overlay)
        (( ${#PKGS[@]} )) || { echo "$(t "layer") '$name': $(t "missing package list, cannot rebuild")" >&2; rc=1; continue; }
        ALLOW_UPGRADE=0
        echo "── $(t "Rebuilding layer") '$name' ($(image_version))"
        tmp=$(mktemp -d)
        if ( build_layer "$name" "$tmp/$name.raw"; install_layer "$name" "$tmp/$name.raw" ); then :; else
            echo "$(t "layer") '$name': $(t "could not rebuild; kept previous version")" >&2; rc=1
        fi
        rm -rf "$tmp"
    done
    return $rc
}

cmd_stale() {
    local name
    for name in $(names); do [[ $(state_of "$name") == desatualizada ]] && echo "$name"; done
    return 0
}

cmd_off() {
    compgen -G "$EXT/*.raw" >/dev/null || { tl "No active layers."; return 0; }
    $SUDO install -d -m 755 "$OFF"
    $SUDO sh -c "mv '$EXT'/*.raw '$OFF'/"
    refresh
    echo "$(t "Layers disabled. To re-enable"): tamagi-layer on"
}

cmd_on() {
    compgen -G "$OFF/*.raw" >/dev/null || { tl "No disabled layers."; return 0; }
    $SUDO install -d -m 755 "$EXT"
    $SUDO sh -c "mv '$OFF'/*.raw '$EXT'/"
    refresh
    tl "Layers re-enabled."
}

cmd_temp() {
    tl "/usr is writable until the next reboot; all changes vanish on reboot."
    exec $SUDO bootc usr-overlay
}

case "${1:-}" in
    add)   shift; cmd_add "$@" ;;
    build) shift; cmd_build "$@" ;;
    remove|rm) shift; cmd_remove "$@" ;;
    list|ls)   cmd_list ;;
    rebuild) shift; cmd_rebuild "$@" ;;
    stale)           cmd_stale ;;
    off)    cmd_off ;;
    on)        cmd_on ;;
    temp)            cmd_temp ;;
    boot)            settle ;;   # tamagi-layer-units.service, after systemd-sysext at boot
    -h|--help|help) usage 0 ;;
    *)               usage 2 ;;
esac
