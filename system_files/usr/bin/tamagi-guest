#!/usr/bin/bash
# tamagi-guest — disposable guest session (for lending the computer).
#
# Adds a password-less "Guest" account to the login screen that opens a clean
# desktop. Its home lives in memory (tmpfs) and is rebuilt from scratch at
# every logout and boot: nothing the guest does stays on disk. No sudo, no
# access to your folders, boxes, VMs or personal Flatpaks; it cannot mount
# disks or install anything on the system (polkit rule).
#
#   tamagi guest on | off | status      (asks for the administrator password)
set -euo pipefail
. /usr/libexec/tamagi/i18n

USER_NAME=convidado
UID_GUEST=1990
HOME_DIR=/var/home/$USER_NAME
MOUNT_UNIT=/etc/systemd/system/var-home-convidado.mount
DROPIN=/etc/systemd/system/user-runtime-dir@$UID_GUEST.service.d/tamagi-guest.conf

as_root() { [[ $(id -u) == 0 ]] || exec pkexec "$0" "$@"; }

enable() {
    as_root on
    if ! id "$USER_NAME" >/dev/null 2>&1; then
        getent passwd "$UID_GUEST" >/dev/null && { echo "uid $UID_GUEST ocupado" >&2; exit 1; }
        groupadd -g "$UID_GUEST" "$USER_NAME" 2>/dev/null || true
        useradd -u "$UID_GUEST" -g "$UID_GUEST" -M -d "$HOME_DIR" -s /bin/bash -c "Convidado" "$USER_NAME"
        passwd -d "$USER_NAME" >/dev/null
    fi
    cat > "$MOUNT_UNIT" <<UNIT
# Gerado por tamagi-guest: a pasta do convidado vive na memória.
[Unit]
Description=Pasta pessoal do convidado (na memória)

[Mount]
What=tmpfs
Where=$HOME_DIR
Type=tmpfs
Options=mode=0700,uid=$UID_GUEST,gid=$UID_GUEST,size=25%,nosuid,nodev

[Install]
WantedBy=multi-user.target
UNIT
    mkdir -p "$(dirname "$DROPIN")"
    cat > "$DROPIN" <<UNIT
# Gerado por tamagi-guest: no logout do convidado, a pasta é refeita.
[Service]
ExecStopPost=/usr/libexec/tamagi/guest-reset
UNIT
    mkdir -p "$HOME_DIR"
    systemctl daemon-reload
    systemctl enable --now var-home-convidado.mount
    /usr/libexec/tamagi/guest-reset
    echo "$(t "Guest session on: pick Convidado (Guest) on the login screen (no password).")"
}

disable() {
    as_root off
    loginctl terminate-user "$USER_NAME" 2>/dev/null || true
    systemctl disable --now var-home-convidado.mount 2>/dev/null || true
    rm -f "$MOUNT_UNIT" "$DROPIN"
    rmdir "$(dirname "$DROPIN")" 2>/dev/null || true
    systemctl daemon-reload
    id "$USER_NAME" >/dev/null 2>&1 && userdel "$USER_NAME"
    rmdir "$HOME_DIR" 2>/dev/null || true
    echo "$(t "Guest session off")"
}

case "${1:-status}" in
    on)      enable ;;
    off)  disable ;;
    status)        if id "$USER_NAME" >/dev/null 2>&1; then echo "$(t "Guest session on")"; else echo "$(t "Guest session off")"; fi ;;
    -h|--help) sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//' ;;
    *) echo "usage: tamagi-guest [on|off|status]" >&2; exit 2 ;;
esac
