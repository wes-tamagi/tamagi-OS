#!/usr/bin/bash
# tamagi-boot-report — o boot que se explica.
#
# Depois de cada atualização, o boot-check confere se o sistema subiu direito
# (/usr/lib/tamagi/boot-check). Se uma imagem nova não subiu, o computador tenta
# mais uma vez, põe o digest com falha em quarentena e volta sozinho para a
# imagem anterior (bootc rollback).
#
#   tamagi-boot-report            mostra os relatórios pendentes (e marca como vistos)
#   tamagi-boot-report list       todos os relatórios guardados
#   tamagi-boot-report status     estado da verificação de saúde deste boot
#   tamagi-boot-report notify     (login) avisa se há relatório pendente
set -uo pipefail
# shellcheck source=/dev/null
. /usr/libexec/tamagi/i18n

DIR=${TAMAGI_BOOT_FAILURES:-/var/lib/tamagi/boot-failures}
QUARANTINE=${TAMAGI_QUARANTINE:-/var/lib/tamagi/quarantine.list}
SEEN="${XDG_STATE_HOME:-$HOME/.local/state}/tamagi/boot-failures-seen"
mkdir -p "$(dirname "$SEEN")"; touch "$SEEN"

pending() { # relatórios que este usuário ainda não viu
    local f
    for f in "$DIR"/*.txt; do
        [[ -r $f ]] || continue
        grep -qxF "$(basename "$f")" "$SEEN" || echo "$f"
    done
}

status() {
    local qcount=0
    [[ -r $QUARANTINE ]] && qcount=$(grep -cvE '^(#|[[:space:]]*$)' "$QUARANTINE" 2>/dev/null || echo 0)
    local st=${TAMAGI_BOOTC_STATUS:-/run/tamagi/bootc-status.json} good booted
    good=$(cat /var/lib/tamagi/boot-state/good 2>/dev/null || true)
    booted=$(jq -r '.status.booted.composefs.verity // empty' "$st" 2>/dev/null)
    echo "$(t "Health check") : $(systemctl is-active tamagi-boot-check.service 2>/dev/null || t "unknown")"
    echo "$(t "Boot marked healthy"): $([[ -n $good && $good == "$booted" ]] && echo active || echo inactive)"
    echo "$(t "Running image")        : $(jq -r '.status.booted.image | "\(.version) (\(.timestamp[0:10]))"' "$st" 2>/dev/null)"
    echo "$(t "Previous image")      : $(jq -r '.status.rollback.image | select(. != null) | "\(.version) (\(.timestamp[0:10]))"' "$st" 2>/dev/null | grep . || t "none saved")"
    echo "$(t "Quarantined digests"): $qcount"
    echo "$(t "Failure reports")  : $(find "$DIR" -name '*.txt' 2>/dev/null | wc -l), $(pending | wc -l) $(t "pending")"
}

explain() { # explain <arquivo>: explicação do agente local, se houver modelo
    if command -v tamagi-ai >/dev/null && [[ -n $(tamagi-ai list 2>/dev/null) ]]; then
        echo; echo "── $(t "Local AI agent explanation") ──"
        tamagi-agent "A system update failed the boot health check and automatically rolled back to the previous image. Below is the failure report. Explain simply, in up to six sentences, what broke and what the user can do next. Do not run any commands." < "$1" \
            || tl "(the agent did not respond; see the report above)"
    else
        echo; tl "To get a local AI explanation: tamagi-ai setup"
    fi
}

show() {
    local files f
    mapfile -t files < <(pending)
    if (( ${#files[@]} == 0 )); then
        tl "No pending boot failures."; status; return 0
    fi
    tl "An update failed the boot health check. The system rebooted,"
    tl "retried, and rolled back to the previous image, which is now active."
    echo "$(t "Recorded attempts"): ${#files[@]}"
    echo; echo "════ $(basename "${files[-1]}" .txt) ════"
    sed -n '1,45p' "${files[-1]}"
    for f in "${files[@]}"; do basename "$f" >> "$SEEN"; done
    explain "${files[-1]}"
    echo
    tl "The failing digest was automatically quarantined to prevent re-installation."
    echo "  tamagi-update quarantine   ·   tamagi update auto off"
}

case "${1:-show}" in
    show)   show; [[ -t 0 ]] && read -rsn1 -p "  ($(t "press any key to close"))" ;;
    list)   ls -1 "$DIR"/*.txt 2>/dev/null || tl "No saved reports." ;;
    status) status ;;
    notify) # chamado no login: só incomoda se houver algo novo
        [[ -n $(pending) ]] || exit 0
        sleep 6
        notify-send -a Tamagi -i dialog-warning "$(t "An update failed and was rolled back")" \
            "$(t "The system rolled back to the previous version. See what happened.")" 2>/dev/null || true
        exec /usr/libexec/tamagi/popup tamagi-boot-report show ;;
    *) echo "usage: tamagi-boot-report [show|list|status]" >&2; exit 2 ;;
esac
