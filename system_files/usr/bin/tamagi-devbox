#!/usr/bin/bash
# tamagi-devbox — development boxes (distrobox): Fedora, Ubuntu, openSUSE
# Tumbleweed or Arch.
#
# The host is immutable and carries no compilers or language runtimes: they
# live in the box. Each box comes with compilers (gcc/cmake/ninja), git,
# SQLite, Rust/Cargo, Node.js/npm, Python, the database clients (psql,
# mariadb, valkey/redis-cli — the databases of `tamagi db` answer on
# 127.0.0.1 from inside the box), mise for other languages and versions, and
# opens links in the browser of the host (logins of gh, npm, AI agents).
set -euo pipefail
. /usr/libexec/tamagi/i18n

LIBEXEC="${TAMAGI_DEVBOX_LIBEXEC:-/run/host/usr/libexec/tamagi}"
DISTRO_ORDER=(fedora ubuntu opensuse arch)

declare -A IMAGE=(
    [fedora]="registry.fedoraproject.org/fedora-toolbox:45"
    [ubuntu]="ghcr.io/ublue-os/ubuntu-toolbox:latest"
    [opensuse]="quay.io/toolbx-images/opensuse-toolbox:tumbleweed"
    [arch]="ghcr.io/ublue-os/arch-toolbox:latest"
)
declare -A LABEL=(
    [fedora]="Fedora 45 (default — dnf)"
    [ubuntu]="Ubuntu LTS (apt)"
    [opensuse]="openSUSE Tumbleweed (rolling — zypper)"
    [arch]="Arch Linux (rolling — pacman)"
)
# Language presets for `tamagi devbox lang` (installed by mise inside the box).
declare -A PRESET=(
    [web]="node@lts pnpm@latest" [bun]="bun@latest" [deno]="deno@latest" [python]="python@3.13"
    [ruby]="ruby@latest" [go]="go@latest" [rust]="rust@latest" [java]="java@temurin-25"
    [dotnet]="dotnet@10" [zig]="zig@latest"
)
PRESET_ORDER=(web bun deno python ruby go rust java dotnet zig)

die() { echo "$(t "error"): $*" >&2; exit 1; }
info() { echo -e "\033[1m$*\033[0m"; }
box_exists() { podman container exists "$1" 2>/dev/null; }
valid_name() { [[ ${1:-} =~ ^[a-z][a-z0-9_-]{0,40}$ ]] || die "$(t "invalid name"): ${1:-}"; }
canon() { case "${1:-}" in tumbleweed|opensuse-tumbleweed|suse) echo opensuse ;; archlinux) echo arch ;; *) echo "${1:-}" ;; esac; }
valid_distro() { local d; d=$(canon "${1:-}"); [[ -n $d && -n ${IMAGE[$d]:-} ]]; }
default_box_name() { if [[ $1 == fedora ]]; then echo dev; else echo "dev-$1"; fi; }
is_system_box() { [[ $1 == browsers || $1 == navegadores || $1 == "${TAMAGI_BROWSER_BOX:-browsers}" ]]; }

usage() {
    echo "tamagi-devbox — $(t "development boxes (Fedora, Ubuntu, openSUSE, Arch)")"
    echo
    echo "  tamagi devbox                                   $(t "choose a distro and create the box")"
    echo "  tamagi devbox create [distro] [--name N] [--minimal] [--extra go,zig,clang,browser]"
    echo "  tamagi devbox enter [name|distro]               $(t "enter the box (default: dev)")"
    echo "  tamagi devbox lang [box] <preset|tool@version>… $(t "languages via mise, inside the box")"
    echo "  tamagi devbox browser [box]                     $(t "Chromium in the box for tests (Playwright, Puppeteer)")"
    echo "  tamagi devbox gpu [box]                         $(t "what the box sees of the GPUs (Vulkan, video, OpenCL)")"
    echo "  tamagi devbox provision <name> [--extra …]      $(t "reinstalls the tools")"
    echo "  tamagi devbox distros | list                    $(t "supported distros / boxes created")"
    echo "  tamagi devbox update [name]                     $(t "update packages in box(es)")"
    echo "  tamagi devbox remove <name>                     $(t "remove the box (home files stay)")"
    echo
    echo "$(t "Distros"): ${DISTRO_ORDER[*]}    $(t "Languages"): ${PRESET_ORDER[*]}"
}

cmd_distros() {
    local d
    for d in "${DISTRO_ORDER[@]}"; do
        printf '  %-9s %-50s %s\n' "$d" "${IMAGE[$d]}" "$(t "${LABEL[$d]}")"
    done
}

distro_of() { # distro_of <box>: from the image of an existing box
    local img; img=$(podman inspect --format '{{.ImageName}}' "$1" 2>/dev/null || true)
    case "$img" in
        *arch*)                  echo arch ;;
        *ubuntu*)                echo ubuntu ;;
        *opensuse*|*tumbleweed*) echo opensuse ;;
        *)                       echo fedora ;;
    esac
}

provision() { # provision <box> <distro> <extras>
    distrobox enter "$1" -- sudo "$LIBEXEC/devbox-provision" "$2" "$3"
}

cmd_create() {
    local distro="" name="" minimal=0 extras=""
    while (( $# )); do
        case "$1" in
            --name)    [[ $# -ge 2 ]] || die "$(t "unknown option"): $1"; name=$2; shift ;;
            --minimal) minimal=1 ;;
            --extra)   [[ $# -ge 2 ]] || die "$(t "unknown option"): $1"; extras=$2; shift ;;
            -*) die "$(t "unknown option"): $1" ;;
            *)  [[ -z $distro ]] && distro=$1 || die "$(t "unexpected argument"): $1" ;;
        esac
        shift
    done
    distro=$(canon "${distro:-fedora}")
    valid_distro "$distro" || die "$(t "unknown distro"): '$distro' (${DISTRO_ORDER[*]})"
    name=${name:-$(default_box_name "$distro")}
    valid_name "$name"

    if box_exists "$name"; then
        echo "$(t "Box already exists"): $name — tamagi devbox enter $name"
        return 0
    fi
    info "$(t "Creating development box") '$name' ($distro · ${IMAGE[$distro]})"
    local args=(--yes --name "$name" --image "${IMAGE[$distro]}")
    [[ -e /proc/driver/nvidia/version ]] && args+=(--nvidia)
    distrobox create "${args[@]}"

    if (( ! minimal )); then
        info "$(t "Installing compilers, languages, database clients and mise…")"
        provision "$name" "$distro" "$extras"
    fi
    echo
    echo "$(t "Box ready"): $name"
    echo "$(t "Enter"): tamagi devbox enter $name"
}

cmd_provision() {
    local name=${1:-dev} extras=""
    shift || true
    while (( $# )); do
        case "$1" in
            --extra) [[ $# -ge 2 ]] || die "$(t "unknown option"): $1"; extras=$2; shift ;;
            *) die "$(t "unknown option"): $1" ;;
        esac
        shift
    done
    box_exists "$name" || die "$(t "Box does not exist"): $name"
    info "$(t "Provisioning box") '$name' ($(distro_of "$name"))…"
    provision "$name" "$(distro_of "$name")" "$extras"
}

ensure_default_box() { box_exists dev || cmd_create fedora --name dev; }

cmd_enter() {
    local target=${1:-dev}
    if ! box_exists "$target"; then
        if valid_distro "$target"; then
            local d; d=$(canon "$target")
            target=$(default_box_name "$d")
            box_exists "$target" || cmd_create "$d"
        elif [[ $target == dev ]]; then
            ensure_default_box
        else
            die "$(t "Box does not exist"): $target"
        fi
    fi
    exec distrobox enter "$target"
}

cmd_lang() {
    local box=dev tools=() item
    if [[ -n ${1:-} ]] && box_exists "$1"; then box=$1; shift; fi
    if (( $# == 0 )); then
        if [[ ! -t 0 ]]; then
            for item in "${PRESET_ORDER[@]}"; do printf '  %-7s %s\n' "$item" "${PRESET[$item]}"; done
            return 0
        fi
        mapfile -t picked < <(for item in "${PRESET_ORDER[@]}"; do printf '%-7s %s\n' "$item" "${PRESET[$item]}"; done \
            | /usr/libexec/tamagi/gum-multi --height 12 --header "$(t "Languages (space marks, Enter installs in the box)")" \
            | awk '{print $1}')
        set -- "${picked[@]}"
        (( $# )) || return 0
    fi
    for item in "$@"; do
        if [[ -n ${PRESET[$item]:-} ]]; then
            read -r -a more <<<"${PRESET[$item]}"; tools+=("${more[@]}")
        else
            [[ $item =~ ^[A-Za-z0-9_:@./+-]+$ ]] || die "$(t "invalid tool"): $item"
            tools+=("$item")
        fi
    done
    [[ $box == dev ]] && ensure_default_box
    box_exists "$box" || die "$(t "Box does not exist"): $box"
    info "mise use -g ${tools[*]}   ($(t "box") $box)"
    distrobox enter "$box" -- mise use -g "${tools[@]}"
}

cmd_browser() {
    local box=${1:-dev}
    [[ $box == dev ]] && ensure_default_box
    box_exists "$box" || die "$(t "Box does not exist"): $box"
    provision "$box" "$(distro_of "$box")" "browser,only"
    echo "$(t "Chromium installed in the box. Playwright and Puppeteer find it through CHROME_BIN.")"
}

cmd_gpu() {
    local box=${1:-dev}
    box_exists "$box" || die "$(t "Box does not exist"): $box"
    # shellcheck disable=SC2016
    distrobox enter "$box" -- sh -c '
        echo "DRM devices : $(ls /dev/dri 2>/dev/null | tr "\n" " ")$([ -e /dev/kfd ] && echo "+ /dev/kfd")"
        vk=$(vulkaninfo --summary 2>/dev/null | sed -n "s/^[[:space:]]*deviceName[[:space:]]*= //p" | grep -vi llvmpipe | paste -sd, -)
        echo "Vulkan      : ${vk:--}"
        va=$(vainfo 2>/dev/null | sed -n "s/.*Driver version: //p" | head -1)
        echo "VA-API      : ${va:--}"
        cl=$(clinfo -l 2>/dev/null | sed -n "s/.*Device #[0-9]*: //p" | paste -sd, -)
        echo "OpenCL      : ${cl:--}"
        command -v nvidia-smi >/dev/null 2>&1 && echo "NVIDIA      : $(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | paste -sd, -)"
        true'
}

each_box() { # names of the development boxes
    local name
    while read -r name; do
        [[ -n $name ]] || continue
        is_system_box "$name" || echo "$name"
    done < <(podman ps -a --filter label=manager=distrobox --format '{{.Names}}' 2>/dev/null || true)
}

cmd_list() {
    local found=0 name
    while read -r name; do
        found=1
        printf '  %-18s %-10s %s\n' "$name" "$(distro_of "$name")" "$(podman inspect --format '{{.State.Status}}' "$name" 2>/dev/null)"
    done < <(each_box)
    (( found )) || echo "$(t "No development box created yet. Create one with"): tamagi devbox create"
}

cmd_update() {
    local target=${1:-} name
    if [[ -n $target ]]; then
        box_exists "$target" || die "$(t "Box does not exist"): $target"
        distrobox upgrade "$target"
        return 0
    fi
    while read -r name; do
        info "$(t "Updating box"): $name"
        distrobox upgrade "$name" || true
    done < <(each_box)
}

cmd_remove() {
    local name=${1:-}
    [[ -n $name ]] || die "usage: tamagi devbox remove <name>"
    box_exists "$name" || die "$(t "Box does not exist"): $name"
    if [[ -t 0 ]]; then
        gum confirm "$(t "Delete this box? Files in your home folder stay.") ($name)" \
            --affirmative "$(t "Yes")" --negative "$(t "No")" || exit 0
    fi
    distrobox rm --force "$name"
    echo "$(t "Box removed"): $name"
}

pick_interactive() {
    if [[ ! -t 0 ]]; then cmd_distros; return 0; fi
    local choice
    choice=$(for d in "${DISTRO_ORDER[@]}"; do printf '%-9s  %s\n' "$d" "$(t "${LABEL[$d]}")"; done \
        | gum choose --height 8 --header "$(t "Choose development box distro (default: fedora)")") || exit 0
    cmd_create "$(awk '{print $1}' <<<"$choice")"
}

case "${1:-}" in
    "")             pick_interactive ;;
    create)         shift; cmd_create "$@" ;;
    enter)          shift; cmd_enter "$@" ;;
    lang)           shift; cmd_lang "$@" ;;
    browser)        shift; cmd_browser "$@" ;;
    gpu)            shift; cmd_gpu "$@" ;;
    provision)      shift; cmd_provision "$@" ;;
    distros)        cmd_distros ;;
    list|status)    cmd_list ;;
    update)         shift; cmd_update "$@" ;;
    remove|rm)      shift; cmd_remove "$@" ;;
    -h|--help|help) usage ;;
    *)
        if valid_distro "$1"; then
            cmd_create "$@"
        else
            usage >&2; exit 2
        fi ;;
esac
