#!/usr/bin/bash
# tamagi-browser — navegadores numa caixa Fedora (distrobox), fora do host.
set -euo pipefail
. /usr/libexec/tamagi/i18n

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/tamagi"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}"
BOX="${TAMAGI_BROWSER_BOX:-navegadores}"
IMAGE="${TAMAGI_BROWSER_IMAGE:-registry.fedoraproject.org/fedora-toolbox:45}"
LIBEXEC="${TAMAGI_BROWSER_LIBEXEC:-/run/host/usr/libexec/tamagi}"
BOX_HOME="${TAMAGI_BROWSER_HOME:-}"
READY="$CONF_DIR/browser-$BOX.ready"
FLAGS_FILE="$CONF_DIR/browser-flags.conf"

declare -A BIN=([chrome]=google-chrome-stable [firefox]=firefox [brave]=brave-browser
                [edge]=microsoft-edge-stable [vivaldi]=vivaldi-stable)
declare -A APP=([chrome]=google-chrome [firefox]=firefox [brave]=brave-browser
                [edge]=microsoft-edge [vivaldi]=vivaldi-stable)

die() { echo "$(t "erro"): $*" >&2; exit 1; }
info() { echo -e "\033[1m$*\033[0m"; }
box_exists() { podman container exists "$BOX" 2>/dev/null; }
in_box() { distrobox enter "$BOX" -- "$@"; }
installed() { in_box sh -c 'command -v "$1" >/dev/null' _ "${BIN[$1]}" 2>/dev/null; }
has_gpu() { grep -qsi "^$1\$" /sys/class/drm/card*/device/vendor; }

usage() {
    echo "tamagi-browser — $(t "navegadores na caixa Fedora (distrobox)")"
    echo
    echo "  tamagi-browser [URL|opções]           $(t "abre o navegador padrão")"
    echo "  tamagi-browser chrome [URL|opções]    $(t "abre um navegador específico (chrome, firefox, brave, edge, vivaldi)")"
    echo "  tamagi-browser chrome --profile <n>   $(t "abre num perfil isolado (cria se não existir)")"
    echo "  profile add <nome> [navegador]        $(t "cria o perfil e um atalho no menu")"
    echo "  profile list | remove <nome> [nav]"
    echo "  fido                                  $(t "diagnóstico da chave de segurança USB (FIDO2)")"
    echo "  setup                                 $(t "cria a caixa e instala o Chrome")"
    echo "  install <navegador>                   chrome | firefox | brave | edge | vivaldi"
    echo "  default <navegador>                   $(t "define o navegador padrão do sistema")"
    echo "  status                                $(t "caixa, navegadores e aceleração de vídeo")"
    echo "  update                                $(t "atualiza a caixa e os navegadores")"
    echo "  enter                                 $(t "abre um shell na caixa")"
    echo "  remove                                $(t "apaga a caixa (perfis e downloads ficam)")"
}

chromium_flags() { # aceleração de vídeo e GPU sem as travas padrão do Linux
    if [[ -f $FLAGS_FILE ]]; then
        sed -e 's/#.*//' -e 's/[[:space:]]*$//' "$FLAGS_FILE" | grep -v '^$' || true
        return
    fi
    local features=AcceleratedVideoDecodeLinuxGL,AcceleratedVideoDecodeLinuxZeroCopyGL,AcceleratedVideoEncoder,VaapiIgnoreDriverChecks
    [[ -e /proc/driver/nvidia/version ]] && features+=,VaapiOnNvidiaGPUs
    printf '%s\n' "--enable-features=$features" --ignore-gpu-blocklist \
        --enable-gpu-rasterization --enable-zero-copy
}

box_env() { # variáveis de ambiente para o navegador dentro da caixa
    if [[ -e /proc/driver/nvidia/version ]] && ! has_gpu 0x8086 && ! has_gpu 0x1002; then
        printf '%s\n' LIBVA_DRIVER_NAME=nvidia NVD_BACKEND=direct
    fi
    printf '%s\n' MOZ_ENABLE_WAYLAND=1
}

default_browser() {
    local name
    name=$(cat "$CONF_DIR/browser-default" 2>/dev/null || true)
    if [[ -n $name && -n ${BIN[$name]:-} ]]; then echo "$name"; else echo chrome; fi
}

integrate() { # põe o navegador no menu do host
    local name=$1 flags
    [[ -n $BOX_HOME ]] && return 0
    if [[ $name == chrome ]]; then
        in_box sh -c 'for s in 16 24 32 48 64 128 256; do
                          f=/opt/google/chrome/product_logo_$s.png
                          [ -f "$f" ] && install -Dm644 "$f" "$1/icons/hicolor/${s}x${s}/apps/google-chrome.png"
                      done; true' _ "$DATA_DIR"
        mkdir -p "$DATA_DIR/applications"
        sed 's/^Icon=tamagi-browser$/Icon=google-chrome/' /usr/share/applications/google-chrome.desktop \
            > "$DATA_DIR/applications/google-chrome.desktop"
        update-desktop-database "$DATA_DIR/applications" 2>/dev/null || true
        return 0
    fi
    flags=""
    [[ $name != firefox ]] && flags=$(chromium_flags | tr '\n' ' ')
    in_box distrobox-export --app "${APP[$name]}" ${flags:+--extra-flags "$flags"} >/dev/null \
        && echo "$(t "No menu"): ${APP[$name]} ($(t "caixa") $BOX)"
}

cmd_install() {
    local name=${1:-}
    [[ -n $name && -n ${BIN[$name]:-} ]] || die "$(t "navegador desconhecido"): '$name' (${!BIN[*]})"
    ensure_box
    info "$(t "Instalando") $name ($(t "caixa") $BOX)"
    in_box sudo "$LIBEXEC/browser-provision" install "$name"
    integrate "$name"
}

ensure_box() {
    box_exists && return 0
    info "$(t "Criando a caixa de navegadores") '$BOX' ($IMAGE)"
    local args=(--yes --name "$BOX" --image "$IMAGE")
    [[ -e /proc/driver/nvidia/version ]] && args+=(--nvidia)
    [[ -n $BOX_HOME ]] && args+=(--home "$BOX_HOME")
    distrobox create "${args[@]}"
    info "$(t "Preparando vídeo por hardware, fontes e idioma")"
    in_box sudo "$LIBEXEC/browser-provision" base
}

cmd_setup() {
    ensure_box
    installed chrome || cmd_install chrome
    mkdir -p "$CONF_DIR"
    touch "$READY"
    info "$(t "Navegador pronto. Estado da aceleração"): tamagi-browser status"
}

ready() { [[ -f $READY ]] && box_exists; }

launch() {
    local name=$1 safe=0 profile=""; shift
    while :; do
        case "${1:-}" in
            --safe) safe=1; shift ;;
            --perfil|--profile) profile=${2:-}; valid_profile "$profile"; shift 2 ;;
            --perfil=*|--profile=*) profile=${1#*=}; valid_profile "$profile"; shift ;;
            *) break ;;
        esac
    done
    local -a flags=() env=()
    if ! ready; then
        if [[ -t 0 && -t 1 ]]; then
            cmd_setup
        else
            exec /usr/libexec/tamagi/popup "$0" --setup-then-run "$name" "$@"
        fi
    fi
    [[ $name == chrome ]] || installed "$name" || die "$name $(t "não está instalado"). tamagi-browser install $name"
    if [[ $name != firefox && $safe == 0 ]]; then mapfile -t flags < <(chromium_flags); fi
    mapfile -t env < <(box_env)
    if [[ -n $profile ]]; then
        local dir; dir=$(profile_dir "$name" "$profile")
        mkdir -p "$dir"
        if [[ $name == firefox ]]; then
            flags+=(--new-instance --profile "$dir" --name "tamagi-$name-$profile")
        else
            flags+=("--user-data-dir=$dir" "--class=tamagi-$name-$profile")
        fi
    fi
    exec distrobox enter "$BOX" -- env "${env[@]}" "${BIN[$name]}" "${flags[@]}" "$@"
}

# ── Perfis isolados ─────────────────────────────────────────────────────────
PROFILES_DIR="$DATA_DIR/tamagi/browser-profiles"
valid_profile() { [[ ${1:-} =~ ^[a-z][a-z0-9-]{0,30}$ ]] || die "$(t "nome de perfil inválido"): '${1:-}'"; }
profile_dir() { echo "$PROFILES_DIR/$1-$2"; }
profile_desktop() { echo "$DATA_DIR/applications/tamagi-$1-$2.desktop"; }

cmd_profile() {
    local action=${1:-list} profile=${2:-} name=${3:-chrome} d
    case "$action" in
        list|lista)
            local found=0
            for d in "$PROFILES_DIR"/*/; do
                [[ -d $d ]] || continue
                found=1; d=$(basename "$d")
                printf '%-10s %s\n' "${d%%-*}" "${d#*-}"
            done
            (( found )) || echo "$(t "Nenhum perfil. Crie com"): tamagi-browser profile add trabalho"
            ;;
        add|criar)
            valid_profile "$profile"
            [[ -n ${BIN[$name]:-} ]] || die "$(t "navegador desconhecido"): '$name' (${!BIN[*]})"
            mkdir -p "$(profile_dir "$name" "$profile")" "$DATA_DIR/applications"
            local icon=tamagi-browser
            [[ $name == chrome && -f $DATA_DIR/icons/hicolor/128x128/apps/google-chrome.png ]] && icon=google-chrome
            cat > "$(profile_desktop "$name" "$profile")" <<DESKTOP
[Desktop Entry]
Type=Application
Name=${name^} ($profile)
Comment=Isolated profile "$profile": separate logins, cookies and extensions
Comment[pt_BR]=Perfil isolado "$profile": logins, cookies e extensões separados
Comment[pt]=Perfil isolado "$profile": logins, cookies e extensões separados
Exec=/usr/bin/tamagi-browser $name --perfil $profile %U
Icon=$icon
Terminal=false
Categories=Network;WebBrowser;
StartupWMClass=tamagi-$name-$profile
X-Tamagi-Browser-Profile=$profile
DESKTOP
            update-desktop-database "$DATA_DIR/applications" 2>/dev/null || true
            echo "$(t "Perfil criado"): '$profile' ($name). $(t "No menu"): ${name^} ($profile)"
            ;;
        remove|remover)
            valid_profile "$profile"
            d=$(profile_dir "$name" "$profile")
            [[ -d $d || -f $(profile_desktop "$name" "$profile") ]] || die "$(t "não existe o perfil") '$profile' ($name)"
            if [[ -t 0 ]]; then
                read -r -p "$(t "Apagar o perfil, com logins, histórico e extensões?") ($name/$profile) [s/y/N] " answer
                [[ ${answer,,} =~ ^(s|sim|y|yes|o|oui)$ ]] || { echo "$(t "Nada foi alterado.")"; exit 1; }
            else
                die "$(t "rode num terminal para confirmar a remoção do perfil")"
            fi
            rm -rf -- "$d" "$(profile_desktop "$name" "$profile")"
            update-desktop-database "$DATA_DIR/applications" 2>/dev/null || true
            echo "$(t "Perfil apagado.") ($profile)"
            ;;
        *) die "$(t "uso"): tamagi-browser profile [list | add <nome> [navegador] | remove <nome> [navegador]]" ;;
    esac
}

cmd_fido() {
    local n dev found=0 props acl
    echo "$(t "Chaves de segurança vistas pelo sistema"):"
    for dev in /dev/hidraw*; do
        [[ -e $dev ]] || continue
        props=$(udevadm info -q property "$dev" 2>/dev/null)
        grep -qE '^ID_(FIDO|SECURITY)_TOKEN=1' <<<"$props" || continue
        found=1; n=$(basename "$dev")
        acl=$(t "não"); [[ -r $dev && -w $dev ]] && acl=$(t "sim")
        echo "  $dev  $(sed -n 's/^HID_NAME=//p' "/sys/class/hidraw/$n/device/uevent" 2>/dev/null)"
        echo "    $(t "liberada para você no sistema") : $acl"
        if box_exists; then
            # shellcheck disable=SC2016
            if in_box sh -c 'exec 3<>"$1"' _ "$dev" 2>/dev/null; then
                echo "    $(t "abre de dentro da caixa") $BOX : $(t "sim")"
            else
                echo "    $(t "abre de dentro da caixa") $BOX : $(t "NÃO")"
            fi
        fi
    done
    if (( ! found )); then
        echo "  $(t "nenhuma. Conecte a chave e rode de novo.")"
        for dev in /sys/class/hidraw/hidraw*; do
            [[ -e $dev ]] && echo "    $(basename "$dev")  $(sed -n 's/^HID_NAME=//p' "$dev/device/uevent" 2>/dev/null)"
        done
        return 1
    fi
    box_exists || { echo "$(t "A caixa ainda não existe"): $BOX (tamagi-browser setup)"; return 0; }
    tl "Conecte a chave ANTES de abrir o navegador."
}

cmd_default() {
    local name=${1:-} desktop
    [[ -n $name && -n ${BIN[$name]:-} ]] || die "$(t "uso"): tamagi-browser default <${!BIN[*]}>"
    ready && installed "$name" || die "$name $(t "não está instalado"). tamagi-browser install $name"
    if [[ $name == chrome ]]; then desktop=google-chrome.desktop; else desktop="$BOX-${APP[$name]}.desktop"; fi
    [[ $name == chrome || -f $DATA_DIR/applications/$desktop ]] || integrate "$name"
    mkdir -p "$CONF_DIR"
    echo "$name" > "$CONF_DIR/browser-default"
    xdg-settings set default-web-browser "$desktop"
    echo "$(t "Navegador padrão"): $name"
}

cmd_status() {
    if ! box_exists; then
        echo "$(t "Caixa") '$BOX': $(t "ainda não criada"). tamagi-browser setup"
        return 0
    fi
    echo "$(t "Caixa")        : $BOX ($(podman inspect --format '{{.ImageName}}' "$BOX" 2>/dev/null))"
    echo "$(t "Padrão")       : $(default_browser)"
    # shellcheck disable=SC2016
    in_box sh -c '
        . /etc/os-release; echo "OS           : $PRETTY_NAME"
        for b in google-chrome-stable firefox brave-browser microsoft-edge-stable vivaldi-stable; do
            command -v "$b" >/dev/null 2>&1 && echo "Browser      : $("$b" --version 2>/dev/null | head -1)"
        done
        va=$(vainfo 2>/dev/null)
        if [ -n "$va" ]; then
            echo "VA-API       : $(echo "$va" | sed -n "s/.*Driver version: //p" | head -1)"
            echo "  decode     : $(echo "$va" | awk "/VAEntrypointVLD/ {sub(/VAProfile/,\"\",\$1); sub(/:/,\"\",\$1); print \$1}" | sed -E "s/(ConstrainedBaseline|Main10|Main|High|Profile[0-9]|Baseline|Simple|Advanced)\$//" | sort -u | tr "\n" " ")"
            echo "  encode     : $(echo "$va" | awk "/VAEntrypointEncSlice/ {sub(/VAProfile/,\"\",\$1); sub(/:/,\"\",\$1); print \$1}" | sed -E "s/(ConstrainedBaseline|Main10|Main|High|Profile[0-9]|Baseline|Simple|Advanced)\$//" | sort -u | tr "\n" " ")"
        else
            echo "VA-API       : software"
        fi
        vk=$(vulkaninfo --summary 2>/dev/null | sed -n "s/^[[:space:]]*deviceName[[:space:]]*= //p" | grep -vi llvmpipe | head -1)
        echo "Vulkan       : ${vk:--}"
    '
    echo "$(t "Opções")       : $([[ -f $FLAGS_FILE ]] && echo "$FLAGS_FILE" || t "padrão (aceleração de vídeo ligada)")"
    echo "$(t "Perfis")       : $(cmd_profile list | awk 'NF == 2 { printf "%s(%s) ", $2, $1; n++ } END { if (!n) printf "-" }')"
}

cmd_remove() {
    box_exists || { echo "$(t "A caixa não existe"): $BOX"; return 0; }
    if [[ -t 0 ]]; then
        read -r -p "$(t "Apagar a caixa e os navegadores dela? Perfis e downloads ficam.") ($BOX) [s/y/N] " answer
        [[ ${answer,,} =~ ^(s|sim|y|yes|o|oui)$ ]] || { echo "$(t "Nada foi alterado.")"; exit 1; }
    fi
    distrobox rm --force "$BOX"
    rm -f -- "$READY"
    if [[ -z $BOX_HOME && -d $DATA_DIR/applications ]]; then
        find "$DATA_DIR/applications" -maxdepth 1 \( -name "$BOX-*.desktop" -o -name google-chrome.desktop \) -delete
    fi
    echo "$(t "Caixa apagada. Para recriar"): tamagi-browser setup"
}

case "${1:-}" in
    setup)           cmd_setup ;;
    install|instalar) shift; cmd_install "$@"; mkdir -p "$CONF_DIR"; touch "$READY" ;;
    default|padrao)  shift; cmd_default "$@" ;;
    status|estado)   cmd_status ;;
    profile|perfil)  shift; cmd_profile "$@" ;;
    fido)            cmd_fido ;;
    update|atualizar) box_exists || die "$(t "A caixa não existe"): $BOX"
                     in_box sudo "$LIBEXEC/browser-provision" upgrade ;;
    enter|entrar)    ensure_box; exec distrobox enter "$BOX" ;;
    remove|remover)  cmd_remove ;;
    help|-h|--help|ajuda) usage ;;
    --setup-then-run)
        shift; name=$1; shift
        if cmd_setup; then
            setsid -f "$0" "$name" "$@" >/dev/null 2>&1
            sleep 1
        else
            echo; read -rsn1 -p "$(t "Não consegui preparar o navegador (sem rede?). Qualquer tecla fecha.")"
            exit 1
        fi ;;
    chrome|firefox|brave|edge|vivaldi) name=$1; shift; launch "$name" "$@" ;;
    *)       launch "$(default_browser)" "$@" ;;
esac
