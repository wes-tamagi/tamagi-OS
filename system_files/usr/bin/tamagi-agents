#!/usr/bin/bash
# tamagi-agents — AI coding agents, installed on demand in your user.
#
# None ships in the image: they are third-party software, downloaded from the
# vendor on your machine when you choose them.
#
#   tamagi agents                    choose from a list
#   tamagi agents list               what exists and what is installed
#   tamagi agents install <name>…    claude antigravity codex clio qwen opencode gemini openclaw local
#   tamagi agents remove <name>
#   tamagi agents update             updates the installed ones
#   tamagi agents run <name> [args]  runs the agent JAILED in the current project
#   tamagi agents jail [-- command]  a shell in the same jail (see what the agent sees)
#
# The jail (bubblewrap, inside the development box when there is one, so the
# agent has compilers and Node): the agent sees the project folder and its own
# settings, and nothing else of your home — no SSH or GPG keys, no tokens, no
# browser profiles, no other projects. The system is read-only; the network
# stays on (the agent talks to its API) unless --offline. Before it starts,
# the state of the project is saved: a snapshot of the home folder (when
# snapshots are on) and a git reference, so `tamagi rewind` and
# `git diff refs/tamagi/before-agent/<time>` show and undo what it did.
#   options of run/jail:  --offline   --db (snapshot the running databases too)
#                         --no-snapshot   --host (do not use the development box)
#
# How each one is installed:
#   claude       Anthropic's installer, checksum verified, in ~/.local/bin
#   codex        official binary from GitHub, digest verified, in ~/.local/bin
#   opencode     official binary from GitHub, digest verified, in ~/.local/bin
#   clio         CLIO (pure Perl, GPL-3.0): release from GitHub, digest verified,
#                unpacked in your user; runs in the development box (the host
#                has only a minimal Perl) and talks to the local model (llama.cpp)
#   antigravity  Google's IDE, in the browser box (with the Chrome its agent drives)
#   qwen, gemini, openclaw   npm packages: they live in the development box
#                (`tamagi devbox`), where Node, git and the compilers are; a
#                launcher in ~/.local/bin opens them from anywhere
#   local        the Tamagi agent with a local model (llama.cpp): tamagi ai setup
set -euo pipefail
. /usr/libexec/tamagi/i18n

BIN_DIR="$HOME/.local/bin"
PREFIX="${XDG_DATA_HOME:-$HOME/.local/share}/tamagi/agents"   # npm prefix, used from the dev box
BOX="${TAMAGI_AGENTS_BOX:-dev}"
ORDER=(claude antigravity codex clio qwen opencode gemini openclaw local)
declare -A TITLE=(
    [claude]="Claude Code — Anthropic" [antigravity]="Antigravity — Google (IDE)" [codex]="Codex CLI — OpenAI"
    [clio]="CLIO — pure Perl, local models" [qwen]="Qwen Code — Alibaba" [opencode]="opencode — open source" [gemini]="Gemini CLI — Google"
    [openclaw]="OpenClaw — open source" [local]="Tamagi agent + local model (llama.cpp)"
)
declare -A NPM=([qwen]="@qwen-code/qwen-code" [gemini]="@google/gemini-cli" [openclaw]="openclaw")
declare -A GH_REPO=([codex]="openai/codex" [opencode]="anomalyco/opencode" [clio]="SyntheticAutonomicMind/CLIO")
CLIO_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/tamagi/clio"      # CLIO is a tree of Perl files, not one binary
declare -A GH_ASSET=([codex]='^codex-x86_64-unknown-linux-musl\.tar\.gz$' [opencode]='^opencode-linux-x64-baseline\.tar\.gz$'
                     [clio]='^clio-[0-9.]+\.tar\.gz$')

die() { echo "$(t "error"): $*" >&2; exit 1; }
# Agents that run in the development box: npm packages (Node is there) and
# CLIO (needs the complete Perl, which the immutable host does not carry).
needs_box() { [[ -n ${NPM[$1]:-} || $1 == clio ]]; }
ensure_box() { podman container exists "$BOX" 2>/dev/null || tamagi-devbox create fedora --name "$BOX"; }
write_launcher() { # write_launcher <name> <program inside the home>: works from the host and from any box
    mkdir -p "$BIN_DIR"
    rm -f "$BIN_DIR/$1"
    cat > "$BIN_DIR/$1" <<SH
#!/bin/sh
# Generated by tamagi-agents: $1 runs in the development box "$BOX".
BIN="$2"
if [ -e /run/.containerenv ] || [ -n "\${CONTAINER_ID:-}" ]; then exec "\$BIN" "\$@"; fi
exec distrobox enter $BOX -- "\$BIN" "\$@"
SH
    chmod +x "$BIN_DIR/$1"
}
DOWNLOAD_TMP=""    # download folder of install_github, removed also when it fails
trap 'if [[ -n $DOWNLOAD_TMP ]]; then rm -rf -- "${DOWNLOAD_TMP:?}"; fi' EXIT
info() { echo -e "\033[1m$*\033[0m"; }
canon() { case "${1:-}" in claude-code) echo claude ;; qwen-code) echo qwen ;; gemini-cli) echo gemini ;; claw|claws) echo openclaw ;; agy) echo antigravity ;; *) echo "${1:-}" ;; esac; }
known() { [[ -n ${1:-} && -n ${TITLE[$1]:-} ]]; }

is_installed() {
    case $1 in
        claude)      [[ -x $BIN_DIR/claude ]] ;;
        antigravity) compgen -G "${XDG_DATA_HOME:-$HOME/.local/share}/applications/*antigravity*.desktop" >/dev/null ;;
        codex|opencode) [[ -x $BIN_DIR/$1 ]] ;;
        clio)        [[ -x $CLIO_DIR/clio && -e $BIN_DIR/clio ]] ;;
        qwen|gemini|openclaw) [[ -x $BIN_DIR/$1 && -e $PREFIX/bin/$1 ]] ;;
        local)       compgen -G "${XDG_DATA_HOME:-$HOME/.local/share}/tamagi/models/*.gguf" >/dev/null \
                         || compgen -G "$HOME/.cache/llama.cpp/*.gguf" >/dev/null ;;
    esac
}

# Official binary from the latest GitHub release, verified against the SHA-256
# digest that GitHub publishes for the asset.
install_github() {
    local name=$1 json url digest tmp bin
    tmp=$(mktemp -d); DOWNLOAD_TMP=$tmp
    json=$(curl -fsSL -H "Accept: application/vnd.github+json" "https://api.github.com/repos/${GH_REPO[$name]}/releases/latest")
    url=$(jq -r --arg re "${GH_ASSET[$name]}" '.assets[] | select(.name | test($re)) | .browser_download_url' <<<"$json" | head -1)
    digest=$(jq -r --arg re "${GH_ASSET[$name]}" '.assets[] | select(.name | test($re)) | .digest // ""' <<<"$json" | head -1)
    [[ -n $url ]] || die "$name: $(t "could not find the binary in the latest release")"
    [[ $digest =~ ^sha256:[0-9a-f]{64}$ ]] || die "$name: $(t "the release does not carry the SHA-256 digest; nothing was installed")"
    curl -fL --progress-bar -o "$tmp/pkg.tar.gz" "$url"
    echo "${digest#sha256:}  $tmp/pkg.tar.gz" | sha256sum -c --quiet - || die "$name: $(t "the downloaded file does not match the published digest")"
    mkdir "$tmp/x"; tar -xzf "$tmp/pkg.tar.gz" -C "$tmp/x"
    if [[ $name == clio ]]; then
        # The whole tree goes to the user's data folder; the launcher is a link
        # (CLIO finds its library next to the real file).
        bin=$(find "$tmp/x" -maxdepth 2 -type f -name clio | head -1)
        [[ -n $bin ]] || die "$name: $(t "the package has no executable")"
        mkdir -p "$(dirname "$CLIO_DIR")"
        [[ -d $CLIO_DIR ]] && mv "$CLIO_DIR" "$tmp/old"
        mv "$(dirname "$bin")" "$CLIO_DIR"
        ensure_box
        distrobox enter "$BOX" -- perl -MFindBin -e1 2>/dev/null \
            || echo "$name: $(t "the box has no complete Perl; run"): tamagi devbox provision $BOX" >&2
        write_launcher clio "$CLIO_DIR/clio"
    else
        bin=$(find "$tmp/x" -type f -perm -u+x | head -1)
        [[ -n $bin ]] || die "$name: $(t "the package has no executable")"
        install -Dm755 "$bin" "$BIN_DIR/$name"
    fi
    rm -rf -- "${tmp:?}"; DOWNLOAD_TMP=""
    echo "$name: $("$BIN_DIR/$name" --version 2>/dev/null | head -1)"
}

# npm agents live in the development box; the launcher works from the host
# and from inside any box.
install_npm() {
    local name=$1
    ensure_box
    info "npm install -g ${NPM[$name]}   ($(t "box") $BOX)"
    distrobox enter "$BOX" -- npm install -g --prefix "$PREFIX" "${NPM[$name]}"
    [[ -e $PREFIX/bin/$name ]] || die "$name: $(t "npm did not create the executable")"
    write_launcher "$name" "$PREFIX/bin/$name"
}

install_one() {
    local name; name=$(canon "$1")
    known "$name" || die "$(t "unknown agent"): $1 (${ORDER[*]})"
    info "── ${TITLE[$name]}"
    case $name in
        claude)      claude --version </dev/null ;;
        antigravity) tamagi-antigravity install ;;
        codex|opencode|clio) install_github "$name" ;;
        qwen|gemini|openclaw) install_npm "$name" ;;
        local)       tamagi-ai setup ;;
    esac
}

remove_one() {
    local name; name=$(canon "$1")
    known "$name" || die "$(t "unknown agent"): $1"
    case $name in
        claude)      rm -f "$BIN_DIR/claude"; rm -rf "${XDG_DATA_HOME:-$HOME/.local/share}/claude" ;;
        antigravity) tamagi-antigravity remove ;;
        codex|opencode) rm -f "$BIN_DIR/$name" ;;
        clio)        rm -f "$BIN_DIR/clio"; [[ -d $CLIO_DIR ]] && rm -rf -- "${CLIO_DIR:?}" ;;
        qwen|gemini|openclaw)
            podman container exists "$BOX" 2>/dev/null \
                && distrobox enter "$BOX" -- npm uninstall -g --prefix "$PREFIX" "${NPM[$name]}" || true
            rm -f "$BIN_DIR/$name" ;;
        local)       echo "$(t "Local models are deleted with"): tamagi ai rm <model>"; return 0 ;;
    esac
    echo "$(t "Removed"): $name"
}

# ── The jail ───────────────────────────────────────────────────────────────
# What each agent keeps in the home folder (settings, login, history).
declare -A STATE=(
    [claude]=".claude" [codex]=".codex" [clio]=".clio" [qwen]=".qwen" [gemini]=".gemini" [openclaw]=".openclaw"
    [opencode]=".config/opencode .local/share/opencode .local/state/opencode .cache/opencode"
    [antigravity]="" [local]=""
)

project_root() { # the git repository around the current folder, or the folder itself
    local root
    root=$(git rev-parse --show-toplevel 2>/dev/null) || root=$PWD
    root=$(realpath "$root")
    [[ $root != "$(realpath "$HOME")" && $root != / && $root != /var/home && $root != /home ]] \
        || die "$(t "enter a project folder: the jail cannot be the whole home folder")"
    echo "$root"
}

save_point() { # save_point <project> <label> <db?>: what `rewind` and git can bring back
    local root=$1 label=$2 db=$3 stamp ref name
    stamp=$(date +%Y%m%d-%H%M%S)
    if git -C "$root" rev-parse --git-dir >/dev/null 2>&1; then
        ref=$(git -C "$root" stash create "tamagi: before $label" 2>/dev/null || true)
        [[ -n $ref ]] || ref=$(git -C "$root" rev-parse -q --verify HEAD 2>/dev/null || true)
        if [[ -n $ref ]]; then
            git -C "$root" update-ref "refs/tamagi/before-agent/$stamp" "$ref"
            echo "$(t "Save point (git)"): git diff refs/tamagi/before-agent/$stamp"
        fi
    fi
    if [[ -d $HOME/.snapshots ]] && command -v tamagi-snap >/dev/null 2>&1; then
        tamagi-snap now "before $label in $(basename "$root")" >/dev/null 2>&1 \
            && echo "$(t "Save point (files)"): tamagi rewind"
    fi
    if (( db )); then
        for name in postgres mysql mariadb redis valkey mongo; do
            [[ $(podman container inspect -f '{{.State.Running}}' "tamagi-db-$name" 2>/dev/null) == true ]] || continue
            tamagi-db snapshot "$name" "before-$label-$stamp" || true
        done
    fi
}

# jail_args <project> <offline> <agent|"">: the bubblewrap options, one per line
jail_args() {
    local root=$1 offline=$2 agent=$3 home rel d
    home=$(realpath "$HOME")
    printf '%s\n' --die-with-parent --unshare-pid --unshare-ipc --ro-bind / / --dev /dev --proc /proc --tmpfs /tmp
    # Nothing of the home, of the session (D-Bus, sockets) or of the host seen
    # from inside a box; then the project and what the agent itself needs.
    # (every place where personal files live is emptied: all the homes,
    # removable and mounted disks)
    for d in /var/home /home /root /var/roothome /run/media /media /mnt; do
        [[ -d $d && ! -L $d ]] && printf '%s\n' --tmpfs "$d"
    done
    case $home in
        /var/home/*|/home/*) printf '%s\n' --dir "$home" ;;
        *)                   printf '%s\n' --tmpfs "$home" ;;
    esac
    printf '%s\n' --tmpfs "/run/user/$(id -u)"
    [[ -d /run/host && ! -L /run/host ]] && printf '%s\n' --tmpfs /run/host
    printf '%s\n' --bind "$root" "$root"
    for rel in .local/bin .local/share/claude .local/share/tamagi/agents .local/share/tamagi/clio .config/mise .gitconfig; do
        [[ -e $home/$rel ]] && printf '%s\n' --ro-bind "$home/$rel" "$home/$rel"
    done
    for d in "$home"/.local/share/mise-*; do
        [[ -d $d ]] && printf '%s\n' --ro-bind "$d" "$d"
    done
    if [[ -n $agent ]]; then
        for rel in ${STATE[$agent]}; do
            mkdir -p "$home/$rel"
            printf '%s\n' --bind "$home/$rel" "$home/$rel"
        done
    fi
    (( offline )) && printf '%s\n' --unshare-net
    printf '%s\n' --setenv HOME "$home" --setenv TAMAGI_AGENT_JAIL 1 --chdir "$PWD"
    # Claude Code keeps its settings file next to the folder; inside the jail it goes in the folder.
    [[ $agent == claude ]] && printf '%s\n' --setenv CLAUDE_CONFIG_DIR "$home/.claude"
    return 0
}

cmd_run() { # cmd_run <shell?> args…
    local shell=$1 offline=0 db=0 snapshot=1 use_box=1 print=0 agent="" root; shift
    while (( $# )); do
        case $1 in
            --offline)     offline=1 ;;
            --db)          db=1 ;;
            --no-snapshot) snapshot=0 ;;
            --host)        use_box=0 ;;
            --print)       print=1 ;;          # show the jail and leave (tests)
            --)            shift; break ;;
            -*)            die "$(t "unknown option"): $1" ;;
            *)             break ;;
        esac
        shift
    done
    local -a cmd
    if (( shell )); then
        cmd=("$@"); (( ${#cmd[@]} )) || cmd=(bash)
    else
        agent=$(canon "${1:-}"); shift || true
        known "$agent" && [[ -n ${STATE[$agent]} ]] || die "usage: tamagi agents run <claude|codex|clio|qwen|opencode|gemini|openclaw> [args]"
        is_installed "$agent" || die "$agent $(t "is not installed"): tamagi agents install $agent"
        cmd=("$BIN_DIR/$agent" "$@")
        [[ -n ${NPM[$agent]:-} ]] && cmd=("$PREFIX/bin/$agent" "$@")
        [[ $agent == clio ]] && cmd=("$CLIO_DIR/clio" "$@")
        if [[ $agent == claude && -f $HOME/.claude.json && ! -e $HOME/.claude/.claude.json ]]; then
            mkdir -p "$HOME/.claude"; cp "$HOME/.claude.json" "$HOME/.claude/.claude.json"
        fi
    fi
    root=$(project_root)
    # In the development box the agent has compilers, Node and git; npm agents live there.
    local in_box=0
    if (( use_box )) && podman container exists "$BOX" 2>/dev/null; then in_box=1; fi
    if [[ -n $agent ]] && needs_box "$agent" && (( ! in_box )); then
        die "$agent $(t "runs in the development box"): tamagi devbox create"
    fi
    local -a jail
    mapfile -t jail < <(jail_args "$root" "$offline" "$agent")
    if (( print )); then
        (( in_box )) && echo "distrobox enter $BOX --"
        printf 'bwrap %s -- %s\n' "${jail[*]}" "${cmd[*]}"
        return 0
    fi
    info "$(t "Jail"): $root   ($( (( in_box )) && echo "$(t "box") $BOX" || t "on the host, without compilers")$( (( offline )) && echo ", offline"))"
    (( snapshot )) && save_point "$root" "${agent:-jail}" "$db"
    if (( in_box )); then
        distrobox enter "$BOX" -- sh -c 'command -v bwrap >/dev/null' 2>/dev/null \
            || die "$(t "bubblewrap is missing in the box; run"): tamagi devbox provision $BOX"
        exec distrobox enter "$BOX" -- bwrap "${jail[@]}" -- "${cmd[@]}"
    fi
    exec bwrap "${jail[@]}" -- "${cmd[@]}"
}

cmd_list() {
    local name
    for name in "${ORDER[@]}"; do
        printf '  %-12s %-42s %s\n' "$name" "${TITLE[$name]}" "$(is_installed "$name" && t "installed" || echo -)"
    done
}

cmd_update() {
    local name rc=0
    for name in "${ORDER[@]}"; do
        is_installed "$name" || continue
        case $name in
            claude)         "$BIN_DIR/claude" update </dev/null || rc=1 ;;
            codex|opencode|clio) install_github "$name" || rc=1 ;;
            qwen|gemini|openclaw)
                distrobox enter "$BOX" -- npm install -g --prefix "$PREFIX" "${NPM[$name]}@latest" </dev/null || rc=1 ;;
            *) ;;   # antigravity updates with its box; local models do not change
        esac
    done
    return $rc
}

pick() {
    [[ -t 0 ]] || { cmd_list; return 0; }
    local picked name
    picked=$(for name in "${ORDER[@]}"; do
                 is_installed "$name" || printf '%-12s %s\n' "$name" "${TITLE[$name]}"
             done | /usr/libexec/tamagi/gum-multi --height 12 \
                 --header "$(t "AI agents (space marks, Enter installs)")") || return 0
    [[ -n $picked ]] || return 0
    while read -r name _; do install_one "$name" || echo "$(t "failed"): $name" >&2; done <<<"$picked"
}

case "${1:-}" in
    "")         pick ;;
    list)       cmd_list ;;
    installed)  for n in "${ORDER[@]}"; do [[ $n != local ]] && is_installed "$n" && echo "$n"; done; exit 0 ;;
    install)    shift; (( $# )) || die "usage: tamagi agents install <${ORDER[*]}>"
                for a in "$@"; do install_one "$a"; done ;;
    remove)     shift; (( $# )) || die "usage: tamagi agents remove <name>"
                for a in "$@"; do remove_one "$a"; done ;;
    update)     cmd_update ;;
    run)        shift; cmd_run 0 "$@" ;;
    jail)       shift; cmd_run 1 "$@" ;;
    -h|--help|help) sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//' ;;
    *)          die "usage: tamagi agents [list|install <name>…|remove <name>|update|run <name>|jail]" ;;
esac
