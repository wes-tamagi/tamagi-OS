#!/usr/bin/bash
# tamagi-isolate — runs a program you do not trust in a disposable jail.
#
# For the script downloaded from the internet, the AppImage of doubtful origin,
# the binary a tutorial tells you to run. Inside the jail (bubblewrap, the same
# as Flatpak):
#   • no network (nothing goes out or comes in) — unless --net
#   • your home disappears: the program sees an empty, temporary folder
#   • the rest of the system is read-only; no D-Bus, no view of other processes
#   • the screen (Wayland and X11), sound and the graphics card work
# The file is copied inside: the original is untouched. On exit the jail is
# deleted (with --keep it stays in ~/.cache/tamagi-isolate for you to inspect).
#
#   tamagi isolate <file> [arguments]       .sh, .py, AppImage or executable
#   tamagi isolate -- <command> [arguments] any command of the system
#   options (before the file): --net  --keep  --no-gui
# In COSMIC Files: right click → Open with → "Open isolated".
set -euo pipefail
. /usr/libexec/tamagi/i18n

net=0 keep=0 gui=1
while [[ ${1:-} == --* && ${1:-} != -- ]]; do
    case $1 in
        --net) net=1 ;;
        --keep) keep=1 ;;
        --no-gui) gui=0 ;;
        -h|--help) sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
        *) echo "$(t "unknown option"): $1" >&2; exit 2 ;;
    esac
    shift
done
[[ ${1:-} == -- ]] && { shift; cmd_mode=1; } || cmd_mode=0
[[ $# -gt 0 ]] || { sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 2; }

base="${XDG_CACHE_HOME:-$HOME/.cache}/tamagi-isolate"
mkdir -p "$base"
jail=$(mktemp -d "$base/$(date +%Y%m%d-%H%M%S)-XXXX")
cleanup() { [[ $keep == 1 ]] && echo "$(t "Jail kept at"): $jail" >&2 || rm -rf --one-file-system "$jail"; }
trap cleanup EXIT
mkdir -p "$jail/home"

run=()
if [[ $cmd_mode == 1 ]]; then
    run=("$@")
else
    src=$1; shift
    [[ -f $src ]] || { echo "$(t "file not found"): $src" >&2; exit 1; }
    name=$(basename "$src")
    cp -- "$src" "$jail/home/$name"
    f="$HOME/$name"                      # caminho visto de dentro da jaula
    case ${name,,} in
        *.sh|*.bash) run=(bash "$f") ;;
        *.py)        run=(python3 "$f") ;;
        *.appimage)  chmod +x "$jail/home/$name"; run=("$f") ;;   # sem FUSE: extrai e roda
        *)           chmod +x "$jail/home/$name"; run=("$f") ;;
    esac
    run+=("$@")
fi

args=(
    --ro-bind / /
    --dev /dev
    --proc /proc
    --tmpfs /tmp
    --tmpfs /var/tmp
    --tmpfs /run
    # /home e /root são links para /var no Fedora atômico: esconde os destinos.
    --tmpfs /var/home --tmpfs /var/roothome
    --bind "$jail/home" "$(realpath "$HOME")"
    --chdir "$HOME"
    --unshare-all
    --die-with-parent
    --new-session
    --cap-drop ALL
    --hostname isolado
    --setenv HOME "$HOME"
    --setenv TMPDIR /tmp
    --setenv APPIMAGE_EXTRACT_AND_RUN 1
    --setenv TAMAGI_ISOLADO 1
    --unsetenv DBUS_SESSION_BUS_ADDRESS
    --unsetenv SSH_AUTH_SOCK
)
[[ $net == 1 ]] && args+=(--share-net --ro-bind-try /run/systemd/resolve /run/systemd/resolve)
if [[ $gui == 1 ]]; then
    rt=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
    args+=(--dir "$rt" --setenv XDG_RUNTIME_DIR "$rt" --dev-bind-try /dev/dri /dev/dri)
    [[ -n ${WAYLAND_DISPLAY:-} && -S $rt/$WAYLAND_DISPLAY ]] && args+=(--ro-bind "$rt/$WAYLAND_DISPLAY" "$rt/$WAYLAND_DISPLAY")
    [[ -S $rt/pipewire-0 ]] && args+=(--ro-bind "$rt/pipewire-0" "$rt/pipewire-0")
    # X11 (Xwayland): muitos AppImages e o Wine só falam X11.
    [[ -n ${DISPLAY:-} && -d /tmp/.X11-unix ]] && args+=(--ro-bind /tmp/.X11-unix /tmp/.X11-unix)
else
    args+=(--unsetenv WAYLAND_DISPLAY --unsetenv DISPLAY)
fi

msg="$(t "Isolated"): $(t "no network"), $(t "home folder hidden"), $(t "system read-only")"
[[ $net == 1 ]] && msg="$(t "Isolated"): $(t "WITH network"), $(t "home folder hidden"), $(t "system read-only")"
echo "$msg" >&2
set +e
bwrap "${args[@]}" -- "${run[@]}"
rc=$?
set -e
exit $rc
