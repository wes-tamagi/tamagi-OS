#!/usr/bin/bash
# tamagi-dev — ambientes de desenvolvimento prontos (o "Install > Development"
# do Omarchy), instalados pelo mise na sua pasta pessoal.
#
#   tamagi-dev                 escolhe um ou mais (menu)
#   tamagi-dev add <preset…>   instala: tamagi-dev add web python
#   tamagi-dev list            presets e o que cada um instala
#
# Só entram linguagens com binário pronto: no Tamagi o sistema é imutável e
# não há compilador no host. Para headers C, SQLite, compiladores ou outras
# distros, use a caixa Fedora padrão (`tamagi-devbox`) ou `tamagi-workspace`.
set -euo pipefail
. /usr/libexec/tamagi/i18n

declare -A TOOLS=(
    [web]="node@lts pnpm@latest"
    [bun]="bun@latest"
    [deno]="deno@latest"
    [python]="python@3.13"
    [ruby]="ruby@latest node@lts"
    [go]="go@latest"
    [rust]="rust@latest"
    [java]="java@temurin-25"
    [dotnet]="dotnet@10"
    [zig]="zig@latest"
)
ORDER=(web bun deno python ruby go rust java dotnet zig)
declare -A HINT=(
    [web]="Node LTS + pnpm"
    [bun]="Bun"
    [deno]="Deno"
    [python]="Python 3.13 (+ uv, já no sistema)"
    [ruby]="Ruby + Node (Rails: gem install rails)"
    [go]="Go"
    [rust]="Rust (rustup)"
    [java]="Java 25 LTS (Temurin)"
    [dotnet]=".NET 10 LTS"
    [zig]="Zig"
)

die() { echo "$(t "erro"): $*" >&2; exit 1; }

list() { local p; for p in "${ORDER[@]}"; do printf '  %-7s %-40s %s\n' "$p" "${HINT[$p]}" "${TOOLS[$p]}"; done; }

add() {
    local p tools=()
    for p in "$@"; do
        [[ -n ${TOOLS[$p]:-} ]] || die "$(t "preset desconhecido"): $p"
        read -r -a more <<<"${TOOLS[$p]}"
        tools+=("${more[@]}")
    done
    [[ ${#tools[@]} -gt 0 ]] || exit 0
    echo "mise use -g ${tools[*]}"
    mise use -g "${tools[@]}"
    echo
    echo "$(t "Pronto. Abra um terminal novo (ou rode: hash -r) e confira com"): mise ls"
}

case "${1:-}" in
    "")
        if [[ ! -t 0 ]]; then list; exit 0; fi
        mapfile -t picked < <(for p in "${ORDER[@]}"; do printf '%-7s %s\n' "$p" "${HINT[$p]}"; done \
            | /usr/libexec/tamagi/gum-multi --header "$(t "Ambientes de desenvolvimento (espaço marca, Enter instala)")" \
            | awk '{print $1}')
        add "${picked[@]}" ;;
    add|instalar) shift; [[ $# -gt 0 ]] || die "uso: tamagi-dev add <${ORDER[*]// /|}>"; add "$@" ;;
    list|lista)   list ;;
    -h|--help|ajuda) sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//' ;;
    *) die "uso: tamagi-dev [add <preset…>|list]" ;;
esac
