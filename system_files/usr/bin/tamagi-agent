#!/usr/bin/python3
"""tamagi-agent — agente de IA local do Tamagi.

Conversa com o llama-server (llama.cpp) local pela API compatível com OpenAI
e usa ferramentas (shell, leitura e escrita de arquivos) para agir no sistema.
Só depende da biblioteca padrão do Python.

Segurança: comandos somente-leitura conhecidos rodam direto; todo o resto
pede confirmação. Nada roda como root sem você digitar a senha do sudo.
"""

import argparse
import json
import os
import re
import shlex
import subprocess
import sys
import time
import urllib.error
import urllib.request

DEFAULT_URL = "http://127.0.0.1:9931/v1"
CONFIG_ENV = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
    "tamagi", "ai.env")
SYSTEM_PROMPT_FILE = "/usr/share/tamagi/agent/system.md"
MAX_TOOL_OUTPUT = 6000
MAX_STEPS = 25

# Comandos que só leem estado: executados sem perguntar.
READ_ONLY = {
    "ls", "cat", "head", "tail", "wc", "grep", "rg", "fd", "find", "stat",
    "file", "df", "du", "free", "uptime", "uname", "date", "whoami", "id",
    "pwd", "echo", "which", "type", "lsblk", "lscpu", "lspci", "lsusb",
    "lsmod", "ss", "ps", "pgrep", "nproc", "printenv", "sensors",
    "sort", "cut", "tr", "jq", "awk", "sed", "realpath", "basename", "dirname",
    "tree", "bat", "eza", "vulkaninfo",
}
# Programas com subcomandos: só os listados são leitura (None = sem subcomando).
READ_ONLY_SUB = {
    "systemctl": {"status", "is-active", "is-enabled", "is-failed", "list-units",
                  "list-unit-files", "list-timers", "show", "cat", "--failed"},
    "journalctl": {None},
    "bootc": {"status"},
    "rpm-ostree": {"status", "db"},
    "rpm": {"-q", "-qa", "-qi", "-ql", "-qf", "--query"},
    "flatpak": {"list", "info", "remotes", "search", "history"},
    "distrobox": {"list", "ls"},
    "podman": {"ps", "images", "info", "version", "inspect", "logs"},
    "docker": {"ps", "images", "info", "version", "inspect", "logs"},
    "git": {"status", "log", "diff", "show"},
    "brew": {"list", "info", "search"},
    "ujust": {"--list", "-l", "--summary"},
    "tamagi-ai": {"status", "list", "presets", "recommend"},
    "tamagi-theme": {"list", "current", "styles"},
    "tamagi-update": {"status"},
    "tamagi": {"diff", "export"},
    "tamagi-bank": {"status"},
    "tamagi-boot-report": {"list", "status"},
    "virsh": {"list", "dominfo", "nodeinfo", "net-list", "pool-list", "version"},
    "mise": {"ls", "list", "current", "doctor", "settings", "version", "--version"},
    "tamagi-warsaw": {None, "status"},
    "tamagi-browser": {"status"},
    "tamagi-harden": {None, "status"},
    "dnf": {"list", "info", "search", "repoquery", "provides"},
    "gsettings": {"get", "list-keys", "list-schemas"},
    "dconf": {"read", "list", "dump"},
    "fastfetch": {None},
    "hostnamectl": {None, "status"},
    "timedatectl": {None, "status", "show"},
    "localectl": {None, "status"},
    "loginctl": {None, "list-sessions", "list-users", "session-status", "user-status"},
    "resolvectl": {None, "status", "query"},
    "ip": {None, "a", "addr", "address", "link", "r", "route", "neigh", "rule"},
    "nmcli": {None, "device", "connection", "general", "radio"},
}
# Argumentos que transformam um comando "de leitura" em escrita ou execução.
WRITE_ARGS = {
    "sed": ("-i", "--in-place"),
    "find": ("-delete", "-exec", "-execdir", "-ok", "-okdir", "-fprint", "-fprint0",
             "-fprintf", "-fls"),
    "fd": ("-x", "--exec", "-X", "--exec-batch"),
    "rg": ("--pre",),
    "bat": ("--pager",),
    "git": ("--output", "--ext-diff"),
    "sort": ("-o", "--output", "--compress-program"),
    "tree": ("-o",),
    "date": ("-s", "--set"),
    "journalctl": ("--rotate", "--flush", "--sync", "--relinquish-var", "--setup-keys",
                   "--update-catalog", "--vacuum-size", "--vacuum-time", "--vacuum-files"),
    "ip": ("add", "del", "delete", "set", "flush", "change", "replace", "append"),
    "nmcli": ("add", "delete", "modify", "edit", "up", "down", "connect", "disconnect",
              "on", "off", "import", "reload", "reapply", "set", "wifi", "clone", "load"),
}

C = {"dim": "\033[2m", "bold": "\033[1m", "cyan": "\033[36m", "yellow": "\033[33m",
     "red": "\033[31m", "green": "\033[32m", "reset": "\033[0m"}
if not sys.stdout.isatty() or os.environ.get("NO_COLOR"):
    C = {k: "" for k in C}

TOOLS = [
    {"type": "function", "function": {
        "name": "shell",
        "description": "Executa um comando bash no computador do usuário e devolve "
                       "stdout, stderr e o código de saída. Use para inspecionar e "
                       "alterar o sistema. Um comando por chamada.",
        "parameters": {"type": "object", "properties": {
            "command": {"type": "string", "description": "Comando bash a executar."},
            "why": {"type": "string", "description": "Uma frase: para que serve."}},
            "required": ["command"]}}},
    {"type": "function", "function": {
        "name": "read_file",
        "description": "Lê um arquivo de texto (até 400 linhas a partir de 'offset').",
        "parameters": {"type": "object", "properties": {
            "path": {"type": "string"},
            "offset": {"type": "integer", "description": "Linha inicial (1 = primeira)."}},
            "required": ["path"]}}},
    {"type": "function", "function": {
        "name": "write_file",
        "description": "Cria ou sobrescreve um arquivo de texto com o conteúdo dado.",
        "parameters": {"type": "object", "properties": {
            "path": {"type": "string"},
            "content": {"type": "string"}},
            "required": ["path", "content"]}}},
]


def load_env_file(path):
    out = {}
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, v = line.split("=", 1)
                    out[k.strip()] = v.strip().strip('"').strip("'")
    except OSError:
        pass
    return out


def http_json(url, payload=None, timeout=10):
    data = json.dumps(payload).encode() if payload is not None else None
    req = urllib.request.Request(url, data=data,
                                 headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return json.loads(resp.read().decode())


def server_alive(base):
    try:
        http_json(base + "/models", timeout=3)
        return True
    except (urllib.error.URLError, OSError, ValueError):
        return False


def ensure_server(base):
    """Sobe o llama-server do usuário se ele não estiver respondendo."""
    if server_alive(base):
        return
    is_local = re.match(r"https?://(127\.0\.0\.1|localhost)[:/]", base)
    if is_local:
        subprocess.run(["systemctl", "--user", "start", "llama-server.service"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
        for _ in range(40):
            if server_alive(base):
                return
            time.sleep(0.5)
    sys.exit(f"{C['red']}Não consegui falar com o servidor de IA em {base}.{C['reset']}\n"
             "Rode `tamagi-ai setup` para baixar um modelo e ligar o llama-server.")


def pick_model(base, wanted):
    try:
        models = [m["id"] for m in http_json(base + "/models").get("data", [])]
    except (urllib.error.URLError, OSError, ValueError, KeyError):
        models = []
    if wanted:
        if wanted in models or not models:
            return wanted
        # aceita prefixo/trecho ("gemma" -> "gemma-4-E4B-it-Q4_0")
        for m in models:
            if wanted.lower() in m.lower():
                return m
        return wanted
    if not models:
        sys.exit("Nenhum modelo instalado. Rode `tamagi-ai setup` primeiro.")
    return models[0]


def is_read_only(command):
    """True se o comando é comprovadamente só leitura (pode rodar sem perguntar)."""
    if re.search(r"[;&`<>\n]|\$\(|\|\|", command):
        return False
    for segment in command.split("|"):
        try:
            argv = shlex.split(segment)
        except ValueError:
            return False
        if not argv or "=" in argv[0]:
            return False
        prog, rest = os.path.basename(argv[0]), argv[1:]
        if any(a == w or a.startswith(w + "=") for a in rest for w in WRITE_ARGS.get(prog, ())):
            return False
        if prog in READ_ONLY_SUB:
            words = [a for a in rest if a not in ("--user", "--system", "--no-pager", "--no-color")]
            sub = words[0] if words and not (prog == "journalctl") else None
            if prog != "journalctl" and words and words[0].startswith("-") \
                    and words[0] not in READ_ONLY_SUB[prog]:
                # opção antes do subcomando (ex.: ip -br a): olha a primeira palavra sem traço
                plain = [w for w in words if not w.startswith("-")]
                sub = plain[0] if plain else None
            if sub not in READ_ONLY_SUB[prog]:
                return False
            continue
        if prog not in READ_ONLY:
            return False
        if prog == "awk" and re.search(r"system\s*\(|getline|>|\|", " ".join(rest)):
            return False
        if prog == "sed":
            # só a forma de impressão (sed -n '1,20p' arq) é reconhecida como leitura
            script = [a for a in rest if not a.startswith("-")][:1]
            if "-n" not in rest or not script or not re.fullmatch(r"[0-9,$~+]*p", script[0]):
                return False
    return True


def ask(question, auto_yes):
    if auto_yes:
        return True
    if not sys.stdin.isatty():
        return False
    try:
        with open("/dev/tty", "r+", encoding="utf-8") as tty:
            tty.write(f"{C['yellow']}{question} [s/N] {C['reset']}")
            tty.flush()
            return tty.readline().strip().lower() in ("s", "sim", "y", "yes")
    except OSError:
        return False


def clip(text):
    if len(text) <= MAX_TOOL_OUTPUT:
        return text
    half = MAX_TOOL_OUTPUT // 2
    return (text[:half] + f"\n[... {len(text) - MAX_TOOL_OUTPUT} caracteres omitidos ...]\n"
            + text[-half:])


def tool_shell(args, auto_yes):
    command = str(args.get("command", "")).strip()
    if not command:
        return "erro: comando vazio"
    why = args.get("why")
    print(f"{C['cyan']}$ {command}{C['reset']}" + (f"  {C['dim']}# {why}{C['reset']}" if why else ""))
    needs_root = bool(re.search(r"(^|[\s;&|(])(sudo|pkexec|run0|su)\b", command))
    if not is_read_only(command):
        # -y nunca aprova sozinho um comando com privilégio de root.
        if not ask("Executar este comando?", auto_yes and not needs_root):
            return "O usuário recusou este comando. Não tente de novo; pergunte como prosseguir."
    try:
        proc = subprocess.run(["bash", "-c", command], capture_output=True, text=True,
                              timeout=300, stdin=None if needs_root else subprocess.DEVNULL,
                              errors="replace", check=False)
    except subprocess.TimeoutExpired:
        return "erro: o comando passou de 300 s e foi interrompido"
    out = proc.stdout
    if proc.stderr.strip():
        out += ("\n[stderr]\n" + proc.stderr)
    shown = out.strip().splitlines()
    for line in shown[:12]:
        print(f"{C['dim']}  {line[:200]}{C['reset']}")
    if len(shown) > 12:
        print(f"{C['dim']}  … (+{len(shown) - 12} linhas){C['reset']}")
    return clip(f"[exit {proc.returncode}]\n{out}".rstrip())


def tool_read_file(args):
    path = os.path.expanduser(str(args.get("path", "")))
    offset = max(int(args.get("offset") or 1), 1)
    print(f"{C['cyan']}ler {path}{C['reset']}")
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            lines = fh.readlines()
    except OSError as exc:
        return f"erro: {exc}"
    chunk = lines[offset - 1: offset - 1 + 400]
    more = len(lines) - (offset - 1 + len(chunk))
    text = "".join(chunk)
    if more > 0:
        text += f"\n[... mais {more} linhas; use offset={offset + len(chunk)}]"
    return clip(text) if text else "(arquivo vazio)"


def tool_write_file(args, auto_yes):
    path = os.path.expanduser(str(args.get("path", "")))
    content = str(args.get("content", ""))
    exists = os.path.exists(path)
    print(f"{C['cyan']}{'sobrescrever' if exists else 'criar'} {path} "
          f"({len(content.splitlines())} linhas){C['reset']}")
    if not ask("Gravar este arquivo?", auto_yes):
        return "O usuário recusou a gravação."
    try:
        os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(content)
    except OSError as exc:
        return f"erro: {exc}"
    return f"ok: {len(content)} bytes gravados em {path}"


def run_tool(name, raw_args, auto_yes):
    try:
        args = json.loads(raw_args) if raw_args and raw_args.strip() else {}
        if not isinstance(args, dict):
            raise ValueError("argumentos não são um objeto")
    except ValueError as exc:
        return f"erro: argumentos inválidos para {name}: {exc}"
    if name == "shell":
        return tool_shell(args, auto_yes)
    if name == "read_file":
        return tool_read_file(args)
    if name == "write_file":
        return tool_write_file(args, auto_yes)
    return f"erro: ferramenta desconhecida '{name}'"


def chat_stream(base, model, messages):
    """Uma rodada de chat com streaming. Devolve (texto, tool_calls)."""
    payload = {"model": model, "messages": messages, "tools": TOOLS, "stream": True}
    req = urllib.request.Request(base + "/chat/completions",
                                 data=json.dumps(payload).encode(),
                                 headers={"Content-Type": "application/json"})
    text, calls, thinking = [], {}, False
    with urllib.request.urlopen(req, timeout=900) as resp:
        for raw in resp:
            line = raw.decode("utf-8", errors="replace").strip()
            if not line.startswith("data:"):
                continue
            data = line[5:].strip()
            if data == "[DONE]":
                break
            try:
                event = json.loads(data)
            except ValueError:
                continue
            if event.get("error"):
                raise RuntimeError(str(event["error"]))
            for choice in event.get("choices", []):
                delta = choice.get("delta") or {}
                if delta.get("reasoning_content") and not thinking:
                    thinking = True
                    print(f"{C['dim']}(pensando…){C['reset']}", flush=True)
                piece = delta.get("content")
                if piece:
                    text.append(piece)
                    sys.stdout.write(piece)
                    sys.stdout.flush()
                for tc in delta.get("tool_calls") or []:
                    slot = calls.setdefault(tc.get("index", 0),
                                            {"id": "", "name": "", "arguments": ""})
                    slot["id"] = tc.get("id") or slot["id"]
                    fn = tc.get("function") or {}
                    slot["name"] += fn.get("name") or ""
                    slot["arguments"] += fn.get("arguments") or ""
    if text:
        print()
    ordered = [calls[i] for i in sorted(calls)]
    return "".join(text), ordered


def run_turn(base, model, messages, auto_yes):
    for _ in range(MAX_STEPS):
        try:
            content, calls = chat_stream(base, model, messages)
        except urllib.error.HTTPError as exc:
            body = exc.read().decode("utf-8", errors="replace")[:500]
            print(f"{C['red']}Erro do servidor ({exc.code}): {body}{C['reset']}")
            return
        except (urllib.error.URLError, OSError, RuntimeError) as exc:
            print(f"{C['red']}Erro falando com o modelo: {exc}{C['reset']}")
            return
        msg = {"role": "assistant", "content": content or None}
        if calls:
            msg["tool_calls"] = [
                {"id": c["id"] or f"call_{i}", "type": "function",
                 "function": {"name": c["name"], "arguments": c["arguments"] or "{}"}}
                for i, c in enumerate(calls)]
        messages.append(msg)
        if not calls:
            return
        for call in msg["tool_calls"]:
            result = run_tool(call["function"]["name"], call["function"]["arguments"], auto_yes)
            messages.append({"role": "tool", "tool_call_id": call["id"], "content": result})
    print(f"{C['yellow']}Parei após {MAX_STEPS} passos; diga 'continue' para seguir.{C['reset']}")


REPLY_LANG = {"pt": "português do Brasil", "en": "English", "es": "español", "fr": "français"}


def reply_language():
    """Idioma das respostas: o do sistema (ou TAMAGI_LANG); outros idiomas caem no inglês."""
    code = os.environ.get("TAMAGI_LANG") or (
        os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or "pt_BR")[:2]
    return REPLY_LANG.get(code, "English")


def system_prompt():
    try:
        with open(SYSTEM_PROMPT_FILE, encoding="utf-8") as fh:
            base = fh.read()
    except OSError:
        base = "Você é o assistente do sistema Tamagi."
    facts = [f"Usuário: {os.environ.get('USER', '?')}", f"Diretório atual: {os.getcwd()}",
             f"Data: {time.strftime('%Y-%m-%d %H:%M')}"]
    # O idioma vai no fim do prompt, onde os modelos locais pequenos obedecem melhor.
    return (base.rstrip() + "\n\n## Contexto desta sessão\n" + "\n".join(facts)
            + f"\n\n## Idioma\nResponda sempre em {reply_language()}.\n")


def main():
    env = load_env_file(CONFIG_ENV)
    parser = argparse.ArgumentParser(
        prog="tamagi-agent", description="Agente de IA local do Tamagi (llama.cpp).")
    parser.add_argument("prompt", nargs="*", help="pedido; sem ele abre o modo conversa")
    parser.add_argument("-y", "--yes", action="store_true",
                        help="não pedir confirmação (comandos com sudo sempre perguntam)")
    parser.add_argument("-m", "--model",
                        default=os.environ.get("TAMAGI_AI_MODEL") or env.get("TAMAGI_AI_MODEL"))
    parser.add_argument("-u", "--url",
                        default=os.environ.get("TAMAGI_AI_URL") or env.get("TAMAGI_AI_URL")
                        or DEFAULT_URL)
    opts = parser.parse_args()
    base = opts.url.rstrip("/")

    ensure_server(base)
    model = pick_model(base, opts.model)
    messages = [{"role": "system", "content": system_prompt()}]

    prompt = " ".join(opts.prompt).strip()
    if not sys.stdin.isatty():
        piped = sys.stdin.read().strip()
        if piped:
            prompt = (prompt + "\n\n" + piped).strip()
    if prompt:
        messages.append({"role": "user", "content": prompt})
        run_turn(base, model, messages, opts.yes)
        return

    print(f"{C['bold']}Tamagi · agente local{C['reset']} {C['dim']}({model}) — "
          f"/sair para encerrar, /limpar para recomeçar{C['reset']}")
    while True:
        try:
            line = input(f"{C['green']}› {C['reset']}").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return
        if not line:
            continue
        if line in ("/sair", "/exit", "/quit", "sair"):
            return
        if line in ("/limpar", "/clear"):
            del messages[1:]
            continue
        messages.append({"role": "user", "content": line})
        try:
            run_turn(base, model, messages, opts.yes)
        except KeyboardInterrupt:
            print(f"\n{C['yellow']}(interrompido){C['reset']}")


if __name__ == "__main__":
    main()
