#!/usr/bin/bash
# tamagi-agent — unified entry point for Tamagi local AI agent and coding agents.
#
#   tamagi-agent [ask] [prompt...]        chat with local system agent (llama.cpp)
#   tamagi-agent list | installed         list available or installed coding agents
#   tamagi-agent install|remove <name>…   manage coding agents (claude, codex, qwen, gemini, agy…)
#   tamagi-agent update                   update installed coding agents
#   tamagi-agent run [opts] <agent> …     run coding agent jailed (--shadow, --egress-guard)
#   tamagi-agent jail [opts] [-- cmd]     shell inside the agent jail
#   tamagi-agent shadow <list|diff|apply|drop>  manage CoW shadow workspaces
#   tamagi-agent flights [list|show|clear]      agent flight recorder (audit)
set -euo pipefail

LOCAL=/usr/libexec/tamagi/agent-local
MGR=/usr/libexec/tamagi/agent-manager

case "${1:-}" in
    "")
        exec "$LOCAL" ;;
    ask)
        shift
        exec "$LOCAL" "$@" ;;
    list|installed|install|remove|update|run|jail|shadow|shadows|flights)
        exec "$MGR" "$@" ;;
    -h|--help|help)
        sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//' ;;
    -*)
        exec "$LOCAL" "$@" ;;
    *)
        exec "$LOCAL" "$@" ;;
esac
