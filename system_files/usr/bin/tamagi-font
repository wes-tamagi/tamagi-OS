#!/usr/bin/bash
# tamagi-font — changes the monospace font everywhere at once: terminal
# and Tamagi windows (foot), COSMIC (terminal, editor and the mono
# font of the interface) and GTK apps.
#
#   tamagi font                 choose from a list (installed mono fonts)
#   tamagi font set "<family>"  e.g.: tamagi font set "CaskaydiaCove Nerd Font"
#   tamagi font list
#   tamagi font current
#   tamagi font reset           back to JetBrains Mono
#
# New font: download it to ~/.local/share/fonts (or install it by Flatpak or
# in a box) and it shows up in the list.
set -euo pipefail
. /usr/libexec/tamagi/i18n

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE="$CONFIG/tamagi/font"
DEFAULT="JetBrains Mono"

list() { fc-list :spacing=mono family | cut -d, -f1 | sort -u; }
current() { head -1 "$STATE" 2>/dev/null || echo "$DEFAULT"; }

apply() {
    local font=$1 tk="$CONFIG/cosmic/com.system76.CosmicTk/v1" app
    list | grep -qxF "$font" || { echo "$(t "monospace font not found"): $font (tamagi-font list)" >&2; exit 1; }
    mkdir -p "$CONFIG/tamagi" "$tk"
    if [[ $font == "$DEFAULT" ]]; then rm -f "$STATE"; else echo "$font" > "$STATE"; fi
    echo "(family: \"$font\", weight: Normal, stretch: Normal, style: Normal)" > "$tk/monospace_font"
    for app in CosmicTerm CosmicEdit; do
        mkdir -p "$CONFIG/cosmic/com.system76.$app/v1"
        echo "\"$font\"" > "$CONFIG/cosmic/com.system76.$app/v1/font_name"
    done
    gsettings set org.gnome.desktop.interface monospace-font-name "$font 11" 2>/dev/null || true
    # foot (terminal and Tamagi windows): tamagi-theme writes them again with the new font.
    tamagi-theme apps >/dev/null
    echo "$(t "Font"): $font  ($(t "new terminals already use it"))"
}

case "${1:-}" in
    "")
        [[ -t 0 ]] || { current; exit 0; }
        font=$(list | gum filter --header "$(t "Monospace font")" --value "$(current)") || exit 0
        [[ -n $font ]] && apply "$font" ;;
    set)     [[ -n ${2:-} ]] || { echo "usage: tamagi font set \"<family>\"" >&2; exit 2; }; apply "$2" ;;
    list)    list ;;
    current) current ;;
    reset)   apply "$DEFAULT" ;;
    -h|--help) sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//' ;;
    *) echo "usage: tamagi font [set <family>|list|current|reset]" >&2; exit 2 ;;
esac
