#!/usr/bin/bash
# tamagi-harden — níveis de endurecimento do sistema, inspirados no GrapheneOS.
set -euo pipefail
. /usr/libexec/tamagi/i18n

STRICT_SYSCTL=/etc/sysctl.d/90-tamagi-strict.conf
STRICT_NM=/etc/NetworkManager/conf.d/90-tamagi-strict.conf
PRELOAD=/etc/ld.so.preload
MALLOC_LIB=/usr/lib64/libhardened_malloc.so
# shellcheck disable=SC2054  # a vírgula faz parte de mitigations=auto,nosmt
STRICT_KARGS=(
    init_on_free=1
    lockdown=integrity
    mitigations=auto,nosmt
    spec_store_bypass_disable=on
    random.trust_cpu=off
    random.trust_bootloader=off
    debugfs=off
    vdso32=0
)

die() { echo "$(t "erro"): $*" >&2; exit 1; }
yn() { "$@" >/dev/null 2>&1 && t "sim" || t "não"; }
is_strict() { [[ -f $STRICT_SYSCTL ]]; }
sysctl_now() { sysctl -n "$1" 2>/dev/null || echo "?"; }

usage() {
    echo "tamagi-harden — $(t "endurecimento do sistema")"
    echo
    echo "  status            $(t "o que está ativo agora")"
    echo "  strict            $(t "liga o modo estrito (pede a senha; vale após reiniciar)")"
    echo "  balanced          $(t "volta ao padrão equilibrado")"
    echo "  usb on|off        $(t "USBGuard: só os aparelhos USB já conhecidos funcionam")"
    echo "  malloc on|off     $(t "hardened_malloc em todos os programas (pode quebrar apps)")"
}

secure_boot() {
    local state
    state=$(mokutil --sb-state 2>&1 | head -1)
    case "$state" in
        *enabled*)  t "ligado" ;;
        *disabled*) t "desligado" ;;
        *)          t "sem suporte nesta máquina" ;;
    esac
}

cmd_status() {
    local karg missing=0
    echo "$(t "Modo")                      : $(is_strict && t "estrito" || t "equilibrado")"
    echo "SELinux                   : $(getenforce 2>/dev/null || echo '?')"
    echo "Secure Boot               : $(secure_boot)"
    echo "$(t "Disco criptografado (LUKS)"): $(yn sh -c 'lsblk -no TYPE | grep -qx crypt')"
    echo "Firewall                  : $(systemctl is-active firewalld 2>/dev/null || true)"
    echo "USBGuard                  : $(systemctl is-active usbguard 2>/dev/null || true)"
    echo "hardened_malloc global    : $(yn grep -qs hardened_malloc "$PRELOAD")"
    echo "$(t "MAC do Wi-Fi")              : $(is_strict && t "aleatório a cada conexão" || t "um por rede salva")"
    echo "kptr_restrict / dmesg     : $(sysctl_now kernel.kptr_restrict) / $(sysctl_now kernel.dmesg_restrict)"
    echo "ptrace_scope              : $(sysctl_now kernel.yama.ptrace_scope)"
    echo "$(t "BPF sem privilégio")        : $([[ $(sysctl_now kernel.unprivileged_bpf_disabled) != 0 ]] && t "bloqueado" || t "liberado")"
    if is_strict; then
        for karg in "${STRICT_KARGS[@]}"; do
            grep -qw -- "$karg" /proc/cmdline || missing=$((missing + 1))
        done
        (( missing )) && echo "Kernel                    : $missing $(t "argumento(s) do modo estrito entram no próximo boot")"
    fi
    return 0
}

cmd_strict() {
    local args=() karg
    for karg in "${STRICT_KARGS[@]}"; do args+=("--append-if-missing=$karg"); done
    echo "$(t "O modo estrito reduz desempenho/compatibilidade (desliga SMT, restringe ptrace, MAC aleatório, lockdown).")"
    echo "$(t "Não mexe em distrobox, Flatpak nem nos navegadores.")"
    if [[ -t 0 ]]; then
        read -r -p "$(t "Ligar o modo estrito?") [s/y/N] " answer
        [[ ${answer,,} =~ ^(s|sim|y|yes|o|oui)$ ]] || { echo "$(t "Nada foi alterado.")"; exit 1; }
    fi
    sudo bash -euo pipefail -c '
        cat > "$1" <<SYSCTL
# Gerado por tamagi-harden strict. Para desfazer: tamagi-harden balanced
kernel.yama.ptrace_scope = 2
kernel.perf_event_paranoid = 3
kernel.sysrq = 0
kernel.core_pattern = |/bin/false
net.ipv4.tcp_timestamps = 0
net.ipv4.icmp_echo_ignore_all = 1
SYSCTL
        mkdir -p "$(dirname "$2")"
        cat > "$2" <<NM
# Gerado por tamagi-harden strict.
[connection-90-tamagi-strict-wifi]
match-device=type:wifi
wifi.cloned-mac-address=random

[connection-90-tamagi-strict-ethernet]
match-device=type:ethernet
ethernet.cloned-mac-address=random
NM
        sysctl --system >/dev/null
        systemctl reload NetworkManager 2>/dev/null || true
        shift 2
        rpm-ostree kargs "$@"
    ' _ "$STRICT_SYSCTL" "$STRICT_NM" "${args[@]}"
    tl "Modo estrito ligado. Os argumentos do kernel valem depois de reiniciar."
}

cmd_balanced() {
    local args=() karg
    for karg in "${STRICT_KARGS[@]}"; do args+=("--delete-if-present=$karg"); done
    sudo bash -euo pipefail -c '
        rm -f "$1" "$2"
        sysctl --system >/dev/null
        systemctl reload NetworkManager 2>/dev/null || true
        shift 2
        rpm-ostree kargs "$@"
    ' _ "$STRICT_SYSCTL" "$STRICT_NM" "${args[@]}"
    tl "Modo equilibrado. Reinicie para o kernel voltar aos argumentos padrão."
}

cmd_usb() {
    case "${1:-}" in
        on|ligar)
            tl "Os aparelhos USB conectados AGORA ficam liberados; os novos serão bloqueados."
            sudo sh -c 'usbguard generate-policy > /etc/usbguard/rules.conf && chmod 600 /etc/usbguard/rules.conf && systemctl enable --now usbguard.service' ;;
        off|desligar)
            sudo systemctl disable --now usbguard.service ;;
        *) die "$(t "uso"): tamagi-harden usb on|off" ;;
    esac
}

cmd_malloc() {
    [[ -f $MALLOC_LIB ]] || die "$(t "hardened_malloc não está nesta imagem")"
    case "${1:-}" in
        on|ligar)
            tl "Todo programa novo passa a usar o hardened_malloc. Para desfazer: tamagi-harden malloc off"
            sudo sh -c "echo '$MALLOC_LIB' > '$PRELOAD'" ;;
        off|desligar)
            sudo rm -f "$PRELOAD" ;;
        *) die "$(t "uso"): tamagi-harden malloc on|off" ;;
    esac
}

case "${1:-status}" in
    status|estado)        cmd_status ;;
    strict|estrito)       cmd_strict ;;
    balanced|equilibrado) cmd_balanced ;;
    usb)                  shift; cmd_usb "$@" ;;
    malloc)               shift; cmd_malloc "$@" ;;
    help|-h|--help|ajuda) usage ;;
    *)                    usage >&2; exit 2 ;;
esac
