#!/usr/bin/bash
# tamagi-harden — níveis de endurecimento do sistema, inspirados no GrapheneOS.
set -euo pipefail
. /usr/libexec/tamagi/i18n

STRICT_SYSCTL=/etc/sysctl.d/90-tamagi-strict.conf
STRICT_NM=/etc/NetworkManager/conf.d/90-tamagi-strict.conf
PRELOAD=/etc/ld.so.preload
MALLOC_LIB=/usr/lib64/libhardened_malloc.so
# shellcheck disable=SC2054  # a vírgula faz parte de mitigations=auto,nosmt
STRICT_KARGS=(
    init_on_free=1
    lockdown=integrity
    mitigations=auto,nosmt
    spec_store_bypass_disable=on
    random.trust_cpu=off
    random.trust_bootloader=off
    debugfs=off
    vdso32=0
)

die() { echo "$(t "error"): $*" >&2; exit 1; }
yn() { "$@" >/dev/null 2>&1 && t "yes" || t "no"; }
is_strict() { [[ -f $STRICT_SYSCTL ]]; }
sysctl_now() { sysctl -n "$1" 2>/dev/null || echo "?"; }

usage() {
    echo "tamagi-harden — $(t "system hardening")"
    echo
    echo "  status            $(t "what is active right now")"
    echo "  strict            $(t "enable strict mode (asks password; applies after reboot)")"
    echo "  balanced          $(t "return to balanced default")"
    echo "  usb on|off        $(t "USBGuard: allow only currently known USB devices")"
    echo "  malloc on|off     $(t "hardened_malloc for all programs (may break some apps)")"
}

secure_boot() {
    local state
    state=$(mokutil --sb-state 2>&1 | head -1)
    case "$state" in
        *enabled*)  t "running" ;;
        *disabled*) t "off" ;;
        *)          t "not supported on this machine" ;;
    esac
}

cmd_status() {
    local karg missing=0
    echo "$(t "Mode")                      : $(is_strict && t "strict" || t "balanced")"
    echo "SELinux                   : $(getenforce 2>/dev/null || echo '?')"
    echo "Secure Boot               : $(secure_boot)"
    echo "$(t "Encrypted disk (LUKS)"): $(yn sh -c 'lsblk -no TYPE | grep -qx crypt')"
    echo "Firewall                  : $(systemctl is-active firewalld 2>/dev/null || true)"
    echo "USBGuard                  : $(command -v usbguard >/dev/null 2>&1 && (systemctl is-active usbguard 2>/dev/null || true) || t "optional")"
    echo "hardened_malloc global    : $(yn grep -qs hardened_malloc "$PRELOAD")"
    echo "$(t "Wi-Fi MAC")              : $(is_strict && t "random per connection" || t "stable per saved network")"
    echo "kptr_restrict / dmesg     : $(sysctl_now kernel.kptr_restrict) / $(sysctl_now kernel.dmesg_restrict)"
    echo "ptrace_scope              : $(sysctl_now kernel.yama.ptrace_scope)"
    echo "$(t "Unprivileged BPF")        : $([[ $(sysctl_now kernel.unprivileged_bpf_disabled) != 0 ]] && t "blocked" || t "allowed")"
    if is_strict; then
        for karg in "${STRICT_KARGS[@]}"; do
            grep -qw -- "$karg" /proc/cmdline || missing=$((missing + 1))
        done
        (( missing )) && echo "Kernel                    : $missing $(t "strict mode kernel arg(s) apply on next boot")"
    fi
    return 0
}

cmd_strict() {
    local args=() karg
    for karg in "${STRICT_KARGS[@]}"; do args+=("--append-if-missing=$karg"); done
    echo "$(t "Strict mode trades performance/compatibility for security (disables SMT, restricts ptrace, random MAC, lockdown).")"
    echo "$(t "Does not affect distrobox, Flatpak, or browsers.")"
    if [[ -t 0 ]]; then
        read -r -p "$(t "Enable strict mode?") [s/y/N] " answer
        [[ ${answer,,} =~ ^(s|sim|y|yes|o|oui)$ ]] || { echo "$(t "Nothing was changed.")"; exit 1; }
    fi
    sudo bash -euo pipefail -c '
        cat > "$1" <<SYSCTL
# Gerado por tamagi-harden strict. Para desfazer: tamagi-harden balanced
kernel.yama.ptrace_scope = 2
kernel.perf_event_paranoid = 3
kernel.sysrq = 0
kernel.core_pattern = |/bin/false
net.ipv4.tcp_timestamps = 0
net.ipv4.icmp_echo_ignore_all = 1
SYSCTL
        mkdir -p "$(dirname "$2")"
        cat > "$2" <<NM
# Gerado por tamagi-harden strict.
[connection-90-tamagi-strict-wifi]
match-device=type:wifi
wifi.cloned-mac-address=random

[connection-90-tamagi-strict-ethernet]
match-device=type:ethernet
ethernet.cloned-mac-address=random
NM
        sysctl --system >/dev/null
        systemctl reload NetworkManager 2>/dev/null || true
        shift 2
        /usr/libexec/tamagi/kargs "$@"
    ' _ "$STRICT_SYSCTL" "$STRICT_NM" "${args[@]}"
    tl "Strict mode enabled. Kernel arguments take effect after reboot."
}

cmd_balanced() {
    local args=() karg
    for karg in "${STRICT_KARGS[@]}"; do args+=("--delete-if-present=$karg"); done
    sudo bash -euo pipefail -c '
        rm -f "$1" "$2"
        sysctl --system >/dev/null
        systemctl reload NetworkManager 2>/dev/null || true
        shift 2
        /usr/libexec/tamagi/kargs "$@"
    ' _ "$STRICT_SYSCTL" "$STRICT_NM" "${args[@]}"
    tl "Balanced mode restored. Reboot to revert kernel arguments."
}

cmd_usb() {
    command -v usbguard >/dev/null 2>&1 || die "USBGuard: tamagi install hardening-extra"
    case "${1:-}" in
        on)
            tl "Currently connected USB devices are allowed; new ones will be blocked."
            sudo sh -c 'usbguard generate-policy > /etc/usbguard/rules.conf && chmod 600 /etc/usbguard/rules.conf && systemctl enable --now usbguard.service' ;;
        off)
            sudo systemctl disable --now usbguard.service ;;
        *) die "$(t "usage"): tamagi-harden usb on|off" ;;
    esac
}

cmd_malloc() {
    [[ -f $MALLOC_LIB ]] || die "$(t "hardened_malloc is not in this image")"
    case "${1:-}" in
        on)
            tl "Every new program will use hardened_malloc. To undo: tamagi-harden malloc off"
            sudo sh -c "echo '$MALLOC_LIB' > '$PRELOAD'" ;;
        off)
            sudo rm -f "$PRELOAD" ;;
        *) die "$(t "usage"): tamagi-harden malloc on|off" ;;
    esac
}

case "${1:-status}" in
    status)        cmd_status ;;
    strict)       cmd_strict ;;
    balanced) cmd_balanced ;;
    usb)                  shift; cmd_usb "$@" ;;
    malloc)               shift; cmd_malloc "$@" ;;
    help|-h|--help) usage ;;
    *)                    usage >&2; exit 2 ;;
esac
