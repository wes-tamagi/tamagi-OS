#!/usr/bin/bash
# tamagi-lembrete — avisa daqui a um tempo (como o "omarchy reminder").
#
#   tamagi-lembrete 10m "Tirar o chá"
#   tamagi-lembrete 1h30m "Reunião"
#   tamagi-lembrete lista            lembretes pendentes
#   tamagi-lembrete cancelar         cancela todos
#   tamagi-lembrete                  pergunta (Super+Ctrl+R)
#
# Usa um timer do systemd do usuário: sobrevive a fechar o terminal (não a
# reiniciar a máquina) e aparece como notificação do COSMIC.
set -euo pipefail
. /usr/libexec/tamagi/i18n

case "${1:-}" in
    lista|list)
        systemctl --user list-timers 'tamagi-lembrete-*' -o json 2>/dev/null \
            | jq -r '.[] | [(.next / 1000000 | strflocaltime("%H:%M:%S")), .activates] | @tsv' \
            | while IFS=$'\t' read -r at svc; do
                  desc=$(systemctl --user show -p Description --value "$svc")
                  printf '  %s  %s\n' "$at" "${desc##*alarm-symbolic }"
              done
        exit 0 ;;
    cancelar|cancel)
        systemctl --user stop 'tamagi-lembrete-*.timer' 2>/dev/null || true
        echo "$(t "Lembretes cancelados")"; exit 0 ;;
    -h|--help|ajuda)
        sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
    "")
        # Sem argumentos num terminal (Super+Ctrl+R): pergunta.
        [[ -t 0 ]] || { sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0; }
        read -r -a ask <<<"$(gum input --placeholder "10m $(t "Tirar o chá")")" || exit 0
        [[ ${#ask[@]} -gt 0 ]] || exit 0
        set -- "${ask[@]}" ;;
esac

when=$1; shift
[[ $when =~ ^([0-9]+[smhd]?)+$ ]] || { echo "uso: tamagi-lembrete <tempo, ex.: 10m> <texto>" >&2; exit 2; }
[[ $when =~ [smhd]$ ]] || when="${when}m"   # só número: minutos
text=${*:-$(t "Lembrete")}
systemd-run --user --quiet --unit="tamagi-lembrete-$(date +%s%N)" --on-active="$when" \
    --timer-property=AccuracySec=1s \
    notify-send --app-name=Tamagi --urgency=critical --icon=alarm-symbolic "$(t "Lembrete")" "$text"
echo "$(t "Lembrete em") $when: $text"
