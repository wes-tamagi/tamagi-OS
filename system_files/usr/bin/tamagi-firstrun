#!/usr/bin/bash
# tamagi-firstrun — first login of a user (runs once). The image is lean, so
# this is short: a ready-made profile (AI and agents is the suggestion), a
# browser and, for who wants to choose item by item, the catalog. Themes, wallpaper, bar and tiling are changed
# the normal way, in COSMIC Settings. Texts in pt/en/es/fr.
#   tamagi-firstrun --force     runs it again
set -uo pipefail
. /usr/libexec/tamagi/i18n
# shellcheck source=/dev/null
[[ -r /usr/share/tamagi/gum.env ]] && . /usr/share/tamagi/gum.env
MULTI=/usr/libexec/tamagi/gum-multi
CATALOG=/usr/share/tamagi/catalog.tsv
FLATPAKS=/usr/share/tamagi/flatpaks.list

STAMP="${XDG_CONFIG_HOME:-$HOME/.config}/tamagi/firstrun-done"
if [[ ${1:-} != --force && -f $STAMP ]]; then exit 0; fi

step() { echo; gum style --foreground 4 --bold "── $(t "$1") "; }
ask() { # ask [--no] <question>: Yes/No in the system language
    local def=()
    [[ $1 == --no ]] && { def=(--default=false); shift; }
    gum confirm "$(t "$1")" --affirmative "$(t "Yes")" --negative "$(t "No")" "${def[@]}"
}

clear
# Fixed width smaller than the window: a long sentence (French, Spanish)
# would otherwise break the frame.
cols=$(tput cols 2>/dev/null || echo 80)
width=$(( cols - 8 )); (( width > 84 )) && width=84; (( width < 30 )) && width=30
gum style --border double --padding "0 2" --border-foreground 4 --width "$width" \
    "$(t "Welcome to Tamagi")" "" \
    "$(t "Atomic, lean system: the host is read-only and updates itself.")" \
    "$(t "Almost nothing comes installed: you choose what you want, now or later.")"

# The big part of the first Flatpak app is the shared runtime: it starts
# downloading now, in the background, while the questions are answered. If
# nothing ends up using it, it is removed at the end.
(tamagi-install prefetch >/dev/null 2>&1 &)

# Clock: 24 hours, except in English (US), which uses AM/PM.
mkdir -p ~/.config/cosmic/com.system76.CosmicAppletTime/v1
[[ $TAMAGI_LANG == en ]] && clock24=false || clock24=true
echo "$clock24" > ~/.config/cosmic/com.system76.CosmicAppletTime/v1/military_time
# The terminal apps start in step with the COSMIC theme.
tamagi-theme sync >/dev/null 2>&1 || true

picked=() profile=""

step "Profile"
tl "A profile installs a ready-made set. You can apply others later: tamagi profiles"
p_ai="ai      $(t "AI and agents: Claude Code, Codex, opencode and the development box")"
p_dev="dev     $(t "Development: Fedora box, Node and Python, Zed and opencode")"
p_gamer="gamer   $(t "Games: native Steam, gamescope with HDR, MangoHud and Heroic")"
p_office="office  $(t "Office: Firefox, OnlyOffice and Thunderbird")"
p_pick=$(t "choose item by item from the catalog")
p_none=$(t "not now")
choice=$(gum choose --height 9 --header "$(t "Which profile?")" --selected "$p_ai" \
    "$p_ai" "$p_dev" "$p_gamer" "$p_office" "$p_pick" "$p_none") || choice=$p_none
case $choice in
    "$p_pick"|"$p_none") ;;
    *) profile=${choice%% *} ;;
esac

step "Browser"
tl "No browser ships in the image. Choose one (you can install others later)."
none=$(t "not now")
browser=$(gum choose --height 8 --header "$(t "Which browser?")" \
    "firefox   Firefox" "chrome    Google Chrome" "vivaldi   Vivaldi" "chromium  Chromium" "$none") || browser=$none
if [[ $browser != "$none" ]]; then
    method=$(gum choose --height 6 --header "$(t "Install how?")" \
        "flatpak  $(t "Flatpak — Flathub app, sandboxed (recommended)")" \
        "native   $(t "native — RPM in a layer over the image (asks for the password)")" \
        "box      $(t "box — in a Fedora box, with hardware video decoding")") || method=flatpak
    picked+=("run:tamagi-browser install ${browser%% *} --${method%% *}")
fi

if [[ $choice == "$p_pick" ]]; then
    step "What to install"
    tl "Everything here is optional and stays available later in: tamagi install"
    # The catalog, minus the browsers (asked above).
    labels=() actions=()
    while IFS=$'\t' read -r id cat size action desc; do
        [[ -z $id || $id == \#* || $cat == Navegadores ]] && continue
        labels+=("[$(t "$cat")] $(t "$desc") (≈ $size)"); actions+=("$action")
    done < "$CATALOG"
    while read -r remote app kind cat size desc; do
        [[ -z $remote || $remote == \#* || $kind != opcional ]] && continue
        labels+=("[$(t "$cat")] $(t "$desc") (≈ $size)"); actions+=("flatpak:$remote:$app")
    done < "$FLATPAKS"
    chosen=$(printf '%s\n' "${labels[@]}" | "$MULTI" --height 18 \
        --header "$(t "Space toggles · Enter installs · nothing selected: installs nothing")") || chosen=""
    if [[ -n $chosen ]]; then
        while IFS= read -r line; do
            for i in "${!labels[@]}"; do [[ ${labels[$i]} == "$line" ]] && picked+=("${actions[$i]}"); done
        done <<<"$chosen"
    fi
fi

if lsblk -no TYPE 2>/dev/null | grep -qx crypt && [[ -e /sys/class/tpm/tpm0 ]] \
        && ! grep -qw 'tpm2-device=auto' /proc/cmdline; then
    step "Encrypted disk"
    if ask --no "Unlock the disk with the TPM chip at boot, without typing the password?"; then
        tamagi-setup tpm-unlock on || true
    else
        tl "Later: tamagi setup tpm-unlock on"
    fi
fi

if (( ${#picked[@]} )) || [[ -n $profile ]]; then
    step "Installing what you chose"
    tl "You can keep using the computer: this window tells you when it is done."
    (( ${#picked[@]} )) && { tamagi-install --actions "${picked[@]}" || true; }
    [[ -n $profile ]] && { tamagi-install prefetch-wait; tamagi apply -y "$profile" || true; }
    notify-send -a Tamagi -i system-software-install "$(t "Your apps are ready")" \
        "$(t "What you chose at first login has been installed.")" 2>/dev/null || true
fi

tamagi-install prefetch-cleanup >/dev/null 2>&1 || true
mkdir -p "$(dirname "$STAMP")"
touch "$STAMP"
step "Done"
tl "Super+Space opens the menu · Super+A the command palette · Super+K the shortcuts."
tl "Themes and wallpapers: COSMIC Settings (Appearance and Wallpaper)."
tl "AI agents jailed in the project: tamagi agents run claude (inside the project folder)."
tl "Every command of the system: tamagi"
read -rsn1 -p "  ($(t "press any key to close"))"
