#!/usr/bin/bash
# tamagi-firstrun — configuração inicial do usuário (roda uma vez no primeiro login).
# Textos em pt/en/es/fr (veja /usr/libexec/tamagi/i18n).
set -uo pipefail
. /usr/libexec/tamagi/i18n
# shellcheck source=/dev/null
[[ -r /usr/share/tamagi/gum.env ]] && . /usr/share/tamagi/gum.env
MULTI=/usr/libexec/tamagi/gum-multi

STAMP="${XDG_CONFIG_HOME:-$HOME/.config}/tamagi/firstrun-done"
[[ ${1:-} == --force ]] && rm -f "$STAMP"
[[ -f $STAMP ]] && exit 0

step() { echo; gum style --foreground 4 --bold "── $(t "$1") "; }
ask() { # ask [--no] <pergunta>: Sim/Não no idioma do sistema
    local def=()
    [[ $1 == --no ]] && { def=(--default=false); shift; }
    gum confirm "$(t "$1")" --affirmative "$(t "Sim")" --negative "$(t "Não")" "${def[@]}"
}

clear
# Largura fixa menor que a janela: sem ela, uma frase longa (francês, espanhol)
# passa da borda do terminal e a moldura quebra em pedaços.
cols=$(tput cols 2>/dev/null || echo 80)
width=$(( cols - 12 )); (( width > 72 )) && width=72; (( width < 30 )) && width=30
gum style --border double --padding "0 2" --border-foreground 4 --width "$width" \
    "$(t "Bem-vindo ao Tamagi")" "" \
    "$(t "Sistema atômico: o host é somente-leitura e se atualiza sozinho.")" \
    "$(t "Apps por Flatpak, navegadores e pacotes em caixas distrobox, IA local.")"

step "Aparência"
theme=$(tamagi-theme list | gum choose --height 14 --header "$(t "Tema")   $(t "↑↓ escolher · Enter confirma · Esc volta")" --selected tokyo-night) && tamagi-theme set "$theme"
panel=$(gum choose --header "$(t "Barra")" \
    "$(t "centro — uma barra embaixo, apps no centro")" \
    "$(t "classico — uma barra embaixo, apps à esquerda")" \
    "$(t "cosmic — painel em cima e dock embaixo")") && tamagi-panel set "${panel%% *}" >/dev/null

# Relógio: 24 horas, menos em inglês (EUA), que usa AM/PM.
mkdir -p ~/.config/cosmic/com.system76.CosmicAppletTime/v1
[[ $TAMAGI_LANG == en ]] && clock24=false || clock24=true
echo "$clock24" > ~/.config/cosmic/com.system76.CosmicAppletTime/v1/military_time

step "Janelas"
tiling=false
gum confirm "$(t "Organizar as janelas automaticamente lado a lado (tiling)?")" \
    --affirmative "Tiling" --negative "$(t "Flutuantes")" && tiling=true
mkdir -p ~/.config/cosmic/com.system76.CosmicComp/v1
echo "$tiling" > ~/.config/cosmic/com.system76.CosmicComp/v1/autotile
tl "Super+Y alterna entre os dois modos a qualquer momento."

step "O que instalar"
tl "O sistema vem enxuto: escolha os apps agora. Eles baixam em segundo plano"
tl "enquanto você segue; o resto continua no Super+Espaço (Instalar)."
# Catálogo: os Flatpaks recomendados e opcionais de flatpaks.list, mais o que
# vive fora do Flatpak (Chrome e Antigravity na caixa de navegadores, Claude Code).
labels=() actions=() preset=()
add_opt() { labels+=("$1"); actions+=("$2"); [[ ${3:-} == on ]] && preset+=("$1"); return 0; }
add_opt "[$(t "Navegadores")] $(t "Chrome — navegador, numa caixa Fedora") (≈ 600 MB)" "browser" on
while read -r remote app kind cat size desc; do
    [[ -z $remote || $remote == \#* ]] && continue
    case $kind in recomendado) on=on ;; opcional) on= ;; *) continue ;; esac
    add_opt "[$(t "$cat")] $(t "$desc") (≈ $size)" "flatpak:$remote:$app" "$on"
done < /usr/share/tamagi/flatpaks.list
add_opt "[$(t "Desenvolvimento")] $(t "Claude Code — agente de programação da Anthropic") (≈ 220 MB)" "claude"
add_opt "[$(t "Desenvolvimento")] $(t "Antigravity — IDE agêntica do Google, com o Chrome") (≈ 700 MB)" "antigravity"

rec=$(t "Instalar o recomendado"); pick=$(t "Escolher app por app"); skip=$(t "agora não")
mode=$(gum choose --header "$(t "Apps")" "$rec — Chrome, Mission Center, Pika Backup" "$pick" "$skip") || mode=$skip
chosen=""
case $mode in
    "$rec"*) chosen=$(printf '%s\n' "${preset[@]}") ;;
    "$pick") selected=$(printf '%s\n' "${preset[@]}" | sed 's/,/\\,/g' | paste -sd, -)
             chosen=$(printf '%s\n' "${labels[@]}" | "$MULTI" --height 18 --selected "$selected" \
                 --header "$(t "Espaço marca/desmarca · Enter instala · nada marcado: instala nada")") || chosen="" ;;
esac
if [[ -n $chosen ]]; then
    queue="${XDG_STATE_HOME:-$HOME/.local/state}/tamagi/apps-setup.queue"
    mkdir -p "$(dirname "$queue")"; : > "$queue"
    while IFS= read -r line; do
        for i in "${!labels[@]}"; do [[ ${labels[$i]} == "$line" ]] && echo "${actions[$i]}" >> "$queue"; done
    done <<<"$chosen"
    # Sem o Chrome, o primeiro navegador Flatpak escolhido vira o padrão.
    if ! grep -qx browser "$queue"; then
        fb=$(grep -oE '^flatpak:flathub:(org\.mozilla\.firefox|com\.brave\.Browser)$' "$queue" | head -1 | cut -d: -f3)
        [[ -n $fb ]] && echo "default-browser:$fb" >> "$queue"
    fi
    systemd-run --user --quiet --collect --unit tamagi-apps-setup --setenv=TAMAGI_LANG="$TAMAGI_LANG" \
        /usr/libexec/tamagi/apps-setup "$queue" \
        && tl "Instalando em segundo plano: pode continuar. Uma notificação avisa quando terminar." \
        || tl "Não deu para começar agora. Depois: Super+Espaço, Instalar."
else
    tl "Depois: Super+Espaço, Instalar."
fi

step "Caixa de desenvolvimento (distrobox)"
tl "A caixa padrão é Fedora (com sqlite, rust/cargo, node/npm, python e compiladores)."
none=$(t "agora não")
box=$(gum choose --height 12 --selected "fedora" --header "$(t "Criar caixa de desenvolvimento com qual distro?")" \
    "fedora" "arch" "popos" "ubuntu" "alma" "rocky" "opensuse" "debian" "alpine" "$none")
if [[ -n $box && $box != "$none" ]]; then
    tamagi-devbox create "$box" || tl "Não deu para criar agora (sem rede?). Depois: tamagi-devbox"
fi

step "Linguagens e ferramentas (mise)"
tl "O mise é o gerenciador padrão de linguagens e ferramentas de desenvolvimento:"
tl "instala no seu usuário, troca de versão por pasta de projeto e se atualiza sozinho."
langs=$("$MULTI" --height 12 --header "$(t "Instalar agora? (espaço marca, Enter confirma; pode ficar vazio)")" \
    "rust@latest" "node@lts" "python@latest" "go@latest" "java@lts" "bun@latest" "deno@latest") || langs=""
if [[ -n $langs ]]; then
    # shellcheck disable=SC2086
    mise use -g $langs || tl "Não deu agora (sem rede?). Depois: mise use -g node@lts"
else
    tl "Depois: mise use -g node@lts python@latest   ·   mise ls"
fi

if lsblk -no TYPE 2>/dev/null | grep -qx crypt && [[ -e /sys/class/tpm/tpm0 ]] \
        && ! grep -qw 'tpm2-device=auto' /proc/cmdline; then
    step "Disco criptografado"
    if ask --no "Desbloquear o disco pelo chip TPM no boot, sem digitar a senha?"; then
        ujust setup-luks-tpm-unlock || true
    else
        tl "Depois: ujust setup-luks-tpm-unlock"
    fi
fi

step "IA local (llama.cpp)"
tamagi-ai presets
if ask "Baixar um modelo agora? (o download pode levar alguns minutos)"; then
    tamagi-ai setup || tl "Depois: tamagi-ai setup"
else
    tl "Depois: tamagi-ai setup"
fi



mkdir -p "$(dirname "$STAMP")"
touch "$STAMP"
step "Pronto"
/usr/libexec/tamagi/apps-setup status
tl "Super+Espaço abre o menu · Super+K mostra os atalhos · Super+A ações rápidas."
tl "Jogos: ujust setup-gaming · Segurança: tamagi-harden status · Idioma: tamagi-lang pick"
read -rsn1 -p "  ($(t "qualquer tecla fecha"))"
