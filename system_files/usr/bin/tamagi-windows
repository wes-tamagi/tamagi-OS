#!/usr/bin/bash
# tamagi-windows — real Windows 11, on demand, in a rootless container.
#
# For what Bottles (Wine) cannot run: Office 365, Adobe, banking and
# certificate software, USB devices with Windows-only drivers. Uses
# dockur/windows (QEMU/KVM inside a rootless Podman container) and opens the
# screen with FreeRDP (Flatpak). Nothing from Windows ships in the image: it
# is downloaded from Microsoft on your machine, after you accept the licence
# notice.
#
#   tamagi windows                 opens (installs the first time)
#   tamagi windows install         creates the machine and downloads Windows (~6 GB)
#   tamagi windows open            starts (if needed) and opens the desktop
#   tamagi windows web             opens the screen in the browser (install/emergency)
#   tamagi windows stop            shuts Windows down (frees the memory)
#   tamagi windows status
#   tamagi windows remove          deletes the machine and the Windows disk
#
# Cost while running: the whole reserved memory (4 to 8 GB, depending on the
# machine). Stopped, it uses none. Disk: up to 64 GB, growing gradually.
# Files: the ~/Windows folder shows up in Windows (network, "host.lan\Data"
# and the "Tamagi" drive in the session).
set -euo pipefail
. /usr/libexec/tamagi/i18n

IMAGE="docker.io/dockurr/windows:6.06"
NAME=tamagi-windows
CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
ENVF="$CFG/tamagi/windows.env"
UNIT_DIR="$CFG/containers/systemd"
UNIT="$UNIT_DIR/$NAME.container"
STORAGE="${XDG_DATA_HOME:-$HOME/.local/share}/tamagi-windows"
SHARED="$HOME/Windows"
APPS="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
RDP_APP=com.freerdp.FreeRDP
MIN_RAM_GB=12

die() { echo "$(t "error"): $*" >&2; exit 1; }
installed() { [[ -f $UNIT && -f $ENVF ]]; }
running() { [[ $(podman container inspect -f '{{.State.Running}}' "$NAME" 2>/dev/null) == true ]]; }
ram_gb() { awk '/^MemTotal:/ {printf "%d", $2 / 1048576 + 0.5}' /proc/meminfo; }

check_host() {
    [[ -c /dev/kvm && -r /dev/kvm && -w /dev/kvm ]] \
        || die "$(t "no access to /dev/kvm: enable virtualization (VT-x/AMD-V) in the BIOS")"
    [[ -c /dev/net/tun ]] || die "$(t "/dev/net/tun is missing")"
    local ram; ram=$(ram_gb)
    (( ram >= MIN_RAM_GB )) || die "$(t "not enough memory for Windows"): ${ram} GB (min. ${MIN_RAM_GB} GB)"
    local free_gb
    mkdir -p "$(dirname "$STORAGE")"
    free_gb=$(df -BG --output=avail "$(dirname "$STORAGE")" | tail -1 | tr -dc 0-9)
    (( free_gb >= 40 )) || die "$(t "not enough free space"): ${free_gb} GB (min. 40 GB)"
}

# Memória do Windows: um quarto da máquina, entre 4 e 8 GB.
vm_ram() { local r; r=$(( $(ram_gb) / 4 )); (( r < 4 )) && r=4; (( r > 8 )) && r=8; echo "${r}G"; }
vm_cores() { local c; c=$(( $(nproc) / 2 )); (( c < 2 )) && c=2; (( c > 8 )) && c=8; echo "$c"; }

lang_settings() { # idioma do Windows conforme o do Tamagi
    case $TAMAGI_LANG in
        pt) echo "LANGUAGE=Portuguese"; echo "REGION=pt-BR"; echo "KEYBOARD=pt-BR" ;;
        es) echo "LANGUAGE=Spanish"; echo "REGION=es-ES"; echo "KEYBOARD=es-ES" ;;
        fr) echo "LANGUAGE=French"; echo "REGION=fr-FR"; echo "KEYBOARD=fr-FR" ;;
        *)  echo "LANGUAGE=English"; echo "REGION=en-US"; echo "KEYBOARD=en-US" ;;
    esac
}

license_notice() {
    cat <<EOF

  $(t "Windows 11 in a container")

  $(t "Windows is downloaded from Microsoft now, on your machine (about 6 GB),")
  $(t "and installed automatically; it takes 10 to 30 minutes.")
  $(t "It is Microsoft software: to use it you need a")
  $(t "valid license. Without an activation key it works, but stays unactivated.")
  $(t "Memory reserved while running"): $(vm_ram) · CPUs: $(vm_cores) · $(t "disk up to 64 GB")

EOF
}

ensure_rdp() {
    flatpak info "$RDP_APP" >/dev/null 2>&1 && return 0
    echo "$(t "Installing the remote desktop client (FreeRDP)…")"
    flatpak install --user -y --noninteractive flathub "$RDP_APP"
}

install_vm() {
    if installed; then
        echo "$(t "Windows is already installed"). tamagi-windows open"
        return 0
    fi
    check_host
    license_notice
    if [[ -t 0 ]]; then
        gum confirm "$(t "I accept: download and install Windows")" || exit 0
    elif [[ ${TAMAGI_WINDOWS_ACCEPT:-} != yes ]]; then
        die "$(t "run it in a terminal to accept the license notice")"
    fi
    mkdir -p "$(dirname "$STORAGE")" "$SHARED" "$UNIT_DIR" "$(dirname "$ENVF")"
    # Em btrfs, o disco do Windows fica num subvolume à parte (fora dos
    # snapshots da pasta pessoal) e sem cópia-na-escrita (disco de VM muda o
    # tempo todo; com CoW fica lento e fragmenta).
    if [[ ! -d $STORAGE ]]; then
        btrfs subvolume create "$STORAGE" >/dev/null 2>&1 || mkdir -p "$STORAGE"
    fi
    # +C só vale para arquivos criados depois: aplica enquanto a pasta está vazia
    # (o home-snapshots pode já tê-la criado como subvolume).
    [[ -z $(ls -A "$STORAGE") ]] && chattr +C "$STORAGE" 2>/dev/null || true
    # Senha aleatória da conta do Windows; fica só neste arquivo (0600).
    local pass user
    pass=$(head -c 18 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 16)
    user=$(id -un | tr -dc 'A-Za-z0-9_' | head -c 20); [[ -n $user ]] || user=tamagi
    umask 077
    {
        echo "# Gerado por tamagi-windows. Conta do Windows e recursos da máquina."
        echo "VERSION=11"
        echo "USERNAME=$user"
        echo "PASSWORD=$pass"
        echo "RAM_SIZE=$(vm_ram)"
        echo "CPU_CORES=$(vm_cores)"
        echo "DISK_SIZE=64G"
        lang_settings
    } > "$ENVF"
    umask 022
    # Quadlet: o systemd do usuário cuida do contêiner (sem [Install]: só liga
    # quando você abre o Windows).
    cat > "$UNIT" <<EOF
# Gerado por tamagi-windows. Windows 11 (dockur/windows) sob demanda.
[Unit]
Description=Windows 11 do Tamagi (dockur)

[Container]
ContainerName=$NAME
Image=$IMAGE
EnvironmentFile=$ENVF
AddDevice=/dev/kvm
AddDevice=/dev/net/tun
AddCapability=NET_ADMIN
PublishPort=127.0.0.1:8006:8006
PublishPort=127.0.0.1:3389:3389/tcp
PublishPort=127.0.0.1:3389:3389/udp
Volume=$STORAGE:/storage:Z
Volume=$SHARED:/shared:Z
StopTimeout=120

[Service]
TimeoutStartSec=900
TimeoutStopSec=150
EOF
    systemctl --user daemon-reload
    echo "$(t "Downloading the container image…")"
    podman pull "$IMAGE" >/dev/null
    ensure_rdp
    desktop_entry
    systemctl --user start "$NAME.service"
    echo
    echo "$(t "Windows installation started. Follow it in the browser"): http://127.0.0.1:8006"
    echo "$(t "When it finishes, open it with"): tamagi-windows open"
    xdg-open http://127.0.0.1:8006 >/dev/null 2>&1 || true
}

desktop_entry() {
    mkdir -p "$APPS"
    cat > "$APPS/tamagi-windows.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Windows
Comment=$(t "Windows 11 in a container (dockur)")
Exec=tamagi-windows open
Icon=computer
Terminal=false
Categories=System;Emulator;
Actions=parar;navegador;

[Desktop Action parar]
Name=$(t "Shut down Windows")
Exec=tamagi-windows stop

[Desktop Action navegador]
Name=$(t "Open in the browser")
Exec=tamagi-windows web
EOF
    update-desktop-database "$APPS" 2>/dev/null || true
}

wait_rdp() { # espera o Windows aceitar conexões RDP (até ~5 min)
    for _ in $(seq 150); do
        (exec 3<>/dev/tcp/127.0.0.1/3389) 2>/dev/null && return 0
        running || die "$(t "the Windows container stopped; see"): journalctl --user -u $NAME"
        sleep 2
    done
    return 1
}

start_vm() {
    installed || { install_vm; exit 0; }
    running && return 0
    echo "$(t "Starting Windows…")"
    systemctl --user start "$NAME.service"
}

open_vm() {
    start_vm
    wait_rdp || die "$(t "Windows did not respond; try"): tamagi-windows web"
    ensure_rdp
    # shellcheck source=/dev/null
    . "$ENVF"
    # A senha vai pela entrada padrão (não aparece na lista de processos).
    printf '%s\n' "$PASSWORD" | flatpak run --filesystem="$SHARED" "$RDP_APP" \
        /v:127.0.0.1 /u:"$USERNAME" /from-stdin:force /cert:ignore \
        /dynamic-resolution /scale-desktop:100 +clipboard /sound /microphone \
        /drive:Tamagi,"$SHARED" /title:Windows >/dev/null 2>&1 &
    disown
}

case "${1:-open}" in
    install) install_vm ;;
    open)       open_vm ;;
    web)    start_vm; xdg-open http://127.0.0.1:8006 ;;
    stop)       systemctl --user stop "$NAME.service"; echo "$(t "Windows shut down")" ;;
    status)
        if ! installed; then echo "$(t "Windows not installed") (tamagi-windows install)"; exit 0; fi
        echo "$(t "Windows installed"): $(running && t "running" || t "off")"
        echo "$(t "disk"): $(du -sh "$STORAGE" 2>/dev/null | cut -f1) · $(grep -E '^(RAM_SIZE|CPU_CORES)=' "$ENVF" | tr '\n' ' ')"
        echo "$(t "shared folder"): $SHARED" ;;
    remove)
        installed || { echo "$(t "Windows not installed")"; exit 0; }
        gum confirm "$(t "Delete Windows and its whole disk? This cannot be undone.")" || exit 0
        systemctl --user stop "$NAME.service" 2>/dev/null || true
        rm -f "$UNIT" "$ENVF" "$APPS/tamagi-windows.desktop"
        systemctl --user daemon-reload
        podman unshare rm -rf --one-file-system "${STORAGE:?}"
        echo "$(t "Windows removed"). $(t "The folder") $SHARED $(t "was kept")." ;;
    -h|--help) sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//' ;;
    *) die "usage: tamagi-windows [install|open|web|stop|status|remove]" ;;
esac
