#!/usr/bin/python3
"""tamagi-doctor — diagnóstico autônomo de integridade, deriva e desempenho.

Executa 12 verificações arquiteturais (imagem bootc, kernel/Secure Boot,
Btrfs/armazenamento, zram/desempenho, systemd, camadas sysext, contêineres,
GPU, KVM/VMs, segurança, desktop/menu e IA local). Suporta --json, --fix
(correções seguras no usuário) e --explain (resumo via IA local llama.cpp).
"""
import argparse
import importlib.util
import json
import os
import pathlib
import re
import shutil
import subprocess
import sys
import urllib.request


def _load_i18n():
    for candidate in (
        pathlib.Path("/usr/libexec/tamagi/tamagi_i18n.py"),
        pathlib.Path(__file__).resolve().parents[1] / "libexec/tamagi/tamagi_i18n.py",
    ):
        if candidate.is_file():
            spec = importlib.util.spec_from_file_location("tamagi_i18n", candidate)
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            return mod
    raise RuntimeError("tamagi_i18n.py not found")


_I18N = _load_i18n()
t = _I18N.t
HOME = pathlib.Path.home()
DATA = pathlib.Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share"))


def run_out(cmd, timeout=5):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout.strip(), r.stderr.strip()
    except (OSError, subprocess.SubprocessError):
        return 127, "", ""


def item(check_id, status, summary, fix=""):
    return {"id": check_id, "status": status, "summary": summary, "fix": fix}


def check_image():
    quarantine = pathlib.Path("/var/lib/tamagi/quarantine.list")
    q_count = 0
    if quarantine.is_file():
        q_count = sum(1 for ln in quarantine.read_text(errors="replace").splitlines() if ln.strip() and not ln.startswith("#"))
    boot_fail = pathlib.Path("/var/lib/tamagi/boot-failures")
    fails = list(boot_fail.glob("*.txt")) if boot_fail.is_dir() else []
    if q_count > 0:
        return item("image", "WARN", f"{t('Quarantined digest')}: {q_count}", "tamagi-update quarantine")
    if fails:
        return item("image", "WARN", f"{t('Pending boot report')}: {len(fails)}", "tamagi-boot-report show")
    ver = ""
    try:
        for ln in pathlib.Path("/usr/lib/os-release").read_text().splitlines():
            if ln.startswith("PRETTY_NAME="):
                ver = ln.split("=", 1)[1].strip('"')
                break
    except OSError:
        pass
    return item("image", "OK", ver or "Tamagi")


def check_kernel():
    kver = os.uname().release
    flav = ""
    p = pathlib.Path("/usr/share/tamagi/kernel-flavor")
    if p.is_file():
        flav = p.read_text().strip()
    has_scx = pathlib.Path("/sys/kernel/sched_ext").is_dir()
    rc, sb, _ = run_out(["mokutil", "--sb-state"])
    if rc == 0 and "enabled" in sb.lower() and flav == "ogc":
        cert = pathlib.Path("/etc/pki/akmods/certs/akmods-ublue.der")
        if cert.is_file():
            rc2, _, _ = run_out(["mokutil", "--test-key", str(cert)])
            if rc2 == 0:
                return item("kernel", "WARN", f"{kver} ({flav}): {t('Universal Blue Secure Boot key missing')}",
                            "tamagi setup secure-boot-key")
    detail = f"{kver}" + (f" ({flav})" if flav else "") + (" · sched_ext" if has_scx else "")
    return item("kernel", "OK", detail)


def check_storage():
    try:
        st = shutil.disk_usage(str(HOME))
        free_pct = (st.free * 100.0) / st.total if st.total else 100.0
        free_gb = st.free / (1024 ** 3)
    except OSError:
        return item("storage", "WARN", t("could not measure disk space"))
    if free_pct < 5 or free_gb < 5:
        return item("storage", "FAIL", f"{t('critical disk space')}: {free_gb:.1f} GiB ({free_pct:.0f}%)",
                    "flatpak uninstall --unused && podman system prune")
    if free_pct < 12 or free_gb < 15:
        return item("storage", "WARN", f"{t('low disk space')}: {free_gb:.1f} GiB ({free_pct:.0f}%)",
                    "flatpak uninstall --unused")
    # Verifica se ~/.local ou ~/.local/state pertence ao usuário atual (senão os apps não conseguem gravar a própria configuração).
    uid = os.getuid()
    for rel in (".local", ".local/state", ".local/share"):
        d = HOME / rel
        if d.exists():
            try:
                if d.stat().st_uid != uid:
                    return item("storage", "FAIL", f"{d} {t('is owned by another user (root?)')}",
                                f"sudo chown {os.environ.get('USER', '$USER')}: {HOME / '.local'} {HOME / '.local/state'}")
            except OSError:
                pass
    # Verifica atributo NoCoW (+C) na pasta de discos de VM em Btrfs
    vm_dir = DATA / "libvirt/images"
    if vm_dir.is_dir():
        rc, out, _ = run_out(["lsattr", "-d", str(vm_dir)])
        if rc == 0 and "C" not in out.split()[0]:
            return item("storage", "WARN", f"{free_gb:.1f} GiB · {t('VM directory missing NoCoW (+C) attribute')}",
                        f"chattr +C {vm_dir}")
    return item("storage", "OK", f"{free_gb:.1f} GiB {t('free')} ({free_pct:.0f}%)")


def check_performance():
    issues = []
    zram = pathlib.Path("/sys/block/zram0/disksize").is_file()
    if not zram:
        issues.append(t("no zram0"))
    rc, db, _ = run_out(["sysctl", "-n", "vm.dirty_bytes"])
    try:
        mem_kb = int([l.split()[1] for l in pathlib.Path("/proc/meminfo").read_text().splitlines() if l.startswith("MemTotal:")][0])
    except (OSError, ValueError, IndexError):
        mem_kb = 0
    if rc == 0 and db == "0" and mem_kb >= 16 * 1024 * 1024:
        issues.append("vm.dirty_bytes=0")
    if issues:
        return item("performance", "WARN", ", ".join(issues), "tamagi-perf status")
    rc_cc, cc, _ = run_out(["sysctl", "-n", "net.ipv4.tcp_congestion_control"])
    return item("performance", "OK", f"zram · TCP {cc or '-'}")


def check_systemd():
    rc1, sys_f, _ = run_out(["systemctl", "--failed", "--no-legend", "--plain"])
    rc2, usr_f, _ = run_out(["systemctl", "--user", "--failed", "--no-legend", "--plain"])
    if rc1 != 0 and rc2 != 0:
        return item("systemd", "OK", t("systemd unavailable in this environment"))
    failed = [l.split()[0] for l in (sys_f + "\n" + usr_f).splitlines() if l.strip()]
    if failed:
        return item("systemd", "WARN", f"{t('failed units')}: {', '.join(failed[:4])}",
                    "systemctl --failed && systemctl --user --failed")
    return item("systemd", "OK", t("no failed units"))


def check_layers():
    rc, out, _ = run_out(["tamagi-layer", "stale"])
    stale = [l.strip() for l in out.splitlines() if l.strip()] if rc == 0 else []
    if stale:
        return item("layers", "WARN", f"{t('stale layers')}: {', '.join(stale)}", "tamagi-layer rebuild")
    return item("layers", "OK", t("layers up to date"))


def check_containers():
    rc, out, _ = run_out(["podman", "ps", "-a", "--filter", "label=manager=distrobox", "--format", "{{.Names}}"])
    if rc != 0:
        return item("containers", "OK", t("podman unavailable in this environment"))
    boxes = [b for b in out.splitlines() if b.strip()]
    return item("containers", "OK", f"{len(boxes)} {t('distrobox containers')}" + (f" ({', '.join(boxes[:5])})" if boxes else ""))


def check_gpu():
    renders = sorted(pathlib.Path("/dev/dri").glob("renderD*")) if pathlib.Path("/dev/dri").is_dir() else []
    if not renders:
        return item("gpu", "WARN", t("no DRM render node found"))
    return item("gpu", "OK", f"{len(renders)} GPU DRM ({', '.join(r.name for r in renders)})")


def check_kvm():
    kvm = pathlib.Path("/dev/kvm")
    if not kvm.exists():
        return item("virtualization", "WARN", t("/dev/kvm missing (virtualization disabled in BIOS?)"))
    if not os.access(kvm, os.R_OK | os.W_OK):
        return item("virtualization", "WARN", t("no read/write permission on /dev/kvm"))
    return item("virtualization", "OK", "/dev/kvm OK")


def check_security():
    rc, enf, _ = run_out(["getenforce"])
    if rc == 0 and enf.lower() != "enforcing":
        return item("security", "WARN", f"SELinux: {enf}", "sudo setenforce 1")
    mode = t("strict") if pathlib.Path("/etc/sysctl.d/90-tamagi-strict.conf").exists() else t("balanced")
    return item("security", "OK", f"SELinux {enf or '-'} · {t('mode')} {mode}")


def check_desktop():
    apps = DATA / "applications"
    bad = []
    if apps.is_dir() and shutil.which("desktop-file-validate"):
        for f in sorted(apps.glob("*.desktop")):
            rc, _, _ = run_out(["desktop-file-validate", str(f)])
            if rc != 0:
                bad.append(f.name)
    if bad:
        return item("desktop", "WARN", f"{t('invalid .desktop entries')}: {', '.join(bad[:3])}",
                    f"desktop-file-validate {apps}/{bad[0]}")
    if shutil.which("agy") or (HOME / ".local/bin/agy").is_file():
        has_agy = pathlib.Path("/usr/share/applications/agy.desktop").is_file() or (apps / "agy.desktop").is_file()
        if not has_agy:
            return item("desktop", "WARN", t("agy is installed but missing from the menu"),
                        "tamagi-doctor --fix")
    return item("desktop", "OK", t("menu and .desktop entries are valid"))


def check_ai():
    vk = pathlib.Path("/usr/lib64/ggml/libggml-vulkan.so").is_file()
    if not vk:
        return item("ai", "WARN", t("llama.cpp Vulkan backend missing"))
    rc, state, _ = run_out(["systemctl", "--user", "is-active", "llama-server.service"])
    return item("ai", "OK", f"Vulkan · llama-server: {state if rc == 0 else t('stopped')}")


CHECKS = [
    check_image, check_kernel, check_storage, check_performance, check_systemd,
    check_layers, check_containers, check_gpu, check_kvm, check_security,
    check_desktop, check_ai,
]


def run_safe_fixes():
    actions = []
    apps = DATA / "applications"
    if apps.is_dir() and shutil.which("update-desktop-database"):
        run_out(["update-desktop-database", str(apps)])
        actions.append("update-desktop-database")
    # Se agy está instalado mas a imagem em execução ainda não tem /usr/share/applications/agy.desktop, cria no usuário.
    if (shutil.which("agy") or (HOME / ".local/bin/agy").is_file()) and not pathlib.Path("/usr/share/applications/agy.desktop").is_file():
        if not (apps / "agy.desktop").is_file():
            apps.mkdir(parents=True, exist_ok=True)
            (apps / "agy.desktop").write_text(
                "[Desktop Entry]\nType=Application\nName=Antigravity (agy)\nTryExec=agy\n"
                "Exec=/usr/libexec/tamagi/popup --class agy --title \"Antigravity (agy)\" agy\n"
                "StartupWMClass=agy\nIcon=utilities-terminal\nTerminal=false\nCategories=Development;\n"
                "Keywords=agy;antigravity;google;gemini;ia;ai;agent;\n",
                encoding="utf-8",
            )
            run_out(["update-desktop-database", str(apps)])
            actions.append("agy.desktop")
    # Limpa falhas transitórias de unidades do usuário.
    rc, usr_f, _ = run_out(["systemctl", "--user", "--failed", "--no-legend", "--plain"])
    if rc == 0 and usr_f.strip():
        run_out(["systemctl", "--user", "reset-failed"])
        actions.append("systemctl --user reset-failed")
    return actions


def explain_with_ai(results):
    problems = [r for r in results if r["status"] != "OK"]
    if not problems:
        return t("No issues found to explain.")
    lang = _I18N.detect_lang()
    lang_name = {"pt": "português", "en": "English", "es": "español", "fr": "français"}[lang]
    body = json.dumps({
        "messages": [
            {"role": "system", "content": f"You are a concise Linux systems architect. Reply in {lang_name} in at most 4 short bullet points explaining the root cause and exact next step based ONLY on the JSON diagnostics."},
            {"role": "user", "content": json.dumps(problems, ensure_ascii=False)},
        ],
        "temperature": 0.2,
        "max_tokens": 300,
    }).encode("utf-8")
    req = urllib.request.Request(
        "http://127.0.0.1:9931/v1/chat/completions",
        data=body,
        headers={"Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            return data["choices"][0]["message"]["content"].strip()
    except Exception:
        return t("Local AI unavailable (start with: tamagi-ai start).")


def main():
    p = argparse.ArgumentParser(
        prog="tamagi-doctor",
        description=t("Autonomous health, integrity, and performance diagnostics for Tamagi"),
    )
    p.add_argument("--json", action="store_true", help=t("structured JSON output"))
    p.add_argument("--fix", action="store_true", help=t("apply safe user-level fixes"))
    p.add_argument("--explain", action="store_true", help=t("ask local AI (llama.cpp) for an explanation"))
    args = p.parse_args()

    fixed = run_safe_fixes() if args.fix else []
    results = [fn() for fn in CHECKS]

    if args.json:
        print(json.dumps({"checks": results, "fixed": fixed}, ensure_ascii=False, indent=2))
        return

    if fixed:
        print(f"{t('Applied fixes')}: {', '.join(fixed)}\n")

    ok_n = sum(1 for r in results if r["status"] == "OK")
    warn_n = sum(1 for r in results if r["status"] == "WARN")
    fail_n = sum(1 for r in results if r["status"] == "FAIL")

    colors = {"OK": "\033[32m", "WARN": "\033[33m", "FAIL": "\033[31m"}
    reset = "\033[0m"
    use_color = sys.stdout.isatty()
    for r in results:
        tag = f"{colors[r['status']]}{r['status']:4}{reset}" if use_color else f"{r['status']:4}"
        print(f"  [{tag}] {r['id']:15} {r['summary']}")
        if r["fix"]:
            print(f"           → {r['fix']}")

    print(f"\n{t('Summary')}: {ok_n} OK · {warn_n} WARN · {fail_n} FAIL")
    if args.explain:
        print(f"\n── {t('Local AI analysis')}")
        print(explain_with_ai(results))
    sys.exit(1 if fail_n else 0)


if __name__ == "__main__":
    main()
