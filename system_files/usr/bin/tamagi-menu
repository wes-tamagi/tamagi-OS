def is_available(action):
    """Retorna False se a ação exige um binário (try_exec) não instalado."""
    req = action.get("try_exec")
    if not req:
        return True
    if shutil.which(req):
        return True
    home = pathlib.Path.home()
    return (
        os.access(home / ".local/bin" / req, os.X_OK)
    )


def detect_lang():
    raw = os.environ.get("TAMAGI_LANG") or os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES")
    if not raw:
        try:
            raw = (CONFIG_DIR / "lang").read_text(encoding="utf-8").strip().splitlines()[0]
        except (OSError, IndexError):
            raw = ""
    if not raw:
        raw = os.environ.get("LANG") or "en"
    code = raw.split("_")[0].split(".")[0].lower()
    return code if code in ("pt", "en", "es", "fr") else "en"


def load_registry():
    with open(ACTIONS_FILE, "rb") as fh:
        data = tomllib.load(fh)
    cats = sorted(data.get("categories", {}).items(), key=lambda kv: kv[1].get("order", 99))
    actions = data.get("action", [])
    return cats, actions


def loc(mapping, lang):
    if isinstance(mapping, dict):
        return mapping.get(lang) or mapping.get("en") or mapping.get("pt") or ""
    return str(mapping)


APP_ID = "org.tamagi.Menu"
APP_PATH = "/org/tamagi/Menu"


def current_theme():
    """The theme tamagi-theme uses: a saved theme the image no longer has
    falls back to the default (Ipê), as in `tamagi-theme current`."""
    try:
        name = (CONFIG_DIR / "theme").read_text(encoding="utf-8").strip()
    except OSError:
        name = ""
    if name and (pathlib.Path("/usr/share/tamagi/themes") / f"{name}.conf").is_file():
        return name
    if name and (CONFIG_DIR / "themes" / f"{name}.conf").is_file():
        return name
    return "ipe"


def gvariant_str(value):
    return "'" + value.replace("\\", "\\\\").replace("'", "\\'") + "'"


def show_remote(category):
    """Pede à instância residente que mostre a paleta. False se não houver uma.

    Usa o gdbus (C, poucos milissegundos) em vez de importar o GTK só para
    repassar o pedido. O token de ativação vai junto: com ele o compositor
    entrega o teclado à janela também quando ela é aberta por um clique.
    """
    gdbus = shutil.which("gdbus")
    if not gdbus or not os.environ.get("DBUS_SESSION_BUS_ADDRESS"):
        return False
    token = os.environ.get("XDG_ACTIVATION_TOKEN", "")
    pdata = "{'activation-token': <%s>}" % gvariant_str(token) if token else "@a{sv} {}"
    try:
        r = subprocess.run(
            [gdbus, "call", "--session", "--dest", APP_ID, "--object-path", APP_PATH,
             "--method", "org.gtk.Actions.Activate", "show", f"[<{gvariant_str(category)}>]", pdata],
            capture_output=True, timeout=2, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return False
    return r.returncode == 0


def load_theme_colors():
    theme_name = current_theme()
    colors = {
        "name": theme_name,
        "scheme": "dark",
        "bg": "#1a1b26",
        "surface": "#24283b",
        "fg": "#c0caf5",
        "muted": "#7aa2f7",
        "accent": "#7aa2f7",
        "border": "#414868",
    }
    conf = THEMES_DIR / f"{theme_name}.conf"
    if conf.is_file():
        text = conf.read_text(encoding="utf-8", errors="replace")
        for key, pat in (("scheme", r'^SCHEME=(\w+)'), ("bg", r'^BG="([^"]+)"'), ("fg", r'^FG="([^"]+)"')):
            m = re.search(pat, text, re.M)
            if m:
                colors[key] = m.group(1)
        m_wall = re.search(r'^WALL=\(([^)]+)\)', text, re.M)
        if m_wall:
            vals = re.findall(r'"([^"]+)"', m_wall.group(1))
            if len(vals) >= 3:
                colors["surface"] = vals[0]
                colors["accent"] = vals[2]
        m_pal = re.search(r'^PALETTE=\(([^)]+)\)', text, re.M)
        if m_pal:
            vals = re.findall(r'"([^"]+)"', m_pal.group(1))
            if len(vals) >= 9:
                colors["border"] = vals[8]
                colors["muted"] = vals[7]
    return colors


def quick_status(lang):
    """Lê estado vivo rápido em arquivos locais (sem bloquear a abertura)."""
    tr = UI[lang]
    theme = current_theme()

    ai_label = tr["ai_off"]
    try:
        for line in (CONFIG_DIR / "ai.env").read_text(encoding="utf-8").splitlines():
            if line.startswith("TAMAGI_AI_MODEL="):
                m = line.split("=", 1)[1].strip().strip('"').strip("'")
                if m:
                    short = re.sub(r"-Q\d.*$", "", m)
                    ai_label = f"AI: {short[:26]}"
                break
    except OSError:
        pass

    boot_pending = False
    try:
        seen = set()
        seen_file = STATE_DIR / "boot-failures-seen"
        if seen_file.is_file():
            seen = set(seen_file.read_text(encoding="utf-8").splitlines())
        if BOOT_FAIL_DIR.is_dir():
            boot_pending = any(f.name not in seen for f in BOOT_FAIL_DIR.glob("*.txt"))
    except OSError:
        pass

    quarantined = 0
    try:
        if QUARANTINE_FILE.is_file():
            quarantined = sum(1 for ln in QUARANTINE_FILE.read_text(encoding="utf-8").splitlines()
                              if ln.strip() and not ln.strip().startswith("#"))
    except OSError:
        pass

    return {
        "theme": theme,
        "ai": ai_label,
        "boot_pending": boot_pending,
        "quarantined": quarantined,
    }


def check_staged_update():
    try:
        r = subprocess.run(["bootc", "status", "--format", "json"],
                           capture_output=True, text=True, timeout=3, check=False)
        if r.returncode == 0 and r.stdout.strip():
            data = json.loads(r.stdout)
            return data.get("status", {}).get("staged") is not None
    except (OSError, ValueError, subprocess.TimeoutExpired):
        pass
    return False


def fuzzy_score(query, action, lang):
    if not query:
        return 1
    q = query.lower().strip()
    title = loc(action.get("title", {}), lang).lower()
    sub = loc(action.get("subtitle", {}), lang).lower()
    kw = str(action.get("keywords", "")).lower()
    aid = str(action.get("id", "")).lower()
    hay = f"{title} {sub} {kw} {aid}"
    tokens = q.split()
    if all(tok in hay for tok in tokens):
        score = 100
        if title.startswith(q):
            score += 60
        elif q in title:
            score += 35
        if q in aid:
            score += 20
        return score
    # Subsequência fuzzy no título/keywords
    it = iter(hay)
    if all(ch in it for ch in q.replace(" ", "")):
        return 10
    return 0


def spawn_action(action, lang):
    cmd = action["command"]
    tr = UI[lang]
    if action.get("terminal", False):
        popup = "/usr/libexec/tamagi/popup"
        needs_pause = cmd not in INTERACTIVE_NO_PAUSE and not cmd.startswith("bash -c ")
        if cmd.startswith("bash -c "):
            # Já é um fluxo interativo bash; pausa ao final para o usuário ver o resultado.
            inner = shlex.split(cmd)[2]
            wrapped = f'{inner}; echo; read -rsn1 -p "  ({tr["press_any"]})"'
            argv = [popup, "--title", loc(action["title"], lang), "bash", "-c", wrapped]
        elif needs_pause:
            wrapped = f'{cmd}; echo; read -rsn1 -p "  ({tr["press_any"]})"'
            argv = [popup, "--title", loc(action["title"], lang), "bash", "-c", wrapped]
        else:
            argv = [popup, "--title", loc(action["title"], lang), "bash", "-c", cmd]
        if shutil.which(popup):
            subprocess.Popen(argv, start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        else:
            subprocess.Popen(["bash", "-c", cmd], start_new_session=True)
    else:
        subprocess.Popen(["bash", "-c", cmd], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def run_cli_fallback(cats, actions, lang, initial_cat, list_only=False):
    filtered = [
        a for a in actions
        if is_available(a) and (initial_cat == "all" or a.get("category") == initial_cat)
    ]
    if not list_only and shutil.which("gum") and sys.stdin.isatty():
        labels = [f"{loc(a['title'], lang)}  —  {loc(a['subtitle'], lang)}" for a in filtered]
        r = subprocess.run(["gum", "filter", "--placeholder", UI[lang]["placeholder"]],
                           input="\n".join(labels), text=True, capture_output=True, check=False)
        chosen = r.stdout.strip()
        for label, action in zip(labels, filtered):
            if label == chosen:
                subprocess.run(["bash", "-c", action["command"]], check=False)
                return 0
        return 0
    for a in filtered:
        print(f"{a['id']:22} [{a['category']:10}] {loc(a['title'], lang)}")
    return 0


def run_gui(cats, actions, lang, initial_cat, service=False):
    import gi
    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    from gi.repository import Adw, Gdk, Gio, GLib, Gtk, Pango  # noqa: E402

    tr = UI[lang]

    class PaletteWindow(Adw.ApplicationWindow):
        def __init__(self, app, start_cat):
            super().__init__(application=app, title="Tamagi")
            self.set_default_size(680, 540)
            self.set_resizable(False)
            self.set_decorated(False)
            self.active_cat = start_cat
            self.pending_confirm = None
            self.visible_actions = []
            self.css_provider = None
            self.css_theme = None
            # Linhas montadas uma vez por ação; filtrar só reordena e esconde.
            self.rows = {}
            self.order = {}

            self._apply_css()
            self._build_ui()
            # Fechar só esconde: a próxima abertura é imediata.
            self.connect("close-request", self._on_close_request)

        def prepare(self, cat):
            """Deixa a paleta pronta para aparecer: busca limpa, estado atual."""
            if self.css_theme != current_theme():
                self._apply_css()
            self._cancel_confirm()
            self.search.set_text("")
            self.active_cat = cat
            for k, btn in self.cat_buttons.items():
                if k == cat:
                    btn.add_css_class("active")
                else:
                    btn.remove_css_class("active")
            self._refresh_status()
            self._refresh_list()
            self.search.grab_focus()

            # Checa atualização pendente em background sem travar a abertura.
            def bg_check():
                if check_staged_update():
                    GLib.idle_add(self._show_staged_badge)
            threading.Thread(target=bg_check, daemon=True).start()

        def _on_close_request(self, _win):
            self.set_visible(False)
            return True

        def dismiss(self):
            self.set_visible(False)

        def _apply_css(self):
            colors = load_theme_colors()
            self.css_theme = colors["name"]
            is_dark = colors["scheme"] == "dark"
            sm = Adw.StyleManager.get_default()
            sm.set_color_scheme(
                Adw.ColorScheme.FORCE_DARK if is_dark else Adw.ColorScheme.FORCE_LIGHT
            )
            bg = colors["bg"]
            surface = colors["surface"]
            fg = colors["fg"]
            accent = colors["accent"]
            border = colors["border"]
            acc_hex = accent.lstrip("#")
            if len(acc_hex) == 6:
                ar, ag, ab = int(acc_hex[0:2], 16), int(acc_hex[2:4], 16), int(acc_hex[4:6], 16)
                row_sel = f"rgba({ar}, {ag}, {ab}, {'0.24' if is_dark else '0.16'})"
            else:
                row_sel = "rgba(156, 102, 11, 0.24)" if is_dark else "rgba(115, 79, 0, 0.16)"
            row_hov = "rgba(255, 255, 255, 0.06)" if is_dark else "rgba(0, 0, 0, 0.05)"
            pill_bg = "rgba(255, 255, 255, 0.08)" if is_dark else "rgba(0, 0, 0, 0.06)"
            css = f"""
            window {{
                background-color: {bg};
                color: {fg};
                border-radius: 16px;
                border: 1.5px solid {border};
            }}
            .palette-root {{
                padding: 16px 18px 12px 18px;
                background-color: {bg};
            }}
            .search-box {{
                background-color: {surface};
                border: 1px solid {border};
                border-radius: 12px;
                padding: 6px 12px;
                font-size: 15px;
                color: {fg};
            }}
            .search-box:focus-within {{
                border-color: {accent};
            }}
            .cat-pill {{
                border-radius: 999px;
                padding: 4px 12px;
                font-size: 12px;
                font-weight: 600;
                background-color: {pill_bg};
                color: {fg};
                border: 1px solid transparent;
            }}
            .cat-pill.active {{
                background-color: {accent};
                color: {bg};
            }}
            .status-chip {{
                border-radius: 999px;
                padding: 2px 10px;
                font-size: 11px;
                background-color: {pill_bg};
                color: {fg};
                opacity: 0.85;
            }}
            .status-warn {{
                background-color: #e0af68;
                color: #15161e;
                font-weight: 700;
                opacity: 1.0;
            }}
            .action-list {{
                background: transparent;
            }}
            .action-list row {{
                border-radius: 10px;
                padding: 8px 12px;
                margin: 2px 0;
            }}
            .action-list row:hover {{
                background-color: {row_hov};
            }}
            .action-list row:selected {{
                background-color: {row_sel};
                border: 1px solid {accent};
            }}
            .action-title {{
                font-size: 14px;
                font-weight: 600;
                color: {fg};
            }}
            .action-sub {{
                font-size: 12px;
                opacity: 0.72;
                color: {fg};
            }}
            .risk-tag {{
                font-size: 10px;
                font-weight: 600;
                padding: 2px 8px;
                border-radius: 999px;
                background-color: {pill_bg};
                opacity: 0.75;
            }}
            .confirm-bar {{
                background-color: {surface};
                border: 1px solid {accent};
                border-radius: 10px;
                padding: 10px 12px;
            }}
            .footer-hint {{
                font-size: 11px;
                opacity: 0.55;
            }}
            """
            provider = Gtk.CssProvider()
            provider.load_from_string(css)
            display = Gdk.Display.get_default()
            if self.css_provider is not None:
                Gtk.StyleContext.remove_provider_for_display(display, self.css_provider)
            Gtk.StyleContext.add_provider_for_display(
                display, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )
            self.css_provider = provider

        def _build_ui(self):
            root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
            root.add_css_class("palette-root")

            # ── Top status bar ──
            header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            brand = Gtk.Label(label="Tamagi", xalign=0)
            brand.set_markup(f"<b>Tamagi</b>")
            header.append(brand)

            self.status_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            self.status_box.set_hexpand(True)
            self.status_box.set_halign(Gtk.Align.END)
            header.append(self.status_box)
            root.append(header)

            # ── Search entry ──
            self.search = Gtk.SearchEntry()
            self.search.set_placeholder_text(tr["placeholder"])
            self.search.add_css_class("search-box")
            self.search.connect("search-changed", lambda _e: self._refresh_list())
            self.search.connect("activate", lambda _e: self._trigger_selected())
            # Digitar com o foco em qualquer lugar da paleta (lista, botões)
            # escreve na busca: abriu, é só digitar.
            self.search.set_key_capture_widget(self)
            root.append(self.search)

            # ── Category pills ──
            self.cat_buttons = {}
            cat_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            for cid, cmeta in cats:
                btn = Gtk.Button(label=loc(cmeta, lang))
                btn.add_css_class("cat-pill")
                if cid == self.active_cat:
                    btn.add_css_class("active")
                btn.connect("clicked", lambda _b, c=cid: self.set_category(c))
                self.cat_buttons[cid] = btn
                cat_box.append(btn)
            root.append(cat_box)

            # ── Scrollable action list ──
            scrolled = Gtk.ScrolledWindow()
            scrolled.set_vexpand(True)
            scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)

            self.listbox = Gtk.ListBox()
            self.listbox.set_selection_mode(Gtk.SelectionMode.SINGLE)
            self.listbox.add_css_class("action-list")
            self.listbox.connect("row-activated", lambda _lb, _row: self._trigger_selected())
            self.listbox.set_sort_func(self._sort_rows)
            self.listbox.set_filter_func(self._filter_row)
            for a in actions:
                row = self._make_row(a)
                self.rows[id(a)] = row
                self.listbox.append(row)
            self.empty_row = Gtk.ListBoxRow()
            self.empty_row.set_selectable(False)
            self.empty_row.set_activatable(False)
            lbl = Gtk.Label(label=tr["empty"], margin_top=24, margin_bottom=24)
            lbl.add_css_class("action-sub")
            self.empty_row.set_child(lbl)
            self.empty_row.action = None
            self.listbox.append(self.empty_row)
            self.scrolled = scrolled
            scrolled.set_child(self.listbox)
            root.append(scrolled)

            # ── Inline confirmation bar (hidden by default) ──
            self.confirm_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            self.confirm_bar.add_css_class("confirm-bar")
            self.confirm_bar.set_visible(False)
            self.confirm_label = Gtk.Label(xalign=0, hexpand=True)
            self.confirm_label.set_ellipsize(Pango.EllipsizeMode.END)
            btn_cancel = Gtk.Button(label=tr["cancel_btn"])
            btn_cancel.connect("clicked", lambda _b: self._cancel_confirm())
            btn_ok = Gtk.Button(label=tr["confirm_btn"])
            btn_ok.add_css_class("suggested-action")
            btn_ok.connect("clicked", lambda _b: self._execute_confirmed())
            self.confirm_bar.append(self.confirm_label)
            self.confirm_bar.append(btn_cancel)
            self.confirm_bar.append(btn_ok)
            root.append(self.confirm_bar)

            # ── Footer hint ──
            footer = Gtk.Label(label=tr["hint"], xalign=0)
            footer.add_css_class("footer-hint")
            root.append(footer)

            # ── Keyboard controller ──
            key_ctrl = Gtk.EventControllerKey()
            key_ctrl.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
            key_ctrl.connect("key-pressed", self._on_key)
            self.add_controller(key_ctrl)

            self.set_content(root)
            self.search.grab_focus()

        def _make_row(self, a):
            row = Gtk.ListBoxRow()
            row.action = a
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            img = Gtk.Image.new_from_icon_name(a.get("icon", "emblem-system-symbolic"))
            img.set_pixel_size(20)
            box.append(img)

            text_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            text_box.set_hexpand(True)
            title_lbl = Gtk.Label(label=loc(a["title"], lang), xalign=0)
            title_lbl.add_css_class("action-title")
            title_lbl.set_ellipsize(Pango.EllipsizeMode.END)
            sub_lbl = Gtk.Label(label=loc(a["subtitle"], lang), xalign=0)
            sub_lbl.add_css_class("action-sub")
            sub_lbl.set_ellipsize(Pango.EllipsizeMode.END)
            text_box.append(title_lbl)
            text_box.append(sub_lbl)
            box.append(text_box)

            risk = a.get("risk", "user")
            if risk in ("system", "read"):
                tag = Gtk.Label(label=tr[f"risk_{risk}"])
                tag.add_css_class("risk-tag")
                tag.set_valign(Gtk.Align.CENTER)
                box.append(tag)

            row.set_child(box)
            return row

        def _sort_rows(self, r1, r2):
            # A linha "nada encontrado" fica sempre por último.
            o1 = self.order.get(id(r1.action), 1 << 30) if r1.action else 1 << 31
            o2 = self.order.get(id(r2.action), 1 << 30) if r2.action else 1 << 31
            return (o1 > o2) - (o1 < o2)

        def _filter_row(self, row):
            if row.action is None:
                return not self.visible_actions
            return id(row.action) in self.order

        def _refresh_status(self):
            status = quick_status(lang)
            while (child := self.status_box.get_first_child()) is not None:
                self.status_box.remove(child)
            for txt in (status["ai"], status["theme"]):
                chip = Gtk.Label(label=txt)
                chip.add_css_class("status-chip")
                self.status_box.append(chip)
            if status["boot_pending"]:
                warn = Gtk.Label(label=tr["boot_alert"])
                warn.add_css_class("status-chip")
                warn.add_css_class("status-warn")
                self.status_box.append(warn)
            if status["quarantined"] > 0:
                qchip = Gtk.Label(label=f"{tr['quarantine']} ({status['quarantined']})")
                qchip.add_css_class("status-chip")
                qchip.add_css_class("status-warn")
                self.status_box.append(qchip)

        def _show_staged_badge(self):
            if getattr(self.status_box.get_first_child(), "staged", False):
                return False
            chip = Gtk.Label(label=tr["update_ready"])
            chip.staged = True
            chip.add_css_class("status-chip")
            chip.add_css_class("status-warn")
            self.status_box.prepend(chip)
            return False

        def set_category(self, cid):
            self.active_cat = cid
            for k, btn in self.cat_buttons.items():
                if k == cid:
                    btn.add_css_class("active")
                else:
                    btn.remove_css_class("active")
            self._cancel_confirm()
            self._refresh_list()
            self.search.grab_focus()

        def _cycle_category(self, delta):
            ids = [cid for cid, _ in cats]
            idx = ids.index(self.active_cat) if self.active_cat in ids else 0
            self.set_category(ids[(idx + delta) % len(ids)])

        def _refresh_list(self):
            query = self.search.get_text().strip()
            scored = []
            for a in actions:
                if not is_available(a):
                    continue
                if not query and self.active_cat != "all" and a.get("category") != self.active_cat:
                    continue
                if query and self.active_cat != "all" and a.get("category") != self.active_cat:
                    # Com busca digitada, mostra matches da categoria ativa com prioridade e também globais.
                    s = fuzzy_score(query, a, lang)
                    if s > 0:
                        scored.append((s, a))
                    continue
                s = fuzzy_score(query, a, lang)
                if s > 0:
                    bonus = 25 if a.get("category") == self.active_cat else 0
                    scored.append((s + bonus, a))
            if query:
                scored.sort(key=lambda x: -x[0])
            self.visible_actions = [a for _, a in scored]
            self.order = {id(a): i for i, a in enumerate(self.visible_actions)}
            self.listbox.invalidate_sort()
            self.listbox.invalidate_filter()
            if self.visible_actions:
                self.listbox.select_row(self.rows[id(self.visible_actions[0])])
                self.scrolled.get_vadjustment().set_value(0)
            else:
                self.listbox.unselect_all()

        def _selected_index(self):
            row = self.listbox.get_selected_row()
            if row is None or row.action is None:
                return -1
            return self.order.get(id(row.action), -1)

        def _move_selection(self, delta, wrap=True):
            if not self.visible_actions:
                return
            idx = max(self._selected_index(), 0)
            n = len(self.visible_actions)
            nxt = (idx + delta) % n if wrap else min(max(idx + delta, 0), n - 1)
            target = self.rows[id(self.visible_actions[nxt])]
            self.listbox.select_row(target)
            # Rola até a linha sem tirar o foco da busca (digitar continua filtrando).
            ok, rect = target.compute_bounds(self.listbox)
            if ok:
                adj = self.scrolled.get_vadjustment()
                top, bottom = rect.get_y(), rect.get_y() + rect.get_height()
                if top < adj.get_value():
                    adj.set_value(top)
                elif bottom > adj.get_value() + adj.get_page_size():
                    adj.set_value(bottom - adj.get_page_size())
            if not self.search.has_focus():
                self.search.grab_focus()
            self.search.set_position(-1)

        def _trigger_selected(self):
            if self.pending_confirm is not None:
                self._execute_confirmed()
                return
            idx = self._selected_index()
            if idx < 0:
                return
            action = self.visible_actions[idx]
            if action.get("confirm", False):
                self.pending_confirm = action
                self.confirm_label.set_text(f"{tr['confirm_q']} {loc(action['title'], lang)}")
                self.confirm_bar.set_visible(True)
                return
            self._run_and_close(action)

        def _cancel_confirm(self):
            self.pending_confirm = None
            self.confirm_bar.set_visible(False)

        def _execute_confirmed(self):
            action = self.pending_confirm
            self._cancel_confirm()
            if action:
                self._run_and_close(action)

        def _run_and_close(self, action):
            spawn_action(action, lang)
            self.dismiss()

        def _on_key(self, _ctrl, keyval, _keycode, state):
            if keyval == Gdk.KEY_Escape:
                if self.pending_confirm is not None:
                    self._cancel_confirm()
                    return True
                if self.search.get_text():
                    self.search.set_text("")
                    return True
                self.dismiss()
                return True
            if keyval in (Gdk.KEY_Down, Gdk.KEY_KP_Down):
                self._move_selection(1)
                return True
            if keyval in (Gdk.KEY_Up, Gdk.KEY_KP_Up):
                self._move_selection(-1)
                return True
            if keyval in (Gdk.KEY_Page_Down, Gdk.KEY_KP_Page_Down):
                self._move_selection(8, wrap=False)
                return True
            if keyval in (Gdk.KEY_Page_Up, Gdk.KEY_KP_Page_Up):
                self._move_selection(-8, wrap=False)
                return True
            if keyval == Gdk.KEY_Tab:
                self._cycle_category(1)
                return True
            if keyval == Gdk.KEY_ISO_Left_Tab:
                self._cycle_category(-1)
                return True
            if keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
                self._trigger_selected()
                return True
            return False

    class TamagiMenuApp(Adw.Application):
        def __init__(self):
            super().__init__(
                application_id=APP_ID,
                flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE,
            )
            self.win = None
            self.held = False
            show = Gio.SimpleAction.new("show", GLib.VariantType.new("s"))
            show.connect("activate", lambda _a, param: self.toggle(param.get_string() or None))
            self.add_action(show)

        def _window(self):
            if self.win is None:
                self.win = PaletteWindow(self, initial_cat)
            if not self.held:
                # Continua vivo com a janela escondida: abrir de novo é instantâneo.
                self.hold()
                self.held = True
            return self.win

        def toggle(self, req_cat):
            win = self._window()
            if win.get_visible():
                if req_cat is None:
                    # Super+Espaço com a paleta já aberta: alterna (fecha).
                    win.dismiss()
                else:
                    win.set_category(req_cat)
                    win.present()
                return
            win.prepare(req_cat or "all")
            win.present()

        def do_command_line(self, command_line):
            argv = command_line.get_arguments()[1:]
            if "--service" in argv:
                # Autostart: monta a janela sem mostrar.
                self._window()
                return 0
            cat = CATEGORY_ALIASES.get(argv[0].lower(), "all") if argv else None
            self.toggle(cat)
            return 0

    app = TamagiMenuApp()
    if service:
        args = ["--service"]
    else:
        args = [initial_cat] if initial_cat != "all" else []
    return app.run(sys.argv[:1] + args)


def main():
    parser = argparse.ArgumentParser(prog="tamagi-menu", description="Tamagi Command Palette")
    parser.add_argument("category", nargs="?", default="all", help="initial category")
    parser.add_argument("--list", action="store_true", help="list actions and exit")
    parser.add_argument("--json", action="store_true", help="dump actions as JSON and exit")
    parser.add_argument("--service", action="store_true", help="preload in the background (autostart)")
    args = parser.parse_args()

    initial_cat = CATEGORY_ALIASES.get(args.category.lower(), "all")
    has_display = bool(os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY"))
    # Caminho rápido: a paleta já está carregada, só pede para aparecer.
    if has_display and not (args.json or args.list or args.service):
        if show_remote(initial_cat if args.category != "all" else ""):
            return 0

    lang = detect_lang()
    cats, actions = load_registry()

    if args.json:
        out = [
            {
                "id": a["id"],
                "category": a["category"],
                "risk": a.get("risk", "user"),
                "title": loc(a["title"], lang),
                "subtitle": loc(a["subtitle"], lang),
                "command": a["command"],
            }
            for a in actions
            if is_available(a) and (initial_cat == "all" or a.get("category") == initial_cat)
        ]
        print(json.dumps(out, ensure_ascii=False, indent=2))
        return 0

    if args.list:
        return run_cli_fallback(cats, actions, lang, initial_cat, list_only=True)

    if not has_display:
        if args.service:
            return 0
        return run_cli_fallback(cats, actions, lang, initial_cat, list_only=False)

    return run_gui(cats, actions, lang, initial_cat, service=args.service)


if __name__ == "__main__":
    sys.exit(main())
