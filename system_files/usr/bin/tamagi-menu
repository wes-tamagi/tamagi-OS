THEMES_DIR = pathlib.Path(os.environ.get("TAMAGI_THEMES", "/usr/share/tamagi/themes"))
CONFIG_DIR = pathlib.Path(os.environ.get("XDG_CONFIG_HOME", pathlib.Path.home() / ".config")) / "tamagi"
STATE_DIR = pathlib.Path(os.environ.get("XDG_STATE_HOME", pathlib.Path.home() / ".local/state")) / "tamagi"
BOOT_FAIL_DIR = pathlib.Path(os.environ.get("TAMAGI_BOOT_FAILURES", "/var/lib/tamagi/boot-failures"))
QUARANTINE_FILE = pathlib.Path(os.environ.get("TAMAGI_QUARANTINE", "/var/lib/tamagi/quarantine.list"))

