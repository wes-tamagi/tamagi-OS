#!/usr/bin/python3
"""tamagi-menu — Tamagi Command Palette (GTK4 + libadwaita).

Abre com Super+Espaço (configurado no COSMIC). Alimentado pelo registro único
/usr/share/tamagi/actions.toml, com busca fuzzy instantânea, filtros por
categoria, badges de estado vivo e suporte a pt/en/es/fr.

Fica residente depois da primeira abertura (ou desde o login, pelo autostart
com --service): abrir de novo só mostra a janela já montada. O pedido chega
pelo D-Bus (gdbus), sem carregar o GTK de novo.

Uso:
  tamagi-menu [categoria]      abre a paleta (ex.: ai, install, appearance, system, power)
  tamagi-menu --service        carrega em segundo plano, sem mostrar (autostart)
  tamagi-menu --list           lista as ações disponíveis (CLI / sem display)
  tamagi-menu --json           exporta as ações em JSON
"""
import argparse
import json
import os
import pathlib
import re
import shlex
import shutil
import subprocess
import sys
import threading
import tomllib

