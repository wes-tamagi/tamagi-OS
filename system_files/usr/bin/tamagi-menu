INTERACTIVE_NO_PAUSE = {
    "tamagi-agent", "claude", "agy", "tamagi-ai code", "tamagi-firstrun --force", "tamagi-fboot",
    "tamagi-keys", "tamagi-theme pick", "tamagi-panel pick", "tamagi-lang pick",
    "tamagi-devbox", "tamagi-perf pick", "tamagi-gaming", "tamagi-install", "tamagi-remove", "tamagi-agent",
