#!/usr/bin/bash
# tamagi-config — declarative host configuration (/etc/tamagi/system.toml).
#
#   tamagi-config show       shows current /etc/tamagi/system.toml
#   tamagi-config validate   validates syntax and keys
#   tamagi-config apply      applies settings to the host (needs sudo)
set -euo pipefail

CONF=${TAMAGI_SYSTEM_CONF:-/etc/tamagi/system.toml}

show_conf() {
    if [[ -f $CONF ]]; then
        cat "$CONF"
    else
        echo "missing: $CONF" >&2
        return 1
    fi
}

parse_val() {
    local key=$1
    awk -F'=' -v k="$key" '
        /^[[:space:]]*#/ || /^[[:space:]]*\[/ || !NF { next }
        {
            lhs=$1; gsub(/^[[:space:]]+|[[:space:]]+$/, "", lhs)
            if (lhs == k) {
                rhs=$2; gsub(/^[[:space:]]+|[[:space:]]+$/, "", rhs)
                gsub(/^"|"$/, "", rhs)
                print rhs
                exit
            }
        }
    ' "$CONF"
}

validate_conf() {
    [[ -f $CONF ]] || { echo "missing: $CONF" >&2; return 1; }
    local lang harden vm_access auto_update
    lang=$(parse_val lang)
    harden=$(parse_val harden)
    vm_access=$(parse_val vm_access)
    auto_update=$(parse_val auto_update)
    case "${lang:-en}" in en|pt|es|fr) ;; *) echo "invalid lang: $lang" >&2; return 2 ;; esac
    case "${harden:-balanced}" in balanced|strict) ;; *) echo "invalid harden: $harden" >&2; return 2 ;; esac
    case "${vm_access:-standard}" in standard|full) ;; *) echo "invalid vm_access: $vm_access" >&2; return 2 ;; esac
    case "${auto_update:-true}" in true|false) ;; *) echo "invalid auto_update: $auto_update" >&2; return 2 ;; esac
    echo "ok: $CONF"
}

apply_conf() {
    validate_conf >/dev/null
    local lang harden vm_access auto_update
    lang=$(parse_val lang)
    harden=$(parse_val harden)
    vm_access=$(parse_val vm_access)
    auto_update=$(parse_val auto_update)
    [[ -n $lang ]] && command -v tamagi-lang >/dev/null 2>&1 && tamagi-lang "$lang" >/dev/null || true
    [[ -n $harden ]] && command -v tamagi-harden >/dev/null 2>&1 && sudo tamagi-harden "$harden" >/dev/null || true
    [[ -n $vm_access ]] && command -v tamagi-vm >/dev/null 2>&1 && tamagi-vm access "$vm_access" >/dev/null || true
    if [[ $auto_update == false ]]; then
        sudo tamagi-update auto off >/dev/null || true
    else
        sudo tamagi-update auto on >/dev/null || true
    fi
    echo "applied: $CONF"
}

case "${1:-show}" in
    show) show_conf ;;
    validate) validate_conf ;;
    apply) apply_conf ;;
    -h|--help|help) sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//' ;;
    *) echo "usage: tamagi-config [show|validate|apply]" >&2; exit 2 ;;
esac
