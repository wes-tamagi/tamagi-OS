#!/usr/bin/bash
# tamagi-vm — virtual machines with Cockpit Machines, libvirt and QEMU/KVM (built in).
#
# Virtualization ships built into the DX image and starts on demand by socket
# (cockpit.socket + virtqemud.socket — zero idle RAM). Opens Cockpit Machines
# natively in Chromium app mode and reads .img, .qcow2 and .iso files directly.
#
#   tamagi vm             opens the integrated Cockpit Machines VM console
#   tamagi vm install     checks/enables built-in virtualization sockets
#   tamagi vm status      shows KVM, libvirt, Cockpit and VM access status
#   tamagi vm access [standard|full]
#                         standard: VMs run confined (libvirt's default).
#                         full: VMs run as root without SELinux confinement
#                           (access USB sticks and external disks).
#   tamagi vm open        alias for `tamagi vm`
set -euo pipefail
. /usr/libexec/tamagi/i18n

UNITS=(cockpit.socket virtqemud.socket virtnetworkd.socket virtstoraged.socket
       virtnodedevd.socket virtsecretd.socket virtinterfaced.socket virtnwfilterd.socket
       virtlogd.socket virtlockd.socket)

installed() { command -v virsh >/dev/null 2>&1 && command -v qemu-kvm >/dev/null 2>&1; }
die() { echo "$(t "error"): $*" >&2; exit 1; }

ensure_sockets() {
    local u missing=0
    for u in "${UNITS[@]}"; do
        systemctl is-active --quiet "$u" 2>/dev/null || missing=1
    done
    if (( missing )); then
        sudo systemctl start "${UNITS[@]}" >/dev/null 2>&1 || true
    fi
}

open_console() {
    ensure_sockets
    local url="https://localhost:9090/machines"
    if command -v chromium-browser >/dev/null 2>&1; then
        setsid -f chromium-browser --app="$url" --class=tamagi-vm --ignore-certificate-errors >/dev/null 2>&1
    elif command -v xdg-open >/dev/null 2>&1; then
        setsid -f xdg-open "$url" >/dev/null 2>&1
    else
        echo "$url"
    fi
}

QEMU_CONF=/etc/libvirt/qemu.conf
MARK_BEGIN="# >>> tamagi vm access (managed; change with: tamagi vm access standard|full)"
MARK_END="# <<< tamagi vm access"

access_now() { sudo grep -qF "$MARK_BEGIN" "$QEMU_CONF" 2>/dev/null && echo full || echo standard; }

set_access() {
    local mode=$1
    installed || die "libvirt/QEMU $(t "is not installed")"
    sudo touch "$QEMU_CONF"
    sudo sed -i "/^# >>> tamagi vm access/,/^# <<< tamagi vm access/d" "$QEMU_CONF"
    if [[ $mode == full ]]; then
        printf '%s\n' "$MARK_BEGIN" 'user = "root"' 'group = "root"' 'dynamic_ownership = 0' \
            'security_driver = "none"' "$MARK_END" | sudo tee -a "$QEMU_CONF" >/dev/null
        local g
        for g in libvirt kvm disk; do
            getent group "$g" >/dev/null && sudo usermod -aG "$g" "$USER"
        done
        echo "$(t "Full access on: VMs run as root, unconfined, and reach USB sticks and external disks.")"
        echo "$(t "Log out and back in for the new groups to count.")"
    else
        echo "$(t "Standard access: VMs run confined again.")"
    fi
    sudo systemctl try-restart virtqemud.service 2>/dev/null || true
}

install_vm() {
    installed || die "libvirt/QEMU $(t "is not installed")"
    grep -qE 'vmx|svm' /proc/cpuinfo || echo "$(t "warning: virtualization (VT-x/AMD-V) seems to be disabled in the firmware; VMs will be slow.")" >&2
    ensure_sockets
    echo "$(t "Cockpit Machines and QEMU/KVM are built into this image.")"
    echo "$(t "Done. Open it with"): tamagi vm"
}

case "${1:-open}" in
    open) open_console ;;
    install) install_vm ;;
    status)
        echo "cockpit-machines: $(rpm -q --qf '%{VERSION}-%{RELEASE}' cockpit-machines 2>/dev/null || t "built in")"
        echo "libvirt / QEMU: $(installed && t "built in" || t "not installed")"
        echo "KVM: $([[ -e /dev/kvm ]] && t "yes" || t "no")"
        echo "cockpit.socket: $(systemctl is-active cockpit.socket 2>/dev/null || echo inactive)"
        echo "$(t "VM access"): $(access_now)   (tamagi vm access standard|full)" ;;
    access)
        case "${2:-status}" in
            status)        echo "$(t "VM access"): $(access_now)" ;;
            standard|full) set_access "$2" ;;
            *) echo "usage: tamagi vm access [standard|full]" >&2; exit 2 ;;
        esac ;;
    remove)
        echo "$(t "Virtualization is built into the DX image. Use 'tamagi vm access standard' to keep VMs confined.")" ;;
    -h|--help) sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//' ;;
    *) echo "usage: tamagi vm [open|install|status|access|remove]" >&2; exit 2 ;;
esac
