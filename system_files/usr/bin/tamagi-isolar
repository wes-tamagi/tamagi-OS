#!/usr/bin/bash
# tamagi-isolar — roda um programa em que você não confia numa jaula descartável.
#
# Para o script baixado da internet, o AppImage de origem duvidosa, o binário
# que um tutorial manda rodar. Dentro da jaula (bubblewrap, o mesmo dos Flatpaks):
#   • sem rede (nada sai nem entra) — a não ser com --rede
#   • a sua pasta pessoal some: o programa vê uma pasta vazia e temporária
#   • o resto do sistema só para leitura; sem D-Bus, sem ver outros processos
#   • a tela (Wayland e X11), o som e a placa de vídeo funcionam
# O arquivo é copiado para dentro: o original não é alterado. Ao sair, a jaula
# é apagada (com --manter, fica em ~/.cache/tamagi-isolar para você olhar).
#
#   tamagi-isolar <arquivo> [argumentos]    .sh, .py, AppImage ou executável
#   tamagi-isolar -- <comando> [argumentos] um comando qualquer do sistema
#   opções (antes do arquivo): --rede  --manter  --sem-tela
# No COSMIC Files: botão direito → Abrir com → "Abrir isolado".
set -euo pipefail
. /usr/libexec/tamagi/i18n

net=0 keep=0 gui=1
while [[ ${1:-} == --* && ${1:-} != -- ]]; do
    case $1 in
        --rede|--net) net=1 ;;
        --manter|--keep) keep=1 ;;
        --sem-tela|--no-gui) gui=0 ;;
        -h|--help) sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
        *) echo "$(t "opção desconhecida"): $1" >&2; exit 2 ;;
    esac
    shift
done
[[ ${1:-} == -- ]] && { shift; cmd_mode=1; } || cmd_mode=0
[[ $# -gt 0 ]] || { sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 2; }

base="${XDG_CACHE_HOME:-$HOME/.cache}/tamagi-isolar"
mkdir -p "$base"
jail=$(mktemp -d "$base/$(date +%Y%m%d-%H%M%S)-XXXX")
cleanup() { [[ $keep == 1 ]] && echo "$(t "Jaula mantida em"): $jail" >&2 || rm -rf --one-file-system "$jail"; }
trap cleanup EXIT
mkdir -p "$jail/home"

run=()
if [[ $cmd_mode == 1 ]]; then
    run=("$@")
else
    src=$1; shift
    [[ -f $src ]] || { echo "$(t "arquivo não encontrado"): $src" >&2; exit 1; }
    name=$(basename "$src")
    cp -- "$src" "$jail/home/$name"
    f="$HOME/$name"                      # caminho visto de dentro da jaula
    case ${name,,} in
        *.sh|*.bash) run=(bash "$f") ;;
        *.py)        run=(python3 "$f") ;;
        *.appimage)  chmod +x "$jail/home/$name"; run=("$f") ;;   # sem FUSE: extrai e roda
        *)           chmod +x "$jail/home/$name"; run=("$f") ;;
    esac
    run+=("$@")
fi

args=(
    --ro-bind / /
    --dev /dev
    --proc /proc
    --tmpfs /tmp
    --tmpfs /var/tmp
    --tmpfs /run
    # /home e /root são links para /var no Fedora atômico: esconde os destinos.
    --tmpfs /var/home --tmpfs /var/roothome
    --bind "$jail/home" "$(realpath "$HOME")"
    --chdir "$HOME"
    --unshare-all
    --die-with-parent
    --new-session
    --cap-drop ALL
    --hostname isolado
    --setenv HOME "$HOME"
    --setenv TMPDIR /tmp
    --setenv APPIMAGE_EXTRACT_AND_RUN 1
    --setenv TAMAGI_ISOLADO 1
    --unsetenv DBUS_SESSION_BUS_ADDRESS
    --unsetenv SSH_AUTH_SOCK
)
[[ $net == 1 ]] && args+=(--share-net --ro-bind-try /run/systemd/resolve /run/systemd/resolve)
if [[ $gui == 1 ]]; then
    rt=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
    args+=(--dir "$rt" --setenv XDG_RUNTIME_DIR "$rt" --dev-bind-try /dev/dri /dev/dri)
    [[ -n ${WAYLAND_DISPLAY:-} && -S $rt/$WAYLAND_DISPLAY ]] && args+=(--ro-bind "$rt/$WAYLAND_DISPLAY" "$rt/$WAYLAND_DISPLAY")
    [[ -S $rt/pipewire-0 ]] && args+=(--ro-bind "$rt/pipewire-0" "$rt/pipewire-0")
    # X11 (Xwayland): muitos AppImages e o Wine só falam X11.
    [[ -n ${DISPLAY:-} && -d /tmp/.X11-unix ]] && args+=(--ro-bind /tmp/.X11-unix /tmp/.X11-unix)
else
    args+=(--unsetenv WAYLAND_DISPLAY --unsetenv DISPLAY)
fi

msg="$(t "Isolado"): $(t "sem rede"), $(t "pasta pessoal escondida"), $(t "sistema só leitura")"
[[ $net == 1 ]] && msg="$(t "Isolado"): $(t "COM rede"), $(t "pasta pessoal escondida"), $(t "sistema só leitura")"
echo "$msg" >&2
set +e
bwrap "${args[@]}" -- "${run[@]}"
rc=$?
set -e
exit $rc
