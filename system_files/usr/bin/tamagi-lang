#!/usr/bin/bash
# tamagi-lang — idioma do sistema: português (Brasil), inglês (EUA), espanhol ou francês.
#
#   tamagi-lang            mostra o idioma atual
#   tamagi-lang pick       escolhe numa lista
#   tamagi-lang set <pt|en|es|fr>
#
# Troca o idioma do sistema inteiro (desktop COSMIC, apps e as ferramentas do
# Tamagi); vale no próximo login. O teclado não muda: Configurações > Teclado.
set -euo pipefail
. /usr/libexec/tamagi/i18n

declare -A LOCALE=([pt]=pt_BR.UTF-8 [en]=en_US.UTF-8 [es]=es_ES.UTF-8 [fr]=fr_FR.UTF-8)
declare -A NAME=([pt]="Português (Brasil)" [en]="English (United States)" [es]="Español" [fr]="Français")

current() { local l; l=$(localectl status 2>/dev/null | sed -n 's/.*LANG=\([a-zA-Z_]*\).*/\1/p' | head -1); echo "${l:-${LANG:-pt_BR}}"; }

set_lang() {
    local code=$1
    [[ -n $code && -n ${LOCALE[$code]:-} ]] || { echo "$(t "idioma desconhecido"): $code (pt, en, es, fr)" >&2; exit 2; }
    if [[ $(id -u) == 0 ]]; then localectl set-locale "LANG=${LOCALE[$code]}"
    else sudo localectl set-locale "LANG=${LOCALE[$code]}"; fi
    echo "${NAME[$code]} — $(t "vale no próximo login (saia da sessão e entre de novo).")"
}

case "${1:-}" in
    "")   echo "$(t "Idioma do sistema"): $(current)" ;;
    list) for c in pt en es fr; do printf '%s  %s\n' "$c" "${NAME[$c]}"; done ;;
    pick) choice=$(for c in pt en es fr; do echo "${NAME[$c]}"; done | gum choose --header "$(t "Idioma do sistema")") || exit 0
          for c in pt en es fr; do
              if [[ ${NAME[$c]} == "$choice" ]]; then set_lang "$c"; break; fi
          done ;;
    set)  set_lang "${2:-}" ;;
    *)    echo "uso: tamagi-lang [list|pick|set <pt|en|es|fr>]" >&2; exit 2 ;;
esac
