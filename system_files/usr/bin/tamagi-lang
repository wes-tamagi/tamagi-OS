#!/usr/bin/bash
# tamagi-lang — idioma do sistema: português (Brasil), inglês (EUA), espanhol ou francês.
#
#   tamagi-lang            mostra o idioma atual
#   tamagi-lang pick       escolhe numa lista
#   tamagi-lang set <pt|en|es|fr>
#
# Troca o idioma das ferramentas do Tamagi na hora (~/.config/tamagi/lang) e
# do sistema inteiro (desktop COSMIC e apps) no próximo login.
set -euo pipefail
. /usr/libexec/tamagi/i18n

declare -A LOCALE=([pt]=pt_BR.UTF-8 [en]=en_US.UTF-8 [es]=es_ES.UTF-8 [fr]=fr_FR.UTF-8)
# The default language of this image (en, or pt in the :ptbr variant) comes first.
DEFAULT_LANG=$(cat /usr/share/tamagi/default-lang 2>/dev/null || echo en)
[[ $DEFAULT_LANG == pt ]] && ORDER=(pt en es fr) || { DEFAULT_LANG=en; ORDER=(en pt es fr); }
declare -A NAME=([pt]="Português (Brasil)" [en]="English (United States)" [es]="Español" [fr]="Français")
LANG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/tamagi/lang"

current() {
    local l
    if [[ -r $LANG_FILE ]]; then
        l=$(head -n 1 "$LANG_FILE" 2>/dev/null || true)
        if [[ -n ${LOCALE[$l]:-} ]]; then echo "${LOCALE[$l]} ($l)"; return 0; fi
    fi
    l=$(localectl status 2>/dev/null | sed -n 's/.*LANG=\([a-zA-Z_]*\).*/\1/p' | head -1)
    echo "${l:-${LANG:-${LOCALE[$DEFAULT_LANG]%.*}}}"
}

set_lang() {
    local code=$1
    [[ -n $code && -n ${LOCALE[$code]:-} ]] || { echo "$(t "unknown language"): $code (en, pt, es, fr)" >&2; exit 2; }
    mkdir -p "$(dirname "$LANG_FILE")"
    printf '%s\n' "$code" > "$LANG_FILE"
    systemctl --user set-environment "LANG=${LOCALE[$code]}" 2>/dev/null || true
    if [[ $(id -u) == 0 ]]; then localectl set-locale "LANG=${LOCALE[$code]}" 2>/dev/null || true
    else sudo localectl set-locale "LANG=${LOCALE[$code]}"; fi
    # Recarrega o daemon do tamagi-menu (Super+Espaço) no idioma recém-escolhido.
    if [[ -n ${USER:-} ]] && pgrep -u "$USER" -f 'tamagi-menu --service' >/dev/null 2>&1; then
        pkill -u "$USER" -f 'tamagi-menu --service' 2>/dev/null || true
        setsid -f tamagi-menu --service >/dev/null 2>&1 || true
    fi
    TAMAGI_LANG=$code
    # Recarrega traduções no idioma recém-escolhido para a mensagem de confirmação.
    # shellcheck source=/dev/null
    . /usr/libexec/tamagi/i18n
    echo "${NAME[$code]} — $(t "Tamagi tools updated immediately; full desktop on next login.")"
}

case "${1:-}" in
    "")            echo "$(t "System language"): $(current)" ;;
    list)    for c in "${ORDER[@]}"; do printf '%s  %s\n' "$c" "${NAME[$c]}"; done ;;
    pick) choice=$(for c in "${ORDER[@]}"; do echo "${NAME[$c]}"; done | gum choose --header "$(t "System language")") || exit 0
                   for c in "${ORDER[@]}"; do
                       if [[ ${NAME[$c]} == "$choice" ]]; then set_lang "$c"; break; fi
                   done ;;
    set)   set_lang "${2:-}" ;;
    -h|--help|help)
                   echo "tamagi-lang [list|pick|set <en|pt|es|fr>]" ;;
    *)             echo "$(t "usage"): tamagi-lang [list|pick|set <pt|en|es|fr>]" >&2; exit 2 ;;
esac
