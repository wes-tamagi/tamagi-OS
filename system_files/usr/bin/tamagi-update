#!/usr/bin/bash
# tamagi-update — um comando para atualizar tudo (sistema, Flatpaks, caixas, agentes de IA).
#
#   tamagi-update              sistema + Flatpaks + subsistemas/caixas + agentes de IA
#   tamagi-update --arch       só pacotes do Arch (pacman e AUR)
#   tamagi-update --system     só a imagem do sistema
#   tamagi-update status       timers automáticos e digests em quarentena
#   tamagi-update auto on|off  liga ou desliga a atualização automática
#   tamagi-update quarantine   mostra digests bloqueados após falha de boot
#   tamagi-update unquarantine limpa a quarentena de digests
#   tamagi-update changes      o que muda na atualização pronta (com resumo da IA local)
set -uo pipefail
# shellcheck source=/dev/null
. /usr/libexec/tamagi/i18n

QUARANTINE="${TAMAGI_QUARANTINE:-/var/lib/tamagi/quarantine.list}"

step() { echo; echo -e "\033[1;34m── $(t "$1")\033[0m"; }
failed=()

STATUS="${TAMAGI_BOOTC_STATUS:-/run/tamagi/bootc-status.json}"
SYSTEM_UPDATE=/usr/libexec/tamagi/system-update

# `bootc status` needs root: the system publishes a copy for the desktop.
# (An image downloaded but held back by the Secure Boot guard is not staged.)
staged_digest() { jq -r '.status.staged | select(.downloadOnly != true) | .image.imageDigest // empty' "$STATUS" 2>/dev/null; }

quarantine_count() {
    [[ -r $QUARANTINE ]] || { echo 0; return; }
    grep -cvE '^(#|[[:space:]]*$)' "$QUARANTINE" 2>/dev/null || echo 0
}

update_system() {
    step "System (atomic image)"
    local before
    before=$(staged_digest)
    # Prepared beside the running system; quarantine and Secure Boot are
    # checked there (system-update).
    if sudo "$SYSTEM_UPDATE" --now; then
        if [[ -n $(staged_digest) ]]; then
            tl "New image staged: takes effect on next boot."
            if [[ $(staged_digest) != "$before" ]]; then
                echo
                /usr/libexec/tamagi/update-changes --sem-ia || true
            fi
        fi
    else
        tl "Could not update the image. If installed from a local build, publish it first"
        echo "  sudo bootc switch <registry>/tamagi:latest"
        failed+=(sistema)
    fi
}

update_layers() { # camadas do tamagi-layer feitas para uma versão anterior da imagem
    local stale
    stale=$(tamagi-layer stale 2>/dev/null) || return 0
    [[ -n $stale ]] || return 0
    step "Image layers (tamagi-layer)"
    tamagi-layer rebuild || failed+=(camadas)
}

all_boxes() { podman ps -a --filter label=manager=distrobox --format '{{.Names}}' 2>/dev/null; }

arch_boxes() { # caixas distrobox cuja distro é Arch
    local name
    for name in $(all_boxes); do
        podman inspect --format '{{.ImageName}}' "$name" 2>/dev/null | grep -qi arch && echo "$name"
    done
}

update_arch() {
    local box found=0
    for box in $(arch_boxes); do
        found=1
        echo; echo -e "\033[1;34m── Arch ($box): pacman\033[0m"
        distrobox enter "$box" -- sudo pacman -Syu --noconfirm || failed+=("arch:$box")
        if distrobox enter "$box" -- sh -c 'command -v paru' >/dev/null 2>&1; then
            echo; echo -e "\033[1;34m── Arch ($box): AUR (paru)\033[0m"
            distrobox enter "$box" -- paru -Sua --noconfirm || failed+=("aur:$box")
        elif distrobox enter "$box" -- sh -c 'command -v yay' >/dev/null 2>&1; then
            echo; echo -e "\033[1;34m── Arch ($box): AUR (yay)\033[0m"
            distrobox enter "$box" -- yay -Sua --noconfirm || failed+=("aur:$box")
        fi
    done
    (( found )) || echo "$(t "No Arch box. Create one with"): tamagi devbox create arch"
}

on_battery() { # só a bateria do computador conta: a de mouse, teclado ou fone sem fio (scope=Device) não
    local s
    for s in /sys/class/power_supply/*; do
        [[ $(cat "$s/type" 2>/dev/null) == Battery ]] || continue
        [[ $(cat "$s/scope" 2>/dev/null) == Device ]] && continue
        [[ $(cat "$s/status" 2>/dev/null) == Discharging ]] && return 0
    done
    return 1
}

update_auto() { # chamado pelo tamagi-autoupdate.timer: sem perguntas e sem senha
    if on_battery; then tl "On battery: deferring until next run."; return 0; fi
    local box
    for box in $(all_boxes); do
        echo; echo -e "\033[1;34m── $(t "Box") $box\033[0m"
        distrobox upgrade "$box" </dev/null || failed+=("caixa:$box")
    done
    # A imagem nova é preparada pelo sistema em segundo plano
    # (tamagi-system-update.timer); aqui só o aviso, uma vez por imagem.
    local staged seen="${XDG_RUNTIME_DIR:-/tmp}/tamagi-update-notified"
    staged=$(staged_digest)
    if [[ -n $staged && $(cat "$seen" 2>/dev/null) != "$staged" ]]; then
        echo "$staged" > "$seen"
        # O que muda, numa linha (kernel, desktop, drivers…); detalhes e resumo
        # da IA local: tamagi-update changes.
        changes=$(/usr/libexec/tamagi/update-changes --curto 2>/dev/null || true)
        notify-send -a Tamagi -i system-software-update "$(t "System update ready")" \
            "${changes:+$changes
}$(t "It will take effect the next time you reboot.") (tamagi update changes)" 2>/dev/null || true
    fi
}

timer_line() { # timer_line <rótulo> [--user] <unit>
    local label=$1 scope=() unit next_word; shift
    [[ $1 == --user ]] && { scope=(--user); shift; }
    unit=$1
    next_word=$(t "next")
    printf '%-36s %-9s %s: %s\n' "  $(t "$label")" \
        "$(systemctl "${scope[@]}" is-enabled "$unit" 2>/dev/null || t "missing")" \
        "$next_word" \
        "$(systemctl "${scope[@]}" show "$unit" -p NextElapseUSecRealtime --value 2>/dev/null | sed 's/^$/-/')"
}

status_auto() {
    echo "$(t "Automatic updates"):"
    timer_line "System (image, applied on boot)" tamagi-system-update.timer
    timer_line "System Flatpaks" flatpak-system-update.timer
    timer_line "User Flatpaks" --user flatpak-user-update.timer
    timer_line "Distrobox boxes" --user tamagi-autoupdate.timer
    local qcount
    qcount=$(quarantine_count)
    if (( qcount > 0 )); then
        echo "$(t "Quarantined digests"): $qcount (tamagi-update quarantine)"
    fi
    if [[ -f /var/lib/tamagi/secureboot-blocked ]]; then
        tl "Update cancelled by Secure Boot: the Universal Blue key is missing."
        echo "  tamagi setup secure-boot-key   ($(t "password"): universalblue)"
    fi
    if [[ -n $(staged_digest) ]]; then
        tl "A new image is staged: reboot to apply."
    fi
}

cmd_quarantine() {
    if [[ ! -r $QUARANTINE ]] || (( $(quarantine_count) == 0 )); then
        tl "No quarantined digests."
        return 0
    fi
    echo "$(t "Quarantined digests") ($QUARANTINE):"
    grep -vE '^(#|[[:space:]]*$)' "$QUARANTINE" | sed 's/^/  /'
}

cmd_unquarantine() {
    if [[ ! -e $QUARANTINE ]]; then
        tl "No quarantined digests."
        return 0
    fi
    if [[ $(id -u) == 0 ]]; then
        rm -f "$QUARANTINE"
    else
        sudo rm -f "$QUARANTINE"
    fi
    tl "Quarantine cleared."
}

set_auto() { # set_auto on|off
    local verb=enable
    [[ $1 == off ]] && verb=disable
    sudo systemctl "$verb" --now tamagi-system-update.timer flatpak-system-update.timer
    systemctl --user "$verb" --now flatpak-user-update.timer tamagi-autoupdate.timer
    status_auto
}

case "${1:-all}" in
    --arch)       update_arch ;;
    --system)     update_system ;;
    --auto)       update_auto ;;
    status)       status_auto; exit 0 ;;
    changes) /usr/libexec/tamagi/update-changes "${@:2}"; exit $? ;;
    quarantine)   cmd_quarantine; exit 0 ;;
    unquarantine) cmd_unquarantine; exit 0 ;;
    auto)         case "${2:-}" in on|off) set_auto "$2"; exit 0 ;; *) echo "usage: tamagi-update auto on|off" >&2; exit 2 ;; esac ;;
    all)
        update_system
        update_layers
        step "Flatpaks"
        flatpak update -y || failed+=(flatpak)
        step "Distrobox boxes"
        archs=$(arch_boxes)
        for box in $(all_boxes); do
            grep -qx "$box" <<<"$archs" && continue
            distrobox upgrade "$box" || failed+=("caixa:$box")
        done
        update_arch
        if [[ -n $(tamagi-agents installed 2>/dev/null) ]]; then
            step "AI agents"
            tamagi-agents update || failed+=(agents)
        fi
        ;;
    *) echo "usage: tamagi-update [--arch|--system|status|changes|quarantine|unquarantine|auto on|off]" >&2; exit 2 ;;
esac

echo
if (( ${#failed[@]} )); then
    echo "$(t "Finished with failures in"): ${failed[*]}"
    exit 1
fi
tl "Everything is up to date."
