#!/usr/bin/bash
# tamagi-db — development databases with one command, in rootless Podman
# containers.
#
#   tamagi db                    choose and start a database (menu)
#   tamagi db add <db>           postgres | mysql | mariadb | redis | valkey | mongo
#   tamagi db list               installed databases and whether they are running
#   tamagi db start|stop <db>
#   tamagi db url <db>           connection URL (for DATABASE_URL, an ORM, a GUI)
#   tamagi db env                `export …_URL=…` lines for every running database
#   tamagi db shell <db>         the database's own client (psql, mysql, redis-cli, mongosh)
#   tamagi db snapshot <db> [name]    saves the data as it is now
#   tamagi db restore <db> [name]     brings a snapshot back (asks first)
#   tamagi db snapshots [db]     saved snapshots
#   tamagi db remove <db>        deletes the container and the data
#
# Each database is a Quadlet unit in ~/.config/containers/systemd/ that starts
# with your session and listens only on 127.0.0.1 (nobody outside the machine
# reaches it). No password: it is for local development. From a development
# box (`tamagi devbox`) the same 127.0.0.1 address works, and the clients
# (psql, mariadb, valkey-cli) are already there. The data lives in a Podman
# volume (tamagi-db-<db>) that survives updates and recreating the container.
set -euo pipefail
. /usr/libexec/tamagi/i18n

UNITS="${XDG_CONFIG_HOME:-$HOME/.config}/containers/systemd"
SNAPS="${XDG_DATA_HOME:-$HOME/.local/share}/tamagi/db-snapshots"
DBS=(postgres mysql mariadb redis valkey mongo)

die() { echo "$(t "error"): $*" >&2; exit 1; }

spec() { # spec <db> -> IMAGE PORT TARGET VOLPATH ENV...
    case $1 in
        postgres) echo "docker.io/library/postgres:18 5432 5432 /var/lib/postgresql POSTGRES_HOST_AUTH_METHOD=trust" ;;
        mysql)    echo "docker.io/library/mysql:8.4 3306 3306 /var/lib/mysql MYSQL_ALLOW_EMPTY_PASSWORD=yes" ;;
        mariadb)  echo "docker.io/library/mariadb:11.8 3307 3306 /var/lib/mysql MARIADB_ALLOW_EMPTY_ROOT_PASSWORD=1" ;;
        redis)    echo "docker.io/library/redis:7 6379 6379 /data" ;;
        valkey)   echo "docker.io/valkey/valkey:8 6380 6379 /data" ;;
        mongo)    echo "docker.io/library/mongo:8 27017 27017 /data/db" ;;
        *) return 1 ;;
    esac
}
port_of() { spec "$1" | cut -d' ' -f2; }

url_of() {
    local port; port=$(port_of "$1")
    case $1 in
        postgres)      echo "postgresql://postgres@127.0.0.1:$port/postgres" ;;
        mysql|mariadb) echo "mysql://root@127.0.0.1:$port/" ;;
        redis|valkey)  echo "redis://127.0.0.1:$port/0" ;;
        mongo)         echo "mongodb://127.0.0.1:$port/" ;;
    esac
}

unit_of() { echo "$UNITS/tamagi-db-$1.container"; }
running() { [[ $(podman container inspect -f '{{.State.Running}}' "tamagi-db-$1" 2>/dev/null) == true ]]; }
need() { [[ -n ${1:-} && -f $(unit_of "$1") ]] || die "$(t "database not installed"): ${1:-?}"; }

add() {
    local db=$1 image port target vol envs
    spec "$db" >/dev/null || die "$(t "unknown database"): $db (${DBS[*]})"
    read -r image port target vol envs <<<"$(spec "$db")"
    mkdir -p "$UNITS"
    {
        echo "# Generated by tamagi-db. Development database: 127.0.0.1 only, no password."
        echo "[Unit]"
        echo "Description=$db (tamagi-db)"
        echo
        echo "[Container]"
        echo "ContainerName=tamagi-db-$db"
        echo "Image=$image"
        echo "PublishPort=127.0.0.1:$port:$target"
        echo "Volume=tamagi-db-$db:$vol"
        for e in $envs; do echo "Environment=$e"; done
        echo
        echo "[Service]"
        echo "Restart=on-failure"
        echo "TimeoutStartSec=600"
        echo
        echo "[Install]"
        echo "WantedBy=default.target"
    } > "$(unit_of "$db")"
    systemctl --user daemon-reload
    echo "$(t "Downloading and starting") $db…"
    podman pull -q "$image" >/dev/null
    systemctl --user start "tamagi-db-$db.service"
    echo "$db: $(url_of "$db")"
}

list() {
    local db any=
    for db in "${DBS[@]}"; do
        [[ -f $(unit_of "$db") ]] || continue
        any=1
        printf '  %-9s %-46s %s\n' "$db" "$(url_of "$db")" "$(running "$db" && t "running" || t "off")"
    done
    [[ -n $any ]] || echo "$(t "No database installed"). tamagi db add <${DBS[*]// /|}>"
}

cmd_env() {
    local db
    for db in "${DBS[@]}"; do
        running "$db" || continue
        echo "export ${db^^}_URL=\"$(url_of "$db")\""
        [[ $db == postgres ]] && echo "export DATABASE_URL=\"$(url_of "$db")\""
    done
    return 0
}

cmd_shell() {
    local db=$1; shift
    running "$db" || systemctl --user start "tamagi-db-$db.service"
    local tty=(-i); [[ -t 0 ]] && tty=(-it)
    case $db in
        postgres) exec podman exec "${tty[@]}" "tamagi-db-$db" psql -U postgres "$@" ;;
        mysql)    exec podman exec "${tty[@]}" "tamagi-db-$db" mysql -uroot "$@" ;;
        mariadb)  exec podman exec "${tty[@]}" "tamagi-db-$db" mariadb -uroot "$@" ;;
        redis)    exec podman exec "${tty[@]}" "tamagi-db-$db" redis-cli "$@" ;;
        valkey)   exec podman exec "${tty[@]}" "tamagi-db-$db" valkey-cli "$@" ;;
        mongo)    exec podman exec "${tty[@]}" "tamagi-db-$db" mongosh "$@" ;;
    esac
}

# Snapshots: the whole data volume, with the database stopped for a moment so
# the copy is consistent. One file per snapshot; restoring swaps the volume.
valid_snap() { [[ ${1:-} =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,60}$ ]] || die "$(t "invalid snapshot name"): ${1:-}"; }

cmd_snapshot() {
    local db=$1 name=${2:-$(date +%Y%m%d-%H%M%S)} was=0 file
    valid_snap "$name"
    file="$SNAPS/$db/$name.tar.zst"
    [[ ! -e $file ]] || die "$(t "a snapshot with that name already exists"): $name"
    mkdir -p "$SNAPS/$db"
    running "$db" && { was=1; systemctl --user stop "tamagi-db-$db.service"; }
    podman volume export "tamagi-db-$db" | zstd -q -T0 -o "$file" || rm -f -- "${file:?}"
    (( was )) && systemctl --user start "tamagi-db-$db.service"
    [[ -s $file ]] || die "$(t "could not write the snapshot")"
    echo "$(t "Snapshot saved"): $db/$name ($(du -h "$file" | cut -f1))"
}

cmd_restore() {
    local db=$1 name=${2:-} was=0 file
    if [[ -z $name ]]; then
        name=$(find "$SNAPS/$db" -maxdepth 1 -name '*.tar.zst' -printf '%T@ %f\n' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2)
        name=${name%.tar.zst}
        [[ -n $name ]] || die "$(t "no snapshot saved for") $db"
    fi
    valid_snap "$name"
    file="$SNAPS/$db/$name.tar.zst"
    [[ -s $file ]] || die "$(t "there is no snapshot"): $db/$name"
    if [[ -t 0 ]]; then
        gum confirm "$(t "Replace the current data of the database with the snapshot's?") ($db ← $name)" \
            --affirmative "$(t "Yes")" --negative "$(t "No")" || exit 0
    else
        [[ ${TAMAGI_DB_YES:-} == 1 ]] || die "$(t "run it in a terminal to confirm")"
    fi
    running "$db" && { was=1; systemctl --user stop "tamagi-db-$db.service"; }
    podman rm -f "tamagi-db-$db" >/dev/null 2>&1 || true
    podman volume rm -f "tamagi-db-$db" >/dev/null
    podman volume create "tamagi-db-$db" >/dev/null
    zstd -dc "$file" | podman volume import "tamagi-db-$db" -
    (( was )) && systemctl --user start "tamagi-db-$db.service"
    echo "$(t "Snapshot restored"): $db/$name"
}

cmd_snapshots() {
    local db any="" f
    for db in "${DBS[@]}"; do
        [[ -z ${1:-} || $1 == "$db" ]] || continue
        for f in "$SNAPS/$db"/*.tar.zst; do
            [[ -e $f ]] || continue
            any=1
            printf '  %-9s %-28s %6s  %s\n' "$db" "$(basename "$f" .tar.zst)" "$(du -h "$f" | cut -f1)" "$(date -r "$f" '+%Y-%m-%d %H:%M')"
        done
    done
    [[ -n $any ]] || echo "$(t "No snapshots. Create one with"): tamagi db snapshot <db>"
}

case "${1:-}" in
    "")
        [[ -t 0 ]] || { list; exit 0; }
        db=$(printf '%s\n' "${DBS[@]}" | gum choose --header "$(t "Development database")") || exit 0
        add "$db" ;;
    add)       [[ -n ${2:-} ]] || die "usage: tamagi db add <${DBS[*]// /|}>"; add "$2" ;;
    list)      list ;;
    start)     need "${2:-}"; systemctl --user start "tamagi-db-$2.service" ;;
    stop)      need "${2:-}"; systemctl --user stop "tamagi-db-$2.service" ;;
    url)       need "${2:-}"; url_of "$2" ;;
    env)       cmd_env ;;
    shell)     need "${2:-}"; shift; cmd_shell "$@" ;;
    snapshot)  need "${2:-}"; cmd_snapshot "$2" "${3:-}" ;;
    restore)   need "${2:-}"; cmd_restore "$2" "${3:-}" ;;
    snapshots) cmd_snapshots "${2:-}" ;;
    remove)
        need "${2:-}"
        gum confirm "$(t "Delete the database and all its data?") ($2)" --affirmative "$(t "Yes")" --negative "$(t "No")" || exit 0
        systemctl --user stop "tamagi-db-$2.service" 2>/dev/null || true
        rm -f "$(unit_of "$2")"
        systemctl --user daemon-reload
        podman volume rm -f "tamagi-db-$2" >/dev/null 2>&1 || true
        echo "$(t "Database removed"): $2" ;;
    -h|--help) sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//' ;;
    *) die "usage: tamagi db [add|list|start|stop|url|env|shell|snapshot|restore|snapshots|remove] <db>" ;;
esac
