#!/usr/bin/python3
"""tamagi — one command for the whole system.

    tamagi                    lists every command
    tamagi <command> [...]    runs it (tamagi doctor, tamagi update, tamagi devbox ...)

The system in one file (~/.config/tamagi/tamagi.toml):

    tamagi init               writes the file from the current state
    tamagi export [file]      prints (or writes) the current state
    tamagi diff [file]        shows what is missing for the machine to match the file
    tamagi apply [file]       does what is missing (-y does not ask)
    tamagi apply <profile>    a ready-made profile: ai, dev, gamer, office
    tamagi apply <https URL>  a file someone shared (shows the plan and asks)
    tamagi profiles           lists the profiles

Every `tamagi <command>` is the program `tamagi-<command>`; command names are
the same in every language.
"""
import argparse
import importlib.util
import json
import os
import pathlib
import re
import shutil
import subprocess
import sys
import tomllib


def _load_i18n():
    for candidate in (
        pathlib.Path("/usr/libexec/tamagi/tamagi_i18n.py"),
        pathlib.Path(__file__).resolve().parents[1] / "libexec/tamagi/tamagi_i18n.py",
    ):
        if candidate.is_file():
            spec = importlib.util.spec_from_file_location("tamagi_i18n", candidate)
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            return mod
    raise RuntimeError("tamagi_i18n.py not found")


_I18N = _load_i18n()
t = _I18N.t

HOME = pathlib.Path.home()
CONFIG = pathlib.Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
DATA = pathlib.Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share"))
DEFAULT_FILE = CONFIG / "tamagi" / "tamagi.toml"
BROWSERS = ("chrome", "firefox", "vivaldi", "chromium")
BROWSER_METHODS = ("flatpak", "native", "box")
BOX_DISTROS = ("fedora", "ubuntu", "opensuse", "arch")
AGENTS = ("claude", "antigravity", "codex", "clio", "qwen", "opencode", "gemini", "openclaw")
PERF_PROFILES = ("eco", "balanced", "performance", "latency")
BROWSER_BOX = os.environ.get("TAMAGI_BROWSER_BOX", "browsers")
KNOWN = {
    "appearance": {"theme", "tiling"},
    "browsers": {"install", "default"},
    "flatpak": {"apps"},
    "mise": {"tools"},
    "agents": {"install"},
    "catalog": {"install"},
    "boxes": None,        # name = distro
    "layers": None,       # name = [Fedora packages]
    "webapps": None,      # name = address
    "services": {"autoupdate", "security", "performance"},
}
# Files written before the commands and keys became English keep working.
LEGACY_SECTIONS = {"aparencia": "appearance", "navegadores": "browsers",
                   "caixas": "boxes", "camadas": "layers", "servicos": "services"}
# Sections of commands that no longer exist: read and ignored, with a note.
RETIRED_SECTIONS = {"packages", "pacotes"}
LEGACY_KEYS = {
    "appearance": {"tema": "theme", "papel": None},
    "browsers": {"instalar": "install", "padrao": "default"},
    "mise": {"ferramentas": "tools"},
    "services": {"atualizacao_automatica": "autoupdate", "seguranca": "security", "desempenho": "performance"},
}
LEGACY_VALUES = {"equilibrado": "balanced", "estrito": "strict"}

PROFILE_DIR = pathlib.Path(os.environ.get("TAMAGI_PROFILES", "/usr/share/tamagi/profiles"))
PROFILES = (
    ("ai", "AI and agents: Claude Code, Codex, opencode and the development box"),
    ("dev", "Development: Fedora box, Node and Python, Zed and opencode"),
    ("gamer", "Games: native Steam, gamescope with HDR, MangoHud and Heroic"),
    ("office", "Office: Firefox, OnlyOffice and Thunderbird"),
)

# Commands shown by `tamagi` with no arguments: (group, name, description).
COMMANDS = (
    ("System", "update", "updates everything: image, Flatpaks, boxes"),
    ("System", "rewind", "goes back in time: system, files and apps"),
    ("System", "doctor", "health, integrity and performance check"),
    ("System", "boot-report", "boot health check and rolled-back updates"),
    ("System", "snap", "history of the home folder (snapshots)"),
    ("System", "layer", "Fedora packages on top of the image"),
    ("System", "perf", "performance profiles and sched_ext"),
    ("System", "harden", "security: status, strict, balanced, usb, malloc"),
    ("System", "privacy", "one-touch privacy mode"),
    ("System", "guest", "disposable guest session"),
    ("System", "lang", "system language"),
    ("Install", "install", "everything optional, in one catalog"),
    ("Install", "browser", "browsers: Flatpak, native or box"),
    ("Install", "agents", "AI agents: Claude Code, Codex, Qwen Code, opencode…"),
    ("Install", "ai", "local AI (llama.cpp): models and server"),
    ("Install", "agent", "chat with the local AI agent"),
    ("Install", "gaming", "native games (like on Bazzite) or Flatpak"),
    ("Install", "vm", "virtual machines (native virt-manager)"),
    ("Install", "windows", "Windows 11 in a container (dockur)"),
    ("Install", "webapp", "turns a website into an app"),
    ("Install", "try", "tries a package in a disposable box"),
    ("Development", "devbox", "development boxes (Fedora, Ubuntu, openSUSE, Arch)"),
    ("Development", "db", "development databases"),
    ("Development", "workspace", "declarative per-project environments"),
    ("Development", "isolate", "runs a program in a disposable jail"),
    ("Desktop", "theme", "terminal theme (follows COSMIC)"),
    ("Desktop", "panel", "bar style"),
    ("Desktop", "font", "monospace font"),
    ("Desktop", "tiling", "automatic tiling: on, off or toggle"),
    ("Desktop", "keys", "keyboard shortcuts"),
    ("Desktop", "capture", "screenshot, OCR and screen recording"),
    ("Desktop", "remind", "reminder after a while"),
    ("Desktop", "menu", "command palette"),
)


def out(cmd):
    """Output of a command, or "" if it fails or does not exist."""
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=120).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


def ok(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, timeout=120).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def slug(name):
    return re.sub(r"^-|-$", "", re.sub(r"[^a-z0-9]+", "-", name.lower()))


# ── Current state ───────────────────────────────────────────────────────────

def box_exists(name):
    return ok(["podman", "container", "exists", name])


def browsers_installed():
    """["firefox:flatpak", "chrome:box", ...] as printed by tamagi-browser."""
    return [l for l in out(["tamagi-browser", "installed"]).split() if l.partition(":")[0] in BROWSERS]


def agents_installed():
    return [a for a in out(["tamagi-agents", "installed"]).split() if a in AGENTS]


def catalog_ids():
    return set(out(["tamagi-install", "ids"]).split())


def catalog_installed():
    """Catalog items on this machine that no other section describes (native
    games, virtual machines, Windows, Tailscale)."""
    found = []
    for line in out(["tamagi-install", "installed"]).splitlines():
        item, _, action = line.partition("\t")
        if action.startswith(("gaming:", "run:")) and not action.startswith(("run:tamagi-browser", "run:tamagi-devbox")):
            found.append(item)
    return found


def mise_global():
    path = CONFIG / "mise" / "config.toml"
    try:
        tools = tomllib.loads(path.read_text()).get("tools", {})
    except (OSError, tomllib.TOMLDecodeError):
        return {}
    return {name: (v if isinstance(v, str) else str(v)) for name, v in tools.items()}


def user_boxes():
    names = out(["podman", "ps", "-a", "--filter", "label=manager=distrobox", "--format", "{{.Names}}\t{{.Image}}"])
    boxes = {}
    for line in names.splitlines():
        name, _, image = line.partition("\t")
        if name in (BROWSER_BOX, "navegadores"):
            continue
        distro = next((d for d in BOX_DISTROS if d in image or (d == "opensuse" and "tumbleweed" in image)), None)
        if distro:
            boxes[name] = distro
    return boxes


def webapps():
    apps = {}
    for f in sorted((DATA / "applications").glob("webapp-*.desktop")):
        text = f.read_text(errors="replace")
        name = re.search(r"^Name=(.*)$", text, re.M)
        url = re.search(r"^Comment=Web app: (.*)$", text, re.M)
        if name and url and "X-Tamagi-WebApp=true" in text:
            apps[name.group(1)] = url.group(1)
    return apps


def layers():
    """Layers of tamagi-layer: name -> requested packages."""
    found = {}
    for f in sorted(pathlib.Path("/var/lib/tamagi/layers").glob("*.request")):
        try:
            found[f.stem] = f.read_text().split()
        except OSError:
            continue
    return found


def tiling_file():
    return CONFIG / "cosmic/com.system76.CosmicComp/v1/autotile"


def tiling():
    for path in (tiling_file(), pathlib.Path("/usr/share/cosmic/com.system76.CosmicComp/v1/autotile")):
        try:
            return path.read_text().strip() == "true"
        except OSError:
            continue
    return True


def perf_profile():
    p = pathlib.Path("/var/lib/tamagi/perf-profile")
    try:
        v = p.read_text().strip()
        if v in PERF_PROFILES:
            return v
    except OSError:
        pass
    return "balanced"


def default_browser():
    path = CONFIG / "tamagi/browser-default"
    return path.read_text().strip() if path.exists() else ""


def current_state():
    return {
        "appearance": {
            "theme": out(["tamagi-theme", "current"]) or "tokyo-night",
            "tiling": tiling(),
        },
        "browsers": {"install": browsers_installed(), "default": default_browser()},
        "flatpak": {"apps": sorted(set(out(["flatpak", "list", "--app", "--columns=application"]).split()))},
        "mise": {"tools": [f"{n}@{v}" for n, v in sorted(mise_global().items())]},
        "agents": {"install": agents_installed()},
        "catalog": {"install": catalog_installed()},
        "boxes": user_boxes(),
        "layers": layers(),
        "webapps": webapps(),
        "services": {
            "autoupdate": ok(["systemctl", "--user", "is-enabled", "tamagi-autoupdate.timer"]),
            "security": "strict" if pathlib.Path("/etc/sysctl.d/90-tamagi-strict.conf").exists() else "balanced",
            "performance": perf_profile(),
        },
    }


# ── Export ──────────────────────────────────────────────────────────────────

def toml_value(v):
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, list):
        return "[" + ", ".join(json.dumps(x, ensure_ascii=False) for x in v) + "]"
    return json.dumps(v, ensure_ascii=False)


def to_toml(state):
    notes = {
        "appearance": t("theme: tamagi theme list · the wallpaper is chosen in COSMIC Settings"),
        "browsers": t("chrome, firefox, vivaldi or chromium; method after the colon: flatpak (default), native or box"),
        "flatpak": t("Flathub or COSMIC repository IDs"),
        "mise": t("languages and tools in the development box, as in `mise use -g`"),
        "agents": t("AI agents: claude, antigravity, codex, qwen, opencode, gemini, openclaw"),
        "catalog": t("catalog items (tamagi install list): steam, gaming-tools, virt-manager, windows, tailscale…"),
        "boxes": t("name = distro (fedora, ubuntu, opensuse, arch)"),
        "layers": t("Fedora packages on top of the image (tamagi layer): name = [packages]"),
        "webapps": t("name = URL"),
        "services": t("security: balanced or strict · performance: eco, balanced, performance or latency"),
    }
    lines = [
        f"# {t('Tamagi — your system in one file. `tamagi apply` converges the machine to it;')}",
        f"# {t('`tamagi diff` shows what is missing. Nothing absent here is removed.')}",
        "",
    ]
    for section, values in state.items():
        lines += [f"# {notes[section]}", f"[{section}]"]
        for key, value in values.items():
            k = key if re.fullmatch(r"[A-Za-z0-9_-]+", key) else json.dumps(key, ensure_ascii=False)
            lines.append(f"{k} = {toml_value(value)}")
        lines.append("")
    return "\n".join(lines)


# ── Plan ────────────────────────────────────────────────────────────────────

def modernize(wanted):
    """Portuguese section and key names (older files) become English."""
    result = {}
    for section, values in wanted.items():
        if section in RETIRED_SECTIONS:
            print(f"{t('warning')}: [{section}] {t('no longer exists (use a box: tamagi devbox); ignored')}", file=sys.stderr)
            continue
        section = LEGACY_SECTIONS.get(section, section)
        if isinstance(values, dict) and section in LEGACY_KEYS:
            renamed = {}
            for key, value in values.items():
                key = LEGACY_KEYS[section].get(key, key)
                if key is not None:
                    renamed[key] = LEGACY_VALUES.get(value, value) if isinstance(value, str) else value
            values = renamed
        result[section] = values
    return result


def browser_spec(item):
    name, _, method = str(item).partition(":")
    return name, method or "flatpak"


def load(path):
    try:
        wanted = tomllib.loads(pathlib.Path(path).read_text())
    except OSError as e:
        sys.exit(f"{t('error')}: {t('could not read')} {path}: {e.strerror}. {t('Create one with')}: tamagi init")
    except tomllib.TOMLDecodeError as e:
        sys.exit(f"{t('error')}: {path} {t('is not valid TOML')}: {e}")
    wanted = modernize(wanted)
    problems = []
    for section, values in wanted.items():
        if section not in KNOWN:
            problems.append(f"{t('unknown section')} [{section}]")
        elif not isinstance(values, dict):
            problems.append(f"[{section}] {t('must be a section')}")
        elif KNOWN[section] is not None:
            problems += [f"{t('unknown key')} {section}.{k}" for k in values if k not in KNOWN[section]]
    for item in wanted.get("browsers", {}).get("install", []):
        name, method = browser_spec(item)
        if name not in BROWSERS:
            problems.append(f"{t('unknown browser')}: {name}")
        elif method not in BROWSER_METHODS:
            problems.append(f"{t('browser')} {name}: {t('unknown method')} '{method}'")
    for name in wanted.get("agents", {}).get("install", []):
        if name not in AGENTS:
            problems.append(f"{t('unknown agent')}: {name}")
    wanted_items = wanted.get("catalog", {}).get("install", [])
    if wanted_items:
        known = catalog_ids()
        for item in wanted_items:
            if known and item not in known:
                problems.append(f"{t('is not in the catalog')}: {item}")
    for name, distro in wanted.get("boxes", {}).items():
        if distro not in BOX_DISTROS:
            problems.append(f"{t('box')} {name}: {t('unknown distro')} '{distro}'")
        if not re.fullmatch(r"[a-z][a-z0-9_-]*", name):
            problems.append(f"{t('invalid box name')}: {name}")
    for name, pkgs in wanted.get("layers", {}).items():
        if not re.fullmatch(r"[a-z][a-z0-9-]{0,39}", name):
            problems.append(f"{t('invalid layer name')}: {name}")
        if not (isinstance(pkgs, list) and pkgs and all(isinstance(p, str) and p for p in pkgs)):
            problems.append(f"{t('layer')} {name}: {t('must be a list of packages')}")
    for name, url in wanted.get("webapps", {}).items():
        if not re.match(r"https?://", str(url)):
            problems.append(f"{t('web app')} {name}: {t('URL must start with http:// or https://')}")
    if wanted.get("services", {}).get("security", "balanced") not in ("balanced", "strict"):
        problems.append(t("services.security must be balanced or strict"))
    if wanted.get("services", {}).get("performance", "balanced") not in PERF_PROFILES:
        problems.append(t("services.performance must be eco, balanced, performance or latency"))
    if problems:
        sys.exit(f"{t('file error')}:\n  " + "\n  ".join(problems))
    return wanted


def plan(wanted):
    """List of (description, command, needs_password) to reach the wanted state."""
    now = current_state()
    steps = []
    ap = wanted.get("appearance", {})
    if "theme" in ap and ap["theme"] != now["appearance"]["theme"]:
        steps.append((f"{t('theme')}: {ap['theme']}", ["tamagi-theme", "set", str(ap["theme"])], False))
    if "tiling" in ap and bool(ap["tiling"]) != now["appearance"]["tiling"]:
        steps.append((f"tiling: {t('running') if ap['tiling'] else t('off')}",
                      ["tamagi", "tiling", "on" if ap["tiling"] else "off"], False))
    have = {b.partition(":")[0] for b in now["browsers"]["install"]}
    for item in wanted.get("browsers", {}).get("install", []):
        name, method = browser_spec(item)
        if name not in have:
            steps.append((f"{t('browser')}: {name} ({method})",
                          ["tamagi-browser", "install", name, f"--{method}"], method == "native"))
    default = wanted.get("browsers", {}).get("default")
    if default and default != now["browsers"]["default"]:
        steps.append((f"{t('default browser')}: {default}", ["tamagi-browser", "default", default], False))
    for app in wanted.get("flatpak", {}).get("apps", []):
        if app not in now["flatpak"]["apps"]:
            steps.append((f"Flatpak: {app}", ["flatpak", "install", "--user", "-y", "--noninteractive", app], False))
    have = mise_global()
    for tool in wanted.get("mise", {}).get("tools", []):
        name, _, version = tool.partition("@")
        if name not in have or (version and have[name] != version):
            steps.append((f"mise: {tool}", ["tamagi-devbox", "lang", tool], False))
    for name in wanted.get("agents", {}).get("install", []):
        if name not in now["agents"]["install"]:
            steps.append((f"{t('agent')}: {name}", ["tamagi-agents", "install", name], False))
    missing = [i for i in wanted.get("catalog", {}).get("install", []) if i not in now["catalog"]["install"]]
    if missing:
        installed = {l.partition("\t")[0] for l in out(["tamagi-install", "installed"]).splitlines()}
        missing = [i for i in missing if i not in installed]
    if missing:
        steps.append((f"{t('catalog')}: {' '.join(missing)}", ["tamagi-install", *missing], True))
    for name, distro in wanted.get("boxes", {}).items():
        if not box_exists(name):
            steps.append((f"{t('box')} {name} ({distro})",
                          ["tamagi-devbox", "create", distro, "--name", name], False))
    for name, pkgs in wanted.get("layers", {}).items():
        if sorted(now["layers"].get(name, [])) != sorted(pkgs):
            steps.append((f"{t('layer')} {name}: {' '.join(pkgs)}", ["tamagi-layer", "add", name, *pkgs], True))
    for name, url in wanted.get("webapps", {}).items():
        if not (DATA / "applications" / f"webapp-{slug(name)}.desktop").exists():
            steps.append((f"{t('web app')}: {name}", ["tamagi-webapp", "install", name, str(url)], False))
    sv = wanted.get("services", {})
    if "autoupdate" in sv and bool(sv["autoupdate"]) != now["services"]["autoupdate"]:
        steps.append((f"{t('automatic updates')}: {t('on') if sv['autoupdate'] else t('off')}",
                      ["tamagi-update", "auto", "on" if sv["autoupdate"] else "off"], True))
    if "security" in sv and sv["security"] != now["services"]["security"]:
        steps.append((f"{t('security')}: {sv['security']}", ["tamagi-harden", sv["security"]], True))
    if "performance" in sv and sv["performance"] != now["services"]["performance"]:
        steps.append((f"{t('performance')}: {sv['performance']}",
                      ["tamagi-perf", "set", sv["performance"]], True))
    return steps, now


def extras(wanted, now):
    """What the machine has and the file does not mention (information only)."""
    found = []
    listed = set(wanted.get("flatpak", {}).get("apps", []))
    found += [f"Flatpak {a}" for a in now["flatpak"]["apps"] if a not in listed]
    listed = {item.partition("@")[0] for item in wanted.get("mise", {}).get("tools", [])}
    found += [f"mise {item}" for item in now["mise"]["tools"] if item.partition("@")[0] not in listed]
    found += [f"{t('box')} {n}" for n in now["boxes"] if n not in wanted.get("boxes", {})]
    found += [f"{t('layer')} {n}" for n in now["layers"] if n not in wanted.get("layers", {})]
    found += [f"{t('web app')} {n}" for n in now["webapps"] if n not in wanted.get("webapps", {})]
    return found


# ── Small built-in commands ─────────────────────────────────────────────────

def cmd_tiling(argv):
    action = argv[0] if argv else "toggle"
    if action not in ("on", "off", "toggle", "status"):
        sys.exit("usage: tamagi tiling [on|off|toggle|status]")
    new = tiling()
    if action != "status":
        new = {"on": True, "off": False, "toggle": not tiling()}[action]
        tiling_file().parent.mkdir(parents=True, exist_ok=True)
        tiling_file().write_text("true\n" if new else "false\n")
    print(f"tiling: {t('running') if new else t('off')}")


def cmd_profiles():
    for name, desc in PROFILES:
        print(f"  tamagi apply {name:<7} {t(desc)}")
    print(f"\n{t('A profile only adds what is missing; nothing is removed.')}")


def resolve(source):
    """A file, the name of a profile or an https address -> path of a TOML file."""
    if re.match(r"https://", source):
        import tempfile
        import urllib.request
        try:
            with urllib.request.urlopen(source, timeout=30) as r:
                data = r.read(1_000_001)
        except OSError as e:
            sys.exit(f"{t('error')}: {t('could not download')} {source}: {e}")
        if len(data) > 1_000_000:
            sys.exit(f"{t('error')}: {t('file too large for a tamagi.toml')}")
        import atexit
        tmp = tempfile.NamedTemporaryFile(prefix="tamagi-", suffix=".toml", delete=False)
        tmp.write(data)
        tmp.close()
        atexit.register(lambda: pathlib.Path(tmp.name).unlink(missing_ok=True))
        print(f"{t('Downloaded from')} {source}")
        return tmp.name, True
    if re.match(r"[a-z]+://", source):
        sys.exit(f"{t('error')}: {t('only https:// addresses are accepted')}")
    if not pathlib.Path(source).exists() and (PROFILE_DIR / f"{source}.toml").is_file():
        return str(PROFILE_DIR / f"{source}.toml"), False
    return source, False


def cmd_list():
    width = max(len(name) for _, name, _ in COMMANDS)
    print(f"tamagi — {t('one command for the whole system')}\n")
    group = None
    for g, name, desc in COMMANDS:
        if g != group:
            group = g
            print(f"{t(g)}")
        print(f"  tamagi {name:<{width}}  {t(desc)}")
    print(f"\n{t('Ready-made profiles')}: tamagi profiles  ·  tamagi apply ai | dev | gamer | office")
    print(f"\n{t('The system in one file')}")
    for name, desc in (("init", "create the file from the current state"), ("export", "print or save the current state"),
                       ("diff", "show what is missing"), ("apply", "apply what is missing")):
        print(f"  tamagi {name:<{width}}  {t(desc)}")


def main():
    argv = sys.argv[1:]
    if not argv or argv[0] in ("help", "list", "commands"):
        cmd_list()
        return
    if argv[0] == "profiles":
        cmd_profiles()
        return
    if argv[0] == "tiling":
        cmd_tiling(argv[1:])
        return
    # Every other command is the program tamagi-<command>.
    if re.fullmatch(r"[a-z][a-z0-9-]*", argv[0]) and argv[0] not in ("init", "export", "diff", "apply"):
        prog = shutil.which(f"tamagi-{argv[0]}")
        if prog:
            os.execv(prog, [prog] + argv[1:])
        sys.exit(f"tamagi: {t('unknown command')}: {argv[0]}  ({t('see')}: tamagi)")

    parser = argparse.ArgumentParser(prog="tamagi", description=t("Your system described in a single file."))
    sub = parser.add_subparsers(dest="cmd", required=True)
    sub.add_parser("init", help=t("create the file from the current state"))
    p = sub.add_parser("export", help=t("print or save the current state"))
    p.add_argument("file", nargs="?")
    for name, text in (("diff", t("show what is missing")), ("apply", t("apply what is missing"))):
        p = sub.add_parser(name, help=text)
        p.add_argument("file", nargs="?", default=str(DEFAULT_FILE))
        if name == "apply":
            p.add_argument("-y", "--yes", action="store_true", help=t("do not ask before starting"))
    args = parser.parse_args()

    if args.cmd in ("init", "export"):
        text = to_toml(current_state())
        target = DEFAULT_FILE if args.cmd == "init" else (pathlib.Path(args.file) if args.file else None)
        if target is None:
            print(text)
            return
        if args.cmd == "init" and target.exists():
            sys.exit(f"{target} {t('already exists. To see differences')}: tamagi diff")
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(text)
        print(f"{t('Saved to')} {target}. {t('Edit and run')}: tamagi apply")
        return

    args.file, remote = resolve(args.file)
    if remote and args.cmd == "apply" and args.yes:
        # A file from the network is always shown before it changes the machine.
        args.yes = False
    wanted = load(args.file)
    steps, now = plan(wanted)
    if not steps:
        print(t("Nothing to do: the machine already matches the file."))
    else:
        print(f"{t('Missing') if args.cmd == 'diff' else t('Will apply')} ({len(steps)}):")
        for desc, _, root in steps:
            print(f"  + {desc}" + (f"   [{t('needs password')}]" if root else ""))
    more = extras(wanted, now)
    if more and args.cmd == "diff":
        print(f"{t('On this machine and outside the file')} ({len(more)}; {t('nothing is removed')}):")
        for item in more:
            print(f"  · {item}")
    if args.cmd == "diff" or not steps:
        return
    if not args.yes:
        if not sys.stdin.isatty():
            sys.exit(t("Run in a terminal, or pass -y to apply without prompting."))
        if input(f"{t('Apply?')} [s/y/N] ").strip().lower() not in ("s", "sim", "y", "yes", "o", "oui"):
            sys.exit(t("Nothing was changed."))
    failed = []
    for desc, cmd, _ in steps:
        print(f"\n── {desc}")
        if shutil.which(cmd[0]) is None or subprocess.run(cmd).returncode != 0:
            failed.append(desc)
    print()
    if failed:
        sys.exit(f"{t('Finished with failures in')}: " + "; ".join(failed) + f"\n{t('Run `tamagi diff` to see what is still missing.')}")
    print(t("Done: the machine now matches the file."))


if __name__ == "__main__":
    main()
