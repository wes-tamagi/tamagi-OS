#!/usr/bin/python3
"""tamagi — o seu sistema descrito num arquivo só.

    tamagi init              cria ~/.config/tamagi/tamagi.toml a partir do estado atual
    tamagi export [arquivo]  imprime (ou grava) o estado atual no formato do arquivo
    tamagi diff [arquivo]    mostra o que falta para a máquina ficar como o arquivo
    tamagi apply [arquivo]   faz o que falta (-y não pergunta)
    tamagi voltar|back       volta no tempo: sistema, arquivos e apps (tamagi-voltar)
    tamagi devbox            caixas de desenvolvimento (Fedora padrão + multi-distro)
    tamagi workspace         ambientes declarativos por projeto (tamagi-workspace)
    tamagi perf              perfis de desempenho e sched_ext (tamagi-perf)
    tamagi doctor            diagnóstico autônomo do sistema (tamagi-doctor)
"""
import argparse
import importlib.util
import json
import os
import pathlib
import re
import shutil
import subprocess
import sys
import tomllib


def _load_i18n():
    for candidate in (
        pathlib.Path("/usr/libexec/tamagi/tamagi_i18n.py"),
        pathlib.Path(__file__).resolve().parents[1] / "libexec/tamagi/tamagi_i18n.py",
    ):
        if candidate.is_file():
            spec = importlib.util.spec_from_file_location("tamagi_i18n", candidate)
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            return mod
    raise RuntimeError("tamagi_i18n.py not found")


_I18N = _load_i18n()
t = _I18N.t

HOME = pathlib.Path.home()
CONFIG = pathlib.Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
DATA = pathlib.Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share"))
DEFAULT_FILE = CONFIG / "tamagi" / "tamagi.toml"
BROWSERS = ("chrome", "firefox", "brave", "edge", "vivaldi")
BROWSER_BIN = {"chrome": "google-chrome-stable", "firefox": "firefox", "brave": "brave-browser",
               "edge": "microsoft-edge-stable", "vivaldi": "vivaldi-stable"}
BOX_DISTROS = ("fedora", "arch", "popos", "ubuntu", "alma", "rocky", "opensuse", "debian", "alpine")
PERF_PROFILES = ("eco", "balanced", "performance", "latency")
BROWSER_BOX = os.environ.get("TAMAGI_BROWSER_BOX", "navegadores")
KNOWN = {
    "aparencia": {"tema", "papel", "tiling"},
    "navegadores": {"instalar", "padrao"},
    "flatpak": {"apps"},
    "mise": {"ferramentas"},
    "pacotes": {"deb", "rpm", "arch", "omarchy"},
    "caixas": None,       # nome = distro
    "camadas": None,      # nome = [pacotes do Fedora]
    "webapps": None,      # nome = endereço
    "servicos": {"atualizacao_automatica", "android", "seguranca", "desempenho"},
}


def out(cmd):
    """Saída de um comando, ou "" se ele falhar ou não existir."""
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=120).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


def ok(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, timeout=120).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def slug(name):
    return re.sub(r"^-|-$", "", re.sub(r"[^a-z0-9]+", "-", name.lower()))


# ── Estado atual ────────────────────────────────────────────────────────────

def box_exists(name):
    return ok(["podman", "container", "exists", name])


def browsers_installed():
    if not box_exists(BROWSER_BOX):
        return []
    script = "for b in %s; do command -v $b >/dev/null 2>&1 && echo $b; done" % " ".join(BROWSER_BIN.values())
    found = out(["distrobox", "enter", BROWSER_BOX, "--", "sh", "-c", script]).split()
    return [name for name, binary in BROWSER_BIN.items() if binary in found]


def mise_global():
    path = CONFIG / "mise" / "config.toml"
    try:
        tools = tomllib.loads(path.read_text()).get("tools", {})
    except (OSError, tomllib.TOMLDecodeError):
        return {}
    return {name: (v if isinstance(v, str) else str(v)) for name, v in tools.items()}


def pkg_list(sub):
    try:
        return [l for l in (DATA / "tamagi" / f"pkg-{sub}.list").read_text().split() if l]
    except OSError:
        return []


def user_boxes():
    names = out(["podman", "ps", "-a", "--filter", "label=manager=distrobox", "--format", "{{.Names}}\t{{.Image}}"])
    boxes = {}
    for line in names.splitlines():
        name, _, image = line.partition("\t")
        if name in ("deb", "rpm", "arch", BROWSER_BOX):
            continue
        if "popos" in name:
            distro = "popos"
        else:
            distro = next((d for d in BOX_DISTROS if d in image or (d == "opensuse" and "tumbleweed" in image)), None)
        if distro:
            boxes[name] = distro
    return boxes


def webapps():
    apps = {}
    for f in sorted((DATA / "applications").glob("webapp-*.desktop")):
        text = f.read_text(errors="replace")
        name = re.search(r"^Name=(.*)$", text, re.M)
        url = re.search(r"^Comment=Web app: (.*)$", text, re.M)
        if name and url and "X-Tamagi-WebApp=true" in text:
            apps[name.group(1)] = url.group(1)
    return apps


def layers():
    """Camadas do tamagi-layer: nome -> pacotes pedidos."""
    found = {}
    for f in sorted(pathlib.Path("/var/lib/tamagi/layers").glob("*.request")):
        try:
            found[f.stem] = f.read_text().split()
        except OSError:
            continue
    return found


def tiling():
    for base in (CONFIG / "cosmic", pathlib.Path("/usr/share/cosmic")):
        try:
            return (base / "com.system76.CosmicComp/v1/autotile").read_text().strip() == "true"
        except OSError:
            continue
    return True


def perf_profile():
    p = pathlib.Path("/var/lib/tamagi/perf-profile")
    try:
        v = p.read_text().strip()
        if v in PERF_PROFILES:
            return v
    except OSError:
        pass
    return "balanced"


def current_state(with_browsers=True):
    state = {
        "aparencia": {
            "tema": out(["tamagi-theme", "current"]) or "tokyo-night",
            "papel": ((CONFIG / "tamagi/wallpaper").read_text().strip()
                      if (CONFIG / "tamagi/wallpaper").exists() else "mon"),
            "tiling": tiling(),
        },
        "navegadores": {"instalar": browsers_installed() if with_browsers else [],
                        "padrao": ((CONFIG / "tamagi/browser-default").read_text().strip()
                                   if (CONFIG / "tamagi/browser-default").exists() else "chrome")},
        "flatpak": {"apps": sorted(set(out(["flatpak", "list", "--app", "--columns=application"]).split()))},
        "mise": {"ferramentas": [f"{n}@{v}" for n, v in sorted(mise_global().items())]},
        "pacotes": {sub: pkg_list(sub) for sub in ("deb", "rpm", "arch")},
        "caixas": user_boxes(),
        "camadas": layers(),
        "webapps": webapps(),
        "servicos": {
            "atualizacao_automatica": ok(["systemctl", "--user", "is-enabled", "tamagi-autoupdate.timer"]),
            "seguranca": "estrito" if pathlib.Path("/etc/sysctl.d/90-tamagi-strict.conf").exists() else "equilibrado",
            "desempenho": perf_profile(),
        },
    }
    state["pacotes"]["omarchy"] = []
    return state


# ── Exportar ────────────────────────────────────────────────────────────────

def toml_value(v):
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, list):
        return "[" + ", ".join(json.dumps(x, ensure_ascii=False) for x in v) + "]"
    return json.dumps(v, ensure_ascii=False)


def to_toml(state):
    notes = {
        "aparencia": t("tema: tamagi-theme list · papel: mon, seigaiha, asanoha, byobu, shippo, hinode, uroko, ondas"),
        "navegadores": t("na caixa Fedora: chrome, firefox, brave, edge, vivaldi"),
        "flatpak": t("IDs do Flathub ou do repositório COSMIC"),
        "mise": t("linguagens e ferramentas globais, como em `mise use -g`"),
        "pacotes": t("subsistemas do tamagi-pkg (omarchy usa a caixa Arch)"),
        "caixas": t("nome = distro (fedora, arch, popos, ubuntu, alma, rocky, opensuse, debian, alpine)"),
        "camadas": t("pacotes do Fedora por cima da imagem (tamagi-layer): nome = [pacotes]"),
        "webapps": t("nome = endereço"),
        "servicos": t("seguranca: equilibrado ou estrito · desempenho: eco, balanced, performance ou latency"),
    }
    lines = [
        f"# {t('Tamagi — o seu sistema num arquivo. `tamagi apply` deixa a máquina assim;')}",
        f"# {t('`tamagi diff` mostra o que falta. Nada que não esteja aqui é removido.')}",
        "",
    ]
    for section, values in state.items():
        lines += [f"# {notes[section]}", f"[{section}]"]
        for key, value in values.items():
            k = key if re.fullmatch(r"[A-Za-z0-9_-]+", key) else json.dumps(key, ensure_ascii=False)
            lines.append(f"{k} = {toml_value(value)}")
        lines.append("")
    return "\n".join(lines)


# ── Plano ───────────────────────────────────────────────────────────────────

def load(path):
    try:
        wanted = tomllib.loads(pathlib.Path(path).read_text())
    except OSError as e:
        sys.exit(f"{t('erro')}: {t('não consegui ler')} {path}: {e.strerror}. {t('Crie um com')}: tamagi init")
    except tomllib.TOMLDecodeError as e:
        sys.exit(f"{t('erro')}: {path} {t('não é TOML válido')}: {e}")
    problems = []
    for section, values in wanted.items():
        if section not in KNOWN:
            problems.append(f"{t('seção desconhecida')} [{section}]")
        elif not isinstance(values, dict):
            problems.append(f"[{section}] {t('precisa ser uma seção')}")
        elif KNOWN[section] is not None:
            problems += [f"{t('chave desconhecida')} {section}.{k}" for k in values if k not in KNOWN[section]]
    for name in wanted.get("navegadores", {}).get("instalar", []):
        if name not in BROWSERS:
            problems.append(f"{t('navegador desconhecido')}: {name}")
    for name, distro in wanted.get("caixas", {}).items():
        if distro not in BOX_DISTROS:
            problems.append(f"{t('caixa')} {name}: {t('distro desconhecida')} '{distro}'")
        if not re.fullmatch(r"[a-z][a-z0-9_-]*", name):
            problems.append(f"{t('nome de caixa inválido')}: {name}")
    for name, pkgs in wanted.get("camadas", {}).items():
        if not re.fullmatch(r"[a-z][a-z0-9-]{0,39}", name):
            problems.append(f"{t('nome de camada inválido')}: {name}")
        if not (isinstance(pkgs, list) and pkgs and all(isinstance(p, str) and p for p in pkgs)):
            problems.append(f"{t('camada')} {name}: {t('precisa ser uma lista de pacotes')}")
    for name, url in wanted.get("webapps", {}).items():
        if not re.match(r"https?://", str(url)):
            problems.append(f"{t('web app')} {name}: {t('o endereço precisa começar com http:// ou https://')}")
    if wanted.get("servicos", {}).get("seguranca", "equilibrado") not in ("equilibrado", "estrito"):
        problems.append(t("servicos.seguranca precisa ser equilibrado ou estrito"))
    if wanted.get("servicos", {}).get("desempenho", "balanced") not in PERF_PROFILES:
        problems.append(t("servicos.desempenho precisa ser eco, balanced, performance ou latency"))
    if problems:
        sys.exit(f"{t('erro no arquivo')}:\n  " + "\n  ".join(problems))
    return wanted


def plan(wanted):
    """Lista de (descrição, comando, precisa_de_senha) para chegar ao estado pedido."""
    want_browsers = wanted.get("navegadores", {}).get("instalar", [])
    now = current_state(with_browsers=bool(want_browsers))
    steps = []
    ap = wanted.get("aparencia", {})
    if "papel" in ap and ap["papel"] != now["aparencia"]["papel"]:
        steps.append((f"{t('papel de parede')}: {ap['papel']}", ["tamagi-theme", "wallpaper", str(ap["papel"])], False))
    if "tema" in ap and ap["tema"] != now["aparencia"]["tema"]:
        steps.append((f"{t('tema')}: {ap['tema']}", ["tamagi-theme", "set", str(ap["tema"])], False))
    if "tiling" in ap and bool(ap["tiling"]) != now["aparencia"]["tiling"]:
        steps.append((f"tiling: {t('ligado') if ap['tiling'] else t('desligado')}",
                      ["ujust", "tiling", "on" if ap["tiling"] else "off"], False))
    for name in want_browsers:
        if name not in now["navegadores"]["instalar"]:
            steps.append((f"{t('navegador')}: {name}", ["tamagi-browser", "install", name], False))
    default = wanted.get("navegadores", {}).get("padrao")
    if default and default != now["navegadores"]["padrao"]:
        steps.append((f"{t('navegador padrão')}: {default}", ["tamagi-browser", "default", default], False))
    for app in wanted.get("flatpak", {}).get("apps", []):
        if app not in now["flatpak"]["apps"]:
            steps.append((f"Flatpak: {app}", ["flatpak", "install", "-y", "--noninteractive", app], False))
    have = mise_global()
    for tool in wanted.get("mise", {}).get("ferramentas", []):
        name, _, version = tool.partition("@")
        if name not in have or (version and have[name] != version):
            steps.append((f"mise: {tool}", ["mise", "use", "-g", tool], False))
    for sub, flag in (("deb", "--deb"), ("rpm", "--rpm"), ("arch", "--arch"), ("omarchy", "--omarchy")):
        installed = now["pacotes"]["arch" if sub == "omarchy" else sub]
        for pkg in wanted.get("pacotes", {}).get(sub, []):
            if pkg not in installed:
                steps.append((f"{t('pacote')} {sub}: {pkg}", ["tamagi-pkg", "install", flag, pkg], False))
    for name, distro in wanted.get("caixas", {}).items():
        if not box_exists(name):
            steps.append((f"{t('caixa')} {name} ({distro})",
                          ["tamagi-devbox", "create", distro, "--name", name], False))
    for name, pkgs in wanted.get("camadas", {}).items():
        if sorted(now["camadas"].get(name, [])) != sorted(pkgs):
            steps.append((f"{t('camada')} {name}: {' '.join(pkgs)}", ["tamagi-layer", "add", name, *pkgs], True))
    for name, url in wanted.get("webapps", {}).items():
        if not (DATA / "applications" / f"webapp-{slug(name)}.desktop").exists():
            steps.append((f"{t('web app')}: {name}", ["tamagi-webapp", "install", name, str(url)], False))
    sv = wanted.get("servicos", {})
    if "atualizacao_automatica" in sv and bool(sv["atualizacao_automatica"]) != now["servicos"]["atualizacao_automatica"]:
        steps.append((f"{t('atualização automática')}: {t('ligada') if sv['atualizacao_automatica'] else t('desligada')}",
                      ["tamagi-update", "auto", "on" if sv["atualizacao_automatica"] else "off"], True))
    if "seguranca" in sv and sv["seguranca"] != now["servicos"]["seguranca"]:
        steps.append((f"{t('segurança')}: {sv['seguranca']}",
                      ["tamagi-harden", "strict" if sv["seguranca"] == "estrito" else "balanced"], True))
    if "desempenho" in sv and sv["desempenho"] != now["servicos"]["desempenho"]:
        steps.append((f"{t('desempenho')}: {sv['desempenho']}",
                      ["tamagi-perf", "set", sv["desempenho"]], True))
    return steps, now


def extras(wanted, now):
    """O que a máquina tem e o arquivo não cita (só informa; nada é removido)."""
    found = []
    listed = set(wanted.get("flatpak", {}).get("apps", []))
    found += [f"Flatpak {a}" for a in now["flatpak"]["apps"] if a not in listed]
    listed = {t_item.partition("@")[0] for t_item in wanted.get("mise", {}).get("ferramentas", [])}
    found += [f"mise {t_item}" for t_item in now["mise"]["ferramentas"] if t_item.partition("@")[0] not in listed]
    found += [f"{t('caixa')} {n}" for n in now["caixas"] if n not in wanted.get("caixas", {})]
    found += [f"{t('camada')} {n}" for n in now["camadas"] if n not in wanted.get("camadas", {})]
    found += [f"{t('web app')} {n}" for n in now["webapps"] if n not in wanted.get("webapps", {})]
    return found


def main():
    # Subcomandos delegados (aceita português, inglês, espanhol e francês).
    delegates = {
        "voltar": "tamagi-voltar", "back": "tamagi-voltar", "rollback": "tamagi-voltar",
        "volver": "tamagi-voltar", "retour": "tamagi-voltar",
        "devbox": "tamagi-devbox",
        "workspace": "tamagi-workspace",
        "perf": "tamagi-perf", "desempenho": "tamagi-perf", "performance": "tamagi-perf",
        "doctor": "tamagi-doctor", "diagnostico": "tamagi-doctor",
        "gaming": "tamagi-gaming", "jogos": "tamagi-gaming",
    }
    if len(sys.argv) >= 2 and sys.argv[1] in delegates:
        prog = delegates[sys.argv[1]]
        os.execvp(prog, [prog] + sys.argv[2:])

    parser = argparse.ArgumentParser(prog="tamagi", description=t("O seu sistema descrito num arquivo só."))
    sub = parser.add_subparsers(dest="cmd", required=True)
    sub.add_parser("init", help=t("cria o arquivo a partir do estado atual"))
    p = sub.add_parser("export", help=t("imprime ou grava o estado atual"))
    p.add_argument("arquivo", nargs="?")
    for name, text in (("diff", t("mostra o que falta")), ("apply", t("faz o que falta"))):
        p = sub.add_parser(name, help=text)
        p.add_argument("arquivo", nargs="?", default=str(DEFAULT_FILE))
        if name == "apply":
            p.add_argument("-y", "--yes", action="store_true", help=t("não pergunta antes de começar"))
    args = parser.parse_args()

    if args.cmd in ("init", "export"):
        text = to_toml(current_state())
        target = DEFAULT_FILE if args.cmd == "init" else (pathlib.Path(args.arquivo) if args.arquivo else None)
        if target is None:
            print(text)
            return
        if args.cmd == "init" and target.exists():
            sys.exit(f"{target} {t('já existe. Para ver a diferença')}: tamagi diff")
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(text)
        print(f"{t('Gravado em')} {target}. {t('Edite e rode')}: tamagi apply")
        return

    wanted = load(args.arquivo)
    steps, now = plan(wanted)
    if not steps:
        print(t("Nada a fazer: a máquina já está como o arquivo descreve."))
    else:
        print(f"{t('Falta') if args.cmd == 'diff' else t('Vou fazer')} ({len(steps)}):")
        for desc, _, root in steps:
            print(f"  + {desc}" + (f"   [{t('pede senha')}]" if root else ""))
    more = extras(wanted, now)
    if more and args.cmd == "diff":
        print(f"{t('Na máquina e fora do arquivo')} ({len(more)}; {t('nada é removido')}):")
        for item in more:
            print(f"  · {item}")
    if args.cmd == "diff" or not steps:
        return
    if not args.yes:
        if not sys.stdin.isatty():
            sys.exit(t("Rode num terminal, ou use -y para aplicar sem perguntar."))
        if input(f"{t('Aplicar?')} [s/y/N] ").strip().lower() not in ("s", "sim", "y", "yes", "o", "oui"):
            sys.exit(t("Nada foi alterado."))
    failed = []
    for desc, cmd, _ in steps:
        print(f"\n── {desc}")
        if shutil.which(cmd[0]) is None or subprocess.run(cmd).returncode != 0:
            failed.append(desc)
    print()
    if failed:
        sys.exit(f"{t('Terminou com falhas em')}: " + "; ".join(failed) + f"\n{t('Rode `tamagi diff` para ver o que ainda falta.')}")
    print(t("Pronto: a máquina está como o arquivo descreve."))


if __name__ == "__main__":
    main()
