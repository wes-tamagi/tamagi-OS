#!/usr/bin/bash
# tamagi-theme — the colours of the terminal apps follow the COSMIC theme.
#
# Themes and wallpapers are chosen the normal way, in COSMIC Settings
# (Appearance and Wallpaper): the Tamagi themes are there to import
# (/usr/share/cosmic-themes) and the wallpapers are in the system list.
# What COSMIC does not reach — the terminal and the Tamagi windows (foot),
# btop and Neovim — is kept in step by `tamagi theme sync`, which
# a user unit runs whenever the COSMIC theme changes.
#
#   tamagi theme                 current theme
#   tamagi theme list            Tamagi themes
#   tamagi theme set <theme>     applies it to COSMIC and to the terminal apps
#   tamagi theme next | pick     next one / choose from a list
#   tamagi theme sync            re-reads the COSMIC theme (automatic)
#   tamagi theme settings        opens COSMIC Settings › Appearance
#   tamagi theme wallpaper       opens COSMIC Settings › Wallpaper
set -euo pipefail
. /usr/libexec/tamagi/i18n

THEMES=${TAMAGI_THEMES:-/usr/share/tamagi/themes}
WALLS=/usr/share/backgrounds/tamagi
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE="$CONFIG/tamagi/theme"
USER_THEMES="$CONFIG/tamagi/themes"      # "cosmic.conf": made from a COSMIC theme that is not a Tamagi one
COSMIC_SYS=${TAMAGI_COSMIC_DEFAULTS:-/usr/share/cosmic}

list() { find "$THEMES" -name '*.conf' -printf '%f\n' | sed 's/\.conf$//' | sort; }
# The default themes: Ipê (dark) and Ipê Claro (light). A saved theme that
# the image no longer has falls back to the default.
DEFAULT_DARK=ipe DEFAULT_LIGHT=ipe-light
current() {
    local name; name=$(cat "$STATE" 2>/dev/null || true)
    if [[ -n $name && ( -f $THEMES/$name.conf || -f $USER_THEMES/$name.conf ) ]]; then echo "$name"; else echo "$DEFAULT_DARK"; fi
}

# The wallpaper belongs to COSMIC. When the one in use is a Tamagi wallpaper
# (one style drawn in the colours of each theme), changing theme keeps the
# style and brings the new colours; any other wallpaper is left alone.
wall_file() { # wall_file <theme>: path to swap to, or nothing
    local bg="$CONFIG/cosmic/com.system76.CosmicBackground/v1/all" cur style
    [[ -f $bg ]] || bg="$COSMIC_SYS/com.system76.CosmicBackground/v1/all"
    cur=$(sed -n 's/.*source: Path("\(.*\)").*/\1/p' "$bg" 2>/dev/null | head -1)
    [[ $cur == "$WALLS"/* ]] || return 0
    style=$(basename "$cur" .png); style=${style##*-}
    [[ -f $WALLS/$1-$style.png ]] && echo "$WALLS/$1-$style.png"
    return 0
}

# Fonte dos terminais (tamagi-font set troca).
mono_font() { local f; f=$(head -1 "$CONFIG/tamagi/font" 2>/dev/null || true); echo "${f:-JetBrains Mono}"; }

load() {
    local conf="$THEMES/$1.conf"
    [[ -f $conf ]] || conf="$USER_THEMES/$1.conf"
    [[ -f $conf ]] || { echo "$(t "unknown theme"): $1 (tamagi theme list)" >&2; exit 1; }
    # shellcheck disable=SC1090
    source "$conf"
}

foot_config() { # configuração do foot (terminal padrão) com a paleta do tema
    local i
    cat <<INI
# Gerado por tamagi-theme ($NAME). Enquanto esta primeira linha existir, trocar
# de tema reescreve este arquivo; para personalizar o foot, apague-a.
[main]
font=$(mono_font):size=11
pad=12x10
term=xterm-256color

[scrollback]
lines=10000

[mouse]
hide-when-typing=yes

[colors-dark]
background=${BG#\#}
foreground=${FG#\#}
cursor=${BG#\#} ${CURSOR#\#}
selection-background=${WALL[2]#\#}
selection-foreground=${BG#\#}
INI
    for i in 0 1 2 3 4 5 6 7; do echo "regular$i=${PALETTE[$i]#\#}"; done
    for i in 0 1 2 3 4 5 6 7; do echo "bright$i=${PALETTE[$((i + 8))]#\#}"; done
}

apply_ptyxis() { # the terminal of the system: a palette "Tamagi" with the colours of the theme
    local dir="${XDG_DATA_HOME:-$HOME/.local/share}/org.gnome.Ptyxis/palettes" i section uuid
    mkdir -p "$dir"
    {
        printf '[Palette]\nName=Tamagi\n'
        for section in Light Dark; do
            printf '\n[%s]\nForeground=%s\nBackground=%s\nCursor=%s\n' "$section" "$FG" "$BG" "$CURSOR"
            for i in "${!PALETTE[@]}"; do printf 'Color%s=%s\n' "$i" "${PALETTE[$i]}"; done
        done
    } > "$dir/tamagi.palette"
    # Chosen for the default profile, when Ptyxis has already made one.
    uuid=$(gsettings get org.gnome.Ptyxis default-profile-uuid 2>/dev/null | tr -d "'") || true
    if [[ -n $uuid ]]; then
        gsettings set "org.gnome.Ptyxis.Profile:/org/gnome/Ptyxis/Profiles/$uuid/" palette tamagi 2>/dev/null || true
    fi
}

apply_foot() { # só reescreve o foot.ini que o próprio tamagi-theme gerou
    local ini="$CONFIG/foot/foot.ini"
    if [[ ! -e $ini ]] || head -1 "$ini" | grep -q '^# Gerado por tamagi-theme'; then
        mkdir -p "$CONFIG/foot"
        foot_config > "$ini"
    fi
}

btop_theme() { # tema do btop com a paleta do tema (como no Omarchy)
    local accent=${WALL[2]} red=${PALETTE[1]} green=${PALETTE[2]} yellow=${PALETTE[3]}
    local blue=${PALETTE[4]} magenta=${PALETTE[5]} cyan=${PALETTE[6]} gray=${PALETTE[8]}
    cat <<THEME
# Gerado por tamagi-theme ($NAME).
theme[main_bg]="$BG"
theme[main_fg]="$FG"
theme[title]="$FG"
theme[hi_fg]="$accent"
theme[selected_bg]="$gray"
theme[selected_fg]="$FG"
theme[inactive_fg]="$gray"
theme[graph_text]="$FG"
theme[meter_bg]="$gray"
theme[proc_misc]="$cyan"
theme[cpu_box]="$blue"
theme[mem_box]="$green"
theme[net_box]="$magenta"
theme[proc_box]="$accent"
theme[div_line]="$gray"
theme[temp_start]="$green"
theme[temp_mid]="$yellow"
theme[temp_end]="$red"
theme[cpu_start]="$cyan"
theme[cpu_mid]="$blue"
theme[cpu_end]="$magenta"
theme[free_start]="$green"
theme[free_mid]="$green"
theme[free_end]="$green"
theme[cached_start]="$cyan"
theme[cached_mid]="$cyan"
theme[cached_end]="$blue"
theme[available_start]="$yellow"
theme[available_mid]="$yellow"
theme[available_end]="$yellow"
theme[used_start]="$red"
theme[used_mid]="$red"
theme[used_end]="$red"
theme[download_start]="$blue"
theme[download_mid]="$cyan"
theme[download_end]="$green"
theme[upload_start]="$magenta"
theme[upload_mid]="$red"
theme[upload_end]="$yellow"
theme[process_start]="$cyan"
theme[process_mid]="$blue"
theme[process_end]="$magenta"
THEME
}

apply_btop() { # escreve o tema e o escolhe, se você não escolheu outro
    local dir="$CONFIG/btop" conf
    mkdir -p "$dir/themes"
    btop_theme > "$dir/themes/tamagi.theme"
    conf="$dir/btop.conf"
    if [[ ! -f $conf ]]; then
        echo 'color_theme = "tamagi"' > "$conf"
    elif grep -qE '^color_theme = "(Default|tamagi|)"' "$conf"; then
        sed -i 's/^color_theme = .*/color_theme = "tamagi"/' "$conf"
    fi
}

nvim_spec() { # plugin de cores do LazyVim para o tema (os mesmos do Omarchy)
    local theme=$1 plugin="" scheme="" extra=""
    case $theme in
        tokyo-night) plugin='"folke/tokyonight.nvim"'; scheme=tokyonight-night ;;
        gruvbox)     plugin='"ellisonleao/gruvbox.nvim"'; scheme=gruvbox ;;
        nord)        plugin='"gbprod/nord.nvim"'; scheme=nord ;;
    esac
    echo "-- Gerado por tamagi-theme ($NAME). Enquanto esta linha existir, trocar de tema"
    echo "-- reescreve este arquivo; para escolher outro colorscheme, apague-a."
    echo "return {"
    if [[ -n $plugin ]]; then
        echo "  { $plugin, priority = 1000, lazy = false$extra },"
        echo "  { \"LazyVim/LazyVim\", opts = { colorscheme = \"$scheme\" } },"
    else
        # Tema sem plugin próprio (os Ipê): base16 com as cores do tema.
        local b=("$BG" "${WALL[0]}" "${PALETTE[8]}" "${PALETTE[8]}" "${PALETTE[7]}" "$FG" "$FG" "${PALETTE[15]}"
                 "${PALETTE[1]}" "${PALETTE[11]}" "${PALETTE[3]}" "${PALETTE[2]}" "${PALETTE[6]}" "${PALETTE[4]}"
                 "${PALETTE[5]}" "${PALETTE[9]}")
        local i keys=""
        for i in "${!b[@]}"; do keys+=$(printf 'base0%X = "%s", ' "$i" "${b[$i]}"); done
        echo "  { \"RRethy/base16-nvim\", priority = 1000, lazy = false },"
        echo "  { \"LazyVim/LazyVim\", opts = { colorscheme = function()"
        echo "    require(\"base16-colorscheme\").setup({ ${keys%, } })"
        echo "  end } },"
    fi
    echo "}"
}

apply_nvim() { # só se você usa LazyVim (tamagi setup lazyvim) e não personalizou
    local dir="$CONFIG/nvim/lua/plugins" f
    [[ -d $dir ]] || return 0
    f="$dir/tamagi-theme.lua"
    if [[ ! -e $f ]] || head -1 "$f" | grep -q '^-- Gerado por tamagi-theme'; then
        nvim_spec "$1" > "$f"
    fi
}

apply_cosmic() { # COSMIC keeps its configuration in files, one per key
    local name=$1 cfg="$CONFIG/cosmic" wall
    mkdir -p "$cfg/com.system76.CosmicTheme.Mode/v1" "$cfg/com.system76.CosmicBackground/v1"
    [[ $SCHEME == dark ]] && echo true > "$cfg/com.system76.CosmicTheme.Mode/v1/is_dark" \
                          || echo false > "$cfg/com.system76.CosmicTheme.Mode/v1/is_dark"
    wall=$(wall_file "$name")
    if [[ -n $wall ]]; then
        cat > "$cfg/com.system76.CosmicBackground/v1/all" <<RON
(
    output: "all",
    source: Path("$wall"),
    filter_by_theme: false,
    rotation_frequency: 3600,
    filter_method: Lanczos,
    scaling_mode: Zoom,
    sampling_method: Alphanumeric,
)
RON
    fi
    # The colours of COSMIC itself: every Tamagi theme has a COSMIC theme made
    # at build time (make-cosmic-themes.py), the same file that Settings ›
    # Appearance › Import reads.
    local ron="${TAMAGI_COSMIC_THEMES:-/usr/share/cosmic-themes}/tamagi-$name.ron"
    if [[ -r $ron ]] && command -v cosmic-settings >/dev/null 2>&1; then
        timeout 20 cosmic-settings appearance import "$ron" >/dev/null 2>&1 || true
    fi
    # GTK apps and the browser follow light/dark through the portal.
    gsettings set org.gnome.desktop.interface color-scheme \
        "$([[ $SCHEME == dark ]] && echo prefer-dark || echo default)" 2>/dev/null || true
}

apply_terminal() { # foot (terminal and Tamagi windows), btop and Neovim
    local name=$1
    load "$name"
    mkdir -p "$CONFIG/tamagi"
    foot_config > "$CONFIG/tamagi/foot.ini"      # the Tamagi windows (/usr/libexec/tamagi/popup)
    rm -f "$CONFIG/tamagi/alacritty.toml"        # from when those windows were alacritty
    apply_foot
    apply_ptyxis
    apply_btop
    apply_nvim "$name"
    echo "$name" > "$STATE"
}

apply() {
    local name=$1
    load "$name"
    apply_cosmic "$name"
    apply_terminal "$name"
    echo "$(t "Theme applied"): $NAME"
}

# What COSMIC is showing now: "<dark|light> <background #rrggbb or -> <accent or ->".
cosmic_now() {
    python3 - "$CONFIG/cosmic" "$COSMIC_SYS" <<'PY'
import pathlib, re, sys
roots = [pathlib.Path(p) for p in sys.argv[1:3]]
def read(rel):
    for root in roots:
        try:
            return (root / rel).read_text()
        except OSError:
            continue
    return ""
dark = read("com.system76.CosmicTheme.Mode/v1/is_dark").strip() != "false"
builder = "com.system76.CosmicTheme.%s.Builder/" % ("Dark" if dark else "Light")
def colour(key):
    text = read(builder + "v2/" + key) or read(builder + "v1/" + key)   # v2 since COSMIC 1.1x
    m = re.search(r'"#([0-9A-Fa-f]{6})', text)                          # v2: Some("#16211CFF")
    if m:
        return "#" + m.group(1).lower()
    m = re.search(r"red:\s*([0-9.]+).*?green:\s*([0-9.]+).*?blue:\s*([0-9.]+)", text, re.S)
    return "#%02x%02x%02x" % tuple(round(float(v) * 255) for v in m.groups()) if m else "-"
print("dark" if dark else "light", colour("bg_color"), colour("accent"))
PY
}

close_to() { # close_to #rrggbb #rrggbb: equal within the rounding of the theme file
    local c1=${1#\#} c2=${2#\#} i d
    [[ ${#c1} -eq 6 && ${#c2} -eq 6 ]] || return 1
    for i in 0 2 4; do
        d=$(( 0x${c1:$i:2} - 0x${c2:$i:2} )); (( d < 0 )) && d=$(( -d ))
        (( d <= 2 )) || return 1
    done
}

sync() { # the terminal apps follow whatever theme COSMIC has now
    local mode bg accent name target="" cur
    read -r mode bg accent <<<"$(cosmic_now)"
    cur=$(current)
    for name in $(list); do
        if ( load "$name"; [[ $SCHEME == "$mode" ]] && close_to "$BG" "$bg" && close_to "${WALL[2]}" "$accent" ); then
            target=$name; break
        fi
    done
    if [[ -z $target && $bg != - ]]; then
        # A COSMIC theme that is not a Tamagi one: its background and accent
        # over the terminal palette of the default theme of that mode.
        local base=$DEFAULT_DARK new="$USER_THEMES/cosmic.conf.new"
        [[ $mode == light ]] && base=$DEFAULT_LIGHT
        [[ $accent == - ]] && accent=$(load "$base"; echo "${WALL[2]}")
        mkdir -p "$USER_THEMES"
        sed -e 's/^NAME=.*/NAME="COSMIC"/' -e "s/^BG=.*/BG=\"$bg\"/" \
            -e "s/^WALL=(\"\([^\"]*\)\" \"\([^\"]*\)\" \"[^\"]*\"/WALL=(\"\1\" \"\2\" \"$accent\"/" \
            "$THEMES/$base.conf" > "$new"
        if cmp -s "$new" "$USER_THEMES/cosmic.conf" 2>/dev/null; then
            : > "$new"
        else
            cp "$new" "$USER_THEMES/cosmic.conf"; : > "$new"; cur=""
        fi
        target=cosmic
    fi
    if [[ -z $target ]]; then
        # COSMIC's own default theme: only light/dark has to agree.
        [[ $(load "$cur" 2>/dev/null; echo "${SCHEME:-}") == "$mode" ]] && return 0
        target=$DEFAULT_DARK; [[ $mode == light ]] && target=$DEFAULT_LIGHT
    fi
    [[ $target == "$cur" ]] && return 0
    apply_terminal "$target"
    echo "$(t "Terminals following the COSMIC theme"): $target"
}

case "${1:-}" in
    "")      current ;;
    list)    list ;;
    current) current ;;
    set)     [[ -n ${2:-} ]] || { echo "usage: tamagi theme set <theme>" >&2; exit 2; }; apply "$2" ;;
    next)    # next theme in alphabetical order (good for a shortcut)
             mapfile -t all < <(list); cur=$(current); i=0
             for i in "${!all[@]}"; do [[ ${all[$i]} == "$cur" ]] && break; done
             apply "${all[$(( (i + 1) % ${#all[@]} ))]}" ;;
    pick)    choice=$(list | gum choose --height 14 --header "$(t "Theme")" --selected "$(current)") && apply "$choice" ;;
    sync)    sync ;;
    settings)  setsid -f cosmic-settings appearance >/dev/null 2>&1 ;;
    wallpaper) setsid -f cosmic-settings wallpaper >/dev/null 2>&1 ;;
    apps)    # re-applies the current theme to the terminal apps only
             apply_terminal "$(current)" ;;
    nvim)    load "${2:-$DEFAULT_DARK}"; nvim_spec "${2:-$DEFAULT_DARK}" ;;
    foot)    load "${2:-$DEFAULT_DARK}"; foot_config ;;
    -h|--help|help) sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//' ;;
    *)       echo "usage: tamagi theme [list|current|set <theme>|next|pick|sync|settings|wallpaper]" >&2; exit 2 ;;
esac
