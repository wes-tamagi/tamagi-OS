#!/usr/bin/bash
# tamagi-theme — troca o tema do desktop com um comando: as cores do COSMIC
# (fundo, destaque, claro/escuro), o papel de parede, a paleta do terminal
# padrão (foot), do btop, do Neovim (LazyVim) e a das janelas do Tamagi (alacritty).
set -euo pipefail
. /usr/libexec/tamagi/i18n

THEMES=/usr/share/tamagi/themes
WALLS=/usr/share/backgrounds/tamagi
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE="$CONFIG/tamagi/theme"
WALL_STATE="$CONFIG/tamagi/wallpaper"
# Estilos de papel de parede (cada tema tem todos, nas cores dele):
#   mon       brasão: anel (tamaki) com três joias (tama) sobre ondas seigaiha
#   seigaiha  ondas em escamas    asanoha  folha de cânhamo
#   byobu     biombo: nuvens, lua e monte    shippo   círculos entrelaçados
#   hinode    nascer do sol sobre o mar      uroko    escamas triangulares
#   ondas     o papel de parede original
STYLES=(mon seigaiha asanoha byobu shippo hinode uroko ondas)

list() { find "$THEMES" -name '*.conf' -printf '%f\n' | sed 's/\.conf$//' | sort; }
current() { cat "$STATE" 2>/dev/null || echo tokyo-night; }
style() { cat "$WALL_STATE" 2>/dev/null || echo mon; }
wall_file() { # wall_file <tema>: caminho do PNG no estilo atual
    local st; st=$(style)
    if [[ $st == ondas ]]; then echo "$WALLS/$1.png"; else echo "$WALLS/$1-$st.png"; fi
}

# Fonte dos terminais (tamagi-font set troca).
mono_font() { local f; f=$(head -1 "$CONFIG/tamagi/font" 2>/dev/null || true); echo "${f:-JetBrains Mono}"; }

load() {
    local conf="$THEMES/$1.conf"
    [[ -f $conf ]] || { echo "tema desconhecido: $1 (veja 'tamagi-theme list')" >&2; exit 1; }
    # shellcheck disable=SC1090
    source "$conf"
}

alacritty_config() { # configuração completa do alacritty com a paleta do tema
    local names=(black red green yellow blue magenta cyan white) i
    cat <<TOML
# Gerado por tamagi-theme ($NAME). Usado pelas janelas do Tamagi
# (/usr/libexec/tamagi/popup); para o seu alacritty, use ~/.config/alacritty.
[window]
dimensions = { columns = 104, lines = 30 }
padding = { x = 14, y = 12 }

[font]
normal = { family = "$(mono_font)" }
size = 11.0

[colors.primary]
background = "$BG"
foreground = "$FG"

[colors.cursor]
cursor = "$CURSOR"
text = "$BG"

[colors.normal]
TOML
    for i in "${!names[@]}"; do echo "${names[$i]} = \"${PALETTE[$i]}\""; done
    echo
    echo "[colors.bright]"
    for i in "${!names[@]}"; do echo "${names[$i]} = \"${PALETTE[$((i + 8))]}\""; done
}

foot_config() { # configuração do foot (terminal padrão) com a paleta do tema
    local i
    cat <<INI
# Gerado por tamagi-theme ($NAME). Enquanto esta primeira linha existir, trocar
# de tema reescreve este arquivo; para personalizar o foot, apague-a.
[main]
font=$(mono_font):size=11
pad=12x10
term=xterm-256color

[scrollback]
lines=10000

[mouse]
hide-when-typing=yes

[colors-dark]
background=${BG#\#}
foreground=${FG#\#}
cursor=${BG#\#} ${CURSOR#\#}
selection-background=${WALL[2]#\#}
selection-foreground=${BG#\#}
INI
    for i in 0 1 2 3 4 5 6 7; do echo "regular$i=${PALETTE[$i]#\#}"; done
    for i in 0 1 2 3 4 5 6 7; do echo "bright$i=${PALETTE[$((i + 8))]#\#}"; done
}

apply_foot() { # só reescreve o foot.ini que o próprio tamagi-theme gerou
    local ini="$CONFIG/foot/foot.ini"
    if [[ ! -e $ini ]] || head -1 "$ini" | grep -q '^# Gerado por tamagi-theme'; then
        mkdir -p "$CONFIG/foot"
        foot_config > "$ini"
    fi
}

btop_theme() { # tema do btop com a paleta do tema (como no Omarchy)
    local accent=${WALL[2]} red=${PALETTE[1]} green=${PALETTE[2]} yellow=${PALETTE[3]}
    local blue=${PALETTE[4]} magenta=${PALETTE[5]} cyan=${PALETTE[6]} gray=${PALETTE[8]}
    cat <<THEME
# Gerado por tamagi-theme ($NAME).
theme[main_bg]="$BG"
theme[main_fg]="$FG"
theme[title]="$FG"
theme[hi_fg]="$accent"
theme[selected_bg]="$gray"
theme[selected_fg]="$FG"
theme[inactive_fg]="$gray"
theme[graph_text]="$FG"
theme[meter_bg]="$gray"
theme[proc_misc]="$cyan"
theme[cpu_box]="$blue"
theme[mem_box]="$green"
theme[net_box]="$magenta"
theme[proc_box]="$accent"
theme[div_line]="$gray"
theme[temp_start]="$green"
theme[temp_mid]="$yellow"
theme[temp_end]="$red"
theme[cpu_start]="$cyan"
theme[cpu_mid]="$blue"
theme[cpu_end]="$magenta"
theme[free_start]="$green"
theme[free_mid]="$green"
theme[free_end]="$green"
theme[cached_start]="$cyan"
theme[cached_mid]="$cyan"
theme[cached_end]="$blue"
theme[available_start]="$yellow"
theme[available_mid]="$yellow"
theme[available_end]="$yellow"
theme[used_start]="$red"
theme[used_mid]="$red"
theme[used_end]="$red"
theme[download_start]="$blue"
theme[download_mid]="$cyan"
theme[download_end]="$green"
theme[upload_start]="$magenta"
theme[upload_mid]="$red"
theme[upload_end]="$yellow"
theme[process_start]="$cyan"
theme[process_mid]="$blue"
theme[process_end]="$magenta"
THEME
}

apply_btop() { # escreve o tema e o escolhe, se você não escolheu outro
    local dir="$CONFIG/btop" conf
    mkdir -p "$dir/themes"
    btop_theme > "$dir/themes/tamagi.theme"
    conf="$dir/btop.conf"
    if [[ ! -f $conf ]]; then
        echo 'color_theme = "tamagi"' > "$conf"
    elif grep -qE '^color_theme = "(Default|tamagi|)"' "$conf"; then
        sed -i 's/^color_theme = .*/color_theme = "tamagi"/' "$conf"
    fi
}

nvim_spec() { # plugin de cores do LazyVim para o tema (os mesmos do Omarchy)
    local theme=$1 plugin="" scheme="" extra=""
    case $theme in
        tokyo-night) plugin='"folke/tokyonight.nvim"'; scheme=tokyonight-night ;;
        catppuccin)  plugin='"catppuccin/nvim", name = "catppuccin"'; scheme=catppuccin-mocha ;;
        latte)       plugin='"catppuccin/nvim", name = "catppuccin"'; scheme=catppuccin-latte ;;
        gruvbox)     plugin='"ellisonleao/gruvbox.nvim"'; scheme=gruvbox ;;
        nord)        plugin='"gbprod/nord.nvim"'; scheme=nord ;;
        everforest)  plugin='"neanias/everforest-nvim", main = "everforest"'; scheme=everforest ;;
        rose-pine)   plugin='"rose-pine/neovim", name = "rose-pine"'; scheme=rose-pine ;;
        kanagawa)    plugin='"rebelot/kanagawa.nvim"'; scheme=kanagawa ;;
        matte-black) plugin='"tahayvr/matteblack.nvim"'; scheme=matteblack ;;
        ristretto)   plugin='"loctvl842/monokai-pro.nvim"'; scheme=monokai-pro; extra=', opts = { filter = "ristretto" }' ;;
    esac
    echo "-- Gerado por tamagi-theme ($NAME). Enquanto esta linha existir, trocar de tema"
    echo "-- reescreve este arquivo; para escolher outro colorscheme, apague-a."
    echo "return {"
    if [[ -n $plugin ]]; then
        echo "  { $plugin, priority = 1000, lazy = false$extra },"
        echo "  { \"LazyVim/LazyVim\", opts = { colorscheme = \"$scheme\" } },"
    else
        # Tema sem plugin próprio (o Ipê): base16 com as cores do tema.
        local b=("$BG" "${WALL[0]}" "${PALETTE[8]}" "${PALETTE[8]}" "${PALETTE[7]}" "$FG" "$FG" "${PALETTE[15]}"
                 "${PALETTE[1]}" "${PALETTE[11]}" "${PALETTE[3]}" "${PALETTE[2]}" "${PALETTE[6]}" "${PALETTE[4]}"
                 "${PALETTE[5]}" "${PALETTE[9]}")
        local i keys=""
        for i in "${!b[@]}"; do keys+=$(printf 'base0%X = "%s", ' "$i" "${b[$i]}"); done
        echo "  { \"RRethy/base16-nvim\", priority = 1000, lazy = false },"
        echo "  { \"LazyVim/LazyVim\", opts = { colorscheme = function()"
        echo "    require(\"base16-colorscheme\").setup({ ${keys%, } })"
        echo "  end } },"
    fi
    echo "}"
}

apply_nvim() { # só se você usa LazyVim (ujust setup-lazyvim) e não personalizou
    local dir="$CONFIG/nvim/lua/plugins" f
    [[ -d $dir ]] || return 0
    f="$dir/tamagi-theme.lua"
    if [[ ! -e $f ]] || head -1 "$f" | grep -q '^-- Gerado por tamagi-theme'; then
        nvim_spec "$1" > "$f"
    fi
}

apply_omarchy_apps() { # apps do Omarchy (instalados pelo tamagi-pkg) leem as cores do tema neste arquivo
    local dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current/theme" i
    mkdir -p "$dir"
    {
        echo "# Gerado por tamagi-theme ($NAME)"
        echo "accent = \"${WALL[2]}\""
        echo "cursor = \"$CURSOR\""
        echo "foreground = \"$FG\""
        echo "background = \"$BG\""
        echo "selection_foreground = \"$BG\""
        echo "selection_background = \"${WALL[2]}\""
        for i in "${!PALETTE[@]}"; do echo "color$i = \"${PALETTE[$i]}\""; done
    } > "$dir/colors.toml"
}

apply_cosmic() { # o COSMIC guarda a configuração em arquivos, um por chave
    local name=$1 cfg="$CONFIG/cosmic"
    mkdir -p "$cfg/com.system76.CosmicTheme.Mode/v1" "$cfg/com.system76.CosmicBackground/v1"
    [[ $SCHEME == dark ]] && echo true > "$cfg/com.system76.CosmicTheme.Mode/v1/is_dark" \
                          || echo false > "$cfg/com.system76.CosmicTheme.Mode/v1/is_dark"
    cat > "$cfg/com.system76.CosmicBackground/v1/all" <<RON
(
    output: "all",
    source: Path("$(wall_file "$name")"),
    filter_by_theme: false,
    rotation_frequency: 3600,
    filter_method: Lanczos,
    scaling_mode: Zoom,
    sampling_method: Alphanumeric,
)
RON
    # Cores do próprio COSMIC (fundo, destaque, texto): cada tema do Tamagi tem
    # um tema do COSMIC gerado no build (make-cosmic-themes.py). Só dentro da
    # sessão gráfica; fora dela ficam o claro/escuro e o papel de parede.
    local ron="${TAMAGI_COSMIC_THEMES:-/usr/share/cosmic-themes}/tamagi-$name.ron"
    if [[ -r $ron && -n ${WAYLAND_DISPLAY:-} ]] && command -v cosmic-settings >/dev/null 2>&1; then
        timeout 20 cosmic-settings appearance import "$ron" >/dev/null 2>&1 || true
    fi
    # Apps GTK e o navegador seguem o esquema claro/escuro pelo portal.
    gsettings set org.gnome.desktop.interface color-scheme \
        "$([[ $SCHEME == dark ]] && echo prefer-dark || echo default)" 2>/dev/null || true
}

apply() {
    local name=$1
    load "$name"
    apply_cosmic "$name"
    mkdir -p "$CONFIG/tamagi"
    alacritty_config > "$CONFIG/tamagi/alacritty.toml"
    apply_foot
    apply_btop
    apply_nvim "$name"
    apply_omarchy_apps
    echo "$name" > "$STATE"
    echo "$(t "Tema aplicado"): $NAME"
}

case "${1:-}" in
    list)    list ;;
    current) current ;;
    set)     [[ -n ${2:-} ]] || { echo "uso: tamagi-theme set <tema>" >&2; exit 2; }; apply "$2" ;;
    next)    # próximo tema em ordem alfabética (bom para um atalho)
             mapfile -t all < <(list); cur=$(current)
             for i in "${!all[@]}"; do [[ ${all[$i]} == "$cur" ]] && break; done
             apply "${all[$(( (i + 1) % ${#all[@]} ))]}" ;;
    pick)    choice=$(list | gum choose --height 14 --header "$(t "Tema")" --selected "$(current)") && apply "$choice" ;;
    wallpaper|papel) # estilo do papel de parede: tamagi-theme wallpaper [estilo]
             choice=${2:-}
             if [[ -z $choice ]]; then
                 choice=$(printf '%s\n' "${STYLES[@]}" | gum choose --height 12 --header "$(t "Papel de parede")" --selected "$(style)") || exit 0
             fi
             [[ " ${STYLES[*]} " == *" $choice "* ]] || { echo "estilo desconhecido: $choice (use: ${STYLES[*]})" >&2; exit 2; }
             mkdir -p "$CONFIG/tamagi"; echo "$choice" > "$WALL_STATE"
             apply "$(current)" >/dev/null; echo "$(t "Papel de parede"): $choice" ;;
    styles)  printf '%s\n' "${STYLES[@]}" ;;
    alacritty) # imprime a configuração do alacritty de um tema (usado no build)
             load "${2:-tokyo-night}"; alacritty_config ;;
    apps)    # reaplica o tema atual só nos apps de terminal (foot, btop, Neovim)
             name=$(current); load "$name"; apply_foot; apply_btop; apply_nvim "$name" ;;
    nvim)    # imprime o plugin de cores do LazyVim de um tema
             load "${2:-tokyo-night}"; nvim_spec "${2:-tokyo-night}" ;;
    foot)    # imprime a configuração do foot de um tema (usado no build)
             load "${2:-tokyo-night}"; foot_config ;;
    *)       echo "uso: tamagi-theme [list|current|set <tema>|next|pick|wallpaper [estilo]|styles]" >&2; exit 2 ;;
esac
