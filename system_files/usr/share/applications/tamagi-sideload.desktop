[Desktop Entry]
Type=Application
Name=Install package (.deb / .rpm)
Name[pt_BR]=Instalar pacote (.deb / .rpm)
Name[es]=Instalar paquete (.deb / .rpm)
Name[fr]=Installer un paquet (.deb / .rpm)
Comment=Installs the package in a distrobox subsystem and adds the app to the menu
Comment[pt_BR]=Instala o pacote num subsistema distrobox e põe o app no menu
Comment[es]=Instala el paquete en un subsistema distrobox y pone la app en el menú
Comment[fr]=Installe le paquet dans un sous-système distrobox et ajoute l'application au menu
Exec=/usr/libexec/tamagi/popup tamagi-pkg install --wait %f
Icon=package-x-generic
Terminal=false
NoDisplay=true
MimeType=application/vnd.debian.binary-package;application/x-deb;application/x-rpm;application/x-redhat-package-manager;
