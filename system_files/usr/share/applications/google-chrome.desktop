[Desktop Entry]
Type=Application
Name=Google Chrome
GenericName=Web browser
GenericName[pt_BR]=Navegador web
GenericName[es]=Navegador web
GenericName[fr]=Navigateur web
Comment=Browser in the Ubuntu 26.04 LTS box (distrobox), with video acceleration and Warsaw
Comment[pt_BR]=Navegador na caixa Ubuntu 26.04 LTS (distrobox), com aceleração de vídeo e Warsaw
Comment[es]=Navegador en la caja Ubuntu 26.04 LTS (distrobox), con aceleración de vídeo y Warsaw
Comment[fr]=Navigateur dans la boîte Ubuntu 26.04 LTS (distrobox), avec accélération vidéo et Warsaw
Exec=/usr/bin/tamagi-browser chrome %U
Icon=tamagi-browser
Terminal=false
StartupNotify=true
StartupWMClass=google-chrome
Categories=Network;WebBrowser;
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
Keywords=navegador;internet;web;chrome;browser;
Actions=new-window;new-private-window;

[Desktop Action new-window]
Name=New window
Name[pt_BR]=Nova janela
Name[es]=Nueva ventana
Name[fr]=Nouvelle fenêtre
Exec=/usr/bin/tamagi-browser chrome --new-window

[Desktop Action new-private-window]
Name=New incognito window
Name[pt_BR]=Nova janela anônima
Name[es]=Nueva ventana de incógnito
Name[fr]=Nouvelle fenêtre de navigation privée
Exec=/usr/bin/tamagi-browser chrome --incognito
