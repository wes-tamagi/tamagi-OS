[Desktop Entry]
Type=Application
Name=Web Browser
Name[pt_BR]=Navegador web
Name[pt]=Navegador web
Name[es]=Navegador web
Name[fr]=Navigateur web
Comment=Opens your default browser (Chromium pre-installed with Google Account sign-in, or Chrome, Firefox, Vivaldi, Opera GX)
Comment[pt_BR]=Abre o seu navegador padrão (Chromium pré-instalado com conta Google, ou Chrome, Firefox, Vivaldi, Opera GX)
Comment[pt]=Abre o seu navegador padrão (Chromium pré-instalado com conta Google, ou Chrome, Firefox, Vivaldi, Opera GX)
Comment[es]=Abre tu navegador predeterminado (Chromium preinstalado con cuenta de Google, o Chrome, Firefox, Vivaldi, Opera GX)
Comment[fr]=Ouvre votre navigateur par défaut (Chromium préinstallé avec compte Google, ou Chrome, Firefox, Vivaldi, Opera GX)
Exec=/usr/bin/tamagi-browser %U
Icon=tamagi-browser
Terminal=false
StartupNotify=true
Categories=Network;WebBrowser;
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
Keywords=browser;internet;web;navegador;navigateur;chrome;firefox;vivaldi;chromium;
