# Apps Flatpak instalados no primeiro boot. Uma linha por app: <remote> <ID>.
# Remotes: flathub e cosmic (repositório da System76 para o COSMIC).
# Navegadores não entram aqui: vivem na caixa Fedora (tamagi-browser).
# Terminal, arquivos, editor, loja e player são os do
# COSMIC (RPM).
flathub org.onlyoffice.desktopeditors
flathub com.github.tchx84.Flatseal
flathub io.github.flattool.Warehouse
flathub io.missioncenter.MissionCenter
flathub org.gnome.Loupe
flathub org.gnome.Papers
flathub com.ranfdev.DistroShelf
flathub dev.edfloreshz.CosmicTweaks
flathub io.github.cosmic_utils.Examine
cosmic io.github.cosmic_utils.minimon-applet
cosmic io.github.cosmic_utils.weather-applet
cosmic io.github.cosmic_utils.cosmic-ext-applet-clipboard-manager
