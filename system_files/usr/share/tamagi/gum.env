# Cores dos botões do `gum confirm` nas janelas e no terminal do Tamagi.
# O padrão do gum é texto amarelo-claro sobre rosa: o botão selecionado vira
# um retângulo sem letras legíveis. Aqui: texto escuro sobre azul claro
# (selecionado) e texto claro sobre cinza (o outro), bons em tema claro e escuro.
export GUM_CONFIRM_SELECTED_FOREGROUND="#11111b"
export GUM_CONFIRM_SELECTED_BACKGROUND="#89b4fa"
export GUM_CONFIRM_UNSELECTED_FOREGROUND="#e6e9ef"
export GUM_CONFIRM_UNSELECTED_BACKGROUND="#45475a"

# A linha de ajuda do gum ("navigate • enter submit") só existe em inglês:
# fica escondida, e as ferramentas do Tamagi mostram a dica no idioma do sistema.
export GUM_CHOOSE_SHOW_HELP=false GUM_CONFIRM_SHOW_HELP=false
export GUM_INPUT_SHOW_HELP=false GUM_FILTER_SHOW_HELP=false
