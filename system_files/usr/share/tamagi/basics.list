# Tamagi-DxAI — apps offered at first login (multi-select in tamagi-welcome).
# Native COSMIC Rust apps come first; GTK/GNOME equivalents stay optional.
#   <on|off> <id>   id: catalog.tsv id or Flatpak app id from flatpaks.list.
on  dev.edfloreshz.Calculator
on  dev.edfloreshz.CosmicTweaks
on  dev.mariinkys.Cedilla
on  org.gnome.Papers
off io.github.cosmic_utils.Examine
off dev.edfloreshz.Tasks
off com.jwestall.Forecast
off com.francescogaglione.chronos
off com.system76.Popsicle
off sniffnet
off app.drey.KeyRack
off com.github.flxzt.rnote
off org.gnome.Snapshot
off app.drey.Warp
off io.github.seadve.Kooha
off com.belmoussaoui.Authenticator
off io.github.flattool.Ignition
off io.missioncenter.MissionCenter
off org.onlyoffice.desktopeditors
off whatsapp
