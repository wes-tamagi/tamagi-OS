// Perfis de desempenho (tamagi-perf): quem é administrador, na sessão ativa e
// local, alterna o perfil sem digitar a senha — só este programa.
// O convidado (tamagi-convidado) nunca, nem com senha.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.policykit.exec" &&
        action.lookup("program") == "/usr/libexec/tamagi/perf-helper" &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
