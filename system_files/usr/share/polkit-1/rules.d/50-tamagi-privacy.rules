// Modo privacidade (tamagi-privacy): quem é administrador, na sessão
// ativa e local, liga e desliga sem digitar a senha — só este programa.
// O convidado (tamagi-guest) nunca, nem com senha.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.policykit.exec" &&
        action.lookup("program") == "/usr/libexec/tamagi/privacy-helper" &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
