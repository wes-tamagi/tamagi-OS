[Unit]
Description=Tamagi: the terminal apps follow the COSMIC theme
Documentation=file:///usr/share/doc/tamagi/README.md

[Path]
PathChanged=%E/cosmic/com.system76.CosmicTheme.Mode/v1/is_dark
PathChanged=%E/cosmic/com.system76.CosmicTheme.Dark.Builder/v2
PathChanged=%E/cosmic/com.system76.CosmicTheme.Light.Builder/v2
TriggerLimitIntervalSec=10
TriggerLimitBurst=30

[Install]
WantedBy=default.target
