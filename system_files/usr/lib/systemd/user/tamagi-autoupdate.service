[Unit]
Description=Tamagi: atualiza os subsistemas e as caixas distrobox
Documentation=file:///usr/share/doc/tamagi/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/tamagi-update --auto
Nice=10
IOSchedulingClass=idle
CPUWeight=20
IOWeight=20
