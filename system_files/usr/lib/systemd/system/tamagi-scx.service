[Unit]
Description=Tamagi sched_ext CPU scheduler (scx_rustland / scx_rusty)
Documentation=https://github.com/sched-ext/scx
ConditionPathExists=/sys/kernel/sched_ext
After=multi-user.target

[Service]
Type=simple
Environment=SCX_SCHED=scx_rustland
EnvironmentFile=-/var/lib/tamagi/scx.env
ExecStart=/usr/libexec/tamagi/scx-launch
Restart=on-failure
RestartSec=5
OOMScoreAdjust=-500
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
