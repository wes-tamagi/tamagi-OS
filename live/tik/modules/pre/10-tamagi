# Tamagi — módulo do tik (fase "pre"). O tik faz `source` deste arquivo.
# shellcheck shell=bash disable=SC2154,SC2034
#
# O tik (https://github.com/sysrich/tik, o instalador do openSUSE Aeon) cuida
# da conversa: janelas zenity e escolha do disco. Ele foi feito para gravar
# uma imagem de disco pronta; o Tamagi é uma imagem bootc, então este módulo:
#
#   1. faz as perguntas (idioma, teclado, fuso, conta, criptografia), em
#      português, inglês, espanhol ou francês;
#   2. redefine as etapas do tik que gravariam a imagem de disco, para chamar
#      /usr/libexec/tamagi-install (particiona e roda `bootc install`);
#   3. redefine o encerramento: cancelar volta para o desktop live em vez de
#      desligar o computador.
#
# Variáveis e funções do tik usadas aqui: gui, tik_log, d, log, error.
#
# Instalação sem perguntas (testes e automação), pela linha do kernel:
#   tamagi.autoinstall=/dev/vda [tamagi.autoinstall.lang=en|pt|es|fr] [tamagi.autoinstall.user=nome]
#   [tamagi.autoinstall.password=senha] [tamagi.autoinstall.luks=senha-do-disco] [tamagi.autoinstall.tpm=1]
#   [tamagi.autoinstall.kargs=arg1,arg2]

tamagi_dir="${XDG_RUNTIME_DIR:-/run}/tamagi-install"
mkdir -p "${tamagi_dir}" && chmod 700 "${tamagi_dir}"
tamagi_answers="${tamagi_dir}/answers"
tamagi_luks_key="${tamagi_dir}/luks.key"
tamagi_existing_luks_key="${tamagi_dir}/existing-luks.key"
tamagi_started=0
tamagi_done=0

# A imagem embutida na mídia é conferida (SHA-256 de cada camada) ANTES de o
# disco ser apagado. A conferência começa já, em segundo plano, e roda enquanto
# as perguntas são respondidas: quando o disco é escolhido ela costuma ter
# terminado, e a imagem já está no cache de memória para a cópia.
tamagi_verify="${tamagi_dir}/verify"
tamagi_payload="$(sed -n 's/^PAYLOAD_DIR=//p' /etc/tamagi-live.conf 2>/dev/null)"
if [ -n "${tamagi_payload}" ] && [ -d "${tamagi_payload}" ] && [ -x /usr/libexec/tamagi-verify-media ]; then
    rm -rf "${tamagi_verify}"
    ( setsid /usr/libexec/tamagi-verify-media "${tamagi_payload}" "${tamagi_verify}" >/dev/null 2>&1 & )
fi

