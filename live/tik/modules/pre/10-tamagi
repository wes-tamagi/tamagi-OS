    [luks_unlock_bad]="Mot de passe incorrect pour ouvrir la partition chiffrée."
    [begin_preserve_text]="Le système sur le disque ci-dessous sera réinstallé tout en <b>conservant votre dossier personnel</b> (<tt>/var/home</tt> : {users}) :"
)
# The default language of the image (en; pt in the :ptbr variant) is the
# pre-selected one and comes first in the list; the other is the second.
tamagi_default_lang="$(cat /usr/share/tamagi/default-lang 2>/dev/null || echo en)"
[ "${tamagi_default_lang}" = "pt" ] || tamagi_default_lang="en"
tamagi_lang="en"
tamagi_locale="en_US.UTF-8"
T() { local -n _txt="TXT_${tamagi_lang}"; printf '%s' "${_txt[$1]:-${TXT_en[$1]}}"; }
tamagi_set_lang() { # tamagi_set_lang pt|en|es|fr
    case "$1" in
        pt) tamagi_lang=pt; tamagi_locale="pt_BR.UTF-8" ;;
        es) tamagi_lang=es; tamagi_locale="es_ES.UTF-8" ;;
        fr) tamagi_lang=fr; tamagi_locale="fr_FR.UTF-8" ;;
        *)  tamagi_lang=en; tamagi_locale="en_US.UTF-8" ;;
    esac
    # Botões padrão do zenity (OK, Cancelar) no mesmo idioma.
    export LANG="${tamagi_locale}" LANGUAGE="${tamagi_locale%%.*}"
    tamagi_t_quit="$(T quit)"; tamagi_t_col_disk="$(T col_disk)"; tamagi_t_col_size="$(T col_size)"
    tamagi_t_col_parts="$(T col_parts)"; tamagi_t_col_fs="$(T col_fs)"
    tamagi_t_disk_title="$(T disk_title)"; tamagi_t_disk_text="$(T disk_text)"; tamagi_t_no_disk="$(T no_disk)"
}
tamagi_set_lang "${tamagi_default_lang}"
# As janelas do instalador (zenity, GTK 4) desenham por software: o renderizador
# por GPU do GTK deixa botões sem texto em algumas placas e VMs, e a instalação
# não pode depender disso.
export GSK_RENDERER=cairo

tamagi_karg() { # valor de <nome>=valor na linha do kernel (vazio se não houver)
    sed -nE "s/(^|.* )$1=([^ ]+).*/\2/p" /proc/cmdline
}
tamagi_auto="$(tamagi_karg tamagi.autoinstall)"

tamagi_priv() { # roda como root: direto se já for root (modo sem perguntas), senão pkexec
    if [ "$(id -u)" = "0" ]; then "$@"; else pkexec "$@"; fi
}

tamagi_msg() { # aviso simples, sem passar pelo log do tik
    if $gui; then zenity --warning --no-wrap --title="Tamagi" --text="$1"; else echo "$1" >&2; fi
}

tamagi_cancel() { # o usuário fechou uma janela: sair ou continuar?
    zenity --question --no-wrap --title="Tamagi" --text="$(T quit)" \
        --ok-label="$(T quit_yes)" --cancel-label="$(T quit_no)" && exit 1
    return 0
}

tamagi_ask_language() {
    local first=(TRUE "en" "English (United States)" FALSE "pt" "Português (Brasil)")
    [ "${tamagi_default_lang}" = "pt" ] && first=(TRUE "pt" "Português (Brasil)" FALSE "en" "English (United States)")
    d --list --radiolist --title="Tamagi" --width=460 --height=370 \
        --text="Language  ·  Idioma  ·  Idioma  ·  Langue" \
        --column="" --column="id" --column="Language / Idioma / Langue" --hide-column=2 --print-column=2 \
        "${first[@]}" \
        FALSE "es" "Español" \
        FALSE "fr" "Français"
    tamagi_set_lang "${result:-${tamagi_default_lang}}"
}

tamagi_welcome() {
    # Tela de abertura: o brasão, o nome e a versão do sistema e o texto de
    # boas-vindas. 0 = instalar; 1 = fechou a janela (só experimentar); outro
    # código = a janela não abriu, e cai na janela simples do zenity.
    local rc=3
    if $gui && [ -x /usr/libexec/tamagi-installer-splash ]; then
        rc=0
        /usr/libexec/tamagi-installer-splash "$(T welcome_body)" "$(T install_now)" "$(T try_only)" || rc=$?
        log "[tamagi] tela de abertura: código ${rc}"
    fi
    case "${rc}" in
        0) ;;
        1) exit 1 ;;
        *) d --info --no-wrap --width=460 --ok-label="$(T install_now)" --title="Tamagi" \
               --icon=tamagi-menu --text="$(T welcome)" ;;
    esac
    [ -d /sys/firmware/efi ] || error "$(T no_uefi)"
}

tamagi_ask_keyboard() {
    # Coluna 2: layout|variante do xkb|mapa do console. O primeiro marcado
    # acompanha o idioma escolhido.
    local fallback="us:-:us"
    case "${tamagi_lang}" in
        pt) fallback="br:-:br-abnt2" ;;
        es) fallback="es:-:es" ;;
        fr) fallback="fr:-:fr" ;;
    esac
    local rows=() id label
    while IFS='|' read -r id label; do
        rows+=("$([ "${id}" = "${fallback}" ] && echo TRUE || echo FALSE)" "${id}" "${label}")
    done <<'KEYBOARDS'
us:-:us|English (US)
us:intl:us-acentos|English (US, international, with accents)
br:-:br-abnt2|Português (Brasil, ABNT2)
es:-:es|Español (España)
latam:-:la-latin1|Español (Latinoamérica)
fr:-:fr|Français (AZERTY)
ca:-:cf|Français (Canada)
ch:fr:fr_CH|Français (Suisse)
be:-:be-latin1|Français (Belgique)
pt:-:pt-latin1|Português (Portugal)
KEYBOARDS
    d --list --radiolist --title="$(T kbd_title)" --width=520 --height=460 \
        --text="$(T kbd_text)" \
        --column="" --column="id" --column="$(T kbd_title)" --hide-column=2 --print-column=2 \
        "${rows[@]}"
    IFS=':' read -r tamagi_xkb_layout tamagi_xkb_variant tamagi_keymap <<< "${result:-${fallback}}"
    [ "${tamagi_xkb_variant}" = "-" ] && tamagi_xkb_variant=""
    # Vale já na sessão live: a senha é digitada com o teclado que será usado depois.
    local cfg="${XDG_CONFIG_HOME:-$HOME/.config}/cosmic/com.system76.CosmicComp/v1"
    mkdir -p "${cfg}"
    cat > "${cfg}/xkb_config" <<RON
(
    rules: "",
    model: "",
    layout: "${tamagi_xkb_layout}",
    variant: "${tamagi_xkb_variant}",
    options: None,
    repeat_delay: 600,
    repeat_rate: 25,
)
RON
}

tamagi_ask_timezone() {
    tamagi_timezone="OUTRO"
    if [ "${tamagi_lang}" = "pt" ]; then
        d --list --radiolist --title="$(T tz_title)" --width=560 --height=520 \
            --text="$(T tz_text)" \
            --column="" --column="id" --column="$(T tz_col)" --hide-column=2 --print-column=2 \
            TRUE  "America/Sao_Paulo"    "Brasília, São Paulo, Rio de Janeiro, Minas, Sul" \
            FALSE "America/Bahia"        "Bahia" \
            FALSE "America/Fortaleza"    "Ceará, Maranhão, Piauí, Rio Grande do Norte, Paraíba" \
            FALSE "America/Recife"       "Pernambuco" \
            FALSE "America/Maceio"       "Alagoas, Sergipe" \
            FALSE "America/Belem"        "Pará (leste), Amapá" \
            FALSE "America/Araguaina"    "Tocantins" \
            FALSE "America/Cuiaba"       "Mato Grosso" \
            FALSE "America/Campo_Grande" "Mato Grosso do Sul" \
            FALSE "America/Manaus"       "Amazonas" \
            FALSE "America/Porto_Velho"  "Rondônia" \
            FALSE "America/Boa_Vista"    "Roraima" \
            FALSE "America/Rio_Branco"   "Acre" \
            FALSE "America/Noronha"      "Fernando de Noronha" \
            FALSE "OUTRO"                "$(T tz_other)"
        tamagi_timezone="${result:-America/Sao_Paulo}"
    fi
    if [ "${tamagi_timezone}" = "OUTRO" ]; then
        # Em inglês não há lista curta: vai direto à lista completa.
        # shellcheck disable=SC2046
        d --list --title="$(T tz_title)" --width=460 --height=560 --text="$(T tz_pick)" \
            --column="$(T tz_zone)" $(timedatectl list-timezones --no-pager)
        tamagi_timezone="${result:-UTC}"
    fi
}

tamagi_ask_user() {
    # zenity direto, e não pelo d() do tik: o d() grava o resultado no tik.log,
    # e aqui o resultado tem a senha.
    local out fullname user pass1 pass2
    while true; do
        out=$(zenity --forms --title="$(T user_title)" --width=460 --separator=$'\x1f' \
            --text="$(T user_text)" \
            --add-entry="$(T user_full)" \
            --add-entry="$(T user_name)" \
            --add-password="$(T user_pass)" \
            --add-password="$(T user_pass2)") || { tamagi_cancel; continue; }
        IFS=$'\x1f' read -r fullname user pass1 pass2 <<< "${out}"
        fullname=$(printf '%s' "${fullname}" | tr -d ':,\n' | sed -E 's/^ +| +$//g')
        user=$(printf '%s' "${user}" | sed -E 's/^ +| +$//g')
        if [ -z "${user}" ] && [ -n "${fullname}" ]; then
            # Sem nome de usuário: sugere o primeiro nome, sem acentos.
            user=$(printf '%s' "${fullname%% *}" | iconv -f UTF-8 -t ASCII//TRANSLIT 2>/dev/null | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9')
        fi
        if ! [[ ${user} =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]; then
            tamagi_msg "$(T bad_user)"; continue
        fi
        if getent passwd "${user}" >/dev/null 2>&1 && [ "${user}" != "live" ]; then
            tamagi_msg "$(T reserved)"; continue
        fi
        [ "${user}" != "live" ] || { tamagi_msg "$(T reserved)"; continue; }
        [ -n "${pass1}" ] || { tamagi_msg "$(T empty_pass)"; continue; }
        [ "${pass1}" = "${pass2}" ] || { tamagi_msg "$(T pass_mismatch)"; continue; }
        break
    done
    tamagi_user="${user}"
    tamagi_fullname="${fullname:-${user}}"
    tamagi_hash=$(printf '%s' "${pass1}" | openssl passwd -6 -stdin)
}

tamagi_ask_encryption() {
    local out pass1 pass2
    rm -f "${tamagi_luks_key}"
    while true; do
        zenity --question --no-wrap --title="$(T enc_title)" --width=480 \
            --ok-label="$(T enc_yes)" --cancel-label="$(T enc_no)" --text="$(T enc_text)" \
            || return 0
        # Cancelar o formulário volta à pergunta acima: quem pediu criptografia
        # não fica sem ela por engano.
        out=$(zenity --forms --title="$(T luks_title)" --width=460 --separator=$'\x1f' \
            --text="$(T luks_text)" \
            --add-password="$(T luks_title)" --add-password="$(T user_pass2)") || continue
        IFS=$'\x1f' read -r pass1 pass2 <<< "${out}"
        [ "${#pass1}" -ge 8 ] || { tamagi_msg "$(T luks_short)"; continue; }
        [ "${pass1}" = "${pass2}" ] || { tamagi_msg "$(T pass_mismatch)"; continue; }
        break
    done
    ( umask 077; printf '%s' "${pass1}" > "${tamagi_luks_key}" )
    # Com chip TPM 2.0, a chave pode ficar nele: o disco abre sozinho no boot
    # e a senha fica de reserva.
    tamagi_tpm=0
    if [ -e /sys/class/tpm/tpm0 ] && [ "$(cat /sys/class/tpm/tpm0/tpm_version_major 2>/dev/null)" = "2" ]; then
        zenity --question --no-wrap --title="$(T tpm_title)" --width=520 \
            --ok-label="$(T tpm_yes)" --cancel-label="$(T tpm_no)" --text="$(T tpm_text)" && tamagi_tpm=1
    fi
    return 0
}

tamagi_write_answers() {
    ( umask 077
      {
          echo "LOCALE=${tamagi_locale}"
          echo "KEYMAP=${tamagi_keymap}"
          echo "XKB_LAYOUT=${tamagi_xkb_layout}"
          echo "XKB_VARIANT=${tamagi_xkb_variant}"
          echo "TIMEZONE=${tamagi_timezone}"
          echo "HOSTNAME=tamagi"
          echo "USER=${tamagi_user}"
          echo "FULLNAME=${tamagi_fullname}"
          echo "PASSWORD_HASH=${tamagi_hash}"
          [ -s "${tamagi_luks_key}" ] && echo "LUKS_KEYFILE=${tamagi_luks_key}"
          [ -s "${tamagi_luks_key}" ] && [ "${tamagi_tpm:-0}" = "1" ] && echo "LUKS_TPM=1"
          [ -n "${tamagi_extra_kargs:-}" ] && echo "EXTRA_KARGS=${tamagi_extra_kargs}"
          [ -n "${tamagi_imgref:-}" ] && echo "TARGET_IMGREF=${tamagi_imgref}"
          echo "VERIFY_STATE=${tamagi_verify}"
      } > "${tamagi_answers}" )
}

# ── Etapas do tik redefinidas ───────────────────────────────────────────────

get_img() { # o tik procuraria uma imagem de disco; aqui a origem é a imagem bootc
    TIK_INSTALL_IMAGE="bootc"
}

dump_image() { # no tik: grava a imagem no disco. Aqui: bootc install.
    local target=$2 info rc preserve=0
    local -A D=()
    info=$(lsblk -dno SIZE,MODEL "${target}" 2>/dev/null | sed -E 's/ +/ /g')

    detect_into() {
        local line k v rc_d=0
        D=()
        while IFS='=' read -r k v; do
            [[ -n $k ]] && D[$k]=$v
        done < <(tamagi_priv /usr/libexec/tamagi-detect-home "${target}" "$@" 2>/dev/null) || rc_d=$?
        return "$rc_d"
    }

    append_preserve_answers() {
        sed -i '/^PRESERVE_/d; /^HOME_/d; /^SYS_PART=/d; /^ESP_PART=/d; /^BOOT_PART=/d' "${tamagi_answers}"
        {
            echo "PRESERVE_HOME=1"
            echo "PRESERVE_MODE=${D[PRESERVABLE]}"
            echo "PRESERVE_LUKS=${D[PRESERVE_LUKS]:-0}"
            echo "HOME_PART=${D[HOME_PART]}"
            echo "HOME_SUBVOL=${D[HOME_SUBVOL]:-}"
            echo "HOME_RELPATH=${D[HOME_RELPATH]:-}"
            echo "HOME_FSTYPE=${D[HOME_FSTYPE]:-btrfs}"
            echo "SYS_PART=${D[SYS_PART]:-}"
            echo "ESP_PART=${D[ESP_PART]}"
            echo "BOOT_PART=${D[BOOT_PART]:-}"
        } >> "${tamagi_answers}"
    }

    if [ -n "${tamagi_auto}" ]; then
        if [ "${tamagi_preserve_auto:-}" = "1" ]; then
            if [ -s "${tamagi_luks_key}" ]; then
                detect_into --key-file "${tamagi_luks_key}" || error "tamagi.autoinstall.preserve_home=1: falha ao abrir LUKS em ${target}"
            else
                detect_into || true
            fi
            case "${D[PRESERVABLE]:-}" in
                btrfs-subvol|ostree-home|separate-home)
                    preserve=1
                    append_preserve_answers
                    log "[tamagi] autoinstall: preservando /var/home (${D[PRESERVABLE]}, usuários: ${D[USERS]:-})" ;;
                *) error "tamagi.autoinstall.preserve_home=1: nenhum /var/home preservável encontrado em ${target}" ;;
            esac
        fi
    elif [ -x /usr/libexec/tamagi-detect-home ]; then
        detect_into || true
        if [ "${D[PRESERVABLE]:-}" = "luks" ]; then
            if zenity --question --no-wrap --title="$(T luks_found_title)" --width=480 \
                --ok-label="$(T luks_unlock_yes)" --cancel-label="$(T luks_unlock_no)" --text="$(T luks_found_text)"; then
                local existing_pw rc_u
                while true; do
                    existing_pw=$(zenity --password --title="$(T luks_found_title)" --text="$(T luks_unlock_prompt)") || break
                    ( umask 077; printf '%s' "${existing_pw}" > "${tamagi_existing_luks_key}" )
                    rc_u=0
                    detect_into --key-file "${tamagi_existing_luks_key}" || rc_u=$?
                    if [ "${rc_u}" -eq 0 ]; then
                        break
                    elif [ "${rc_u}" -eq 2 ]; then
                        rm -f "${tamagi_existing_luks_key}"
                        tamagi_msg "$(T luks_unlock_bad)"
                    else
                        rm -f "${tamagi_existing_luks_key}"
                        break
                    fi
                done
            fi
        fi
        case "${D[PRESERVABLE]:-}" in
            btrfs-subvol|ostree-home|separate-home)
                local htxt
                htxt="$(T home_found_text)"
                htxt="${htxt//\{users\}/${D[USERS]:-}}"
                if zenity --question --no-wrap --title="$(T home_found_title)" --width=500 \
                    --ok-label="$(T home_keep)" --cancel-label="$(T home_erase)" --text="${htxt}"; then
                    preserve=1
                    append_preserve_answers
                    if [ "${D[PRESERVE_LUKS]:-0}" = "1" ] && [ -s "${tamagi_existing_luks_key}" ]; then
                        sed -i '/^LUKS_KEYFILE=/d; /^LUKS_TPM=/d' "${tamagi_answers}"
                        echo "LUKS_KEYFILE=${tamagi_existing_luks_key}" >> "${tamagi_answers}"
                        if [ -e /sys/class/tpm/tpm0 ] && [ "$(cat /sys/class/tpm/tpm0/tpm_version_major 2>/dev/null)" = "2" ]; then
                            zenity --question --no-wrap --title="$(T tpm_title)" --width=520 \
                                --ok-label="$(T tpm_yes)" --cancel-label="$(T tpm_no)" --text="$(T tpm_text)" \
                                && echo "LUKS_TPM=1" >> "${tamagi_answers}"
                        fi
                    fi
                fi ;;
        esac
    fi

    if (( preserve )); then
        local ptxt enc_label
        ptxt="$(T begin_preserve_text)"
        ptxt="${ptxt//\{users\}/${D[USERS]:-}}"
        enc_label="$( [ "${D[PRESERVE_LUKS]:-0}" = "1" ] || [ -s "${tamagi_luks_key}" ] && T yes || T no )"
        d --question --no-wrap --title="$(T begin_title)" --width=500 \
            --ok-label="$(T begin_ok)" --cancel-label="$(T cancel)" \
            --text="${ptxt}\n\n<tt>${target}</tt>\n${info}\n\n$(T begin_enc): <b>${enc_label}</b>\n$(T begin_warn)"
    else
        d --question --no-wrap --title="$(T begin_title)" --width=480 \
            --ok-label="$(T begin_ok)" --cancel-label="$(T cancel)" \
            --text="$(T begin_text)\n\n<tt>${target}</tt>\n${info}\n\n$(T begin_enc): <b>$([ -s "${tamagi_luks_key}" ] && T yes || T no)</b>\n$(T begin_warn)"
    fi
    tamagi_started=1
    log "[tamagi] instalando em ${target}"
    if $gui && [ -z "${tamagi_auto}" ]; then
        # O código de saída vai por arquivo, e a barra sempre recebe 100 no
        # fim: assim a janela de progresso fecha também quando dá erro.
        rm -f "${tamagi_dir}/rc"
        {
            tamagi_priv /usr/libexec/tamagi-install "${target}" "${tamagi_answers}"
            echo "$?" > "${tamagi_dir}/rc"
            echo "PROGRESS 100 Fim"
        } | tee -a "${tik_log}" \
            | sed -unE 's/^PROGRESS ([0-9]+) (.*)$/\1\n# \2/p' \
            | zenity --progress --no-cancel --auto-close --width=520 \
                --title="$(T prog_title)" --text="$(T prog_text)"
        rc=$(cat "${tamagi_dir}/rc" 2>/dev/null || echo 1)
    else
        tamagi_priv /usr/libexec/tamagi-install "${target}" "${tamagi_answers}"
        rc=$?
    fi
    log "[tamagi] tamagi-install terminou com código ${rc}"
    [ "${rc}" = "0" ] || error "$(T failed) <tt>${tik_log}</tt>."
    tamagi_done=1
}

# O tamagi-install já deixa o disco pronto; o bootc (bootupd) instala o
# carregador de boot e registra a entrada na firmware.
reread_partitiontable() { :; }
wipe_keyfile() { :; }
set_boot_target() { :; }

cleanup() { # no tik: reinicia ou DESLIGA. Aqui: cancelar volta ao desktop live.
    retval=$?
    log "[STOP][${retval}] $0"
    rm -f "${tamagi_luks_key}" "${tamagi_existing_luks_key}" "${tamagi_answers}"
    # Saiu antes de instalar: a conferência da mídia não tem mais para quem trabalhar.
    [ -s "${tamagi_verify}/pid" ] && kill "$(cat "${tamagi_verify}/pid")" 2>/dev/null
    if [ -n "${tamagi_auto}" ]; then
        if [ "${tamagi_done}" = "1" ]; then echo "TAMAGI-AUTOINSTALL: OK"; else echo "TAMAGI-AUTOINSTALL: FALHOU (código ${retval})"; fi
        sync
        systemctl poweroff --no-block
    elif [ "${tamagi_done}" = "1" ]; then
        local rc=3
        if [ -x /usr/libexec/tamagi-installer-splash ]; then
            rc=0
            /usr/libexec/tamagi-installer-splash --title "$(T done_title)" --heading "$(T done_title)" \
                "$(T done_text)" "$(T reboot)" "$(T stay)" || rc=$?
        fi
        if [ "${rc}" = "3" ]; then
            rc=0
            zenity --question --no-wrap --title="$(T done_title)" --width=440 \
                --ok-label="$(T reboot)" --cancel-label="$(T stay)" --text="$(T done_text)" || rc=$?
        fi
        [ "${rc}" = "0" ] && tamagi_priv systemctl reboot
    elif [ "${tamagi_started}" = "1" ]; then
        local rc=3
        if [ -x /usr/libexec/tamagi-installer-splash ]; then
            rc=0
            /usr/libexec/tamagi-installer-splash --title "$(T fail_title)" --heading "$(T fail_title)" \
                "$(T fail_text) <tt>${tik_log}</tt>" "OK" || rc=$?
        fi
        if [ "${rc}" = "3" ]; then
            zenity --error --no-wrap --title="$(T fail_title)" --width=480 \
                --text="$(T fail_text) <tt>${tik_log}</tt>" || true
        fi
    fi
}

# ── Perguntas ───────────────────────────────────────────────────────────────

if [ -n "${tamagi_auto}" ]; then
    log "[tamagi] instalação sem perguntas em ${tamagi_auto}"
    # Sem ninguém para responder: nenhuma janela pode travar a instalação.
    d() { log "[auto] janela ignorada: $*"; result=""; return 0; }
    d_opt() { log "[auto] janela ignorada: $*"; result=""; return 0; }
    TIK_INSTALL_DEVICE="${tamagi_auto}"
    tamagi_xkb_variant=""
    tamagi_auto_lang="$(tamagi_karg tamagi.autoinstall.lang)"
    case "${tamagi_auto_lang:-${tamagi_default_lang}}" in
        pt) tamagi_set_lang pt; tamagi_keymap="br-abnt2"; tamagi_xkb_layout="br"; tamagi_timezone="America/Sao_Paulo" ;;
        es) tamagi_set_lang es; tamagi_keymap="es"; tamagi_xkb_layout="es"; tamagi_timezone="Europe/Madrid" ;;
        fr) tamagi_set_lang fr; tamagi_keymap="fr"; tamagi_xkb_layout="fr"; tamagi_timezone="Europe/Paris" ;;
        *)  tamagi_set_lang en; tamagi_keymap="us"; tamagi_xkb_layout="us"; tamagi_timezone="UTC" ;;
    esac
    tamagi_user="$(tamagi_karg tamagi.autoinstall.user)"; tamagi_user="${tamagi_user:-tamagi}"
    tamagi_fullname="${tamagi_user}"
    tamagi_password="$(tamagi_karg tamagi.autoinstall.password)"
    tamagi_hash=$(printf '%s' "${tamagi_password:-tamagi}" | openssl passwd -6 -stdin)
    tamagi_extra_kargs="$(tamagi_karg tamagi.autoinstall.kargs | tr ',' ' ')"
    rm -f "${tamagi_luks_key}"
    tamagi_luks="$(tamagi_karg tamagi.autoinstall.luks)"
    [ -z "${tamagi_luks}" ] || ( umask 077; printf '%s' "${tamagi_luks}" > "${tamagi_luks_key}" )
    tamagi_tpm="$(tamagi_karg tamagi.autoinstall.tpm)"
    # Só para testes: outra origem de atualizações (um registry local).
    tamagi_imgref="$(tamagi_karg tamagi.autoinstall.imgref)"
    tamagi_preserve_auto="$(tamagi_karg tamagi.autoinstall.preserve_home)"
    [ -d /sys/firmware/efi ] || error "sem UEFI"
else
    tamagi_ask_language
    tamagi_welcome
    tamagi_ask_keyboard
    tamagi_ask_timezone
    tamagi_ask_user
    tamagi_ask_encryption
fi
tamagi_write_answers
