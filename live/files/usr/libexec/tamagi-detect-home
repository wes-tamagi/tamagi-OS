#!/usr/bin/bash
# tamagi-detect-home — detecta em modo somente-leitura um /var/home ou /home
# preservável no disco escolhido (layout anterior GRUB+ostree do Tamagi,
# subvolume home/@home estilo Aeon, ou partição /home dedicada).
#
#   tamagi-detect-home <disco> [--key-file <arquivo>]
#
# Saída (CHAVE=valor, uma por linha; PRESERVABLE vazio = nada preservável):
#   PRESERVABLE=luks | btrfs-subvol | ostree-home | separate-home | ""
#   Sai com 2 se --key-file não abrir a partição LUKS.
set -euo pipefail

DISK=${1:-}
KEYFILE=""
shift || true
while (( $# )); do
    case "$1" in
        --key-file) KEYFILE=${2:-}; shift 2 ;;
        *) echo "uso: tamagi-detect-home <disco> [--key-file <arquivo>]" >&2; exit 2 ;;
    esac
done

[[ -b $DISK ]] || { echo "disco inválido: $DISK" >&2; exit 1; }
DISK=$(realpath "$DISK")

WORK="/run/tamagi-detect.$$"
MNT="$WORK/mnt"
MAPPER="tamagi-detect-luks-$$"
MIN_DATA_BYTES=$(( 24 * 1024 * 1024 * 1024 ))
ESP_GUID="C12A7328-F81F-11D2-BA4B-00A0C93EC93B"

cleanup() {
    set +e
    umount "$MNT" 2>/dev/null
    cryptsetup close "$MAPPER" 2>/dev/null
    rm -rf "$WORK" 2>/dev/null
}
trap cleanup EXIT

mkdir -p "$MNT"

emit_none() {
    echo "PRESERVABLE="
    exit 0
}

list_home_users() {
    local dir=$1 u user_list=()
    [[ -d $dir ]] || return 1
    while IFS= read -r u; do
        [[ $u =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || continue
        [[ $u == lost+found || $u == root ]] && continue
        user_list+=("$u")
    done < <(find "$dir" -mindepth 1 -maxdepth 1 -type d ! -name '.*' -printf '%f\n' 2>/dev/null | sort)
    (( ${#user_list[@]} > 0 )) || return 1
    local IFS=,
    echo "${user_list[*]}"
}

looks_like_user_data() {
    local dir=$1 u
    while IFS= read -r u; do
        [[ $u =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || continue
        [[ $u == lost+found || $u == root ]] && continue
        for marker in .bashrc .profile .config Documents Desktop; do
            [[ -e "$dir/$u/$marker" ]] && return 0
        done
    done < <(find "$dir" -mindepth 1 -maxdepth 1 -type d ! -name '.*' -printf '%f\n' 2>/dev/null)
    return 1
}

sfdisk_json=$(sfdisk -J "$DISK" 2>/dev/null) || emit_none
[[ $(jq -r '.partitiontable.label // empty' <<<"$sfdisk_json") == gpt ]] || emit_none

mapfile -t PARTS < <(
    jq -r --arg esp "$ESP_GUID" '
        .partitiontable.partitions
        | sort_by(.start)
        | .[]
        | "\(.node)\t\(.start)\t\(.size)\t\((.type // "") | ascii_upcase)\t\(.name // "")"
    ' <<<"$sfdisk_json"
)
(( ${#PARTS[@]} >= 2 )) || emit_none

ESP_PART="" esp_idx=-1 esp_start=0 esp_size=0
for i in "${!PARTS[@]}"; do
    IFS=$'\t' read -r node start size ptype pname <<<"${PARTS[$i]}"
    [[ -b $node ]] || continue
    if [[ $ptype == "$ESP_GUID" ]] && [[ $(blkid -s TYPE -o value "$node" 2>/dev/null || true) == vfat ]]; then
        ESP_PART=$node
        esp_idx=$i
        esp_start=$start
        esp_size=$size
        break
    fi
done
[[ -n $ESP_PART ]] || emit_none

BOOT_PART=""
MERGED_ESP_MIB=$(( esp_size * 512 / 1048576 ))
if (( esp_idx + 1 < ${#PARTS[@]} )); then
    IFS=$'\t' read -r n_node n_start n_size _ _ <<<"${PARTS[$(( esp_idx + 1 ))]}"
    gap=$(( n_start - (esp_start + esp_size) ))
    # Partição /boot ext4 contígua logo após a ESP (<= 4 GiB, layout GRUB anterior)
    if [[ -b $n_node ]] && (( gap >= 0 && gap <= 4096 && n_size <= 8388608 )); then
        if [[ $(blkid -s TYPE -o value "$n_node" 2>/dev/null || true) == ext4 ]]; then
            BOOT_PART=$n_node
            MERGED_ESP_MIB=$(( (n_start + n_size - esp_start) * 512 / 1048576 ))
        fi
    fi
fi
(( MERGED_ESP_MIB >= 512 )) || emit_none

DATA_PARTS=()
for entry in "${PARTS[@]}"; do
    IFS=$'\t' read -r node _ _ _ _ <<<"$entry"
    [[ -b $node ]] || continue
    [[ $node == "$ESP_PART" || $node == "$BOOT_PART" ]] && continue
    DATA_PARTS+=("$entry")
done
(( ${#DATA_PARTS[@]} >= 1 )) || emit_none

# ── Passagem 1: partição Btrfs (direta ou LUKS2) com subvolume home/@home ou ostree/deploy/*/var/home
for entry in "${DATA_PARTS[@]}"; do
    IFS=$'\t' read -r part _ _ _ _ <<<"$entry"
    size_bytes=$(blockdev --getsize64 "$part" 2>/dev/null || echo 0)
    (( size_bytes >= MIN_DATA_BYTES )) || continue
    fstype=$(blkid -s TYPE -o value "$part" 2>/dev/null || true)
    dev=""
    luks_flag=0
    if [[ $fstype == crypto_LUKS ]]; then
        if [[ -z $KEYFILE ]]; then
            cat <<OUT
PRESERVABLE=luks
LUKS_PART=$part
ESP_PART=$ESP_PART
BOOT_PART=$BOOT_PART
MERGED_ESP_MIB=$MERGED_ESP_MIB
OUT
            exit 0
        fi
        [[ -r $KEYFILE ]] || exit 2
        cryptsetup open --readonly --key-file "$KEYFILE" "$part" "$MAPPER" >/dev/null 2>&1 || exit 2
        dev="/dev/mapper/$MAPPER"
        luks_flag=1
        fstype=$(blkid -s TYPE -o value "$dev" 2>/dev/null || true)
    else
        dev=$part
    fi

    if [[ $fstype == btrfs ]]; then
        if mount -o ro,subvolid=5 "$dev" "$MNT" 2>/dev/null; then
            for cand in home @home; do
                if [[ -d $MNT/$cand ]] && users=$(list_home_users "$MNT/$cand"); then
                    cat <<OUT
PRESERVABLE=btrfs-subvol
HOME_PART=$part
HOME_SUBVOL=$cand
HOME_FSTYPE=btrfs
PRESERVE_LUKS=$luks_flag
USERS=$users
ESP_PART=$ESP_PART
BOOT_PART=$BOOT_PART
MERGED_ESP_MIB=$MERGED_ESP_MIB
OUT
                    exit 0
                fi
            done
            for dir in "$MNT"/ostree/deploy/*/var/home; do
                [[ -d $dir ]] || continue
                if users=$(list_home_users "$dir"); then
                    rel=${dir#"$MNT/"}
                    cat <<OUT
PRESERVABLE=ostree-home
HOME_PART=$part
HOME_RELPATH=$rel
HOME_SUBVOL=home
HOME_FSTYPE=btrfs
PRESERVE_LUKS=$luks_flag
USERS=$users
ESP_PART=$ESP_PART
BOOT_PART=$BOOT_PART
MERGED_ESP_MIB=$MERGED_ESP_MIB
OUT
                    exit 0
                fi
            done
            umount "$MNT" 2>/dev/null || true
        fi
    fi

    if (( luks_flag )); then
        cryptsetup close "$MAPPER" 2>/dev/null || true
    fi
done

# ── Passagem 2: partição /home separada (ex.: ext4/xfs/btrfs dedicada + outra partição >= 24 GiB para o sistema)
if (( ${#DATA_PARTS[@]} >= 2 )); then
    HOME_PART="" HOME_FSTYPE="" HOME_SUBVOL="" USERS=""
    for entry in "${DATA_PARTS[@]}"; do
        IFS=$'\t' read -r part _ _ _ pname <<<"$entry"
        fstype=$(blkid -s TYPE -o value "$part" 2>/dev/null || true)
        case "$fstype" in
            ext4|xfs|btrfs) ;;
            *) continue ;;
        esac
        mnt_opts="ro"
        [[ $fstype == btrfs ]] && mnt_opts="ro,subvolid=5"
        mount -o "$mnt_opts" "$part" "$MNT" 2>/dev/null || continue
        is_os=0
        [[ -d $MNT/usr || -e $MNT/etc/os-release || -d $MNT/ostree || -d $MNT/root/usr ]] && is_os=1
        if (( ! is_os )); then
            fs_label=$(blkid -s LABEL -o value "$part" 2>/dev/null || true)
            cand_dir="" cand_subvol=""
            if [[ $fstype == btrfs ]]; then
                for sv in home @home; do
                    if [[ -d $MNT/$sv ]] && users=$(list_home_users "$MNT/$sv"); then
                        cand_dir="$MNT/$sv"
                        cand_subvol=$sv
                        break
                    fi
                done
            fi
            if [[ -z $cand_dir ]] && users=$(list_home_users "$MNT"); then
                cand_dir="$MNT"
            fi
            if [[ -n $cand_dir ]] && { looks_like_user_data "$cand_dir" || [[ ${pname,,} == *home* || ${fs_label,,} == *home* ]]; }; then
                HOME_PART=$part
                HOME_FSTYPE=$fstype
                HOME_SUBVOL=$cand_subvol
                USERS=$users
                umount "$MNT" 2>/dev/null || true
                break
            fi
        fi
        umount "$MNT" 2>/dev/null || true
    done

    if [[ -n $HOME_PART ]]; then
        SYS_PART="" best_size=0
        for entry in "${DATA_PARTS[@]}"; do
            IFS=$'\t' read -r part _ _ _ _ <<<"$entry"
            [[ $part == "$HOME_PART" ]] && continue
            size_bytes=$(blockdev --getsize64 "$part" 2>/dev/null || echo 0)
            (( size_bytes >= MIN_DATA_BYTES )) || continue
            if (( size_bytes > best_size )); then
                best_size=$size_bytes
                SYS_PART=$part
            fi
        done
        if [[ -n $SYS_PART ]]; then
            cat <<OUT
PRESERVABLE=separate-home
HOME_PART=$HOME_PART
HOME_FSTYPE=$HOME_FSTYPE
HOME_SUBVOL=$HOME_SUBVOL
SYS_PART=$SYS_PART
PRESERVE_LUKS=0
USERS=$USERS
ESP_PART=$ESP_PART
BOOT_PART=$BOOT_PART
MERGED_ESP_MIB=$MERGED_ESP_MIB
OUT
            exit 0
        fi
    fi
fi

emit_none
