#!/usr/bin/bash
# tamagi-verify-media — confere todas as edições embutidas na mídia OCI
# (Tamagi-DxAI e Tamagi-SKL) deduplicando os blobs compartilhados por SHA-256.
set -uo pipefail
dir=${1:?pasta da imagem OCI}
state=${2:-}

verify() {
    local digests manifest d all_digests=()
    mapfile -t digests < <(jq -r '.manifests[].digest' "$dir/index.json") || return 1
    (( ${#digests[@]} > 0 )) || return 1
    for d in "${digests[@]}"; do
        manifest="$dir/blobs/${d/://}"
        [[ -f $manifest ]] || { echo "manifesto ausente: $d" >&2; return 1; }
        if jq -e '.manifests' "$manifest" >/dev/null 2>&1; then
            d=$(jq -r '.manifests[0].digest' "$manifest")
            manifest="$dir/blobs/${d/://}"
            [[ -f $manifest ]] || { echo "manifesto interno ausente: $d" >&2; return 1; }
        fi
        all_digests+=("$d")
        while IFS= read -r layer_d; do
            [[ -n $layer_d ]] && all_digests+=("$layer_d")
        done < <(jq -r '.config.digest, .layers[].digest' "$manifest")
    done
    printf '%s\n' "${all_digests[@]}" | sort -u \
        | sed -E 's#^sha256:([0-9a-f]{64})$#\1  blobs/sha256/\1#' \
        | ( cd "$dir" && xargs -d '\n' -n 8 -P "$(nproc)" sh -c 'printf "%s\n" "$@" | sha256sum --check --quiet --strict' _ )
}

if [[ -z $state ]]; then
    verify
    exit
fi
mkdir -p "$state"
rm -f "$state/rc"
echo $$ > "$state/pid"
ionice -c 3 -p $$ 2>/dev/null || true
if verify 2>"$state/log"; then
    echo "ok $(sha256sum "$dir/index.json" | cut -d' ' -f1)" > "$state/rc.tmp"
else
    echo bad > "$state/rc.tmp"
fi
mv "$state/rc.tmp" "$state/rc"
rm -f "$state/pid"
