[Unit]
Description=Tamagi: instalação sem perguntas (tamagi.autoinstall=<disco> na linha do kernel)
Documentation=file:///usr/share/doc/tamagi/README.md
ConditionKernelCommandLine=tamagi.autoinstall
After=systemd-user-sessions.service

[Service]
Type=oneshot
Environment=HOME=/root XDG_SESSION_TYPE=tty
ExecStart=/usr/libexec/tamagi-autoinstall
StandardOutput=journal+console
StandardError=journal+console
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
